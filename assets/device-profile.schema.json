{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "platform",
    "width",
    "height",
    "dpr",
    "radius",
    "cutout",
    "colors",
    "colorNames"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "[a-z0-9][a-z0-9_-]{0,63}"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android",
        "generic"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 160,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 160,
      "maximum": 4096
    },
    "openWidth": {
      "type": "integer",
      "minimum": 160,
      "maximum": 4096
    },
    "openHeight": {
      "type": "integer",
      "minimum": 160,
      "maximum": 4096
    },
    "dpr": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "radius": {
      "type": "number",
      "minimum": 0,
      "maximum": 200,
      "description": "Screen corner radius in points."
    },
    "bezel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "cutout": {
      "type": "string",
      "enum": [
        "none",
        "island",
        "compact",
        "notch",
        "punch",
        "punch-right"
      ]
    },
    "openCutout": {
      "type": "string",
      "enum": [
        "none",
        "island",
        "compact",
        "notch",
        "punch",
        "punch-right"
      ]
    },
    "cutoutWidth": {
      "type": "number",
      "minimum": 0,
      "maximum": 300
    },
    "cutoutHeight": {
      "type": "number",
      "minimum": 0,
      "maximum": 300
    },
    "cutoutOffset": {
      "type": "number",
      "minimum": 0,
      "maximum": 300
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "#[0-9A-Fa-f]{6}"
      }
    },
    "colorNames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "display": {
      "type": "string",
      "maxLength": 1000
    },
    "family": {
      "type": "string",
      "maxLength": 1000
    },
    "pixels": {
      "type": "string",
      "maxLength": 1000
    },
    "openPixels": {
      "type": "string",
      "maxLength": 1000
    },
    "source": {
      "type": "string",
      "maxLength": 1000
    },
    "designSource": {
      "type": "string",
      "maxLength": 1000
    },
    "verifiedAt": {
      "type": "string",
      "maxLength": 1000
    },
    "confidence": {
      "type": "string",
      "maxLength": 1000
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "safePortrait": {
      "type": "object",
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "right": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "bottom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      }
    },
    "safeLandscape": {
      "type": "object",
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "right": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "bottom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      }
    },
    "openSafePortrait": {
      "type": "object",
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "right": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "bottom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      }
    },
    "openSafeLandscape": {
      "type": "object",
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "right": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "bottom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      }
    },
    "hingeEdge": {
      "type": "boolean"
    },
    "virtual": {
      "type": "object",
      "required": [
        "panel",
        "variant",
        "source"
      ],
      "additionalProperties": false,
      "description": "How the virtual iPhone is described as this model: its panel (WIDTHxHEIGHT@HZ:WIDTH_MMxHEIGHT_MM), the gestalt variant of the device tree it starts from, and for models other than that variant the derived artwork subtype, corner radius (points), bottom edge of the island (pixels; 0 for a device without one) and large-format flag.",
      "properties": {
        "panel": {
          "type": "string",
          "pattern": "^[0-9]{2,5}x[0-9]{2,5}@[0-9]{1,3}:[0-9]{2,4}x[0-9]{2,4}$"
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z0-9]{1,24}$"
        },
        "source": {
          "type": "string",
          "enum": [
            "apple",
            "derived"
          ]
        },
        "artworkSubtype": {
          "type": "integer",
          "minimum": 480,
          "maximum": 8192
        },
        "cornerRadius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "islandBottom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "largeFormat": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "openRadius": {
      "type": "number",
      "minimum": 0,
      "maximum": 200,
      "description": "Corner radius of a foldable's unfolded display in points."
    },
    "ppi": {
      "type": "number",
      "minimum": 100,
      "maximum": 1000,
      "description": "Pixel density of the display; with body it sets the frame's points per millimetre."
    },
    "openPpi": {
      "type": "number",
      "minimum": 100,
      "maximum": 1000
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "description": "The body seen from the front, in millimetres: outline (width, height; openWidth and openHeight unfolded), depth, outer corner radius (continuous; radii per corner where they differ), the display's black border inside the metal band, and the active area's offset from the left and top edges where it is not centred.",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "height": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "border": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "openWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "openHeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "openDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 400
        },
        "screenLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "screenTop": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "openScreenLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "openScreenTop": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "radii": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "description": "Outer corner radii in millimetres where they differ, top left, top right, bottom right, bottom left."
        },
        "openRadii": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "description": "As radii, unfolded."
        }
      }
    },
    "cutoutX": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000,
      "description": "Left edge of the cutout in points from the screen's left edge; centred when absent. The open* values describe the unfolded display."
    },
    "openCutoutWidth": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "openCutoutHeight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "openCutoutOffset": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "openCutoutX": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "buttons": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "edge",
          "from",
          "length"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "side",
              "volume",
              "volumeUp",
              "volumeDown",
              "action",
              "cameraControl"
            ]
          },
          "edge": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "from": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "length": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "description": "Hardware buttons seen from the front: edge, and start and length as fractions of that edge measured from its top (left/right) or its left end (top/bottom)."
    },
    "openButtons": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "edge",
          "from",
          "length"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "side",
              "volume",
              "volumeUp",
              "volumeDown",
              "action",
              "cameraControl"
            ]
          },
          "edge": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "from": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "length": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "back": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parts"
      ],
      "description": "The back seen from behind: parts placed in millimetres from its top left corner; a lens without height is round.",
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "x",
              "y",
              "width"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "plateau",
                  "lens",
                  "flash",
                  "lidar",
                  "mic",
                  "display"
                ]
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              },
              "radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              },
              "radii": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "description": "Corner radii in millimetres where they differ."
              }
            }
          }
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "openBack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parts"
      ],
      "description": "The back seen from behind: parts placed in millimetres from its top left corner; a lens without height is round.",
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "x",
              "y",
              "width"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "plateau",
                  "lens",
                  "flash",
                  "lidar",
                  "mic",
                  "display"
                ]
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              },
              "radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              },
              "radii": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "description": "Corner radii in millimetres where they differ."
              }
            }
          }
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "foldEdge": {
      "type": "string",
      "enum": [
        "left",
        "right",
        "top",
        "bottom"
      ],
      "description": "Edge of a folded device's hinge, seen from the front."
    },
    "provenance": {
      "type": "object",
      "maxProperties": 40,
      "additionalProperties": {
        "type": "string",
        "maxLength": 400
      },
      "description": "Where each geometry value comes from: official (manufacturer), measured (simulator, device tree, reviewer) or estimated, with its source."
    },
    "cornerRadii": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 200
      },
      "description": "Screen corner radii in points, top left, top right, bottom right, bottom left, where they differ (a folded display's hinge side)."
    },
    "openCornerRadii": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 200
      },
      "description": "As cornerRadii, for the unfolded display."
    },
    "cutoutRadius": {
      "type": "number",
      "minimum": 0,
      "maximum": 300,
      "description": "Lower corner radius of a notch in points."
    },
    "cutoutShoulder": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Radius of a notch's shoulders where it meets the top edge, in points."
    }
  }
}
