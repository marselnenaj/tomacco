diff --git a/src/native/tests/buffers.rs b/src/native/tests/buffers.rs
--- a/src/native/tests/buffers.rs
+++ b/src/native/tests/buffers.rs
@@ -7258,6 +7258,38 @@
     assert!(asm.contains("OpBitcast"), "{asm}");
     assert!(!asm.contains("non-bitcastable"), "{asm}");
     assert!(!asm.contains("OpBitcast %_ptr_"), "{asm}");
+}
+
+/// A narrower vector load through an aggregate pointer addresses its first bytes,
+/// even when the leading member has a different scalar width. It must not load
+/// the following member merely because that member has the requested type.
+#[test]
+fn native_aggregate_prefix_vector_load_reads_only_the_required_lanes() {
+    for (result_type, expected_loads) in [("<4 x half>", 2), ("<2 x half>", 1), ("<3 x i32>", 3)] {
+        let ll = format!(
+            r#"
+%Inner = type {{ <4 x float>, <4 x half>, [8 x i8] }}
+%Outer = type {{ %Inner, [32 x i8] }}
+define {result_type} @read_prefix() {{
+entry:
+  %record = alloca %Outer, align 16
+  %head = getelementptr inbounds %Outer, ptr %record, i64 0, i32 0, i32 0
+  store <4 x float> zeroinitializer, ptr %head, align 16
+  %result = load {result_type}, ptr %record, align 4
+  ret {result_type} %result
+}}
+"#
+        );
+        let bytes = emit_vulkan_spirv(&ll).expect("aggregate prefix vector load");
+        let asm = disassemble(&bytes).expect("disassemble");
+        assert_eq!(asm.matches("OpLoad").count(), expected_loads, "{asm}");
+        assert!(asm.contains("OpBitcast"), "{asm}");
+        assert!(!asm.contains("OpBitcast %_ptr_"), "{asm}");
+        assert!(
+            !asm.contains("OpFConvert"),
+            "memory is reinterpreted, not converted: {asm}"
+        );
+    }
 }
 
 #[test]
