 //! Seam-neutral structural queries over retained SPIR-V types and values.
 
 use super::*;
+
+/// Literal indices for an extract/insert. Malformed operands must not disappear from a path.
+pub(in crate::passes) fn literal_index_path(operands: &[Operand]) -> Option<Vec<u32>> {
+    if operands.is_empty() {
+        return None;
+    }
+    operands
+        .iter()
+        .map(|operand| match operand {
+            Operand::LiteralBit32(index) => Some(*index),
+            _ => None,
+        })
+        .collect()
+}
+
+pub(in crate::passes) fn composite_paths_are_disjoint(left: &[u32], right: &[u32]) -> bool {
+    !left.starts_with(right) && !right.starts_with(left)
+}
+
+/// Find an existing SSA value for a composite projection without synthesizing a new aggregate.
+///
+/// An insertion owns its complete subtree. Reading inside it descends into the inserted value;
+/// reading a disjoint field follows the base. Reading an ancestor of a changed field would require
+/// reconstruction and must not return the old base's value. Nested extracts compose their paths.
+/// Exact typed provenance takes precedence over aggregate storage: a logical pointer field may
+/// have an integer payload while its actual pointer is retained in the emitter's sidecar.
+/// The lookup borrows the caller's definitions and retains no cached result across IR rewrites.
+/// A value can be visited at most once: these pure definitions cannot legally form an SSA cycle.
+pub(in crate::passes) fn resolve_composite_path<'a>(
+    mut aggregate: Word,
+    path: &[u32],
+    mut definition: impl FnMut(Word) -> Option<&'a Instruction>,
+    mut projected_value: impl FnMut(Word, &[u32]) -> Option<Word>,
+) -> Option<Word> {
+    let mut path = path.to_vec();
+    let mut visited = HashSet::new();
+    while visited.insert(aggregate) {
+        if path.is_empty() {
+            return Some(aggregate);
+        }
+        if let Some(value) = projected_value(aggregate, &path) {
+            return Some(value);
+        }
+        let instruction = definition(aggregate)?;
+        match instruction.class.opcode {
+            Op::CompositeInsert => {
+                let [Operand::IdRef(object), Operand::IdRef(base), indices @ ..] =
+                    instruction.operands.as_slice()
+                else {
+                    return None;
+                };
+                let inserted_path = literal_index_path(indices)?;
+                if path.starts_with(&inserted_path) {
+                    path.drain(..inserted_path.len());
+                    aggregate = *object;
+                } else if composite_paths_are_disjoint(&path, &inserted_path) {
+                    aggregate = *base;
+                } else {
+                    return None;
+                }
+            }
+            Op::CompositeExtract => {
+                let [Operand::IdRef(composite), indices @ ..] = instruction.operands.as_slice()
+                else {
+                    return None;
+                };
+                let mut combined = literal_index_path(indices)?;
+                combined.extend_from_slice(&path);
+                path = combined;
+                aggregate = *composite;
+            }
+            Op::CompositeConstruct | Op::ConstantComposite | Op::SpecConstantComposite => {
+                let result_type = definition(instruction.result_type?)?;
+                // Structs, arrays and matrices have one operand per member/element/column.
+                // Vector construction can concatenate vector operands: its operand ordinal
+                // is not necessarily a component index. Leave that projection intact.
+                if !matches!(
+                    result_type.class.opcode,
+                    Op::TypeStruct | Op::TypeArray | Op::TypeMatrix
+                ) {
+                    return None;
+                }
+                let Operand::IdRef(object) = instruction.operands.get(path[0] as usize)? else {
+                    return None;
+                };
+                aggregate = *object;
+                path.remove(0);
+            }
+            Op::CopyObject => {
+                let [Operand::IdRef(source)] = instruction.operands.as_slice() else {
+                    return None;
+                };
+                aggregate = *source;
+            }
+            _ => return None,
+        }
+    }
+    None
+}
 
