+
+    #[test]
+    fn every_factor_and_operation_produces_a_valid_module() {
+        use BlendFactor as F;
+        let factors = [
+            F::Zero,
+            F::One,
+            F::SourceColor,
+            F::OneMinusSourceColor,
+            F::SourceAlpha,
+            F::OneMinusSourceAlpha,
+            F::DestinationColor,
+            F::OneMinusDestinationColor,
+            F::DestinationAlpha,
+            F::OneMinusDestinationAlpha,
+            F::SourceAlphaSaturated,
+        ];
+        let operations = [
+            BlendOperation::Add,
+            BlendOperation::Subtract,
+            BlendOperation::ReverseSubtract,
+            BlendOperation::Min,
+            BlendOperation::Max,
+        ];
+        let bytes = fragment("vulkan1.2", "", "");
+        for (index, &factor) in factors.iter().enumerate() {
+            let color = BlendEquation {
+                source: factor,
+                destination: factors[factors.len() - 1 - index],
+                operation: operations[index % operations.len()],
+            };
+            let alpha = BlendEquation {
+                source: factors[(index + 3) % factors.len()],
+                destination: factor,
+                operation: operations[(index + 2) % operations.len()],
+            };
+            let out = blend_and_quantize_present_fragment_color_outputs(
+                &bytes,
+                &[plan(color, alpha, 192)],
+            )
+            .unwrap_or_else(|e| panic!("{color:?}/{alpha:?}: {e}"));
+            validate(&out);
+        }
+    }
+
+    #[test]
+    fn float32_arithmetic_rounds_nothing_and_an_unblended_plan_is_the_quantizer() {
+        let bytes = fragment("vulkan1.2", "", "");
+        let mut float = plan(SOURCE_OVER, SOURCE_OVER, 192);
+        if let Some(blend) = &mut float.blend {
+            blend.arithmetic = BlendArithmetic::Float32;
+        }
+        let out = blend_and_quantize_present_fragment_color_outputs(&bytes, &[float]).unwrap();
+        validate(&out);
+        assert!(!body_ops(&load_bytes(&out).unwrap()).contains(&Op::QuantizeToF16));
+
+        let encoding = float.encoding;
+        assert_eq!(
+            blend_and_quantize_present_fragment_color_outputs(
+                &bytes,
+                &[BlendedFragmentColor {
+                    encoding,
+                    blend: None
+                }]
+            )
+            .unwrap(),
+            quantize_present_fragment_color_outputs(&bytes, &[encoding]).unwrap()
+        );
+    }
