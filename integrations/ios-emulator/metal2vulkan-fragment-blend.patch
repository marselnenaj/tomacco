+    #[test]
+    fn a_source_clamp_must_be_a_finite_ordered_interval() {
+        assert!(SourceClamp::checked(0.0, 1.0).is_ok());
+        assert!(SourceClamp::checked(1.0, 1.0).is_ok());
+        for (minimum, maximum) in [(1.0, 0.0), (f32::NAN, 1.0), (0.0, f32::INFINITY)] {
+            assert!(matches!(
+                SourceClamp::checked(minimum, maximum),
+                Err(ColorQuantizationRefusal::InvalidBlend)
+            ));
+        }
+    }
