+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const XR: AffineColorEncoding = AffineColorEncoding {
+        scale: 510,
+        zero: 384,
+        minimum: 0,
+        maximum: 1023,
+        transfer: ColorTransfer::Linear,
+    };
+
+    const SOURCE_OVER: BlendEquation = BlendEquation {
+        source: BlendFactor::One,
+        destination: BlendFactor::OneMinusSourceAlpha,
+        operation: BlendOperation::Add,
+    };
+
+    /// A fragment shader writing one constant RGBA32F colour to location 0.
+    /// `prelude` declares extra globals; `interface` extends the entry point.
+    fn fragment(env: &str, prelude: &str, interface: &str) -> Vec<u8> {
+        let text = format!(
+            "OpCapability Shader
+             {prelude_capabilities}
+             %glsl = OpExtInstImport \"GLSL.std.450\"
+             OpMemoryModel Logical GLSL450
+             OpEntryPoint Fragment %main \"main\" %color {interface}
+             OpExecutionMode %main OriginUpperLeft
+             OpDecorate %color Location 0
+             {prelude_decorations}
+             %void = OpTypeVoid
+             %fn = OpTypeFunction %void
+             %float = OpTypeFloat 32
+             %v4float = OpTypeVector %float 4
+             %out = OpTypePointer Output %v4float
+             %color = OpVariable %out Output
+             {prelude_types}
+             %half = OpConstant %float 0.5
+             %value = OpConstantComposite %v4float %half %half %half %half
+             %main = OpFunction %void None %fn
+             %entry = OpLabel
+             OpStore %color %value
+             OpReturn
+             OpFunctionEnd
+             ",
+            prelude_capabilities = if prelude.is_empty() {
+                ""
+            } else {
+                "OpCapability InputAttachment"
+            },
+            prelude_decorations = prelude.split('|').next().unwrap_or(""),
+            prelude_types = prelude.split('|').nth(1).unwrap_or(""),
+        );
+        let dir = std::env::temp_dir().join(format!(
+            "m2v-fragment-blend-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir_all(&dir).unwrap();
+        let source = dir.join("fragment.spvasm");
+        let binary = dir.join("fragment.spv");
+        std::fs::write(&source, text).unwrap();
+        let assembled = crate::tools::run(
+            "spirv-as",
+            &[
+                "--target-env",
+                env,
+                source.to_str().unwrap(),
+                "-o",
+                binary.to_str().unwrap(),
+            ],
+        );
+        let bytes = assembled.and_then(|_| std::fs::read(&binary).map_err(|e| e.to_string()));
+        let _ = std::fs::remove_dir_all(&dir);
+        bytes.expect("fixture assembles")
+    }
+
+    fn validate(bytes: &[u8]) {
+        let dir =
+            std::env::temp_dir().join(format!("m2v-fragment-blend-val-{}", std::process::id()));
+        let result = crate::tools::spirv_val_bytes(bytes, &dir);
+        let _ = std::fs::remove_dir(&dir);
+        result.expect("rewritten module validates");
+    }
+
+    fn plan(color: BlendEquation, alpha: BlendEquation, binding: u32) -> BlendedFragmentColor {
+        let rgb = SourceClamp::checked(-0.752_941_2, 1.250_980_4).unwrap();
+        let unit = SourceClamp::checked(0.0, 1.0).unwrap();
+        BlendedFragmentColor {
+            encoding: FragmentColorEncoding {
+                location: 0,
+                channels: [ColorChannelEncoding::Affine(XR); 4],
+            },
+            blend: Some(ProgrammableBlend {
+                color,
+                alpha,
+                source_clamp: [rgb, rgb, rgb, unit],
+                arithmetic: BlendArithmetic::Binary16,
+                destination: DestinationInput { set: 0, binding },
+            }),
+        }
+    }
+
+    fn destination_variables(module: &Module) -> Vec<Word> {
+        module
+            .annotations
+            .iter()
+            .filter(|inst| {
+                inst.class.opcode == Op::Decorate
+                    && inst.operands.get(1)
+                        == Some(&Operand::Decoration(Decoration::InputAttachmentIndex))
+                    && inst.operands.get(2) == Some(&Operand::LiteralBit32(0))
+            })
+            .filter_map(|inst| id(inst.operands.first()))
+            .collect()
+    }
+
+    fn body_ops(module: &Module) -> Vec<Op> {
+        module
+            .functions
+            .iter()
+            .flat_map(|f| f.all_inst_iter())
+            .map(|inst| inst.class.opcode)
+            .collect()
+    }
+
+    #[test]
+    fn blended_output_reads_its_declared_destination_in_both_interface_rules() {
+        for (env, all_globals) in [("vulkan1.0", false), ("vulkan1.2", true)] {
+            let bytes = fragment(env, "", "");
+            let out = blend_and_quantize_present_fragment_color_outputs(
+                &bytes,
+                &[plan(SOURCE_OVER, SOURCE_OVER, 192)],
+            )
+            .unwrap();
+            validate(&out);
+            let module = load_bytes(&out).unwrap();
+            let variables = destination_variables(&module);
+            assert_eq!(variables.len(), 1, "{env}");
+            let variable = variables[0];
+            assert_eq!(
+                direct_decoration(&module, variable, Decoration::DescriptorSet),
+                Some(0)
+            );
+            assert_eq!(
+                direct_decoration(&module, variable, Decoration::Binding),
+                Some(192)
+            );
+            assert!(module.capabilities.iter().any(|inst| {
+                inst.operands.first() == Some(&Operand::Capability(Capability::InputAttachment))
+            }));
+            assert_eq!(
+                module.entry_points[0].operands[3..].contains(&Operand::IdRef(variable)),
+                all_globals,
+                "{env}: the destination joins the interface exactly when SPIR-V 1.4 requires it"
+            );
+            let ops = body_ops(&module);
+            assert_eq!(ops.iter().filter(|&&op| op == Op::ImageRead).count(), 1);
+            assert!(ops.contains(&Op::QuantizeToF16));
+        }
+    }
+
+    #[test]
+    fn an_existing_destination_input_is_reused_only_at_the_declared_binding() {
+        let prelude = "OpDecorate %fetch InputAttachmentIndex 0
+                       OpDecorate %fetch DescriptorSet 0
+                       OpDecorate %fetch Binding 192
+                       |%image = OpTypeImage %float SubpassData 0 0 0 2 Unknown
+                       %image_ptr = OpTypePointer UniformConstant %image
+                       %fetch = OpVariable %image_ptr UniformConstant";
+        let bytes = fragment("vulkan1.2", prelude, "%fetch");
+        let out = blend_and_quantize_present_fragment_color_outputs(
+            &bytes,
+            &[plan(SOURCE_OVER, SOURCE_OVER, 192)],
+        )
+        .unwrap();
+        validate(&out);
+        assert_eq!(destination_variables(&load_bytes(&out).unwrap()).len(), 1);
+
+        let refused = blend_and_quantize_present_fragment_color_outputs(
+            &bytes,
+            &[plan(SOURCE_OVER, SOURCE_OVER, 195)],
+        );
+        assert!(matches!(
+            refused,
+            Err(ColorQuantizationRefusal::DestinationInput(0))
+        ));
+    }
+
+    #[test]
+    fn a_new_destination_cannot_take_an_occupied_binding() {
+        let prelude = "OpDecorate %other DescriptorSet 0
+                       OpDecorate %other Binding 192
+                       |%image = OpTypeImage %float 2D 0 0 0 1 Unknown
+                       %sampled = OpTypeSampledImage %image
+                       %sampled_ptr = OpTypePointer UniformConstant %sampled
+                       %other = OpVariable %sampled_ptr UniformConstant";
+        let bytes = fragment("vulkan1.2", prelude, "%other");
+        assert!(matches!(
+            blend_and_quantize_present_fragment_color_outputs(
+                &bytes,
+                &[plan(SOURCE_OVER, SOURCE_OVER, 192)],
+            ),
+            Err(ColorQuantizationRefusal::DestinationInput(0))
+        ));
