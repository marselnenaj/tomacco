+#[test]
+fn native_air_float_minmax_clamp_and_saturate_keep_metal_nan_rules() {
+    // Metal fmin/fmax are IEEE minNum/maxNum and clamp/saturate are built from them,
+    // so a NaN operand yields the other operand (clamp: the low edge). GLSL FMin,
+    // FMax and FClamp leave that undefined, and RADV and ANV return the NaN from
+    // FMin and FClamp in a fragment shader; the N-variants are the faithful ops.
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define void @main(float %x, float %y) {
+entry:
+  %mx = tail call float @air.fmax.f32(float %x, float %y)
+  %mn = tail call float @air.fmin.f32(float %mx, float %y)
+  %cl = tail call float @air.clamp.f32(float %mn, float 0.000000e+00, float 1.000000e+00)
+  %st = tail call float @air.saturate.f32(float %cl)
+  ret void
+}
+
+declare float @air.fmax.f32(float, float)
+declare float @air.fmin.f32(float, float)
+declare float @air.clamp.f32(float, float, float)
+declare float @air.saturate.f32(float)
+"#;
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_native_float_nan_rules_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let module = load_bytes(emit_vulkan_spirv(ll).expect("native emit")).expect("load native spv");
+    let out = passes::transform(module, Stage::Kernel, None, None, None, Some("main"))
+        .expect("interface transform")
+        .assemble()
+        .iter()
+        .flat_map(|w| w.to_le_bytes())
+        .collect::<Vec<_>>();
+    let asm = disassemble(&out).expect("disassemble transformed");
+    assert!(asm.contains(" NMax "), "{asm}");
+    assert!(asm.contains(" NMin "), "{asm}");
+    assert_eq!(asm.matches(" NClamp ").count(), 2, "{asm}");
+    for undefined_on_nan in [" FMax ", " FMin ", " FClamp "] {
+        assert!(!asm.contains(undefined_on_nan), "{asm}");
+    }
+    assert!(!asm.contains("OpFunctionCall"), "{asm}");
+    if std::process::Command::new("spirv-val")
+        .arg("--version")
+        .output()
+        .is_ok()
+    {
+        tools::spirv_val_bytes(&out, &tmp).expect("spirv-val");
+    }
+}
