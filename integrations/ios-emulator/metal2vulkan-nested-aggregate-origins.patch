diff --git a/src/native/tests/aggregate_resources.rs b/src/native/tests/aggregate_resources.rs
new file mode 100644
--- /dev/null
+++ b/src/native/tests/aggregate_resources.rs
@@ -0,0 +1,140 @@
+use super::*;
+use crate::reflect::{SAMPLER_BINDING_BASE as S, TEXTURE_BINDING_BASE as T};
+
+// Authored fixture: two independent descriptor pairs pass through nested value
+// wrappers and two helper boundaries. Integer aggregate storage cannot stand in
+// for either opaque resource; forwarding must preserve each exact origin.
+const NESTED_RESOURCES: &str = r#"
+target triple = "spirv-unknown-vulkan1.2"
+%ImageBox = type { ptr addrspace(1) }
+%SamplerBox = type { ptr addrspace(2) }
+%Bundle = type { %ImageBox, %SamplerBox, <2 x float> }
+
+define internal %Bundle @assemble(ptr addrspace(1) %image, ptr addrspace(2) %sampler, <2 x float> %uv) {
+entry:
+  %a = insertvalue %Bundle poison, ptr addrspace(1) %image, 0, 0
+  %b = insertvalue %Bundle %a, ptr addrspace(2) %sampler, 1, 0
+  %c = insertvalue %Bundle %b, <2 x float> %uv, 2
+  ret %Bundle %c
+}
+
+define internal <4 x float> @consume(%ImageBox %imageBox, %SamplerBox %samplerBox, <2 x float> %uv) {
+entry:
+  %image = extractvalue %ImageBox %imageBox, 0
+  %sampler = extractvalue %SamplerBox %samplerBox, 0
+  %sample = call { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1) %image, ptr addrspace(2) %sampler, <2 x float> %uv, i1 true, <2 x i32> zeroinitializer, i1 false, float 0.0, float 0.0, i32 0)
+  %color = extractvalue { <4 x float>, i8 } %sample, 0
+  ret <4 x float> %color
+}
+
+define void @nested_resources(ptr addrspace(1) %first, ptr addrspace(1) %second, ptr addrspace(2) %nearest, ptr addrspace(2) %linear, ptr addrspace(1) %output) {
+entry:
+  %left = call %Bundle @assemble(ptr addrspace(1) %first, ptr addrspace(2) %nearest, <2 x float> <float 0.25, float 0.5>)
+  %right = call %Bundle @assemble(ptr addrspace(1) %second, ptr addrspace(2) %linear, <2 x float> <float 0.75, float 0.5>)
+  %li = extractvalue %Bundle %left, 0
+  %ls = extractvalue %Bundle %left, 1
+  %lu = extractvalue %Bundle %left, 2
+  %ri = extractvalue %Bundle %right, 0
+  %rs = extractvalue %Bundle %right, 1
+  %ru = extractvalue %Bundle %right, 2
+  %lc = call <4 x float> @consume(%ImageBox %li, %SamplerBox %ls, <2 x float> %lu)
+  %rc = call <4 x float> @consume(%ImageBox %ri, %SamplerBox %rs, <2 x float> %ru)
+  %combined = fadd <4 x float> %lc, %rc
+  store <4 x float> %combined, ptr addrspace(1) %output, align 16
+  ret void
+}
+
+declare { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>, i1, <2 x i32>, i1, float, float, i32)
+!air.kernel = !{!0}
+!0 = !{ptr @nested_resources, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5, !6, !7}
+!3 = !{i32 0, !"air.texture", !"air.location_index", i32 0, i32 1, !"air.sample", !"air.arg_type_name", !"texture2d<float, sample>", !"air.arg_name", !"first"}
+!4 = !{i32 1, !"air.texture", !"air.location_index", i32 1, i32 1, !"air.sample", !"air.arg_type_name", !"texture2d<float, sample>", !"air.arg_name", !"second"}
+!5 = !{i32 2, !"air.sampler", !"air.location_index", i32 0, i32 1, !"air.arg_type_name", !"sampler", !"air.arg_name", !"nearest"}
+!6 = !{i32 3, !"air.sampler", !"air.location_index", i32 1, i32 1, !"air.arg_type_name", !"sampler", !"air.arg_name", !"linear"}
+!7 = !{i32 4, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"float4*", !"air.arg_name", !"output"}
+"#;
+
+fn assert_descriptor_pairs(source: &str, suffix: &str, expected: &[(u32, u32)]) {
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_nested_resources_{}_{suffix}",
+        std::process::id()
+    ));
+    std::fs::create_dir_all(&tmp).unwrap();
+    let result = crate::translate_sanitized_native_with_options(
+        source,
+        crate::passes::Stage::Kernel,
+        &tmp,
+        whole_workgroup_options(),
+    );
+    let _ = std::fs::remove_dir_all(&tmp);
+    let bytes = result.expect("nested resource provenance must translate and validate");
+    let module = load_bytes(&bytes).unwrap();
+    let definitions: HashMap<_, _> = module
+        .all_inst_iter()
+        .filter_map(|inst| Some((inst.result_id?, inst)))
+        .collect();
+    let bindings: HashMap<_, _> = module
+        .annotations
+        .iter()
+        .filter_map(|inst| match inst.operands.as_slice() {
+            [Operand::IdRef(id), Operand::Decoration(Decoration::Binding), Operand::LiteralBit32(binding)]
+                if inst.class.opcode == Op::Decorate => Some((*id, *binding)),
+            _ => None,
+        })
+        .collect();
+    let binding_of_load = |operand: &Operand| {
+        let Operand::IdRef(value) = operand else {
+            panic!("resource operand must be an id")
+        };
+        let load = definitions[value];
+        assert_eq!(
+            load.class.opcode,
+            Op::Load,
+            "resource must load its descriptor"
+        );
+        let Operand::IdRef(variable) = load.operands[0] else {
+            panic!("load must name its descriptor")
+        };
+        bindings[&variable]
+    };
+    let mut pairs: Vec<_> = module
+        .all_inst_iter()
+        .filter(|inst| inst.class.opcode == Op::SampledImage)
+        .map(|inst| {
+            (
+                binding_of_load(&inst.operands[0]),
+                binding_of_load(&inst.operands[1]),
+            )
+        })
+        .collect();
+    pairs.sort_unstable();
+    assert_eq!(
+        pairs, expected,
+        "helper instances must keep their distinct descriptor origins"
+    );
+}
+
+#[test]
+fn nested_resource_aggregates_keep_each_descriptor_pair_across_helpers() {
+    assert_descriptor_pairs(NESTED_RESOURCES, "pairs", &[(T, S), (T + 1, S + 1)]);
+}
+
+#[test]
+fn nested_resource_aggregate_replacement_does_not_restore_the_previous_field() {
+    let source = NESTED_RESOURCES.replace(
+        "  %li = extractvalue %Bundle %left, 0",
+        "  %changed = insertvalue %Bundle %left, ptr addrspace(1) %second, 0, 0\n  %li = extractvalue %Bundle %changed, 0",
+    );
+    assert_descriptor_pairs(&source, "replacement", &[(T + 1, S), (T + 1, S + 1)]);
+}
+
+#[test]
+fn nested_resource_aggregate_freeze_keeps_pointer_origins() {
+    let source = NESTED_RESOURCES.replace(
+        "  %li = extractvalue %Bundle %left, 0",
+        "  %extracted = extractvalue %Bundle %left, 0\n  %li = freeze %ImageBox %extracted",
+    );
+    assert_descriptor_pairs(&source, "freeze", &[(T, S), (T + 1, S + 1)]);
+}
