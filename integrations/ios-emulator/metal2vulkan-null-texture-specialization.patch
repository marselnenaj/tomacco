+/// The Metal texture index of the `[[texture(n)]]` argument `img` was loaded from, when `img`
+/// resolves to one load of that argument's own descriptor variable.
+fn texture_argument_index(ctx: &Ctx, img: Word) -> Option<u32> {
+    let value = resolve_image_value(ctx, img);
+    let load = super::value_inst(ctx, value)?;
+    if load.class.opcode != Op::Load {
+        return None;
+    }
+    let Some(Operand::IdRef(pointer)) = load.operands.first() else {
+        return None;
+    };
+    ctx.texture_argument_vars.get(pointer).copied()
+}
