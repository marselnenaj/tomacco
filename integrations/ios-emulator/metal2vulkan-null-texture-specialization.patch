+/// `air.is_null_texture(%t)` of a `[[texture(n)]]` argument is the consumer's question, not this
+/// module's: the argument is null exactly when the consumer bound nothing there. So it lowers to
+/// the argument's specialization constant -- `OpSpecConstantFalse` with `SpecId
+/// NULL_TEXTURE_SPEC_ID_BASE + n` -- and a consumer that leaves the argument unbound sets it true.
+/// Folded to a constant false, as it was, the shader took its sampling path on whatever the
+/// consumer substituted for the missing texture. Branching keeps the predicate live, as the shader
+/// this shape was observed in does: an optional darkening texture, sampled only when bound.
+#[test]
+fn native_is_null_texture_of_a_texture_argument_lowers_to_its_specialization_constant() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define void @k(ptr addrspace(1) %tex, ptr addrspace(2) %sampler, ptr addrspace(1) %out) {
+entry:
+  %isnull = call i1 @air.is_null_texture_2d(ptr addrspace(1) %tex)
+  br i1 %isnull, label %null, label %bound
+null:
+  store float 1.000000e+00, ptr addrspace(1) %out, align 4
+  br label %done
+bound:
+  %sample = tail call { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1) %tex, ptr addrspace(2) %sampler, <2 x float> zeroinitializer)
+  %color = extractvalue { <4 x float>, i8 } %sample, 0
+  %x = extractelement <4 x float> %color, i64 0
+  store float %x, ptr addrspace(1) %out, align 4
+  br label %done
+done:
+  ret void
+}
+
+declare i1 @air.is_null_texture_2d(ptr addrspace(1))
+declare { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>)
+
+!air.kernel = !{!0}
+!0 = !{ptr @k, !1, !2}
+!1 = !{}
+!2 = !{!3, !4, !5}
+!3 = !{i32 0, !"air.texture", !"air.location_index", i32 7, i32 1, !"air.sample", !"air.arg_type_name", !"texture2d<float, sample>", !"air.arg_name", !"tex"}
+!4 = !{i32 1, !"air.sampler", !"air.location_index", i32 1, i32 1, !"air.arg_type_name", !"sampler", !"air.arg_name", !"sampler"}
+!5 = !{i32 2, !"air.buffer", !"air.location_index", i32 2, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"float*", !"air.arg_name", !"out"}
+"#;
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_null_texture_argument_spec_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let spv = crate::translate_sanitized_native(ll, Stage::Kernel, &tmp)
+        .expect("a kernel guarding an optional texture must translate");
+    let asm = disassemble(&spv).expect("disassemble");
+    let spec_id = crate::reflect::NULL_TEXTURE_SPEC_ID_BASE + 7;
+    assert!(
+        asm.contains("OpSpecConstantFalse"),
+        "the predicate must be the argument's specialization constant, not a folded false:\n{asm}"
+    );
+    assert!(
+        asm.contains(&format!("SpecId {spec_id}")),
+        "the constant must carry the argument's own id {spec_id}:\n{asm}"
+    );
+    assert!(
+        asm.contains("OpBranchConditional"),
+        "the guard must survive as a branch the consumer decides:\n{asm}"
+    );
+    if std::process::Command::new("spirv-val")
+        .arg("--version")
+        .output()
+        .is_ok()
+    {
+        tools::spirv_val_bytes(&spv, &tmp).expect("spirv-val");
+    }
+    let _ = std::fs::remove_dir_all(tmp);
+}
