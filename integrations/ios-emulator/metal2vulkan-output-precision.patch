+    #[test]
+    fn a_binary16_output_precision_rounds_every_channel_before_its_encoder() {
+        let bytes = fragment("vulkan1.2", "", "");
+        let mut encoding = plan(SOURCE_OVER, SOURCE_OVER, 192).encoding;
+        encoding.precision = OutputPrecision::Binary16;
+        let out = quantize_present_fragment_color_outputs(&bytes, &[encoding]).unwrap();
+        validate(&out);
+        let ops = body_ops(&load_bytes(&out).unwrap());
+        assert_eq!(
+            ops.iter().filter(|&&op| op == Op::QuantizeToF16).count(),
+            4,
+            "one rounding per channel, none inside the encoders"
+        );
+        let last_rounding = ops.iter().rposition(|&op| op == Op::QuantizeToF16).unwrap();
+        let first_encoder = ops.iter().position(|&op| op == Op::IsNan).unwrap();
+        assert!(
+            last_rounding < first_encoder,
+            "rounding precedes every encoder"
+        );
+
+        // A blend in Float32 arithmetic under a binary16 partition rounds its
+        // combined value once; a binary16 blend adds nothing to its own steps.
+        let mut float = plan(SOURCE_OVER, SOURCE_OVER, 192);
+        float.encoding.precision = OutputPrecision::Binary16;
+        if let Some(blend) = &mut float.blend {
+            blend.arithmetic = BlendArithmetic::Float32;
+        }
+        let out = blend_and_quantize_present_fragment_color_outputs(&bytes, &[float]).unwrap();
+        validate(&out);
+        let ops = body_ops(&load_bytes(&out).unwrap());
+        assert_eq!(ops.iter().filter(|&&op| op == Op::QuantizeToF16).count(), 4);
+    }
