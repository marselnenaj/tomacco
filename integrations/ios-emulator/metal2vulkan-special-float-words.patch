+#[test]
+fn native_half_and_bfloat_special_words_emit_their_values() {
+    // LLVM 23's llvm-dis prints an infinity or NaN of every floating type with the words it uses
+    // for float (`half +inf`, `bfloat -inf`, `+qnan`), not as `0xH`/`0xR` patterns.
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+define void @main(i1 %pick, i1 %quiet, ptr addrspace(1) %out, ptr addrspace(1) %outbf) {
+entry:
+  %infinite = select i1 %pick, half +inf, half -inf
+  %value = select i1 %quiet, half +qnan, half %infinite
+  store half %value, ptr addrspace(1) %out, align 2
+  store bfloat -inf, ptr addrspace(1) %outbf, align 2
+  ret void
+}
+"#;
+    let module = load_bytes(emit_vulkan_spirv(ll).expect("native emit")).expect("load native spv");
+    let type_id = |opcode: Op| {
+        module
+            .types_global_values
+            .iter()
+            .find(|inst| {
+                inst.class.opcode == opcode
+                    && matches!(inst.operands.first(), Some(Operand::LiteralBit32(16)))
+            })
+            .and_then(|inst| inst.result_id)
+            .expect("16-bit type")
+    };
+    // The 32-bit literal word of every constant of one type.
+    let literals = |ty: Word| {
+        module
+            .types_global_values
+            .iter()
+            .filter(|inst| inst.class.opcode == Op::Constant && inst.result_type == Some(ty))
+            .filter_map(|inst| match inst.operands.as_slice() {
+                [Operand::LiteralBit32(word)] => Some(*word),
+                _ => None,
+            })
+            .collect::<HashSet<_>>()
+    };
+    let half = literals(type_id(Op::TypeFloat));
+    for bits in [0x7c00, 0xfc00, 0x7e00] {
+        assert!(half.contains(&bits), "missing half 0x{bits:04x}: {half:x?}");
+    }
+    let bfloat = literals(type_id(Op::TypeInt));
+    assert!(bfloat.contains(&0xff80), "missing bfloat -inf: {bfloat:x?}");
+}
