+/// Whether a float32 pattern is an infinity or a NaN (all exponent bits set).
+fn float32_bits_are_inf_or_nan(bits: u32) -> bool {
+    bits & 0x7f80_0000 == 0x7f80_0000
+}
+
+/// The bfloat16 pattern of a float32 infinity or NaN: bfloat16 is float32's upper half, except
+/// that a NaN whose payload lies only in the dropped bits keeps one payload bit so that it stays
+/// a NaN rather than becoming an infinity.
+fn inf_or_nan_float32_bits_as_bfloat16(bits: u32) -> u16 {
+    let upper = (bits >> 16) as u16;
+    let nan_lost_payload = bits & 0x007f_ffff != 0 && upper & 0x007f == 0;
+    upper | u16::from(nan_lost_payload)
+}
