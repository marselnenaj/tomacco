+        // `+inf`, `-inf`, `+qnan`, `-qnan`, `snan` as the parser stores them.
+        for bits in [
+            0x7f80_0000,
+            0xff80_0000,
+            0x7fc0_0000,
+            0xffc0_0000,
+            0x7f80_0001,
+        ] {
+            assert!(float32_bits_are_inf_or_nan(bits));
+        }
+        assert!(!float32_bits_are_inf_or_nan(0x3f80_0000));
+        assert!(!float32_bits_are_inf_or_nan(0x7f7f_ffff));
+        assert_eq!(f32_to_f16_bits(f32::from_bits(0x7f80_0000)), 0x7c00);
+        assert_eq!(f32_to_f16_bits(f32::from_bits(0xff80_0000)), 0xfc00);
+        assert_eq!(f32_to_f16_bits(f32::from_bits(0x7fc0_0000)), 0x7e00);
+        assert_eq!(f32_to_f16_bits(f32::from_bits(0x7f80_0001)), 0x7c01);
+        assert_eq!(inf_or_nan_float32_bits_as_bfloat16(0x7f80_0000), 0x7f80);
