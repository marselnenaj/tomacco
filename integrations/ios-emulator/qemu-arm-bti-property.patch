     DEFINE_PROP_BOOL("tomacco-strict-sysregs", ARMCPU, tomacco_strict_sysregs, false),
     DEFINE_PROP_BOOL("tomacco-ap-reset-fpen", ARMCPU, tomacco_ap_reset_fpen, false),
     DEFINE_PROP_BOOL("tomacco-pauth-fast", ARMCPU, tomacco_pauth_fast, true),
