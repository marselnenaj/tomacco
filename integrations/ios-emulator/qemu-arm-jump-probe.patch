+/*
+ * cflags of TBs whose exits keep the out-of-line lookup: one-off TBs with
+ * an instruction budget or special execution, single-stepping, chaining
+ * suppressed, breakpoints, icount, plugin memory-only re-instrumentation.
+ */
+#define TOMACCO_JMP_INLINE_EXCLUDED_CF \
+    (CF_COUNT_MASK | CF_NO_GOTO_TB | CF_NO_GOTO_PTR | CF_SINGLE_STEP | \
+     CF_MEMI_ONLY | CF_USE_ICOUNT | CF_NOIRQ | CF_BP_PAGE | CF_INVALID)
+
+/*
+ * tcg_gen_lookup_and_goto_ptr() for exits whose resulting CPU state is
+ * known at translation time (ARMCPU tomacco-jmp-probe, default 1).
+ *
+ * helper_lookup_tb_ptr spends ~10 ns per indirect branch even on a hit (a
+ * call, get_tb_cpu_state through a hook, curr_cflags, the breakpoint check,
+ * tb_lookup), while what decides a hit is a hash, two loads and three
+ * compares. Here those compares use the state this TB leaves behind: the
+ * hflags cannot change inside a TB (every write that changes them ends the
+ * TB with an exit); cflags are the TB's own, which is what curr_cflags()
+ * returns for every TB outside TOMACCO_JMP_INLINE_EXCLUDED_CF (a vCPU only
+ * starts single-stepping, and one-insn-per-tb only takes effect, from the
+ * main loop's lookup, as for chained jumps); BTYPE, the only A64 TB flag
+ * not cached in hflags besides PSTATE.SS (never set without SS_ACTIVE,
+ * whose exits do not come here), is @btype: what the TB's last
+ * instruction leaves, -1 when only known at run time. cpu_pc already
+ * holds the target.
+ *
+ *   1  @direct exits (a branch out of the page to @dest, known now) probe
+ *      the entry tb_jmp_cache_hash_func(@dest) inline; indirect ones call
+ *      helper_tomacco_lookup_tb_ptr with the expected state
+ *   2  indirect exits hash cpu_pc and probe inline too (fastest on a hit,
+ *      but ~160 bytes of host code per exit: slower with many TBs)
+ *   0  the generic helper everywhere, as upstream
+ *
+ * Entry, page bucket and fields are those of accel/tcg tb_lookup, so a hit
+ * here is a hit there. An invalidated TB keeps CF_INVALID in the compared
+ * cflags and misses; a CF_PCREL TB run at another virtual address than it
+ * was translated for compares another pc and misses. Every miss, and every
+ * TB this cannot serve, takes the generic helper as before.
+ */
+static void gen_tomacco_lookup_and_goto_ptr(DisasContext *s, int btype,
+                                           bool direct, vaddr dest)
+{
+    TranslationBlock *tb = s->base.tb;
+    uint32_t cflags = tb_cflags(tb);
+    uint64_t cs_base = tb->cs_base;
+    TCGLabel *slow;
+    TCGv_i64 h, t, u;
+    TCGv_ptr entry, target;
+
+    QEMU_BUILD_BUG_ON(sizeof(((CPUJumpCache *)0)->array[0]) != 16);
+    QEMU_BUILD_BUG_ON(offsetof(TranslationBlock, cflags) !=
+                      offsetof(TranslationBlock, flags) + 4);
+    QEMU_BUILD_BUG_ON(offsetof(TranslationBlock, flags) % 8);
+    QEMU_BUILD_BUG_ON(sizeof(vaddr) != 8);
+
+    if (!s->tomacco_jmp_probe || HOST_BIG_ENDIAN || btype < 0 ||
+        (cflags & TOMACCO_JMP_INLINE_EXCLUDED_CF) ||
+        qemu_loglevel_mask(CPU_LOG_TB_CPU | CPU_LOG_EXEC)) {
+        tcg_gen_lookup_and_goto_ptr();
+        return;
+    }
+    if (dc_isar_feature(aa64_bti, s)) {
+        cs_base = FIELD_DP64(cs_base, TBFLAG_A64, BTYPE, btype);
+    } else if (btype != 0) {
+        tcg_gen_lookup_and_goto_ptr();
+        return;
+    }
+
+    if (direct) {
+        /* A direct branch out of the page: the entry index is a constant. */
+        entry = tcg_temp_new_ptr();
+        target = tcg_temp_new_ptr();
+        t = tcg_temp_new_i64();
+        slow = gen_new_label();
+        tcg_gen_ld_ptr(entry, tcg_env,
+                       offsetof(CPUState, tb_jmp_cache) - sizeof(CPUState));
+        tcg_gen_addi_ptr(entry, entry, 16 * tb_jmp_cache_hash_func(dest));
+        /* entry->tb != NULL (a cleared entry keeps its pc) */
+        tcg_gen_ld_i64(t, entry, offsetof(CPUJumpCache, array[0].tb));
+        tcg_gen_brcondi_i64(TCG_COND_EQ, t, 0, slow);
+        tcg_gen_trunc_i64_ptr(target, t);
+        tcg_gen_ld_i64(t, entry, offsetof(CPUJumpCache, array[0].pc));
+        tcg_gen_brcond_i64(TCG_COND_NE, t, cpu_pc, slow);
+        tcg_gen_ld_i64(t, target, offsetof(TranslationBlock, cs_base));
+        tcg_gen_brcondi_i64(TCG_COND_NE, t, cs_base, slow);
+        tcg_gen_ld_i64(t, target, offsetof(TranslationBlock, flags));
+        tcg_gen_brcondi_i64(TCG_COND_NE, t,
+                            (uint64_t)tb->flags | ((uint64_t)cflags << 32), slow);
+        tcg_gen_ld_ptr(target, target, offsetof(TranslationBlock, tc.ptr));
+        tcg_gen_goto_ptr(target);
+        gen_set_label(slow);
+        tcg_gen_lookup_and_goto_ptr();
+        return;
+    }
+    if (s->tomacco_jmp_probe == 1) {
+        target = tcg_temp_new_ptr();
+        gen_helper_tomacco_lookup_tb_ptr(target, tcg_env,
+                                        tcg_constant_i64(cs_base),
+                                        tcg_constant_i64((uint64_t)tb->flags |
+                                                         (uint64_t)cflags << 32));
+        tcg_gen_goto_ptr(target);
+        return;
+    }
+
+    h = tcg_temp_new_i64();
+    t = tcg_temp_new_i64();
+    u = tcg_temp_new_i64();
+    entry = tcg_temp_new_ptr();
+    target = tcg_temp_new_ptr();
+    slow = gen_new_label();
+
+    /* tb_jmp_cache_hash_func(pc) * sizeof(entry) */
+    tcg_gen_shri_i64(h, cpu_pc, TARGET_PAGE_BITS);
+    tcg_gen_muli_i64(h, h, TB_JMP_PAGE_MULTIPLIER);
+    tcg_gen_shri_i64(h, h, 64 - (TB_JMP_CACHE_BITS - TB_JMP_PAGE_BITS));
+    tcg_gen_shli_i64(h, h, TB_JMP_PAGE_BITS);
+    tcg_gen_shri_i64(t, cpu_pc, 2);
+    tcg_gen_shri_i64(u, t, TB_JMP_PAGE_BITS);
+    tcg_gen_xor_i64(t, t, u);
+    tcg_gen_andi_i64(t, t, TB_JMP_ADDR_MASK);
+    tcg_gen_or_i64(h, h, t);
+    tcg_gen_shli_i64(h, h, 4);
+
+    tcg_gen_ld_ptr(entry, tcg_env,
+                   offsetof(CPUState, tb_jmp_cache) - sizeof(CPUState));
+    tcg_gen_trunc_i64_ptr(target, h);
+    tcg_gen_add_ptr(entry, entry, target);
+
+    /* entry->tb != NULL && entry->pc == pc */
+    tcg_gen_ld_i64(t, entry, offsetof(CPUJumpCache, array[0].tb));
+    tcg_gen_brcondi_i64(TCG_COND_EQ, t, 0, slow);
+    tcg_gen_trunc_i64_ptr(target, t);
+    tcg_gen_ld_i64(t, entry, offsetof(CPUJumpCache, array[0].pc));
+    tcg_gen_brcond_i64(TCG_COND_NE, t, cpu_pc, slow);
+    /* tb->cs_base, tb->flags and tb_cflags(tb) of the state we leave */
+    tcg_gen_ld_i64(t, target, offsetof(TranslationBlock, cs_base));
+    tcg_gen_brcondi_i64(TCG_COND_NE, t, cs_base, slow);
+    tcg_gen_ld_i64(t, target, offsetof(TranslationBlock, flags));
+    tcg_gen_brcondi_i64(TCG_COND_NE, t,
+                        (uint64_t)tb->flags | ((uint64_t)cflags << 32), slow);
+    tcg_gen_ld_ptr(target, target, offsetof(TranslationBlock, tc.ptr));
+    tcg_gen_goto_ptr(target);
+
+    gen_set_label(slow);
+    tcg_gen_lookup_and_goto_ptr();
+}
