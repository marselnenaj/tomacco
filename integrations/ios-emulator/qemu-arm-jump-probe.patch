+/*
+ * helper_lookup_tb_ptr for a TB exit whose resulting CPU state the
+ * translator knows (target/arm/tcg/translate-a64.c
+ * gen_tomacco_lookup_and_goto_ptr): @cs_base and @flags_cflags
+ * (tb->flags | cflags << 32) are what helper_lookup_tb_ptr would compute
+ * with get_tb_cpu_state and curr_cflags. A jump-cache hit returns the TB
+ * without either; anything else takes the generic helper.
+ */
+const void *HELPER(tomacco_lookup_tb_ptr)(CPUARMState *env, uint64_t cs_base,
+                                         uint64_t flags_cflags)
+{
+    CPUState *cs = env_cpu(env);
+    CPUJumpCache *jc = cs->tb_jmp_cache;
+    vaddr pc = env->pc;
+    uint32_t h = tb_jmp_cache_hash_func(pc);
+    TranslationBlock *tb = qatomic_read(&jc->array[h].tb);
+
+    if (likely(tb && jc->array[h].pc == pc && tb->cs_base == cs_base &&
+               tb->flags == (uint32_t)flags_cflags &&
+               tb_cflags(tb) == (uint32_t)(flags_cflags >> 32))) {
+        return tb->tc.ptr;
+    }
+    return helper_lookup_tb_ptr(env);
+}
