diff --git a/target/arm/tcg/hflags.c b/target/arm/tcg/hflags.c
--- a/target/arm/tcg/hflags.c
+++ b/target/arm/tcg/hflags.c
@@ -275,6 +275,39 @@
     return 0;
 }
 
+/*
+ * Record what helper_aut* and helper_xpac* would remove from a pointer in this
+ * regime: pauth_original_ptr() with the aa64_va_parameters() of the same
+ * stage 1 regime, per half (bit 55), for instruction and data keys; AUT*
+ * with a key that arm_sctlr() leaves disabled returns its operand, so its
+ * row is 0. Every change of the inputs (TCR, SCTLR, EL, HCR) rebuilds the
+ * hflags, which is what keeps this and the TB flags current together.
+ */
+static void tomacco_pauth_record(CPUARMState *env, int el, ARMMMUIdx stage1)
+{
+    uint64_t sctlr = arm_sctlr(env, el);
+
+    QEMU_BUILD_BUG_ON(ARRAY_SIZE(env->tomacco_pauth_strip) != TOMACCO_PAUTH_ROWS);
+    for (int select = 0; select < 2; select++) {
+        uint64_t va = (uint64_t)select << 55;
+        uint64_t insn = pauth_ptr_mask(aa64_va_parameters(env, va, stage1,
+                                                          false, false));
+        uint64_t data = pauth_ptr_mask(aa64_va_parameters(env, va, stage1,
+                                                          true, false));
+
+        env->tomacco_pauth_strip[TOMACCO_PAUTH_IA][select] =
+            sctlr & SCTLR_EnIA ? insn : 0;
+        env->tomacco_pauth_strip[TOMACCO_PAUTH_IB][select] =
+            sctlr & SCTLR_EnIB ? insn : 0;
+        env->tomacco_pauth_strip[TOMACCO_PAUTH_DA][select] =
+            sctlr & SCTLR_EnDA ? data : 0;
+        env->tomacco_pauth_strip[TOMACCO_PAUTH_DB][select] =
+            sctlr & SCTLR_EnDB ? data : 0;
+        env->tomacco_pauth_strip[TOMACCO_PAUTH_XPACI][select] = insn;
+        env->tomacco_pauth_strip[TOMACCO_PAUTH_XPACD][select] = data;
+    }
+}
+
 static CPUARMTBFlags rebuild_hflags_a64(CPUARMState *env, int el, int fp_el,
                                         ARMMMUIdx mmu_idx)
 {
@@ -367,6 +400,10 @@
          */
         if (sctlr & (SCTLR_EnIA | SCTLR_EnIB | SCTLR_EnDA | SCTLR_EnDB)) {
             DP_TBFLAG_A64(flags, PAUTH_ACTIVE, 1);
+            /* Translated code reads the masks only while PAUTH_ACTIVE. */
+            if (tomacco_pauth_fast(env)) {
+                tomacco_pauth_record(env, el, stage1);
+            }
         }
     }
 
