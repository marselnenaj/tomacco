+/*
+ * The pointer-authentication bypass without a helper call (internals.h
+ * tomacco_pauth_fast): dst = pauth_original_ptr(src) with the mask of
+ * tomacco_pauth_strip[row][src<55>], i.e. src | mask when bit 55 is set and
+ * src & ~mask when it is clear. A zero mask (AUT* with a disabled key)
+ * leaves src as it is, as the helpers do.
+ */
+static void gen_tomacco_pauth_strip(TCGv_i64 dst, TCGv_i64 src, int row)
+{
+    TCGv_i64 half = tcg_temp_new_i64();
+    TCGv_i64 mask = tcg_temp_new_i64();
+    TCGv_ptr entry = tcg_temp_new_ptr();
+
+    tcg_gen_shri_i64(half, src, 55 - 3);
+    tcg_gen_andi_i64(half, half, sizeof(uint64_t));
+    tcg_gen_trunc_i64_ptr(entry, half);
+    tcg_gen_add_ptr(entry, entry, tcg_env);
+    tcg_gen_ld_i64(mask, entry, offsetof(CPUARMState, tomacco_pauth_strip) +
+                   row * sizeof(((CPUARMState *)0)->tomacco_pauth_strip[0]));
+    tcg_gen_sextract_i64(half, src, 55, 1);
+    tcg_gen_and_i64(half, half, mask);
+    tcg_gen_andc_i64(dst, src, mask);
+    tcg_gen_or_i64(dst, dst, half);
+}
