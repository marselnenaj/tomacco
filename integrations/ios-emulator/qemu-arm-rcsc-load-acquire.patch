+/*
+ * A Load-Acquire (LDAR, LDAXR, LDAXP) may not be observed before an earlier
+ * Store-Release (RCsc). Store-Release orders only what precedes it and
+ * Load-Acquire only what follows, so on a host that lets a load pass an
+ * earlier store (x86) nothing else keeps that pair in order. AArch64
+ * compilers emit seq_cst loads and stores as exactly this pair, without a
+ * DMB. Load-AcquirePC (LDAPR) is RCpc and needs no such barrier.
+ */
+static void gen_load_acquire_rcsc_barrier(void)
+{
+    tcg_gen_mb(TCG_MO_ST_LD | TCG_BAR_SC);
+}
