+                                  "tomacco-granule-16k=on\n", TARGET_PAGE_BITS);
+            }
             return;
         }
     }
 #endif
 
+    if (cpu->tomacco_granule16k && arm_feature(env, ARM_FEATURE_AARCH64)) {
+        /*
+         * Apple's XNU, SPTM, TXM and SEP firmware program TG0 = TG1 = 16 KiB
