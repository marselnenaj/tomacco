+        FIELD_DP64_IDREG(isar, ID_AA64MMFR0, TGRAN64, 0xf);
+        if (!FIELD_EX64_IDREG(isar, ID_AA64MMFR0, TGRAN16)) {
+            FIELD_DP64_IDREG(isar, ID_AA64MMFR0, TGRAN16, 1);
+        }
+        FIELD_DP64_IDREG(isar, ID_AA64MMFR0, TGRAN4_2, 1);
+        FIELD_DP64_IDREG(isar, ID_AA64MMFR0, TGRAN64_2, 1);
+        if (FIELD_EX64_IDREG(isar, ID_AA64MMFR0, TGRAN16_2) == 1) {
+            FIELD_DP64_IDREG(isar, ID_AA64MMFR0, TGRAN16_2, 2);
+        }
+    }
