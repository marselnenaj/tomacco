+/*
+ * -M <machine>,tomacco-page-bits=N (qemu-arm-target-page-16k): the target page
+ * size, decided here because machine_memory_init() below commits it before any
+ * machine property is applied. Without it the board's minimum_page_bits (or
+ * the target's legacy default: 1 KiB on Arm for a board that states none, as
+ * tomacco-vphone) stays in charge.
+ */
+bool tomacco_target_page_bits_requested;
+
+static void tomacco_request_target_page_bits(QDict *qdict)
+{
+    const char *text = qdict_get_try_str(qdict, "tomacco-page-bits");
+    uint64_t bits;
+
+    if (!qdict_haskey(qdict, "tomacco-page-bits")) {
+        return;
+    }
+    if (!text || qemu_strtou64(text, NULL, 10, &bits) ||
+        (bits != 10 && bits != 12 && bits != 14)) {
+        error_report("tomacco-page-bits must be 10 (1 KiB), 12 (4 KiB) or 14 (16 KiB) target pages");
+        exit(EXIT_FAILURE);
+    }
+    /* The first preference: the size can only shrink from here. A CPU
+     * whose granules are smaller refuses to realize (target/arm/cpu.c). */
+    if (!set_preferred_target_page_bits(bits)) {
+        g_assert_not_reached();
+    }
+    tomacco_target_page_bits_requested = true;
+}
+
