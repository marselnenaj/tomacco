diff --git a/accel/tcg/tb-jmp-cache.h b/accel/tcg/tb-jmp-cache.h
--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -24,6 +24,8 @@
 #define TB_JMP_CACHE_BITS 16
 #endif
 #define TB_JMP_CACHE_SIZE (1 << TB_JMP_CACHE_BITS)
+/* Page partitions at most: tb-hash.h never makes one smaller than 2^(BITS-7). */
+#define TB_JMP_CACHE_PARTITIONS_MAX (1 << 7)
 /* Fills remembered for a cheap full flush; more fills mean a memset. */
 #define TB_JMP_CACHE_LOG 4096
 
@@ -47,6 +49,30 @@ typedef struct CPUJumpCache {
     uint64_t stat_miss;
     uint64_t stat_absent;
     uint64_t stat_flush;
+    /*
+     * Owner-written: bit h set when entry h was filled from code whose
+     * pages are asid_global, so an ASID change may keep it. Meaningful
+     * only while array[h].tb is set; every fill writes it.
+     */
+    uint64_t asid_global[TB_JMP_CACHE_SIZE / 64];
+    /*
+     * Owner-written: bit h set whenever array[h].tb may be set (a fill sets
+     * it, a clear may leave it), so a page clear visits only these entries.
+     */
+    uint64_t occupied[TB_JMP_CACHE_SIZE / 64];
+    /*
+     * Owner-written, per page partition: fills of TBs that run into the next
+     * page since the partition was last emptied; zero means a page clear of
+     * the next page has nothing to look for here.
+     */
+    uint32_t crossing[TB_JMP_CACHE_PARTITIONS_MAX];
+    /*
+     * Owner-written: entries filled from non-global code since the last ASID
+     * change, for a cheap one; past TB_JMP_CACHE_LOG the occupied bitmap is
+     * walked instead.
+     */
+    uint32_t local_n;
+    uint32_t local[TB_JMP_CACHE_LOG];
     struct {
         TranslationBlock *tb;
         vaddr pc;
@@ -66,4 +92,18 @@ static inline void tb_jmp_cache_note_fill(CPUJumpCache *jc, uint32_t h)
     }
 }
 
+static inline void tb_jmp_cache_set_asid_global(CPUJumpCache *jc, uint32_t h,
+                                                bool global)
+{
+    uint64_t bit = 1ull << (h % 64);
+
+    jc->asid_global[h / 64] = global ? jc->asid_global[h / 64] | bit
+                                     : jc->asid_global[h / 64] & ~bit;
+}
+
+static inline bool tb_jmp_cache_asid_global(const CPUJumpCache *jc, uint32_t h)
+{
+    return jc->asid_global[h / 64] & (1ull << (h % 64));
+}
+
 #endif /* ACCEL_TCG_TB_JMP_CACHE_H */
diff --git a/accel/tcg/translate-all.c b/accel/tcg/translate-all.c
--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -623,6 +623,26 @@ void cpu_io_recompile(CPUState *cpu, uintptr_t retaddr)
  * Called by generic code at e.g. cpu reset after cpu creation,
  * therefore we must be prepared to allocate the jump cache.
  */
+/* Clear every entry the occupied bitmap names. Owner only. */
+static void tcg_flush_jmp_cache_occupied(CPUJumpCache *jc, bool keep_global)
+{
+    for (uint32_t w = 0; w < TB_JMP_CACHE_SIZE / 64; w++) {
+        uint64_t bits = jc->occupied[w];
+
+        while (bits) {
+            uint32_t h = w * 64 + ctz64(bits);
+
+            bits &= bits - 1;
+            if (keep_global && qatomic_read(&jc->array[h].tb) &&
+                tb_jmp_cache_asid_global(jc, h)) {
+                continue;
+            }
+            qatomic_set(&jc->array[h].tb, NULL);
+            jc->occupied[w] &= ~(1ull << (h % 64));
+        }
+    }
+}
+
 void tcg_flush_jmp_cache(CPUState *cpu)
 {
     CPUJumpCache *jc = cpu->tb_jmp_cache;
@@ -634,23 +654,61 @@ void tcg_flush_jmp_cache(CPUState *cpu)
     }
 
