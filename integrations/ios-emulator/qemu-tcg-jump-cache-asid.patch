+/*
+ * In the partition that starts at entry @i0, clear the entries of TBs that
+ * start on @start_page and, if @end_page is not -1, end on it; visit only
+ * occupied entries. Returns whether the partition still holds any.
+ */
+static bool tb_jmp_cache_clear_partition(CPUJumpCache *jc, uint32_t i0,
+                                         vaddr start_page, vaddr end_page)
+{
+    bool left = false;
+
+    for (uint32_t w = i0 / 64; w < (i0 + TB_JMP_PAGE_SIZE) / 64; w++) {
+        uint64_t bits = jc->occupied[w];
+
+        while (bits) {
+            uint32_t h = w * 64 + ctz64(bits);
+            TranslationBlock *tb = qatomic_read(&jc->array[h].tb);
+            vaddr pc = jc->array[h].pc;
+
+            bits &= bits - 1;
+            if (tb && (pc & TARGET_PAGE_MASK) == start_page &&
+                (end_page == -1 ||
+                 ((pc + tb->size - 1) & TARGET_PAGE_MASK) == end_page)) {
+                qatomic_set(&jc->array[h].tb, NULL);
+                tb = NULL;
+            }
+            if (tb) {
+                left = true;
+            } else {
+                jc->occupied[w] &= ~(1ull << (h % 64));
+            }
+        }
+    }
+    return left;
+}
+
+/*
