+bool tlb_code_asid_global(CPUState *cpu, vaddr pc)
+{
+    int mmu_idx = cpu_mmu_index(cpu, true);
+    uintptr_t index = tlb_index(cpu, mmu_idx, pc);
+    CPUTLBEntry *entry = tlb_entry(cpu, mmu_idx, pc);
+
+    /* Not in the main table (evicted, or in the victim TLB): say no. */
+    return tlb_hit(entry->addr_code, pc) &&
