-     * trust and reset the log (TLB flushes run on the owner). Any other
-     * caller (reset, tb_flush in an exclusive section) clears everything
-     * and leaves the log alone: extra entries in it are merely cleared twice.
+     * Only the owning vCPU fills entries, the fill logs and the occupied
+     * bitmap, so only it may trust them (TLB flushes run on the owner): the
+     * log while it did not overflow, the bitmap otherwise. Any other caller
+     * (reset, tb_flush in an exclusive section) clears everything.
      */
     n = jc->filled_n;
     if (qemu_cpu_is_self(cpu) && n <= TB_JMP_CACHE_LOG) {
         for (uint32_t i = 0; i < n; i++) {
             qatomic_set(&jc->array[jc->filled[i]].tb, NULL);
         }
+        memset(jc->occupied, 0, sizeof(jc->occupied));
+    } else if (qemu_cpu_is_self(cpu)) {
+        tcg_flush_jmp_cache_occupied(jc, false);
     } else {
+        /* Logs, bitmap and counts stay: extra names in them cost a visit. */
         for (int i = 0; i < TB_JMP_CACHE_SIZE; i++) {
             qatomic_set(&jc->array[i].tb, NULL);
         }
     }
     if (qemu_cpu_is_self(cpu)) {
         jc->filled_n = 0;
+        jc->local_n = 0;
+        memset(jc->crossing, 0, sizeof(jc->crossing));
     }
     jc->stat_flush++;
 }
+
+void tcg_flush_jmp_cache_asid_change(CPUState *cpu)
+{
+    CPUJumpCache *jc = cpu->tb_jmp_cache;
+    uint32_t n;
+
+    if (unlikely(jc == NULL)) {
+        return;
+    }
+    assert(qemu_cpu_is_self(cpu));
+
+    /*
+     * Only entries filled from non-global code go; they are in the local log
+     * unless it overflowed. An entry refilled from global code since stays.
+     * The fill log keeps naming the cleared ones, which only costs a store
+     * at the next full flush.
+     */
+    n = jc->local_n;
+    if (n <= TB_JMP_CACHE_LOG) {
+        for (uint32_t i = 0; i < n; i++) {
+            uint32_t h = jc->local[i];
+
+            if (!tb_jmp_cache_asid_global(jc, h)) {
+                qatomic_set(&jc->array[h].tb, NULL);
+            }
+        }
+    } else {
+        tcg_flush_jmp_cache_occupied(jc, true);
+    }
+    jc->local_n = 0;
+    jc->stat_flush++;
+}
