+void tlb_flush_asid_change(CPUState *cpu)
+{
+    int64_t now = get_clock_realtime();
+    uint16_t work;
+
+    assert_cpu_is_self(cpu);
+
+    /*
+     * The TLB itself is cleared as by tlb_flush: a memset of each table is
+     * cheaper than sorting out its global entries (measured on the vphone,
+     * the sorting walk cost more than the page-table walks it saved). What
+     * survives is the jump cache's global part.
+     */
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    for (work = cpu->neg.tlb.c.dirty; work != 0; work &= work - 1) {
+        tlb_flush_one_mmuidx_locked(cpu, ctz32(work), now);
+    }
+    cpu->neg.tlb.c.dirty = 0;
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+
+    tcg_flush_jmp_cache_asid_change(cpu);
+    qatomic_set(&cpu->neg.tlb.c.full_flush_count,
+                cpu->neg.tlb.c.full_flush_count + 1);
+}
