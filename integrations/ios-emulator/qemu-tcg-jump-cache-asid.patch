-    for (i = 0; i < TB_JMP_PAGE_SIZE; i++) {
-        qatomic_set(&jc->array[i0 + i].tb, NULL);
+    if (!tb_jmp_cache_clear_partition(jc, i0, page_addr, -1)) {
+        jc->crossing[i0 >> TB_JMP_PAGE_BITS] = 0;
+    }
+    i0 = tb_jmp_cache_hash_page(before);
+    if (jc->crossing[i0 >> TB_JMP_PAGE_BITS] &&
+        !tb_jmp_cache_clear_partition(jc, i0, before, page_addr)) {
+        jc->crossing[i0 >> TB_JMP_PAGE_BITS] = 0;
