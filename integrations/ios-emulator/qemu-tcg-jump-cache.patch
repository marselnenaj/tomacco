diff --git a/accel/tcg/tb-hash.h b/accel/tcg/tb-hash.h
--- a/accel/tcg/tb-hash.h
+++ b/accel/tcg/tb-hash.h
@@ -31,24 +31,38 @@
 /* Only the bottom TB_JMP_PAGE_BITS of the jump cache hash bits vary for
    addresses on the same page.  The top bits are the same.  This allows
    TLB invalidation to quickly clear a subset of the hash table.  */
-#define TB_JMP_PAGE_BITS (TB_JMP_CACHE_BITS / 2)
+/*
+ * 512 entries per 4 KiB page (one per two instructions): hot guest pages
+ * hold ~200 block starts. 128 page buckets in a 2^16-entry cache.
+ */
+#define TB_JMP_PAGE_BITS (TB_JMP_CACHE_BITS - 7)
 #define TB_JMP_PAGE_SIZE (1 << TB_JMP_PAGE_BITS)
 #define TB_JMP_ADDR_MASK (TB_JMP_PAGE_SIZE - 1)
 #define TB_JMP_PAGE_MASK (TB_JMP_CACHE_SIZE - TB_JMP_PAGE_SIZE)
+/* Fibonacci hashing of the page number spreads pages over the buckets. */
+#define TB_JMP_PAGE_MULTIPLIER 0x9e3779b97f4a7c15ull
 
+/*
+ * The page part is a function of the page number alone, the in-page part
+ * of the instruction index (pc >> 2: A64 and A32 code is word aligned; two
+ * Thumb halfwords merely share an entry) folded with the bits above it.
+ * Translated code that probes the cache inline must compute the same
+ * function (target/arm/tcg/translate-a64.c gen_tomacco_jmp_cache_probe).
+ */
 static inline unsigned int tb_jmp_cache_hash_page(vaddr pc)
 {
-    vaddr tmp;
-    tmp = pc ^ (pc >> (TARGET_PAGE_BITS - TB_JMP_PAGE_BITS));
-    return (tmp >> (TARGET_PAGE_BITS - TB_JMP_PAGE_BITS)) & TB_JMP_PAGE_MASK;
+    uint64_t page = (uint64_t)(pc >> TARGET_PAGE_BITS);
+
+    return ((page * TB_JMP_PAGE_MULTIPLIER) >>
+            (64 - (TB_JMP_CACHE_BITS - TB_JMP_PAGE_BITS))) << TB_JMP_PAGE_BITS;
 }
 
 static inline unsigned int tb_jmp_cache_hash_func(vaddr pc)
 {
-    vaddr tmp;
-    tmp = pc ^ (pc >> (TARGET_PAGE_BITS - TB_JMP_PAGE_BITS));
-    return (((tmp >> (TARGET_PAGE_BITS - TB_JMP_PAGE_BITS)) & TB_JMP_PAGE_MASK)
-           | (tmp & TB_JMP_ADDR_MASK));
+    vaddr insn = pc >> 2;
+
+    return tb_jmp_cache_hash_page(pc) |
+           ((insn ^ (insn >> TB_JMP_PAGE_BITS)) & TB_JMP_ADDR_MASK);
 }
 
 #else
diff --git a/accel/tcg/tb-jmp-cache.h b/accel/tcg/tb-jmp-cache.h
--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -12,8 +12,20 @@
 #include "qemu/rcu.h"
 #include "exec/cpu-common.h"
 
-#define TB_JMP_CACHE_BITS 12
+/*
+ * 2^16 entries (1 MiB per vCPU). The guest of a phone executes hundreds of
+ * thousands of distinct blocks with ~200 block starts per 4 KiB page; 4096
+ * entries partitioned 64 per page missed often, and every miss costs a
+ * get_page_addr_code plus a QHT probe (~100 ns against ~10 ns for a hit).
+ * A full flush clears only the entries filled since the previous one (the
+ * fill log), so the size does not make TLB flushes dearer.
+ */
+#ifndef TB_JMP_CACHE_BITS
+#define TB_JMP_CACHE_BITS 16
+#endif
 #define TB_JMP_CACHE_SIZE (1 << TB_JMP_CACHE_BITS)
+/* Fills remembered for a cheap full flush; more fills mean a memset. */
+#define TB_JMP_CACHE_LOG 4096
 
 /*
  * Invalidated in parallel; all accesses to 'tb' must be atomic.
@@ -24,10 +36,34 @@
  */
 typedef struct CPUJumpCache {
     struct rcu_head rcu;
+    /*
+     * Written only by the owning vCPU (or with it stopped): indices filled
+     * since the last full flush; filled_n > TB_JMP_CACHE_LOG means the log
+     * overflowed and the next full flush clears the whole array.
+     */
+    uint32_t filled_n;
+    uint32_t filled[TB_JMP_CACHE_LOG];
+    /* Statistics of the out-of-line misses (owner-written, read racily). */
+    uint64_t stat_miss;
+    uint64_t stat_absent;
+    uint64_t stat_flush;
     struct {
         TranslationBlock *tb;
         vaddr pc;
     } array[TB_JMP_CACHE_SIZE];
 } CPUJumpCache;
 
+/* Remember that entry @h of @jc is about to be filled. Owner only. */
+static inline void tb_jmp_cache_note_fill(CPUJumpCache *jc, uint32_t h)
+{
+    uint32_t n = jc->filled_n;
+
+    if (n < TB_JMP_CACHE_LOG) {
+        jc->filled[n] = h;
+    }
+    if (n <= TB_JMP_CACHE_LOG) {
+        jc->filled_n = n + 1;
+    }
+}
+
 #endif /* ACCEL_TCG_TB_JMP_CACHE_H */
