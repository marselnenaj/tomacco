+/*
+ * Jump-cache statistics summed over the vCPUs: misses found in the QHT,
+ * misses with no TB (a translation follows) and full flushes. Hits are
+ * not counted (most happen in translated code).
+ */
+static void tcg_get_jmp_cache_stat(Object *obj, Visitor *v,
+                                   const char *name, void *opaque,
+                                   Error **errp)
+{
+    size_t offset = (uintptr_t)opaque;
+    uint64_t value = 0;
+    CPUState *cpu;
+
+    CPU_FOREACH(cpu) {
+        if (cpu->tb_jmp_cache) {
+            value += qatomic_read((uint64_t *)((char *)cpu->tb_jmp_cache + offset));
+        }
+    }
+    visit_type_uint64(v, name, &value, errp);
+}
+
