+/* Larger x86_64 caches retain an indirect tail for distant TB chains. */
+#if TCG_TARGET_REG_BITS == 64
+#define MAX_CODE_GEN_BUFFER_SIZE  (4 * GiB)
+#define TCG_TARGET_HAS_WIDE_TB_CHAINING 1
+#else
 #define MAX_CODE_GEN_BUFFER_SIZE  (2 * GiB)
