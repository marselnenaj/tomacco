@@ -895,6 +895,16 @@
  * regions.
  * See also: tcg_code_size()
  */
+/*
+ * Unlike usable code capacity, this includes the holes between regions and
+ * the final guard page removed from total_size at initialization. Branch
+ * reach is an address-span property, not a count of usable code bytes.
+ */
+size_t tcg_code_buffer_size(void)
+{
+    return region.start_aligned ? region.total_size + qemu_real_host_page_size() : 0;
+}
