diff --git a/tcg/x86_64/tcg-target.c.inc b/tcg/x86_64/tcg-target.c.inc
--- a/tcg/x86_64/tcg-target.c.inc
+++ b/tcg/x86_64/tcg-target.c.inc
@@ -2360,6 +2360,22 @@
     tcg_out8(s, OPC_JMP_long); /* jmp im */
     set_jmp_insn_offset(s, which);
     tcg_out32(s, 0);
+    if (TCG_TARGET_HAS_WIDE_TB_CHAINING &&
+        tcg_code_buffer_size() > 2 * GiB) {
+        /*
+         * Keep the direct E9 instruction and its aligned displacement. A
+         * distant target patches that displacement to zero, reaching this
+         * immutable RIP-relative indirect tail. Only data, never an opcode,
+         * changes while another vCPU executes the block.
+         */
+        uintptr_t slot = get_jmp_target_addr(s, which);
+        intptr_t disp = tcg_pcrel_diff(s, (const void *)slot) - 6;
+        g_assert(disp == (int32_t)disp);
+        tcg_out_opc(s, OPC_GRP5, 0, 0, 0);
+        tcg_out8(s, (EXT5_JMPN_Ev << 3) | 5);
+        tcg_out32(s, disp);
+    }
+    /* Reset skips the tail and reaches the original unchained exit. */
     set_jmp_reset_offset(s, which);
 }
 
@@ -2369,12 +2385,32 @@
     tcg_out_modrm(s, OPC_GRP5, EXT5_JMPN_Ev, a0);
 }
 
+#if TCG_TARGET_HAS_WIDE_TB_CHAINING
+static uint64_t wide_chain_patch_count;
+
+uint64_t tcg_wide_chain_patch_count(void)
+{
+    return qatomic_read(&wide_chain_patch_count);
+}
+#endif
+
 void tb_target_set_jmp_target(const TranslationBlock *tb, int n,
                               uintptr_t jmp_rx, uintptr_t jmp_rw)
 {
     /* patch the branch destination */
     uintptr_t addr = tb->jmp_target_addr[n];
-    qatomic_set((int32_t *)jmp_rw, addr - (jmp_rx + 4));
+    intptr_t disp = addr - (jmp_rx + 4);
+    if (disp != (int32_t)disp) {
+        /* Only a wide cache emits the six-byte indirect tail. */
+        g_assert(TCG_TARGET_HAS_WIDE_TB_CHAINING &&
+                 tcg_code_buffer_size() > 2 * GiB);
+        disp = 0;
+#if TCG_TARGET_HAS_WIDE_TB_CHAINING
+        /* Counts far-chain selections, not executed guest branches. */
+        qatomic_inc(&wide_chain_patch_count);
+#endif
+    }
+    qatomic_set((int32_t *)jmp_rw, disp);
     /* no need to flush icache explicitly */
 }
 
