+//! APV XR attachment storage: retained resource, ordered pages, and both planes.
+//! No IOSurface mapping is invented for a type-12 texture. A Store prepares
+//! every host view before moving either plane and publishes after all unmaps.
+
+use crate::model::{DeviceState, TaskResource};
+use crate::runtime::decode::resource::{PlanarXrLayoutRefusal, PlanarXrLevel};
+use crate::runtime::guest_ram::{GuestPageFootprint, GuestRun};
+use crate::runtime::host::{HostMemory, HostOps};
+use crate::runtime::mapper::{RectStride, RunCopy};
+use std::sync::Arc;
+
+#[derive(Debug)]
+pub(crate) enum Refusal {
+    Resource,
+    Layout(PlanarXrLayoutRefusal),
+    View,
+    Shape,
+    Pages,
+    StorageChanged,
+    Allocation,
+    Map,
+    HostBound,
+    Encode(reims_vgpu_vulkan::pixel::RenderStoreRefusal),
+    LoadEncoding(reims_vgpu_vulkan::pixel::SampledUploadRefusal),
+    Read(crate::backend::vulkan::engine::DrawError),
+    SourceLayout,
+}
+
+impl crate::observe::Decline for Refusal {
+    fn slug(&self) -> &'static str {
+        match self {
+            Self::Resource => "apv_xr_rt_resource",
+            Self::Layout(why) => why.slug(),
+            Self::View => "apv_xr_rt_view",
+            Self::Shape => "apv_xr_rt_shape",
+            Self::Pages => "apv_xr_rt_pages",
+            Self::StorageChanged => "apv_xr_rt_storage_changed",
+            Self::Allocation => "apv_xr_rt_allocation",
+            Self::Map => "apv_xr_rt_map",
+            Self::HostBound => "apv_xr_rt_host_bound",
+            Self::Encode(why) => why.slug(),
+            Self::LoadEncoding(why) => why.slug(),
+            Self::Read(why) => why.slug(),
+            Self::SourceLayout => "apv_xr_rt_source_layout",
+        }
+    }
+}
+
+/// A declaration and complete physical destination captured before GPU submit.
+/// The resource Arc retains the original construction lifetime across the wait.
+pub struct PairedXrTarget {
+    pub(crate) level: PlanarXrLevel,
+    resource: Arc<TaskResource>,
+    base_ref: u32,
+    task_id: u32,
+    page_start: u64,
+    span: u64,
+    footprint: GuestPageFootprint,
+    generation: u64,
+}
+
+impl std::fmt::Debug for PairedXrTarget {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("PairedXrTarget")
+            .field("level", &self.level)
+            .field("resource", &self.resource.lifetime_ref().id())
+            .field("generation", &self.generation)
+            .finish()
+    }
+}
+
+impl PartialEq for PairedXrTarget {
+    fn eq(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.resource, &other.resource)
+            && self.level == other.level
+            && self.task_id == other.task_id
+            && self.footprint.pages() == other.footprint.pages()
+    }
+}
+impl Eq for PairedXrTarget {}
+
+impl PairedXrTarget {
+    pub(crate) fn capture<M: HostMemory>(
+        state: &DeviceState,
+        host: &M,
+        task_id: u32,
+        base_ref: u32,
+        resource: Arc<TaskResource>,
+        level: PlanarXrLevel,
+    ) -> Result<Arc<Self>, Refusal> {
+        use std::hash::{Hash, Hasher};
+        if level.planes.iter().any(|p| p.layout.depth != 1) {
+            return Err(Refusal::Shape);
+        }
+        let page = state.page_size();
+        let lo = level
+            .planes
+            .iter()
+            .map(|p| p.gva)
+            .min()
+            .ok_or(Refusal::Shape)?;
+        let hi = level
+            .planes
+            .iter()
+            .map(|p| p.gva.checked_add(p.touched_span))
+            .collect::<Option<Vec<_>>>()
+            .ok_or(Refusal::Shape)?
+            .into_iter()
+            .max()
+            .ok_or(Refusal::Shape)?;
+        let page_start = lo & !(page - 1);
+        let span = hi
+            .checked_sub(page_start)
+            .filter(|s| *s > 0 && *s <= isize::MAX as u64)
+            .ok_or(Refusal::Shape)?;
+        // A hole between planes has no texels. Bound the walk to the actual
+        // two declared levels, rather than accepting an unbounded heap gap.
+        let covered = level
+            .planes
+            .iter()
+            .try_fold(page * 2, |n, p| n.checked_add(p.touched_span))
+            .ok_or(Refusal::Shape)?;
+        if span > covered {
+            return Err(Refusal::Shape);
+        }
+        let pages = complete_pages(state, host, task_id, page_start, span)?;
+        let mut hash = std::collections::hash_map::DefaultHasher::new();
+        resource.lifetime_ref().id().hash(&mut hash);
+        task_id.hash(&mut hash);
+        for p in level.planes {
+            (p.gva, p.layout.row_stride, p.layout.width, p.layout.height).hash(&mut hash);
+        }
+        pages.hash(&mut hash);
+        let generation = hash.finish().max(1);
+        let footprint = GuestPageFootprint::new(pages.into(), page).ok_or(Refusal::Pages)?;
+        let target = Arc::new(Self {
+            level,
+            resource,
+            base_ref,
+            task_id,
+            page_start,
+            span,
+            footprint,
+            generation,
+        });
+        target.current(state, host)?;
+        Ok(target)
+    }
+
+    pub(crate) fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    fn current<M: HostMemory>(&self, state: &DeviceState, host: &M) -> Result<(), Refusal> {
+        let resource =
+            crate::runtime::objects::resolve_resource(state, host, self.task_id, self.base_ref)
+                .map_err(|_| Refusal::StorageChanged)?;
+        let entry =
+            crate::runtime::objects::lookup_list_entry(state, host, self.task_id, self.base_ref)
+                .ok_or(Refusal::StorageChanged)?;
+        let declaration =
+            crate::runtime::objects::read_descriptor(state, host, self.task_id, &entry)
+                .ok_or(Refusal::StorageChanged)?;
+        if entry.object_type != self.resource.entry.object_type
+            || entry.descriptor_length != self.resource.entry.descriptor_length
+            || entry.descriptor_gva != self.resource.entry.descriptor_gva
+            || declaration.as_slice() != self.resource.descriptor.as_ref()
+            || !Arc::ptr_eq(&resource, &self.resource)
+            || complete_pages(state, host, self.task_id, self.page_start, self.span)?
+                != self.footprint.pages()
+        {
+            return Err(Refusal::StorageChanged);
+        }
+        Ok(())
+    }
+
+    fn settle<M: HostMemory + HostOps>(&self, state: &mut DeviceState, host: &mut M) {
+        for p in self.level.planes {
+            crate::runtime::writeback_debt::settle_for_texture(
+                state,
+                host,
+                self.task_id,
+                self.base_ref,
+                p.gva,
+                p.touched_span,
+                crate::runtime::render_writeback::SettleSite::LinearTextureSampled,
+            );
+        }
+    }
+
+    pub(crate) fn load<M: HostMemory + HostOps>(
+        &self,
+        state: &mut DeviceState,
+        host: &mut M,
+    ) -> Result<crate::protocol::pixel_format::ColorLoadSeed, Refusal> {
+        self.settle(state, host);
+        let rects = self.rects()?;
+        let mut planes: [Vec<u8>; 2] = std::array::from_fn(|_| Vec::new());
+        for (bytes, rect) in planes.iter_mut().zip(rects) {
+            bytes
+                .try_reserve_exact(rect.packed())
+                .map_err(|_| Refusal::Allocation)?;
+            bytes.resize(rect.packed(), 0);
+        }
+        let [rgb, alpha] = &mut planes;
+        let mut copies = [
+            RunCopy::read_rect(rgb, rects[0]).ok_or(Refusal::Shape)?,
+            RunCopy::read_rect(alpha, rects[1]).ok_or(Refusal::Shape)?,
+        ];
+        self.transfer(state, host, &mut copies)?;
+        let upload = reims_vgpu_vulkan::pixel::attachment_planar_xr_upload_bytes(
+            self.level.format,
+            &planes[0],
+            &planes[1],
+        )
+        .map_err(Refusal::LoadEncoding)?;
+        crate::runtime::drain::note_store_route("apv_xr_render_load_n");
+        Ok(crate::protocol::pixel_format::ColorLoadSeed {
+            pixels: Arc::new(upload.into_parts().1),
+            layout: crate::protocol::pixel_format::TexelLayout::Rgba32Float,
+        })
+    }
+
+    fn rects(&self) -> Result<[RectStride; 2], Refusal> {
+        let rect = |i: usize| {
+            let p = self.level.planes[i];
+            RectStride::new(
+                p.layout.row_stride,
+                u64::from(p.tight_row),
+                u64::from(p.layout.height),
+            )
+            .ok_or(Refusal::Shape)
+        };
+        Ok([rect(0)?, rect(1)?])
+    }
+
+    pub(crate) fn store<M: HostMemory + HostOps>(
+        &self,
+        state: &mut DeviceState,
+        host: &mut M,
+        planes: &[Vec<u8>; 2],
+    ) -> Result<u64, Refusal> {
+        self.settle(state, host);
+        let rects = self.rects()?;
+        if planes.iter().zip(rects).any(|(p, r)| p.len() != r.packed()) {
+            return Err(Refusal::Shape);
+        }
+        let mut copies = [
+            RunCopy::write_rect(&planes[0], rects[0]).ok_or(Refusal::Shape)?,
+            RunCopy::write_rect(&planes[1], rects[1]).ok_or(Refusal::Shape)?,
+        ];
+        self.transfer(state, host, &mut copies)?;
+        for p in self.level.planes {
+            crate::runtime::surface_cache::forget_gva_copies(
+                state,
+                self.task_id,
+                p.gva,
+                self.base_ref,
+            );
+        }
+        crate::runtime::drain::note_store_route("apv_xr_render_store_n");
+        Ok((planes[0].len() + planes[1].len()) as u64)
+    }
+
+    fn transfer<M: HostMemory + HostOps>(
+        &self,
+        state: &mut DeviceState,
+        host: &mut M,
+        copies: &mut [RunCopy<'_>; 2],
+    ) -> Result<(), Refusal> {
+        self.current(state, host)?;
+        let page = self.footprint.page_size();
+        let mut views = Views {
+            host,
+            runs: Vec::new(),
+        };
+        views
+            .runs
+            .try_reserve_exact(self.footprint.runs().len())
+            .map_err(|_| Refusal::Allocation)?;
+        for r in self.footprint.runs() {
+            let length = (r.len() as u64)
+                .checked_mul(page)
+                .filter(|n| *n <= isize::MAX as u64)
+                .ok_or(Refusal::HostBound)?;
+            let ptr = views
+                .host
+                .map_pages(&self.footprint.pages()[r.clone()], page as usize)
+                .ok_or(Refusal::Map)?;
+            let Some(bytes) = GuestRun::whole(ptr, length) else {
+                views.host.unmap_pages(ptr, length as usize);
+                return Err(Refusal::HostBound);
+            };
+            views.runs.push((r.start as u64 * page, bytes));
+        }
+        // Validate every piece before either plane can be modified, including
+        // a second page walk after all host views have been acquired.
+        self.current(state, views.host)?;
+        let mut pieces = Vec::new();
+        pieces
+            .try_reserve_exact(views.runs.len().checked_mul(2).ok_or(Refusal::Allocation)?)
+            .map_err(|_| Refusal::Allocation)?;
+        for (i, copy) in copies.iter().enumerate() {
+            let start = self.level.planes[i]
+                .gva
+                .checked_sub(self.page_start)
+                .ok_or(Refusal::Shape)?;
+            let end = start.checked_add(copy.len() as u64).ok_or(Refusal::Shape)?;
+            let mut covered = 0;
+            for (offset, run) in &views.runs {
+                let lo = start.max(*offset);
+                let hi = end.min(offset + run.len());
+                if lo >= hi {
+                    continue;
+                }
+                let n = hi - lo;
+                let bytes = GuestRun::in_mapping(run.host_ptr(), run.len(), lo - offset, n)
+                    .ok_or(Refusal::HostBound)?;
+                pieces.push((i, (lo - start) as usize, bytes));
+                covered += n;
+            }
+            if covered != copy.len() as u64 {
+                return Err(Refusal::HostBound);
+            }
+        }
+        let writing = copies[0].is_write();
+        if writing {
+            state.note_host_wrote_pages(self.footprint.pages().to_vec());
+        }
+        for (i, offset, bytes) in pieces {
+            // SAFETY: all pieces are bounded live GuestRuns held by views;
+            // every copy's complete rectangular span was validated above.
+            unsafe {
+                copies[i].apply(bytes.host_ptr(), 0, offset, bytes.len() as usize);
+            }
+        }
+        drop(views);
+        if writing {
+            for p in self.level.planes {
+                crate::runtime::mapper::note_physical_page_write_footprint(
+                    &self.footprint,
+                    p.gva - self.page_start,
+                    p.touched_span,
+                );
+            }
+        }
+        Ok(())
+    }
+}
+
+fn complete_pages<M: HostMemory>(
+    state: &DeviceState,
+    host: &M,
+    task_id: u32,
+    gva: u64,
+    span: u64,
+) -> Result<Vec<u64>, Refusal> {
+    let pages = crate::runtime::gva_mem::task_gva_page_gpas(
+        host,
+        &state.tasks,
+        task_id,
+        gva,
+        span,
+        state.page_shift,
+    );
+    let expected = reims_vgpu_paging::span::pages_spanned(gva, span, state.page_size());
+    // Repeated physical pages would make distinct logical texels alias.
+    let unique: std::collections::HashSet<_> = pages.iter().copied().collect();
+    if pages.len() as u64 != expected || unique.len() != pages.len() {
+        return Err(Refusal::Pages);
+    }
+    Ok(pages)
+}
+
+struct Views<'a, H: HostOps> {
+    host: &'a mut H,
+    runs: Vec<(u64, GuestRun)>,
+}
+impl<H: HostOps> Drop for Views<'_, H> {
+    fn drop(&mut self) {
+        for (_, run) in self.runs.iter().rev() {
+            self.host.unmap_pages(run.host_ptr(), run.len() as usize);
+        }
+    }
+}
+
+pub(crate) fn clear<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    target: &PairedXrTarget,
+    color: [f64; 4],
+) -> Result<u64, Refusal> {
+    let texel: Vec<_> = color
+        .into_iter()
+        .flat_map(|v| (v as f32).to_le_bytes())
+        .collect();
+    let encoded = reims_vgpu_vulkan::pixel::render_store_planar_xr_encoding(
+        target.level.format,
+        crate::protocol::pixel_format::TexelLayout::Rgba32Float,
+        &texel,
+    )
+    .map_err(Refusal::Encode)?;
+    let count = target.rects()?[0].packed() / 4;
+    let mut planes: [Vec<u8>; 2] = std::array::from_fn(|_| Vec::new());
+    for (p, texel) in planes.iter_mut().zip(encoded.planes) {
+        let n = count.checked_mul(texel.len()).ok_or(Refusal::Allocation)?;
+        p.try_reserve_exact(n).map_err(|_| Refusal::Allocation)?;
+        p.resize(n, 0);
+        for out in p.chunks_exact_mut(texel.len()) {
+            out.copy_from_slice(&texel);
+        }
+    }
+    let bytes = target.store(state, host, &planes)?;
+    crate::runtime::drain::note_store_route("apv_xr_render_clear_n");
+    Ok(bytes)
+}
