+/// Consume native float output, then release the staging lease before taking
+/// any guest-memory settlement lock. The pair was captured before GPU submit.
+pub(crate) fn store_paired_xr_frame<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    identity: &crate::backend::vulkan::engine::TargetIdentity,
+    color: &crate::runtime::draw::ColorRtRequest,
+) -> Result<u64, crate::runtime::draw::planar_xr::Refusal> {
+    use crate::protocol::pixel_format::TexelLayout;
+    use crate::runtime::draw::planar_xr::Refusal as R;
+    let pair = color.paired_xr.as_ref().ok_or(R::Resource)?;
+    if !matches!(identity, crate::backend::vulkan::engine::TargetIdentity::Gva { gva, width, height, generation, format }
+        if *gva == color.target_gva && *width == color.width && *height == color.height
+            && *generation == pair.generation() && *format == ash::vk::Format::R32G32B32A32_SFLOAT)
+    {
+        return Err(R::StorageChanged);
+    }
+    let planes = {
+        let readback = crate::backend::vulkan::engine::read_target_texels_consumable(identity)
+            .map_err(R::Read)?;
+        let expected = (color.width as usize)
+            .checked_mul(color.height as usize)
+            .and_then(|n| n.checked_mul(16))
+            .ok_or(R::Shape)?;
+        if readback.texel.native_layout() != Some(TexelLayout::Rgba32Float)
+            || readback.bytes().len() != expected
+        {
+            return Err(R::SourceLayout);
+        }
+        let started = std::time::Instant::now();
+        let encoded = reims_vgpu_vulkan::pixel::render_store_planar_xr_encoding(
+            pair.level.format,
+            TexelLayout::Rgba32Float,
+            readback.bytes(),
+        )
+        .map_err(R::Encode)?;
+        crate::runtime::drain::note_store_route_us(
+            "apv_xr_encode_us",
+            started.elapsed().as_micros() as u64,
+        );
+        crate::runtime::drain::note_store_route_n("apv_xr_encode_texels_n", encoded.encoded_texels);
+        crate::runtime::drain::note_store_route_n(
+            "apv_xr_encode_reused_texels_n",
+            encoded.reused_texels,
+        );
+        encoded.planes
+    };
+    let bytes = pair.store(state, host, &planes)?;
+    crate::backend::vulkan::engine::note_resident_content_copied_out(identity);
+    Ok(bytes)
+}
