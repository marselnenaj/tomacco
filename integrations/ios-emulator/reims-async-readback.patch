+/// The deferred Stores and the words parked behind them.
+#[derive(Debug, Default)]
+pub struct AsyncStores {
+    pending: VecDeque<PendingStore>,
+    parked: VecDeque<(ParkedWord, std::time::Instant)>,
+    next_seq: u64,
+    /// Set while a landing runs. A Store's own write settles its mapping, which
+    /// reaches the hooks here again; those must not land a *later* Store ahead
+    /// of the one in progress.
+    landing: bool,
+}
+
+impl AsyncStores {
+    /// Nothing deferred and nothing parked: every hook returns at once.
+    pub fn is_idle(&self) -> bool {
+        self.pending.is_empty() && self.parked.is_empty()
+    }
+
+    pub fn pending_len(&self) -> usize {
+        self.pending.len()
+    }
+
+    /// Record a Store whose copy has been submitted.
+    pub fn defer(
+        &mut self,
+        target: ResidentTarget,
+        mapping_id: u32,
+        width: u32,
+        height: u32,
+        format: u16,
+        pages: Option<std::sync::Arc<[u64]>>,
+    ) -> u64 {
+        let seq = self.next_seq;
+        self.next_seq += 1;
+        self.pending.push_back(PendingStore {
+            seq,
+            target,
+            mapping_id,
+            width,
+            height,
+            format,
+            pages,
+            deferred_at: std::time::Instant::now(),
+        });
+        seq
+    }
+
+    /// Park a completion word if anything is deferred or parked ahead of it.
+    ///
+    /// Also when only words are parked: a later word may not overtake an
+    /// earlier one, whichever slot it is for, or a guest that reads two slots
+    /// could see the second FIFO complete before work the first one ordered.
+    pub fn park(&mut self, domain: u32, slot: u32, value: u32) -> bool {
+        if self.is_idle() {
+            return false;
+        }
+        self.parked.push_back((
+            ParkedWord {
+                after: self.next_seq,
+                domain,
+                slot,
+                value,
+            },
+            std::time::Instant::now(),
+        ));
+        true
+    }
+
+    /// The first Store not yet landed, which every parked word compares with.
+    fn landed_up_to(&self) -> u64 {
+        self.pending.front().map_or(self.next_seq, |p| p.seq)
+    }
+
+    /// How many Stores from the front must land for `mapping_id`'s newest
+    /// deferred Store to have landed; zero when it has none.
+    pub fn depth_through(&self, mapping_id: u32) -> usize {
+        self.pending
+            .iter()
+            .rposition(|p| p.mapping_id == mapping_id)
+            .map_or(0, |i| i + 1)
+    }
+
+    /// How many Stores from the front must land before a host reader or
+    /// writer of `mapping_id`'s pages `reach` may touch them: through the last
+    /// Store into that mapping or into any page it shares with `reach`.
+    /// Mapping ids are not page identities (two mappings can name one
+    /// allocation), so the pages are compared too.
+    pub fn depth_reaching(&self, mapping_id: u32, reach: Option<&[u64]>) -> usize {
+        self.pending
+            .iter()
+            .rposition(|p| p.mapping_id == mapping_id || pages_overlap(p.pages.as_deref(), reach))
+            .map_or(0, |i| i + 1)
+    }
+
+    /// The parked words every Store ahead of which has landed, in order, with
+    /// repeated words for one slot folded into its last value.
+    ///
+    /// Folding is what the page would hold anyway one statement later, and it
+    /// keeps the page from ever showing an older value than the ordering plane
+    /// already published for that slot (`stamp_publish_behind`). The guest's
+    /// wait is `target - current <= 0`, so the newest value satisfies every
+    /// wait an older one would have. Returns the parked ages beside them.
+    pub fn take_releasable(&mut self) -> Vec<(ParkedWord, std::time::Duration)> {
+        let landed = self.landed_up_to();
+        let mut out: Vec<(ParkedWord, std::time::Duration)> = Vec::new();
+        while let Some((word, _)) = self.parked.front() {
+            if word.after > landed {
+                break;
+            }
+            let (word, at) = self.parked.pop_front().expect("front checked");
+            let age = at.elapsed();
+            match out
+                .iter_mut()
+                .find(|(w, _)| w.domain == word.domain && w.slot == word.slot)
+            {
+                Some(entry) => {
+                    entry.0.value = word.value;
+                    crate::runtime::drain::note_store_route("async_store_word_folded");
+                }
+                None => out.push((word, age)),
+            }
+        }
+        out
+    }
+}
+
+/// Whether the drain still owes a Store's write or a parked word, so the
+/// device poll must make sure a drain runs.
+pub fn owes_drain(state: &DeviceState) -> bool {
+    !state.async_stores.is_idle()
+}
+
+/// Park the completion word `drain::publish_word` was about to publish, if
+/// Stores deferred before it have not landed. `true` when the caller must not
+/// publish it now.
+pub fn park_word(state: &mut DeviceState, domain: u32, slot: u32, value: u32) -> bool {
+    let parked = state.async_stores.park(domain, slot, value);
+    if parked {
+        crate::runtime::drain::note_store_route("async_store_word_parked");
+    }
+    parked
+}
+
+/// Land the Stores whose copies are complete, without waiting, and publish the
+/// words they were holding. For the start and end of a drain pass.
+pub fn service<M: HostMemory + HostOps>(state: &mut DeviceState, host: &mut M) {
+    if state.async_stores.is_idle() {
+        return;
+    }
+    land_stale(state, host);
+    land(state, host, None, LandSite::Ready, false);
+}
+
+/// Land, waiting, every Store at the front that has been deferred longer than
+/// [`STALE_AFTER`]. Returns how many words that published.
+fn land_stale<M: HostMemory + HostOps>(state: &mut DeviceState, host: &mut M) -> usize {
+    let stale = state
+        .async_stores
+        .pending
+        .iter()
+        .take_while(|p| p.deferred_at.elapsed() >= STALE_AFTER)
+        .count();
+    if stale == 0 {
+        return 0;
+    }
+    land(state, host, Some(stale), LandSite::Stale, true)
+}
+
+/// Land every deferred Store, waiting where a copy is still in flight.
+pub fn land_all<M: HostMemory + HostOps>(state: &mut DeviceState, host: &mut M, site: LandSite) {
+    if state.async_stores.is_idle() {
+        return;
+    }
+    land(state, host, None, site, true);
+}
+
+/// Land every deferred Store a host access to `mapping_id`'s guest pages can
+/// observe: through its own newest Store and the newest one whose pages it
+/// shares, in Store order.
+pub fn land_for_mapping_pages<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    mapping_id: u32,
+    site: LandSite,
+) {
+    if state.async_stores.is_idle() || state.async_stores.pending.is_empty() {
+        return;
+    }
+    let reach = sorted_pages(state, mapping_id);
+    let depth = state
+        .async_stores
+        .depth_reaching(mapping_id, reach.as_deref());
+    if depth == 0 {
+        // See `land_through_mapping`: nothing at all happens on this arm.
+        return;
+    }
+    land(state, host, Some(depth), site, true);
+}
+
+/// Land every deferred Store up to and including `mapping_id`'s newest one.
+pub fn land_through_mapping<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    mapping_id: u32,
+    site: LandSite,
+) {
+    if state.async_stores.is_idle() {
+        return;
+    }
+    let depth = state.async_stores.depth_through(mapping_id);
+    if depth == 0 {
+        // Nothing of this mapping's is owed, so nothing happens here at all:
+        // this is the hook every named writer reaches, some of them while they
+        // hold a staging lease, and publishing a word can reach the engine.
+        // Words wait for the next landing or drain pass, which release them.
+        return;
+    }
+    land(state, host, Some(depth), site, true);
+}
+
+/// Land the oldest Store, for a caller at the in-flight cap.
+pub fn land_oldest<M: HostMemory + HostOps>(state: &mut DeviceState, host: &mut M) {
+    if state.async_stores.pending.is_empty() {
+        return;
+    }
+    land(state, host, Some(1), LandSite::Capacity, true);
+}
+
+/// The end of a drain pass: land what is ready, then either have the drain
+/// woken when the oldest copy lands or, failing that, land everything now.
+///
+/// `true` when it published a parked word. A packet of another FIFO may be
+/// held on that word (cross-FIFO waits are decided from the stamp page), and
+/// this pass has already offered its held packets, so the caller schedules
+/// another pass rather than leave it for the guest's next doorbell.
+pub fn after_tranche<M: HostMemory + HostOps>(state: &mut DeviceState, host: &mut M) -> bool {
+    if state.async_stores.is_idle() {
+        return false;
+    }
+    let mut released = land_stale(state, host);
+    released += land(state, host, None, LandSite::Ready, false);
+    if !state.async_stores.pending.is_empty() {
+        if rail::arm_wake() {
+            crate::runtime::drain::note_store_route("async_store_wake_armed");
+        } else {
+            crate::runtime::drain::note_store_route("async_store_wake_unavailable");
+            released += land(state, host, None, LandSite::NoWake, true);
+        }
+    }
+    released != 0
+}
+
+/// Land up to `count` Stores from the front (all with `None`), stopping at
+/// the first copy still in flight unless `wait`, then publish the words that
+/// became due. Returns how many words were published.
+fn land<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    count: Option<usize>,
+    site: LandSite,
+    wait: bool,
+) -> usize {
+    if state.async_stores.landing {
+        return 0;
+    }
+    state.async_stores.landing = true;
+    let started = std::time::Instant::now();
+    let mut landed = 0usize;
+    while count.is_none_or(|n| landed < n) {
+        let Some(front) = state.async_stores.pending.front() else {
+            break;
+        };
+        if !wait && !rail::ready(&front.target) {
+            break;
+        }
+        // Left at the front while it lands, and taken off only after its pages
+        // hold the frame: a hook its own write reaches must still see it owed,
+        // or a word parked behind it would be released before its pixels.
+        let store = front.clone();
+        crate::runtime::drain::note_store_route_us(
+            "async_store_age_us",
+            store.deferred_at.elapsed().as_micros() as u64,
+        );
+        let landed_ok = rail::land(state, host, &store);
+        let popped = state.async_stores.pending.pop_front();
+        debug_assert_eq!(
+            popped.map(|p| p.seq),
+            Some(store.seq),
+            "landing is in Store order"
+        );
+        if !landed_ok {
+            // The Store's rail named its own refusal on the failure channel;
+            // this says it was a deferred one, which is a different
+            // investigation from a Store refused where it was issued.
+            crate::runtime::drain::note_store_route("async_store_lost");
+            crate::observe::fail(format!(
+                "async_store_lost mapping={} {}x{} site={site:?} target={:?}",
+                store.mapping_id, store.width, store.height, store.target
+            ));
+        }
+        landed += 1;
+    }
+    state.async_stores.landing = false;
+    if landed != 0 {
+        crate::runtime::drain::note_store_route_n(site.route(), landed as u64);
+        crate::runtime::drain::note_store_route_us(
+            site.route_us(),
+            started.elapsed().as_micros() as u64,
+        );
+    }
+    release_words(state, host)
+}
+
+fn release_words<M: HostMemory + HostOps>(state: &mut DeviceState, host: &mut M) -> usize {
+    // Never from inside a landing: the Store in progress is still owed.
+    if state.async_stores.parked.is_empty() || state.async_stores.landing {
+        return 0;
+    }
+    let words = state.async_stores.take_releasable();
+    let released = words.len();
+    for (word, age) in words {
+        crate::runtime::drain::note_store_route("async_store_word_released");
+        crate::runtime::drain::note_store_route_us(
+            "async_store_word_park_us",
+            age.as_micros() as u64,
+        );
+        crate::runtime::drain::publish_word_now(state, host, word.domain, word.slot, word.value);
+    }
+    released
+}
+
+/// The rail-specific half: whether a Store's copy has landed, how to run the
+/// Store, and how to be woken. Only the Vulkan rail defers anything.
+#[cfg(feature = "backend-vulkan")]
+mod rail {
+    use super::*;
+
+    pub(super) fn ready(target: &ResidentTarget) -> bool {
+        target
+            .get::<crate::backend::vulkan::engine::TargetIdentity>()
+            .and_then(crate::backend::vulkan::engine::async_readback_ready)
+            .unwrap_or(true)
+    }
+
+    pub(super) fn land<M: HostMemory + HostOps>(
+        state: &mut DeviceState,
+        host: &mut M,
+        store: &PendingStore,
+    ) -> bool {
+        crate::runtime::draw::vulkan::land_async_surface_store(state, host, store)
+    }
+
+    pub(super) fn arm_wake() -> bool {
+        crate::backend::vulkan::engine::arm_async_readback_wake()
+    }
+}
+
+#[cfg(not(feature = "backend-vulkan"))]
+mod rail {
+    use super::*;
+
+    pub(super) fn ready(_target: &ResidentTarget) -> bool {
+        true
+    }
+
+    pub(super) fn land<M: HostMemory + HostOps>(
+        _state: &mut DeviceState,
+        _host: &mut M,
+        _store: &PendingStore,
+    ) -> bool {
+        false
+    }
+
+    pub(super) fn arm_wake() -> bool {
+        false
+    }
+}
