+/// The async readback rail's guest-visible promise, on the real publication
+/// path: a completion word that falls due behind a deferred render Store does
+/// not reach the stamp page until that Store has landed, and then it does,
+/// with its interrupt. See `runtime::async_store`.
+mod async_store_words {
+    use super::*;
+    use crate::runtime::async_store::{self, LandSite};
+    use crate::runtime::resident_target::{RailTarget, ResidentTarget};
+
+    /// A target no rail can read, so its landing is a refused (lost) Store
+    /// without touching a device. A refused Store still lands: the word it was
+    /// holding must not be held forever behind a frame that will never come.
+    #[derive(Debug, PartialEq, Eq)]
+    struct Unreadable;
+    impl RailTarget for Unreadable {
+        fn same_target(&self, other: &dyn RailTarget) -> bool {
+            other.as_any().downcast_ref::<Self>().is_some()
+        }
+        fn as_any(&self) -> &dyn std::any::Any {
+            self
+        }
+    }
+
+    fn stamp_page() -> (DeviceState, FakeHost, u64) {
+        let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_X86);
+        let mut host = FakeHost::new();
+        let stamp_pfn = 0x40u32;
+        let stamp_gpa = state.pfn_gpa(stamp_pfn);
+        host.map_range(stamp_gpa, state.page_size() as usize, 0);
+        state.gfx.fifo_base_page = stamp_pfn;
+        (state, host, stamp_gpa)
+    }
+
+    #[test]
+    fn a_word_behind_a_deferred_store_reaches_the_page_only_when_the_store_lands() {
+        let (mut state, mut host, stamp_gpa) = stamp_page();
+        state
+            .async_stores
+            .defer(ResidentTarget::new(Unreadable), 77, 4, 2, 0, None);
+        publish_word(&mut state, &mut host, 5, 1, 22);
+        assert_eq!(host.get_u32(stamp_gpa + 4), 0, "parked behind the Store");
+        assert!(host.actions.is_empty(), "and not announced either");
+        // A second word for the same slot folds into the newer value.
+        publish_word(&mut state, &mut host, 5, 1, 23);
+        async_store::land_all(&mut state, &mut host, LandSite::Packet);
+        assert_eq!(host.get_u32(stamp_gpa + 4), 23);
+        assert!(state.async_stores.is_idle());
+        // Idle again: the next word publishes at once, as on the synchronous rail.
+        publish_word(&mut state, &mut host, 5, 1, 24);
+        assert_eq!(host.get_u32(stamp_gpa + 4), 24);
+    }
+
+    /// A drain pass never ends owing a Store whose copy is complete, so a guest
+    /// asleep on the parked word is not left waiting for its own next doorbell.
+    #[test]
+    fn a_drain_pass_lands_a_ready_store_and_releases_its_word() {
+        let (mut state, mut host, stamp_gpa) = stamp_page();
+        state
+            .async_stores
+            .defer(ResidentTarget::new(Unreadable), 77, 4, 2, 0, None);
+        publish_word(&mut state, &mut host, 5, 1, 22);
+        assert_eq!(host.get_u32(stamp_gpa + 4), 0);
+        drain_pending(&mut state, &mut host);
+        assert_eq!(host.get_u32(stamp_gpa + 4), 22);
+        assert!(!async_store::owes_drain(&state));
+    }
+
+    /// A word with nothing deferred ahead of it is published where it falls
+    /// due, so with no Store in flight this rail changes no timing at all.
+    #[test]
+    fn an_idle_rail_publishes_every_word_at_once() {
+        let (mut state, mut host, stamp_gpa) = stamp_page();
+        publish_word(&mut state, &mut host, 5, 2, 9);
+        assert_eq!(host.get_u32(stamp_gpa + 8), 9);
+        assert!(state.async_stores.is_idle());
+    }
+}
