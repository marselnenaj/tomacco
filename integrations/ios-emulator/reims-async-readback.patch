+/// Block until the completion timeline reaches `point`.
+///
+/// In slices, so a queue owner that failed the submission carrying the point —
+/// which would then never be signalled — is noticed rather than waited out.
+unsafe fn wait_completion_point(
+    ctx: &context::DeviceContext,
+    counters: &EngineCounters,
+    point: u64,
+) -> Result<(), DrawError> {
+    let Some(completion) = ctx.stamp_completion.as_ref() else {
+        // A prefetch is only ever recorded with a timeline; a context without
+        // one is a different device, whose teardown already dropped it.
+        return Ok(());
+    };
+    let semaphores = [completion.semaphore()];
+    let values = [point];
+    let info = ash::vk::SemaphoreWaitInfo::default()
+        .semaphores(&semaphores)
+        .values(&values);
+    const SLICE_NS: u64 = 50_000_000;
+    let mut waited = 0u64;
+    loop {
+        if let Some(error) = ctx.queue_failure() {
+            return Err(prefetch_wait_error(counters, error));
+        }
+        match unsafe { ctx.device.wait_semaphores(&info, SLICE_NS) } {
+            Ok(()) => return Ok(()),
+            Err(ash::vk::Result::TIMEOUT) if waited < context::FENCE_TIMEOUT_NS => {
+                waited = waited.saturating_add(SLICE_NS);
+            }
+            Err(e) => return Err(prefetch_wait_error(counters, e)),
+        }
+    }
+}
+
+fn prefetch_wait_error(counters: &EngineCounters, e: ash::vk::Result) -> DrawError {
+    if e == ash::vk::Result::TIMEOUT {
+        counters.fence_timeouts.fetch_add(1, Ordering::Relaxed);
+        DrawError::FenceTimeout
+    } else if e == ash::vk::Result::ERROR_DEVICE_LOST {
+        DrawError::DeviceLost(device_lost::DeviceLostDecline::Driver {
+            op: device_lost::DeviceLostOp::PoolsWaitFencesEntry,
+            result: e,
+        })
+    } else {
+        DrawError::VkCall(VkCall::new(VkOp::PoolsWaitFencesEntry, e))
+    }
+}
