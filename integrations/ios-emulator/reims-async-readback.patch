+/// Whether `identity`'s prefetched copy has completed: `Some(true)` when a
+/// Store may land without waiting, `Some(false)` while the copy is in flight,
+/// `None` when there is no prefetch (consumed, or dropped by a teardown — the
+/// Store then reads a fresh copy and should not be held for one).
+pub fn async_readback_ready(identity: &TargetIdentity) -> Option<bool> {
+    let guard = lock_engine();
+    let prefetched = guard
+        .pools
+        .async_readbacks
+        .iter()
+        .find(|p| &p.identity == identity)?;
+    if prefetched.pending_point().is_none() {
+        return Some(true);
+    }
+    let Some(ctx) = guard.owner.ctx.as_ref() else {
+        return Some(true);
+    };
+    let Some(completion) = ctx.stamp_completion.as_ref() else {
+        return Some(true);
+    };
+    // A queue owner that failed a submission may never signal its point; the
+    // landing's own wait is what reports that, so it must be allowed to run.
+    if ctx.queue_failure().is_some() {
+        return Some(true);
+    }
+    // A failed read of the counter is a device problem the landing's own wait
+    // will report; answering "ready" sends it there instead of holding the
+    // Store for a counter that cannot be read.
+    let counter = unsafe {
+        ctx.device
+            .get_semaphore_counter_value(completion.semaphore())
+    }
+    .unwrap_or(u64::MAX);
+    Some(async_readback::reached(counter, prefetched))
+}
