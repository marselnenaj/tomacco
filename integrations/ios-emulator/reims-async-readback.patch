+/// Ask the completion thread to run the drain once the oldest prefetched copy
+/// lands. `false` when nothing could be armed (no prefetch in flight, no
+/// completion thread); the caller then lands its Stores itself.
+pub fn arm_async_readback_wake() -> bool {
+    let guard = lock_engine();
+    let Some(point) = async_readback::earliest_point(&guard.pools.async_readbacks) else {
+        return false;
+    };
+    guard
+        .owner
+        .ctx
+        .as_ref()
+        .and_then(|ctx| ctx.stamp_completion.as_ref())
+        .is_some_and(|completion| completion.wake_drain_at(point))
+}
+
+/// Drop `identity`'s prefetch without reading it, returning its staging slot.
+/// For a Store that landed (or failed) without consuming it.
+pub fn drop_async_readback(identity: &TargetIdentity) -> bool {
+    let mut guard = lock_engine();
+    async_readback::take(&mut guard.pools.async_readbacks, identity).is_some()
+}
