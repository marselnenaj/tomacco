+/// What [`prefetch_target_readback`] did with one Store's readback.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ReadbackPrefetch {
+    /// The copy is recorded and submitted; the Store may run later and will
+    /// read it.
+    Submitted,
+    /// Nothing was recorded, for the named reason. The Store must run now, the
+    /// synchronous way.
+    Declined(&'static str),
