+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[derive(Debug, PartialEq, Eq)]
+    struct Fake(u32);
+    impl crate::runtime::resident_target::RailTarget for Fake {
+        fn same_target(&self, other: &dyn crate::runtime::resident_target::RailTarget) -> bool {
+            other.as_any().downcast_ref::<Self>() == Some(self)
+        }
+        fn as_any(&self) -> &dyn std::any::Any {
+            self
+        }
+    }
+
+    fn defer(s: &mut AsyncStores, mapping_id: u32) -> u64 {
+        s.defer(
+            ResidentTarget::new(Fake(mapping_id)),
+            mapping_id,
+            4,
+            2,
+            0,
+            None,
+        )
+    }
+
+    fn defer_on(s: &mut AsyncStores, mapping_id: u32, pages: &[u64]) -> u64 {
+        s.defer(
+            ResidentTarget::new(Fake(mapping_id)),
+            mapping_id,
+            4,
+            2,
+            0,
+            Some(pages.to_vec().into()),
+        )
+    }
+
+    #[test]
+    fn page_lists_overlap_exactly_when_they_share_a_page_or_one_is_unknown() {
+        assert!(pages_overlap(Some(&[1, 5, 9]), Some(&[2, 5])));
+        assert!(!pages_overlap(Some(&[1, 5, 9]), Some(&[2, 6, 8])));
+        assert!(
+            !pages_overlap(Some(&[1, 2]), Some(&[7, 8])),
+            "disjoint spans"
+        );
+        assert!(
+            !pages_overlap(Some(&[]), Some(&[1])),
+            "an empty list reaches nothing"
+        );
+        assert!(
+            pages_overlap(None, Some(&[1])),
+            "an unnamed Store reaches everything"
+        );
+        assert!(
+            pages_overlap(Some(&[1]), None),
+            "an unnamed reader cannot be ruled out"
+        );
+    }
+
+    /// Two mappings can name one allocation, so a reader of one lands a Store
+    /// into the other when they share a page, and only then — and everything
+    /// ahead of that Store with it, in Store order.
+    #[test]
+    fn a_reader_lands_through_the_newest_store_into_its_mapping_or_its_pages() {
+        let mut s = AsyncStores::default();
+        defer_on(&mut s, 7, &[0x10, 0x11]);
+        defer_on(&mut s, 8, &[0x20, 0x21]);
+        defer_on(&mut s, 9, &[0x30]);
+        assert_eq!(s.depth_reaching(8, Some(&[0x20, 0x21])), 2, "its own Store");
+        assert_eq!(
+            s.depth_reaching(5, Some(&[0x30, 0x40])),
+            3,
+            "an aliasing Store"
+        );
+        assert_eq!(s.depth_reaching(5, Some(&[0x40])), 0, "nothing shared");
+        assert_eq!(
+            s.depth_reaching(5, None),
+            3,
+            "an unnamed reader reaches all"
+        );
+        defer(&mut s, 6);
+        assert_eq!(
+            s.depth_reaching(5, Some(&[0x40])),
+            4,
+            "an unnamed Store is reached"
+        );
+    }
+
+    fn land_front(s: &mut AsyncStores) -> PendingStore {
+        s.pending.pop_front().expect("a Store to land")
+    }
+
+    /// With nothing deferred a word publishes at once, which is the
+    /// synchronous rail's timing exactly.
+    #[test]
+    fn an_idle_rail_parks_nothing() {
+        let mut s = AsyncStores::default();
+        assert!(s.is_idle());
+        assert!(!s.park(1, 3, 10));
+        assert!(s.is_idle());
+    }
+
+    /// The guest must not see a completion before the pixels of a Store that
+    /// preceded it: the word waits for exactly the Stores deferred before it.
+    #[test]
+    fn a_word_waits_for_every_store_deferred_before_it_and_no_later_one() {
+        let mut s = AsyncStores::default();
+        defer(&mut s, 7);
+        defer(&mut s, 8);
+        assert!(s.park(1, 3, 10), "behind two Stores");
+        defer(&mut s, 9);
+        assert!(s.take_releasable().is_empty(), "nothing has landed");
+        land_front(&mut s);
+        assert!(
+            s.take_releasable().is_empty(),
+            "one Store ahead is still owed"
+        );
+        land_front(&mut s);
+        let released = s.take_releasable();
+        assert_eq!(released.len(), 1, "Store 9 came after the word");
+        assert_eq!(released[0].0.value, 10);
+        assert_eq!(s.pending_len(), 1);
+    }
+
+    /// A word parks behind earlier parked words even with no Store pending,
+    /// so words publish in the order the device decided them.
+    #[test]
+    fn a_later_word_never_overtakes_an_earlier_one() {
+        let mut s = AsyncStores::default();
+        defer(&mut s, 7);
+        assert!(s.park(1, 3, 10));
+        land_front(&mut s);
+        assert!(s.park(2, 4, 20), "an earlier word is still parked");
+        let released = s.take_releasable();
+        assert_eq!(
+            released
+                .iter()
+                .map(|(w, _)| (w.slot, w.value))
+                .collect::<Vec<_>>(),
+            vec![(3, 10), (4, 20)]
+        );
+        assert!(s.is_idle());
+        assert!(!s.park(2, 4, 21), "idle again: publish now");
+    }
+
+    /// Two words for one slot become one publication of the newer value, and
+    /// words for other slots keep their place.
+    #[test]
+    fn repeated_words_for_one_slot_fold_into_the_newest_value() {
+        let mut s = AsyncStores::default();
+        defer(&mut s, 7);
+        assert!(s.park(1, 3, 10));
+        assert!(s.park(0, 0, 5));
+        assert!(s.park(1, 3, 11));
+        land_front(&mut s);
+        let released: Vec<_> = s.take_releasable().into_iter().map(|(w, _)| w).collect();
+        assert_eq!(released.len(), 2);
+        assert_eq!(
+            (released[0].domain, released[0].slot, released[0].value),
+            (1, 3, 11)
+        );
+        assert_eq!(
+            (released[1].domain, released[1].slot, released[1].value),
+            (0, 0, 5)
+        );
+    }
+
+    /// A word for one slot of the root FIFO and one of a child channel are two
+    /// different words even when the slot numbers agree.
+    #[test]
+    fn words_of_two_domains_never_fold() {
+        let mut s = AsyncStores::default();
+        defer(&mut s, 7);
+        assert!(s.park(0, 0, 5));
+        assert!(s.park(1, 0, 6));
+        land_front(&mut s);
+        assert_eq!(s.take_releasable().len(), 2);
+    }
+
+    /// Landing for a mapping lands every Store ahead of its newest one too, in
+    /// Store order, so aliasing pages see the guest's order of writes.
+    #[test]
+    fn a_mapping_lands_through_its_newest_store_and_everything_ahead() {
+        let mut s = AsyncStores::default();
+        defer(&mut s, 7);
+        defer(&mut s, 8);
+        defer(&mut s, 7);
+        defer(&mut s, 9);
+        assert_eq!(s.depth_through(7), 3);
+        assert_eq!(s.depth_through(8), 2);
+        assert_eq!(s.depth_through(9), 4);
+        assert_eq!(s.depth_through(5), 0);
+    }
+
+    /// A Store being landed stays owed until its write is done, so a word
+    /// parked behind it cannot be released by a hook that write reaches.
+    #[test]
+    fn a_store_in_progress_still_holds_the_words_behind_it() {
+        let mut s = AsyncStores::default();
+        defer(&mut s, 7);
+        assert!(s.park(1, 3, 10));
+        // `land` clones the front, writes, and only then pops: in between,
+        // the word is not releasable.
+        let _in_progress = s.pending.front().cloned().expect("front");
+        assert!(s.take_releasable().is_empty());
+        s.pending.pop_front();
+        assert_eq!(s.take_releasable().len(), 1);
+    }
+
+    /// Store order is dense and strictly increasing; a word compares against
+    /// the first unlanded Store, or against the next number when none is left.
+    #[test]
+    fn store_order_is_dense_and_the_landed_mark_follows_the_front() {
+        let mut s = AsyncStores::default();
+        assert_eq!(s.landed_up_to(), 0);
+        assert_eq!(defer(&mut s, 1), 0);
+        assert_eq!(defer(&mut s, 2), 1);
+        assert_eq!(s.landed_up_to(), 0);
+        land_front(&mut s);
+        assert_eq!(s.landed_up_to(), 1);
+        land_front(&mut s);
+        assert_eq!(s.landed_up_to(), 2);
+    }
+}
