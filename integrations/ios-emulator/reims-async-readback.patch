+++ b/reims-vgpu/crates/reims-vgpu/src/backend/vulkan/engine/async_readback.rs
@@ -0,0 +1,221 @@
+//! Readbacks submitted at a render Store and consumed later, so the drain does
+//! not wait on the GPU at the Store.
+//!
+//! # What this is for
+//!
+//! On a host whose guest RAM cannot be imported (the Linux phone host: shared
+//! `memory-backend-ram`, RADV refuses the host-pointer import) every render
+//! Store takes the copying rail: copy the resident into a staging buffer, wait
+//! the fence, map, and write the guest's pages on the CPU. Heavy
+//! minutes spent 460 ms of every drain second in that fence wait while the GPU
+//! itself was busy 17 ms a second, so nearly all of it was submission and wake
+//! latency the drain sat out holding the device lock (and, on this machine, the
+//! QEMU main loop's BQL).
+//!
+//! `runtime::async_store` decides *when* a Store's guest writeback may happen
+//! later; this half is the engine's part. [`super::prefetch_target_readback`]
+//! records and submits the copy exactly where the synchronous Store would have,
+//! and keeps the staging slot as a lease that belongs to no ring entry, so the
+//! ring retiring (and resetting) the slot's fence cannot touch it. Completion
+//! is the FIFO completion timeline point of the submission that carries the
+//! copy, which any thread may wait or poll and which is never reset.
+//!
+//! The Store itself runs later through the same code as before.
+//! `read_target_leased` / `read_target_texels_*` take the prefetched copy for
+//! their identity instead of recording a new one, wait its point (normally
+//! already reached), and hand the bytes on through the same lease or copy they
+//! always returned. So every Store rail, and every byte it writes, is
+//! unchanged; only the moment the bytes reach guest RAM moves.
+//!
+//! # Why the bytes are the Store's bytes
+//!
+//! The copy is recorded at the Store, behind the draws that produced the frame,
+//! with the same `ALL_COMMANDS -> TRANSFER` barrier the synchronous rail
+//! records. Anything recorded later — a draw into the same resident, a clear —
+//! is later in queue order and cannot reach the staging buffer. The runtime
+//! additionally lands a pending Store before any later draw into its surface,
+//! so the registry bookkeeping a Store does at the end (`finish`'s epoch stamp,
+//! the sole-copy release) still describes the resident as it is.
+//!
+//! # Lifetime
+//!
+//! A prefetched slot is a readback lease, and teardown waits for every lease
+//! (`pools::teardown`) forever rather than unmap a live borrow. A prefetch held
+//! across tranches would therefore hang a teardown on the drain thread, so
+//! [`super::pools::ResourcePools::destroy_all`] drops every prefetch (returning
+//! its lease) before that wait. A Store that later finds its prefetch gone
+//! records a fresh copy, which on a torn-down device fails like any other
+//! readback of a resident that no longer exists.
+
+use super::pools::{self, BufferSlot, ReadbackLease};
+use super::{ReadbackTexel, TargetIdentity};
+
+/// How many Stores may have a submitted, unconsumed readback at once.
+///
+/// Each holds one full-surface staging slot out of the pool (24 MB for the
+/// phone's RGBA16F composite). Four covers a frame's Stores on every workload
+/// measured on the phone (one composite plus a few layers between two
+/// completion stamps); past it the runtime lands the oldest Store first.
+pub(crate) const MAX_IN_FLIGHT: usize = 4;
+
+/// Where a prefetched frame is until its Store consumes it.
+#[derive(Debug)]
+pub(crate) enum PrefetchStorage {
+    /// The staging slot itself, leased out of the pool. Returned on drop.
+    Lease(LeaseHold),
+    /// The slot could not be leased (uncached or unmappable readback memory),
+    /// so the copy was waited at the prefetch and copied out, exactly as the
+    /// synchronous rail would have. Correct, and no faster.
+    Bytes(Vec<u8>),
+}
+
+/// A readback lease that is returned when dropped unless taken.
+#[derive(Debug)]
+pub(crate) struct LeaseHold(Option<ReadbackLease>);
+
+impl LeaseHold {
+    pub(crate) fn new(lease: ReadbackLease) -> Self {
+        Self(Some(lease))
+    }
+
+    /// Hand the lease on; the taker owes its return from here.
+    pub(crate) fn take(&mut self) -> Option<ReadbackLease> {
+        self.0.take()
+    }
+}
+
+impl Drop for LeaseHold {
+    fn drop(&mut self) {
+        if let Some(lease) = self.0.take() {
+            pools::return_readback_lease(lease.token);
+        }
+    }
+}
+
+/// One submitted readback waiting for its Store.
+pub(crate) struct Prefetched {
+    pub identity: TargetIdentity,
+    /// Bytes the copy wrote: the resident's level 0 at its own texel width.
+    pub rb_size: u64,
+    pub texel: ReadbackTexel,
+    /// The resident's format, for the refusal a four-byte reader owes a wider
+    /// resident.
+    pub format: ash::vk::Format,
+    /// The slot the copy wrote, for the invalidate a non-coherent reader owes.
+    pub slot: BufferSlot,
+    pub storage: PrefetchStorage,
+    /// The completion-timeline point of the submission carrying the copy.
+    pub point: u64,
+}
+
+impl std::fmt::Debug for Prefetched {
+    // `BufferSlot` names raw handles and carries no `Debug`; the slot's size is
+    // the only part of it a log line can use.
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Prefetched")
+            .field("identity", &self.identity)
+            .field("rb_size", &self.rb_size)
+            .field("texel", &self.texel)
+            .field("slot_size", &self.slot.size)
+            .field("bytes", &self.is_bytes())
+            .field("point", &self.point)
+            .finish()
+    }
+}
+
+impl Prefetched {
+    pub(crate) fn is_bytes(&self) -> bool {
+        matches!(self.storage, PrefetchStorage::Bytes(_))
+    }
+
+    /// The timeline point this prefetch still waits for, `None` once its bytes
+    /// are already in host memory.
+    pub(crate) fn pending_point(&self) -> Option<u64> {
+        (!self.is_bytes()).then_some(self.point)
+    }
+}
+
+/// The prefetch for `identity`, removed from the pool, if there is one.
+pub(crate) fn take(list: &mut Vec<Prefetched>, identity: &TargetIdentity) -> Option<Prefetched> {
+    let index = list.iter().position(|p| &p.identity == identity)?;
+    Some(list.remove(index))
+}
+
+/// The oldest point among the prefetches still in flight, which is the point
+/// the drain wants to be woken at: the runtime lands in Store order.
+pub(crate) fn earliest_point(list: &[Prefetched]) -> Option<u64> {
+    earliest_of(list.iter().map(Prefetched::pending_point))
+}
+
+fn earliest_of(points: impl IntoIterator<Item = Option<u64>>) -> Option<u64> {
+    points.into_iter().flatten().min()
+}
+
+/// Whether the timeline has reached `point`. A bytes prefetch is complete.
+pub(crate) fn reached(counter: u64, p: &Prefetched) -> bool {
+    p.is_bytes() || counter >= p.point
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn slot(size: u64) -> BufferSlot {
+        BufferSlot {
+            buffer: ash::vk::Buffer::null(),
+            memory: ash::vk::DeviceMemory::null(),
+            size,
+            mapped: 0,
+            coherent: true,
+            cached: true,
+            backing: pools::BufferBacking::Dedicated,
+        }
+    }
+
+    fn identity(id: u32) -> TargetIdentity {
+        TargetIdentity::Surface {
+            id,
+            width: 4,
+            height: 2,
+            generation: 1,
+            format: ash::vk::Format::B8G8R8A8_UNORM,
+        }
+    }
+
+    fn bytes(id: u32, point: u64) -> Prefetched {
+        Prefetched {
+            identity: identity(id),
+            rb_size: 32,
+            texel: ReadbackTexel::Bgra8,
+            format: ash::vk::Format::B8G8R8A8_UNORM,
+            slot: slot(64),
+            storage: PrefetchStorage::Bytes(vec![0; 32]),
+            point,
+        }
+    }
+
+    #[test]
+    fn a_store_takes_only_the_prefetch_of_its_own_identity_and_only_once() {
+        let mut list = vec![bytes(1, 0), bytes(2, 0)];
+        assert!(take(&mut list, &identity(3)).is_none());
+        let two = take(&mut list, &identity(2)).expect("named");
+        assert_eq!(two.identity, identity(2));
+        assert!(take(&mut list, &identity(2)).is_none(), "consumed once");
+        assert_eq!(list.len(), 1);
+    }
+
+    /// The wake point is the oldest Store's, because the drain lands in Store
+    /// order and cannot use a later copy before an earlier one; a copied-out
+    /// prefetch is already complete and asks for no wake.
+    #[test]
+    fn the_wake_point_is_the_oldest_copy_still_in_flight() {
+        let list = vec![bytes(1, 0), bytes(2, 0)];
+        assert_eq!(earliest_point(&list), None, "bytes need no wake");
+        assert!(
+            reached(0, &list[0]),
+            "bytes are complete whatever the counter"
+        );
+        assert_eq!(earliest_of([Some(9), None, Some(4), Some(7)]), Some(4));
+        assert_eq!(earliest_of([None, None]), None);
+    }
+}
