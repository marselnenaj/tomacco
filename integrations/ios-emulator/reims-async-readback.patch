+    let red = [1.0, 1.0, 1.0, 1.0];
+    let green = [0.5, 0.5, 0.5, 1.0];
+    let (first_ref, second_ref) = (surface(4811), surface(4812));
+    match draw(&first_ref, red) {
+        Ok(()) => {}
+        Err(e) if skip_if_no_gpu(&e.to_string()) => {
+            eprintln!("SKIP prefetched store readback: {e}");
+            return;
+        }
+        Err(e) => panic!("reference draw: {e}"),
+    }
+    draw(&second_ref, green).expect("second reference draw");
+    let first = engine::read_target_texels(&first_ref)
+        .expect("first reference")
+        .pixels;
+    let second = engine::read_target_texels(&second_ref)
+        .expect("second reference")
+        .pixels;
+    assert_ne!(
+        first, second,
+        "the two blend constants must leave different frames"
+    );
+
+    for leased in [false, true] {
+        let identity = surface(if leased { 4814 } else { 4813 });
+        draw(&identity, red).expect("the Store's draw");
+        match engine::prefetch_target_readback(&identity).expect("prefetch") {
+            engine::ReadbackPrefetch::Submitted => {}
+            engine::ReadbackPrefetch::Declined(why) => {
+                panic!("a device with a completion timeline declined the prefetch: {why}")
+            }
+        }
+        assert_eq!(
+            engine::prefetch_target_readback(&identity).expect("second prefetch"),
+            engine::ReadbackPrefetch::Declined("already_prefetched"),
+            "one Store, one copy"
+        );
+        // The next frame into the same resident, recorded after the copy.
+        draw(&identity, green).expect("the later draw");
+        assert!(
+            engine::async_readback_ready(&identity).is_some(),
+            "the prefetch is held until a reader takes it"
+        );
+        let stored = if leased {
+            let frame = engine::read_target_leased(&identity)
+                .expect("leased read")
+                .expect("a cached host lends the prefetched slot");
+            assert!(frame.bgra, "a Surface resident reads back in scanout order");
+            frame.bytes().to_vec()
+        } else {
+            engine::read_target_texels(&identity)
+                .expect("copied read")
+                .pixels
+        };
+        assert_eq!(
+            stored, first,
+            "the Store's frame, not the later draw's (leased={leased})"
+        );
+        assert!(
+            engine::async_readback_ready(&identity).is_none(),
+            "consumed exactly once"
+        );
+        let now = engine::read_target_texels(&identity)
+            .expect("fresh read")
+            .pixels;
+        assert_eq!(
+            now, second,
+            "a reader after the Store reads the resident as drawn since"
+        );
+        assert!(
+            !engine::drop_async_readback(&identity),
+            "nothing left to drop"
+        );
+    }
+
+    // A prefetch nobody reads is dropped and its staging slot returned.
+    let identity = surface(4815);
+    draw(&identity, red).expect("draw");
+    assert_eq!(
+        engine::prefetch_target_readback(&identity).expect("prefetch"),
+        engine::ReadbackPrefetch::Submitted
+    );
+    assert!(
+        engine::arm_async_readback_wake(),
+        "a copy in flight can be waited for"
+    );
+    assert!(engine::drop_async_readback(&identity));
+    assert!(engine::async_readback_ready(&identity).is_none());
+}
