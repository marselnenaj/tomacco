+
+/// Record and submit `identity`'s full readback now, for a render Store whose
+/// guest writeback will run later (`runtime::async_store`).
+///
+/// Exactly the copy `read_target_texels_delivered` records — same barrier,
+/// same slot acquisition, appended to the open batch when one is recording —
+/// but not waited: the staging slot is kept as a lease and the submission's
+/// completion-timeline point is recorded beside it. The next readback of this
+/// identity through any of the target readers consumes it.
+///
+/// Declines rather than recording anything when this device has no
+/// completion timeline (nothing could wait the copy off the ring), when the
+/// identity already has a prefetch (the runtime lands a Store before its
+/// surface is drawn again, so this is a caller defect to refuse rather than
+/// a frame to overwrite), or when [`async_readback::MAX_IN_FLIGHT`] copies
+/// are already outstanding.
+pub fn prefetch_target_readback(identity: &TargetIdentity) -> Result<ReadbackPrefetch, DrawError> {
+    use crate::runtime::drain::{note_readback_phase, ReadbackPhase};
+    let mut guard = lock_engine();
+    let EngineState {
+        ref mut owner,
+        ref mut pools,
+        ref counters,
+        ..
+    } = &mut *guard;
+    let ctx = owner.ensure(counters)?;
+    unsafe { pools.ensure_init(ctx, counters)? };
+    let Some(completion) = ctx.stamp_completion.as_ref() else {
+        return Ok(ReadbackPrefetch::Declined("no_timeline"));
+    };
+    if pools
+        .async_readbacks
+        .iter()
+        .any(|p| &p.identity == identity)
+    {
+        return Ok(ReadbackPrefetch::Declined("already_prefetched"));
+    }
+    if pools.async_readbacks.len() >= async_readback::MAX_IN_FLIGHT {
+        return Ok(ReadbackPrefetch::Declined("in_flight_cap"));
+    }
+    let (snap, layout) = readback_snapshot(pools, identity)?;
+    let rb_size = target_readback_extent(snap.width, snap.height, layout.bytes_per_texel())?;
+    let read_access = pools::ResidentAccess::transfer_read(snap.guest_backing.is_some());
+    let texel = if layout.is_four_byte_color() {
+        ReadbackTexel::eight_bit(snap.bgra())
+    } else {
+        ReadbackTexel::Native(layout)
+    };
+    let ops = target_readback_ops();
+    let submit_started = std::time::Instant::now();
+    let SubmittedImageReadback {
+        fence,
+        readback,
+        mut lease,
+    } = unsafe {
+        submit_image_level0_readback(
+            ctx,
+            pools,
+            counters,
+            snap.image,
+            snap.layout,
+            read_access.layout(),
+            RESIDENT_READ_SRC_ACCESS,
+            snap.width,
+            snap.height,
+            rb_size,
+            ops,
+            ReadbackDelivery::Lease,
+            true,
+        )?
+    };
+    note_readback_phase(
+        ReadbackPhase::Submit,
+        submit_started.elapsed().as_micros() as u64,
+    );
+    // Both under the lock that recorded the copy, as the synchronous reader
+    // does after its wait: the tracked layout has to follow the barrier just
+    // recorded, before any later command records one of its own.
+    pools.registry_note_access(identity, read_access);
+    counters.note_target_read(rb_size, TargetReadDelivery::Host);
+    // This submission's own point: reservations happen only under the engine
+    // lock, in submission order, and nothing has reserved since.
+    let point = completion.reserved_point();
+    let storage = match lease.disarm() {
+        Some(held) if pools::slot_span_fits(rb_size, held.slot_size) => {
+            async_readback::PrefetchStorage::Lease(async_readback::LeaseHold::new(held))
+        }
+        // No lease to keep (uncached or unmapped readback memory), or one too
+        // small to lend: finish the readback the synchronous way now. The
+        // slot is owned by the ring entry the copy was sealed into and is only
+        // safe to read before that entry retires, which is now.
+        other => {
+            let mut guard_lease = ReadbackLeaseGuard::new(other);
+            let fence_started = std::time::Instant::now();
+            unsafe { pools.wait_entry_fence(ctx, counters, fence)? };
+            note_readback_phase(
+                ReadbackPhase::Fence,
+                fence_started.elapsed().as_micros() as u64,
+            );
+            let pixels = match unsafe {
+                deliver_completed_readback(ctx, &readback, &mut guard_lease, rb_size, ops)?
+            } {
+                ReadbackResult::Copied(pixels) => pixels,
+                ReadbackResult::Leased(lent) => lent.bytes().to_vec(),
+            };
+            crate::runtime::drain::note_store_route("async_readback_copied_at_prefetch");
+            async_readback::PrefetchStorage::Bytes(pixels)
+        }
+    };
+    pools.async_readbacks.push(async_readback::Prefetched {
+        identity: identity.clone(),
+        rb_size,
+        texel,
+        format: snap.format,
+        slot: readback,
+        storage,
+        point,
+    });
+    Ok(ReadbackPrefetch::Submitted)
+}
+
+/// Wait `prefetched`'s copy and hand its bytes on in the form `delivery` asks
+/// for. The wait is normally already over: the runtime lands a Store when its
+/// point has been reached, or when an ordering point forces it, which is the
+/// only case this blocks.
+unsafe fn complete_prefetched_readback(
+    ctx: &context::DeviceContext,
+    counters: &EngineCounters,
+    prefetched: async_readback::Prefetched,
+    delivery: ReadbackDelivery,
+) -> Result<ReadbackResult, DrawError> {
+    use crate::runtime::drain::{note_readback_phase, ReadbackPhase};
+    let async_readback::Prefetched {
+        rb_size,
+        slot,
+        storage,
+        point,
+        ..
+    } = prefetched;
+    let mut held = match storage {
+        async_readback::PrefetchStorage::Bytes(pixels) => {
+            return Ok(ReadbackResult::Copied(pixels));
+        }
+        async_readback::PrefetchStorage::Lease(held) => held,
+    };
+    let fence_started = std::time::Instant::now();
+    unsafe { wait_completion_point(ctx, counters, point)? };
+    let waited = fence_started.elapsed().as_micros() as u64;
+    note_readback_phase(ReadbackPhase::Fence, waited);
+    crate::runtime::drain::note_store_route_us("async_readback_consume_wait_us", waited);
+    let map_started = std::time::Instant::now();
+    unsafe { pools::invalidate_slot_for_read(ctx, &slot, target_readback_ops().invalidate)? };
+    let lease = held.take().expect("a held prefetch lease is taken once");
+    let out = match delivery {
+        ReadbackDelivery::Lease => ReadbackResult::Leased(ReadbackBufferLease {
+            token: lease.token,
+            ptr: lease.ptr,
+            len: rb_size as usize,
+        }),
+        ReadbackDelivery::Copy => {
+            // SAFETY: the slot is mapped for its lifetime, `fits` was checked
+            // when the lease was kept, and its copy has completed above.
+            let pixels =
+                unsafe { std::slice::from_raw_parts(lease.ptr as *const u8, rb_size as usize) }
+                    .to_vec();
+            pools::return_readback_lease(lease.token);
+            ReadbackResult::Copied(pixels)
+        }
+    };
+    note_readback_phase(ReadbackPhase::Map, map_started.elapsed().as_micros() as u64);
+    Ok(out)
+}
