 use crate::runtime::host::FakeHost;
 #[cfg(feature = "backend-vulkan")]
 use crate::runtime::mapper::{mapping_guest_write_verdict, GuestWriteVerdict};
+
+mod buffer_packed_read_contract {
+    use super::*;
+    use crate::protocol::endian::st32;
+    use crate::protocol::gva::{DIRECTORY_DEPTH, DIRECTORY_ROOT_PFN};
+
+    fn fixture(shift: u32) -> (DeviceState, FakeHost, BufferBacking, mapper::RectStride) {
+        let page = 1u64 << shift;
+        let mut host = FakeHost::new();
+        host.map_range(2 * page, page as usize, 0);
+        host.map_range(3 * page, page as usize, 0);
+        let mut directory = [0u8; 8];
+        st32(&mut directory[DIRECTORY_ROOT_PFN as usize..], 3);
+        st32(&mut directory[DIRECTORY_DEPTH as usize..], 1);
+        host.write_gpa(2 * page, &directory).unwrap();
+        for (index, pfn) in [(1u64, 16u32), (2, 48)] {
+            let mut pte = [0u8; 4];
+            st32(&mut pte, pfn);
+            host.write_gpa(3 * page + index * 4, &pte).unwrap();
+            host.map_range(u64::from(pfn) * page, page as usize, 0xa5);
+            host.write_gpa(
+                u64::from(pfn) * page + 4,
+                if index == 1 {
+                    &[1, 2, 3, 4, 5, 6, 7, 8]
+                } else {
+                    &[9, 10, 11, 12, 13, 14, 15, 16]
+                },
+            )
+            .unwrap();
+        }
+        let mut state = DeviceState::new(DeviceId(1), shift);
+        state.define_task(1, 0x1000, 2);
+        (
+            state,
+            host,
+            BufferBacking {
+                gva: page,
+                size: page + 12,
+            },
+            mapper::RectStride::new(page, 8, 2).unwrap(),
+        )
+    }
+
+    #[test]
+    fn buffer_packed_read_uses_fragmented_runs_with_explicit_page_geometry() {
+        for shift in [PAGE_SHIFT_X86, PAGE_SHIFT_ARM64E] {
+            let (mut state, mut host, backing, rect) = fixture(shift);
+            let bytes = read_buffer_bytes_resolved(
+                &mut state,
+                &mut host,
+                1,
+                7,
+                &backing,
+                4,
+                BufferReadExtent::Rows(rect),
+            )
+            .unwrap();
+            assert_eq!(bytes, (1..=16).collect::<Vec<u8>>(), "page shift {shift}");
+            assert_eq!(
+                host.map_pages_calls, 2,
+                "one import per disjoint physical run"
+            );
+            assert_eq!(host.unmap_pages_calls, 2);
+        }
+    }
+
+    #[test]
+    fn buffer_packed_read_does_not_fallback_after_guest_walk_or_ram_refusal() {
+        use crate::runtime::drain::store_route_count;
+        for shift in [PAGE_SHIFT_X86, PAGE_SHIFT_ARM64E] {
+            for missing in [false, true] {
+                let (mut state, mut host, backing, rect) = fixture(shift);
+                let page = 1u64 << shift;
+                if missing {
+                    host.write_gpa(3 * page + 8, &[0; 4]).unwrap();
+                } else {
+                    host.mark_non_ram(48 * page, page);
+                }
+                let before = store_route_count("draw_buffer_rect_cpu_fallback");
+                assert!(read_buffer_bytes_resolved(
+                    &mut state,
+                    &mut host,
+                    1,
+                    7,
+                    &backing,
+                    4,
+                    BufferReadExtent::Rows(rect)
+                )
+                .is_none());
+                assert_eq!(host.map_pages_calls, 0);
+                assert_eq!(store_route_count("draw_buffer_rect_cpu_fallback"), before);
+            }
+        }
+    }
+}
 
