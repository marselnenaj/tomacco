diff --git a/reims-vgpu/crates/reims-vgpu/src/runtime/draw/buffer_target.rs b/reims-vgpu/crates/reims-vgpu/src/runtime/draw/buffer_target.rs
new file mode 100644
--- /dev/null
+++ b/reims-vgpu/crates/reims-vgpu/src/runtime/draw/buffer_target.rs
@@ -0,0 +1,331 @@
+//! Colour attachments aliasing an explicitly retained buffer allocation.
+//!
+//! A buffer texture has no allocation of its own. Its serialized offset is
+//! relative to the referenced buffer, once, and its row pitch is mandatory.
+//! Keep both objects through the pass and publish Store before returning it:
+//! the ordinary deferred texture ledger does not name every buffer alias.
+
+use super::*;
+use std::sync::Arc;
+
+#[derive(Clone, Debug)]
+pub struct BufferTextureTarget {
+    descriptor: BufferTextureDescriptor,
+    texture: Arc<crate::model::TaskResource>,
+    parent: Arc<crate::model::TaskResource>,
+    gva: u64,
+    layout: pixel_format::TexelLayout,
+}
+
+impl PartialEq for BufferTextureTarget {
+    fn eq(&self, other: &Self) -> bool {
+        self.descriptor == other.descriptor
+            && Arc::ptr_eq(&self.texture, &other.texture)
+            && Arc::ptr_eq(&self.parent, &other.parent)
+            && self.gva == other.gva
+            && self.layout == other.layout
+    }
+}
+impl Eq for BufferTextureTarget {}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum BufferTargetDecline {
+    Rail,
+    Shape(crate::runtime::heap_query::TextureDescriptor),
+    Usage(u32),
+    Swizzle,
+    Subresource {
+        level: u32,
+        slice: u32,
+        depth_plane: u32,
+    },
+    Object {
+        object: u32,
+        why: objects::LadderRung,
+    },
+    Parent {
+        buffer: u32,
+        why: objects::BufferSpanRefusal,
+    },
+    Reference {
+        requested: u32,
+        declared: u32,
+    },
+    Format(u16),
+    Stride {
+        stride: u64,
+        tight: u32,
+    },
+    Footprint {
+        offset: u64,
+        stride: u64,
+        height: u32,
+        allocation: u64,
+    },
+    Address {
+        base: u64,
+        offset: u64,
+        span: u64,
+    },
+    Pages {
+        want: u64,
+        got: usize,
+    },
+    Allocation,
+    Load {
+        row: u32,
+    },
+    Samples(u32),
+    Clear(u16),
+    Recovery(u16),
+}
+
+impl crate::observe::Decline for BufferTargetDecline {
+    fn slug(&self) -> &'static str {
+        match self {
+            Self::Rail => "rt_buffer_texture_rail",
+            Self::Shape(_) => "rt_buffer_texture_shape",
+            Self::Usage(_) => "rt_buffer_texture_usage",
+            Self::Swizzle => "rt_buffer_texture_swizzle",
+            Self::Subresource { .. } => "rt_buffer_texture_subresource",
+            Self::Object { .. } => "rt_buffer_texture_object",
+            Self::Parent { .. } => "rt_buffer_texture_parent",
+            Self::Reference { .. } => "rt_buffer_texture_reference",
+            Self::Format(_) => "rt_buffer_texture_format",
+            Self::Stride { .. } => "rt_buffer_texture_stride",
+            Self::Footprint { .. } => "rt_buffer_texture_footprint",
+            Self::Address { .. } => "rt_buffer_texture_address",
+            Self::Pages { .. } => "rt_buffer_texture_pages",
+            Self::Allocation => "rt_buffer_texture_host_allocation",
+            Self::Load { .. } => "rt_buffer_texture_load",
+            Self::Samples(_) => "rt_buffer_texture_raster_samples",
+            Self::Clear(_) => "rt_buffer_texture_clear_representation",
+            Self::Recovery(_) => "rt_buffer_texture_recovery_unlicensed",
+        }
+    }
+
+    fn fields(&self) -> Vec<(&'static str, String)> {
+        // Every enum arm carries the decoded values at its own boundary.
+        vec![("detail", format!("{self:?}"))]
+    }
+}
+
+impl BufferTextureTarget {
+    pub(super) fn layout(&self) -> pixel_format::TexelLayout {
+        self.layout
+    }
+
+    pub(super) fn resolve<M: HostMemory + HostOps>(
+        state: &DeviceState,
+        host: &M,
+        task_id: u32,
+        base_ref: u32,
+        bt: BufferTextureDescriptor,
+        att: ColorAttachment,
+        level: u32,
+    ) -> Result<ResolvedRenderTarget, BufferTargetDecline> {
+        use BufferTargetDecline as D;
+        // The Vulkan Store below preserves native texels and publishes every
+        // MRT slot. The Metal copying rail has not established that contract.
+        if crate::backend::selected().rail() != crate::backend::Rail::Vulkan {
+            return Err(D::Rail);
+        }
+        let d = bt.desc;
+        if d.texture_type != 2
+            || d.width == 0
+            || d.height == 0
+            || d.depth != 1
+            || d.mipmap_level_count != 1
+            || d.sample_count != 1
+            || d.array_length != 1
+        {
+            return Err(D::Shape(d));
+        }
+        // Usage zero is the native descriptor's default, including RenderTarget.
+        // An explicit usage mask must actually declare that operation.
+        if d.usage != 0 && d.usage & 4 == 0 {
+            return Err(D::Usage(d.usage));
+        }
+        if d.swizzle.is_some_and(|raw| {
+            pixel_format::swizzle_plan(&raw)
+                .is_none_or(|plan| !pixel_format::swizzle_is_identity(&plan))
+        }) {
+            return Err(D::Swizzle);
+        }
+        if level != 0 || att.slice != 0 || att.depth_plane != 0 {
+            return Err(D::Subresource {
+                level,
+                slice: att.slice,
+                depth_plane: att.depth_plane,
+            });
+        }
+        if bt.new_texture_ref != base_ref {
+            return Err(D::Reference {
+                requested: base_ref,
+                declared: bt.new_texture_ref,
+            });
+        }
+        let layout = native_attachment_layout(d.pixel_format).ok_or(D::Format(d.pixel_format))?;
+        let tight = pixel_format::tight_row_bytes(d.width, d.pixel_format)
+            .ok_or(D::Format(d.pixel_format))?;
+        if bt.bytes_per_row < u64::from(tight) || bt.bytes_per_row > u64::from(u32::MAX) {
+            return Err(D::Stride {
+                stride: bt.bytes_per_row,
+                tight,
+            });
+        }
+        let texture =
+            objects::resolve_resource(state, host, task_id, base_ref).map_err(|why| D::Object {
+                object: base_ref,
+                why,
+            })?;
+        let parent =
+            objects::resolve_resource(state, host, task_id, bt.buffer_ref).map_err(|why| {
+                D::Object {
+                    object: bt.buffer_ref,
+                    why,
+                }
+            })?;
+        let (base, allocation) = objects::resolve_buffer_span_from_resource(state, &parent)
+            .map_err(|why| D::Parent {
+                buffer: bt.buffer_ref,
+                why,
+            })?;
+        // The existing Store capture/map rail authorizes the full padded image.
+        // Keep that whole footprint inside the parent even though row copies
+        // write only texels. No address or extent uses saturating arithmetic.
+        let span = bt
+            .bytes_per_row
+            .checked_mul(u64::from(d.height))
+            .filter(|span| {
+                bt.offset
+                    .checked_add(*span)
+                    .is_some_and(|end| end <= allocation)
+            })
+            .ok_or(D::Footprint {
+                offset: bt.offset,
+                stride: bt.bytes_per_row,
+                height: d.height,
+                allocation,
+            })?;
+        let gva = base
+            .checked_add(bt.offset)
+            .filter(|gva| *gva != 0 && gva.checked_add(span).is_some())
+            .ok_or(D::Address {
+                base,
+                offset: bt.offset,
+                span,
+            })?;
+        let target = Arc::new(Self {
+            descriptor: bt,
+            texture,
+            parent,
+            gva,
+            layout,
+        });
+        crate::runtime::drain::note_store_route("buffer_texture_rt_resolved");
+        Ok(ResolvedRenderTarget {
+            #[cfg(feature = "backend-vulkan")]
+            paired_xr: None,
+            buffer_texture: Some(target),
+            mapping_id: 0,
+            target_gva: gva,
+            width: d.width,
+            height: d.height,
+            row_stride: bt.bytes_per_row as u32,
+            format: d.pixel_format,
+            sample_count: 1,
+        })
+    }
+
+    /// The alias can overlap a debt under another texture name. Complete that
+    /// earlier content before this pass reads or replaces the shared bytes.
+    /// Once per render pass, never once per draw in the pass.
+    pub(crate) fn prepare<M: HostMemory + HostOps>(&self, state: &mut DeviceState, host: &mut M) {
+        crate::runtime::writeback_debt::pay_all(state, host);
+        crate::runtime::render_writeback::settle_guest_writes(
+            crate::runtime::render_writeback::SettleSite::LinearTextureSeed,
+        );
+    }
+
+    /// Read precisely the attachment's native texels. Address/ref pixel caches
+    /// cannot certify a buffer alias after a sibling buffer or texture write.
+    pub(super) fn seed<M: HostMemory + HostOps>(
+        &self,
+        state: &mut DeviceState,
+        host: &mut M,
+        task_id: u32,
+    ) -> Result<pixel_format::ColorLoadSeed, BufferTargetDecline> {
+        let d = self.descriptor.desc;
+        let (tight, len) = reims_vgpu_protocol::extent::tight_image_layout(
+            d.width,
+            d.height,
+            self.layout.bytes_per_texel(),
+        )
+        .ok_or(BufferTargetDecline::Allocation)?;
+        let mut pixels = Vec::new();
+        pixels
+            .try_reserve_exact(len)
+            .map_err(|_| BufferTargetDecline::Allocation)?;
+        pixels.resize(len, 0);
+        for (row, bytes) in pixels.chunks_exact_mut(tight as usize).enumerate() {
+            // The constructor checked the complete padded footprint.
+            let address = self.gva + row as u64 * self.descriptor.bytes_per_row;
+            if !crate::runtime::gva_view::read_span(state, host, task_id, address, bytes) {
+                return Err(BufferTargetDecline::Load { row: row as u32 });
+            }
+        }
+        Ok(pixel_format::ColorLoadSeed {
+            pixels: Arc::new(pixels),
+            layout: self.layout,
+        })
+    }
+
+    pub(crate) fn published(&self, state: &mut DeviceState, task_id: u32, view_ref: u32) {
+        let mut names = [
+            self.descriptor.buffer_ref,
+            self.descriptor.new_texture_ref,
+            view_ref,
+        ];
+        names.sort_unstable();
+        for (index, name) in names.into_iter().enumerate() {
+            if name != 0 && (index == 0 || names[index - 1] != name) {
+                state.buffer_write_gen.note_write(task_id, name);
+                state.invalidate_object_host_copies(task_id, name);
+            }
+        }
+        crate::runtime::surface_cache::evict_gva(state, self.gva);
+        crate::runtime::drain::note_store_route("buffer_texture_rt_published");
+    }
+
+    pub(crate) fn clear_is_exact(&self) -> bool {
+        // Wider float and packed/sRGB clear conversion still needs its own
+        // native CPU representation. Draw clears are performed by the GPU.
+        !pixel_format::is_srgb(self.descriptor.desc.pixel_format)
+            && matches!(
+                self.layout,
+                pixel_format::TexelLayout::Rgba8
+                    | pixel_format::TexelLayout::Bgra8
+                    | pixel_format::TexelLayout::R8
+                    | pixel_format::TexelLayout::R32Float
+                    | pixel_format::TexelLayout::Rg16Uint
+            )
+    }
+}
+
+fn native_attachment_layout(format: u16) -> Option<pixel_format::TexelLayout> {
+    #[cfg(feature = "backend-vulkan")]
+    {
+        let (attachment, _) =
+            crate::backend::vulkan::translate::pixel::color_attachment(format).ok()?;
+        let layout = crate::backend::vulkan::translate::pixel::texel_layout_of(attachment.vk)?;
+        // A codec-backed XR resident is not the buffer's byte representation.
+        (Some(layout.bytes_per_texel()) == pixel_format::render_target_bpp(format))
+            .then_some(layout)
+    }
+    #[cfg(not(feature = "backend-vulkan"))]
+    {
+        let _ = format;
+        None
+    }
+}
