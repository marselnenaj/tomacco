@@ -0,0 +1,91 @@
+//! Ordering between color-attachment writes and framebuffer input reads.
+//!
+//! `VK_EXT_rasterization_order_attachment_access` supplies the framebuffer-local
+//! dependency for previous fragments, including fragments of the same draw.
+//! It requires both the subpass and color-blend pipeline flags. Without its
+//! advertised and enabled color feature, the executor orders whole primitives
+//! with explicit barriers instead.
+//!
+//! Contract: <https://docs.vulkan.org/refpages/latest/refpages/source/VkPipelineColorBlendStateCreateFlagBits.html>
+
+use ash::vk;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum ColorInputOrdering {
+    #[default]
+    PrimitiveCommands,
+    RasterizationOrderExt,
+}
+
+impl ColorInputOrdering {
+    pub fn from_supported(extension_advertised: bool, color_access_supported: bool) -> Self {
+        if extension_advertised && color_access_supported {
+            Self::RasterizationOrderExt
+        } else {
+            Self::PrimitiveCommands
+        }
+    }
+
+    pub fn requires_primitive_commands(self) -> bool {
+        self == Self::PrimitiveCommands
+    }
+
+    pub fn subpass_flags(self, has_color_inputs: bool) -> vk::SubpassDescriptionFlags {
+        if has_color_inputs && self == Self::RasterizationOrderExt {
+            vk::SubpassDescriptionFlags::RASTERIZATION_ORDER_ATTACHMENT_COLOR_ACCESS_EXT
+        } else {
+            vk::SubpassDescriptionFlags::empty()
+        }
+    }
+
+    pub fn pipeline_flags(self, has_color_inputs: bool) -> vk::PipelineColorBlendStateCreateFlags {
+        if has_color_inputs && self == Self::RasterizationOrderExt {
+            vk::PipelineColorBlendStateCreateFlags::RASTERIZATION_ORDER_ATTACHMENT_ACCESS_EXT
+        } else {
+            vk::PipelineColorBlendStateCreateFlags::empty()
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn raster_order_requires_both_extension_and_color_feature() {
+        for extension in [false, true] {
+            for feature in [false, true] {
+                let ordering = ColorInputOrdering::from_supported(extension, feature);
+                assert_eq!(
+                    ordering.requires_primitive_commands(),
+                    !(extension && feature)
+                );
+            }
+        }
+        assert!(ColorInputOrdering::default().requires_primitive_commands());
+    }
+
+    #[test]
+    fn subpass_and_pipeline_flags_move_together_only_for_input_reads() {
+        for ordering in [
+            ColorInputOrdering::PrimitiveCommands,
+            ColorInputOrdering::RasterizationOrderExt,
+        ] {
+            for inputs in [false, true] {
+                let enabled = inputs && !ordering.requires_primitive_commands();
+                assert_eq!(
+                    ordering.subpass_flags(inputs).contains(
+                        vk::SubpassDescriptionFlags::RASTERIZATION_ORDER_ATTACHMENT_COLOR_ACCESS_EXT
+                    ),
+                    enabled
+                );
+                assert_eq!(
+                    ordering.pipeline_flags(inputs).contains(
+                        vk::PipelineColorBlendStateCreateFlags::RASTERIZATION_ORDER_ATTACHMENT_ACCESS_EXT
+                    ),
+                    enabled
+                );
+            }
+        }
+    }
+}
