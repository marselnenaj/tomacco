 /// Storage image Rgba8Unorm: each invocation writes solid red (known unorm result).
+/// A late optional-import refusal must execute once and return the actual
+/// image through host readback, without a guest DMA debt or a false Landed.
+#[test]
+fn compute_guest_import_refusal_uses_readback_without_dma_debt() {
+    use reims_vgpu::runtime::guest_ram::{GuestRamImport, GuestRamRegion, GuestRef};
+    use reims_vgpu::runtime::guest_ram_map::GuestWindowRun;
+    // Isolate the capability switch from every other test's global engine.
+    if reims_vgpu::config::read(reims_vgpu::config::GUEST_IMPORT).0
+        != reims_vgpu::config::Switch::Off
+    {
+        let output = Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "compute_guest_import_refusal_uses_readback_without_dma_debt",
+                "--test-threads=1",
+                "--nocapture",
+            ])
+            .env(reims_vgpu::config::GUEST_IMPORT, "off")
+            .output()
+            .expect("run copying capability in a separate process");
+        eprint!("{}", String::from_utf8_lossy(&output.stderr));
+        println!("{}", String::from_utf8_lossy(&output.stdout));
+        assert!(output.status.success(), "copying child failed");
+        return;
+    }
+    let _g = engine_test_session();
+    let Some(words) = assemble_spvasm(&storage_image_write_red_kernel("Rgba8"), "copy_fallback")
+    else {
+        return;
+    };
+    // Real owned memory. The disabled import must not touch it; retaining it
+    // through the engine reset also makes a mistaken import fail safely.
+    let mut memory = vec![0xa5u8; 8192];
+    let import = std::sync::Arc::new(
+        GuestRamImport::new(
+            GuestRamRegion {
+                gpa_base: 0x100000,
+                host_va: memory.as_mut_ptr() as u64,
+                len: memory.len() as u64,
+            },
+            4096,
+        )
+        .unwrap(),
+    );
+    let footprint = vec![import.gpa_base().unwrap()];
+    for resident in [false, true] {
+        engine::reset_draw_counters();
+        let slice = import.slice(0, 64).unwrap();
+        let identity = ComputeStorageResidencyKey {
+            mapping_id: 91,
+            map_generation: 1,
+            surface_offset: 0,
+            surface_bpr: 16,
+            span_end: 64,
+            width: 4,
+            height: 4,
+            pixel_format: 0x46,
+            texture_ref: 0,
+        };
+        let req = ComputeRequest {
+            spirv: words.clone(),
+            entry: "main".into(),
+            dispatch: engine::ComputeDispatch::Workgroups([4, 4, 1]),
+            storage_images: vec![ComputeStorageImageResource {
+                destination: engine::ComputeImageDestination::GuestPages {
+                    target: Box::new(engine::GuestPageTarget {
+                        runs: vec![GuestWindowRun {
+                            window_offset: 0,
+                            guest: GuestRef::new(import.clone(), slice).unwrap(),
+                        }],
+                        row_length_texels: 4,
+                        width: 4,
+                        height: 4,
+                        format: ash::vk::Format::R8G8B8A8_UNORM,
+                        shared_backing: None,
+                    }),
+                    pages: footprint.clone(),
+                },
+                binding: 0,
+                array_element: 0,
+                descriptor_count: 1,
+                format: StorageImageFormat::Rgba8Unorm,
+                width: 4,
+                height: 4,
+                bytes: vec![0; 64],
+                seed_skipped: false,
+                residency: resident.then_some(ComputeStorageResidency {
+                    identity,
+                    seed_generation: 1,
+                    output_generation: 2,
+                }),
+            }],
+            ..Default::default()
+        };
+        let Some(out) = engine_or_skip("copy fallback", &req) else {
+            return;
+        };
+        assert_eq!(out.images.len(), 1);
+        let engine::ComputeImageResult::Bytes(bytes) = &out.images[0] else {
+            panic!("an unimportable allocation cannot have received DMA");
+        };
+        assert_eq!(bytes, &[255, 0, 0, 255].repeat(16));
+        assert!(memory.iter().all(|&byte| byte == 0xa5));
+        assert!(!engine::guest_writes_outstanding());
+        let counters = engine::counter_snapshot();
+        assert_eq!(counters.dispatches, 1, "no replay after submission");
+        assert_eq!(counters.readback_compute_image_bytes, 64);
+        assert_eq!(counters.compute_post_wait_skips, 0, "CPU bytes owe a fence");
+    }
+    engine::test_reset_engine(engine_device());
+}
