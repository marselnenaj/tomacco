+impl GuestWriteDecline {
+    /// The optional direct-copy representation was unavailable before any
+    /// guest write was submitted. A host readback can preserve the work in
+    /// these cases; invalid bounds, ended lifetimes and device failures cannot
+    /// be repaired by changing the transfer route.
+    pub(crate) fn permits_host_readback(self) -> bool {
+        match self {
+            Self::Unsupported { .. } => true,
+            Self::Import { inner } => matches!(
+                inner,
+                HostRamDecline::Unsupported { .. }
+                    | HostRamDecline::BufferExcludesMemoryType { .. }
+                    | HostRamDecline::TooSmall { .. }
+                    | HostRamDecline::NoImportableMemoryType {
+                        refusal: ImportTypeRefusal::NoTypeMeetsRequest { .. },
+                        ..
+                    }
+                    | HostRamDecline::AllocateMemory {
+                        result: vk::Result::ERROR_INVALID_EXTERNAL_HANDLE,
+                    }
+                    | HostRamDecline::NoImportableMemoryType {
+                        refusal: ImportTypeRefusal::PointerDeclined {
+                            result: vk::Result::ERROR_INVALID_EXTERNAL_HANDLE,
+                        },
+                        ..
+                    }
+            ),
+            _ => false,
+        }
+    }
+}
