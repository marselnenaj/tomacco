+/// Execute the translator's aggregate-prefix load on actual Vulkan memory.
+/// Half values are treated as payload bits, so negative zero, infinity and NaN
+/// must survive without a numeric conversion or selection of the later half field.
+#[test]
+fn compute_aggregate_prefix_vector_load_preserves_memory_bits() {
+    let _g = engine_test_session();
+    let ll = r#"
+%Header = type { <4 x float>, <4 x half>, [8 x i8] }
+%Record = type { %Header, [32 x i8] }
+define void @main(ptr addrspace(1) %input, ptr addrspace(1) %output) {
+entry:
+  %record = alloca %Record, align 16
+  %head = getelementptr inbounds %Record, ptr %record, i64 0, i32 0, i32 0
+  %data = load <4 x float>, ptr addrspace(1) %input, align 16
+  store <4 x float> %data, ptr %head, align 16
+  %tail = getelementptr inbounds %Record, ptr %record, i64 0, i32 0, i32 1
+  store <4 x half> zeroinitializer, ptr %tail, align 8
+  %prefix = load <4 x half>, ptr %record, align 8
+  %bits = bitcast <4 x half> %prefix to <2 x i32>
+  store <2 x i32> %bits, ptr addrspace(1) %output, align 8
+  ret void
+}
+!air.kernel = !{!0}
+!0 = !{ptr @main, !1, !2}
+!1 = !{}
+!2 = !{!3, !4}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 1, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"float4", !"air.arg_name", !"input"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 8, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"uint2", !"air.arg_name", !"output"}
+"#;
+    let tmp = std::env::temp_dir().join(format!("reims_prefix_shader_{}", std::process::id()));
+    std::fs::create_dir_all(&tmp).expect("translator scratch");
+    let translated =
+        metal2vulkan::translate_sanitized_native(ll, metal2vulkan::passes::Stage::Kernel, &tmp);
+    std::fs::remove_dir_all(&tmp).expect("remove translator scratch");
+    let bytes = translated.expect("translate authored aggregate-prefix kernel");
+    let spirv = bytes
+        .as_chunks::<4>()
+        .0
+        .iter()
+        .map(|word| u32::from_le_bytes(*word))
+        .collect();
+    let input: Vec<u8> = [
+        0x3c00u16, 0x8000, 0x7c00, 0x7e55, 0x4000, 0x4200, 0x4400, 0x4500,
+    ]
+    .into_iter()
+    .flat_map(u16::to_le_bytes)
+    .collect();
+    let request = ComputeRequest {
+        spirv,
+        entry: "main".into(),
+        dispatch: engine::ComputeDispatch::Workgroups([1, 1, 1]),
+        storage_buffers: vec![
+            ComputeBufferResource {
+                binding: 0,
+                bytes: input.clone(),
+                writable: false,
+            },
+            ComputeBufferResource {
+                binding: 1,
+                bytes: vec![0xff; 8],
+                writable: true,
+            },
+        ],
+        sampled_images: vec![],
+        samplers: vec![],
+        storage_images: vec![],
+    };
+    let Some(output) = engine_or_skip("aggregate prefix memory", &request) else {
+        return;
+    };
+    let result = output
+        .buffers
+        .iter()
+        .find(|buffer| buffer.binding == 1)
+        .expect("output binding");
+    assert_eq!(
+        result.bytes,
+        input[..8],
+        "load must preserve exactly the aggregate's first eight bytes"
+    );
+}
