+/// Compute sampling must decode sRGB RGB channels once, preserve alpha, and
+/// preserve the guest's channel order. The expected values come from the sRGB
+/// transfer function, independent of the format admission table.
+#[test]
+fn compute_sampled_srgb_decodes_rgb_and_preserves_alpha() {
+    let _g = engine_test_session();
+    let Some(words) = assemble_spvasm(SAMPLED_IMAGE_FETCH_KERNEL, "sampled_srgb") else {
+        return;
+    };
+    for (format, bgra, srgb) in [
+        (StorageImageFormat::Rgba8Srgb, false, true),
+        (StorageImageFormat::Bgra8Srgb, true, true),
+        (StorageImageFormat::Rgba8Unorm, false, false),
+        (StorageImageFormat::Bgra8Unorm, true, false),
+    ] {
+        for rgba in [[128u8, 64, 32, 127], [0, 10, 11, 255], [255, 192, 128, 0]] {
+            let mut packed = rgba;
+            if bgra {
+                packed.swap(0, 2);
+            }
+            let request = ComputeRequest {
+                spirv: words.clone(),
+                entry: "main".into(),
+                dispatch: engine::ComputeDispatch::Workgroups([1, 1, 1]),
+                storage_buffers: vec![ComputeBufferResource {
+                    binding: 0,
+                    bytes: vec![0; 16],
+                    writable: true,
+                }],
+                sampled_images: vec![ComputeSampledImageResource {
+                    mip_levels: 1,
+                    binding: 32,
+                    array_element: 0,
+                    descriptor_count: 1,
+                    format,
+                    width: 1,
+                    height: 1,
+                    source: ComputeSampledSource::Bytes(packed.to_vec()),
+                }],
+                samplers: vec![],
+                storage_images: vec![],
+            };
+            let Some(output) = engine_or_skip("compute sRGB sampling", &request) else {
+                return;
+            };
+            assert!(output.images.is_empty());
+            assert_eq!(output.buffers[0].bytes.len(), 16);
+            for (channel, raw) in output.buffers[0].bytes.as_chunks::<4>().0.iter().enumerate() {
+                let actual = f32::from_le_bytes(*raw);
+                let encoded = f32::from(rgba[channel]) / 255.0;
+                let expected = if srgb && channel < 3 {
+                    if encoded <= 0.04045 {
+                        encoded / 12.92
+                    } else {
+                        ((encoded + 0.055) / 1.055).powf(2.4)
+                    }
+                } else {
+                    encoded
+                };
+                assert!(
+                    (actual - expected).abs() < 0.001,
+                    "{format:?} {rgba:?} channel {channel}: {actual} != {expected}"
+                );
+            }
+        }
+    }
+}
