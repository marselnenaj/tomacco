 /// A submission is executed from the buffers it was read with.
diff --git a/reims-vgpu/crates/reims-vgpu/src/runtime/draw/tests.rs b/reims-vgpu/crates/reims-vgpu/src/runtime/draw/tests.rs
--- a/reims-vgpu/crates/reims-vgpu/src/runtime/draw/tests.rs
+++ b/reims-vgpu/crates/reims-vgpu/src/runtime/draw/tests.rs
@@ -11,6 +11,216 @@
 use crate::runtime::host::FakeHost;
 #[cfg(feature = "backend-vulkan")]
 use crate::runtime::mapper::{mapping_guest_write_verdict, GuestWriteVerdict};
+
+#[cfg(feature = "backend-vulkan")]
+mod buffer_target_contract {
+    use super::super::buffer_target::{BufferTargetDecline as D, BufferTextureTarget};
+    use super::*;
+    use crate::runtime::decode::resource::{
+        ListObjectEntry, LINEAR_DESC_HANDLE, LINEAR_DESC_MIN_LEN, LINEAR_DESC_SIZE,
+        OBJECT_TYPE_BUFFER,
+    };
+    use std::sync::Arc;
+
+    fn fixture() -> (StoreRig, BufferTextureDescriptor) {
+        let mut rig = StoreRig::new(4);
+        let mut bytes = vec![0; LINEAR_DESC_MIN_LEN];
+        crate::protocol::endian::st64(&mut bytes[LINEAR_DESC_SIZE..], 40);
+        crate::protocol::endian::st64(&mut bytes[LINEAR_DESC_HANDLE..], 1);
+        let entry = ListObjectEntry {
+            object_type: OBJECT_TYPE_BUFFER,
+            descriptor_length: bytes.len() as u32,
+            descriptor_gva: 0x200,
+        };
+        write_task_gva_arm64e(&mut rig.host, &rig.state.tasks[1], 0x200, &bytes);
+        for (reference, resource) in [
+            (6, crate::model::TaskResource::new(entry, bytes.into())),
+            // The target owner receives an already decoded buffer-texture
+            // descriptor; this resource supplies its retained logical lifetime.
+            (
+                7,
+                crate::model::TaskResource::new(
+                    ListObjectEntry {
+                        object_type: OBJECT_TYPE_TEXTURE_VIEW,
+                        ..Default::default()
+                    },
+                    Arc::from([]),
+                ),
+            ),
+        ] {
+            let name = rig
+                .state
+                .declare_object(1, reference, reims_vgpu_core::lifecycle::Storage::NoBytes)
+                .unwrap()
+                .id;
+            rig.state
+                .task_resources
+                .register(1, name, Arc::new(resource));
+        }
+        let descriptor = BufferTextureDescriptor {
+            new_texture_ref: 7,
+            buffer_ref: 6,
+            offset: 8,
+            bytes_per_row: 16,
+            desc: crate::runtime::heap_query::TextureDescriptor {
+                texture_type: 2,
+                framebuffer_only: false,
+                is_drawable: false,
+                allow_gpu_optimized_contents: false,
+                usage: 0,
+                pixel_format: pixel_format::MTL_FORMAT_R32_FLOAT,
+                width: 2,
+                height: 2,
+                depth: 1,
+                mipmap_level_count: 1,
+                sample_count: 1,
+                array_length: 1,
+                resource_options: 0,
+                protection_options: 0,
+                swizzle: None,
+            },
+        };
+        (rig, descriptor)
+    }
+
+    fn resolve(
+        rig: &StoreRig,
+        descriptor: BufferTextureDescriptor,
+    ) -> Result<ResolvedRenderTarget, D> {
+        BufferTextureTarget::resolve(
+            &rig.state,
+            &rig.host,
+            1,
+            7,
+            descriptor,
+            clear_black_attachment(7),
+            0,
+        )
+    }
+
+    #[test]
+    fn buffer_target_checks_pitch_usage_shape_and_complete_parent_footprint() {
+        let (rig, descriptor) = fixture();
+        let target = resolve(&rig, descriptor).unwrap();
+        assert_eq!(
+            target.target_gva,
+            StoreRig::gva(1) + 8,
+            "apply buffer offset exactly once"
+        );
+        assert_eq!((target.row_stride, target.width, target.height), (16, 2, 2));
+        for pitch in [0, 7, u64::from(u32::MAX) + 1] {
+            assert!(matches!(
+                resolve(
+                    &rig,
+                    BufferTextureDescriptor {
+                        bytes_per_row: pitch,
+                        ..descriptor
+                    }
+                ),
+                Err(D::Stride { .. })
+            ));
+        }
+        for offset in [9, u64::MAX] {
+            assert!(matches!(
+                resolve(
+                    &rig,
+                    BufferTextureDescriptor {
+                        offset,
+                        ..descriptor
+                    }
+                ),
+                Err(D::Footprint { .. })
+            ));
+        }
+        let mut changed = descriptor;
+        changed.desc.usage = 1;
+        assert!(matches!(resolve(&rig, changed), Err(D::Usage(1))));
+        changed.desc.usage = 4;
+        assert!(resolve(&rig, changed).is_ok());
+        changed.desc.sample_count = 2;
+        assert!(matches!(resolve(&rig, changed), Err(D::Shape(_))));
+    }
+
+    #[test]
+    fn buffer_target_load_keeps_float_bits_skips_padding_and_observes_alias_writes() {
+        let (mut rig, descriptor) = fixture();
+        let target = resolve(&rig, descriptor).unwrap().buffer_texture.unwrap();
+        let raw = [
+            (-3.25f32).to_le_bytes(),
+            0x7fc12345u32.to_le_bytes(),
+            0x80000000u32.to_le_bytes(),
+            65537.0f32.to_le_bytes(),
+        ]
+        .concat();
+        let mut padded = vec![0xa5; 40];
+        padded[8..16].copy_from_slice(&raw[..8]);
+        padded[24..32].copy_from_slice(&raw[8..]);
+        write_task_gva_arm64e(
+            &mut rig.host,
+            &rig.state.tasks[1],
+            StoreRig::gva(1),
+            &padded,
+        );
+        let seed = target.seed(&mut rig.state, &mut rig.host, 1).unwrap();
+        assert_eq!(seed.layout, pixel_format::TexelLayout::R32Float);
+        assert_eq!(seed.pixels.as_slice(), raw);
+        write_task_gva_arm64e(
+            &mut rig.host,
+            &rig.state.tasks[1],
+            StoreRig::gva(1) + 24,
+            &7.125f32.to_le_bytes(),
+        );
+        let fresh = target.seed(&mut rig.state, &mut rig.host, 1).unwrap();
+        assert_eq!(&fresh.pixels[8..12], &7.125f32.to_le_bytes());
+        assert_eq!(&fresh.pixels[..8], &raw[..8]);
+    }
+
+    #[test]
+    fn buffer_target_retains_logical_parent_after_namespace_deletion() {
+        let (mut rig, descriptor) = fixture();
+        let parent = objects::resolve_resource(&rig.state, &rig.host, 1, 6).unwrap();
+        let weak = Arc::downgrade(&parent);
+        drop(parent);
+        let target = resolve(&rig, descriptor).unwrap();
+        assert!(rig.state.delete_object(1, 6));
+        assert!(
+            weak.upgrade().is_some(),
+            "the pass still owns the parent descriptor"
+        );
+        drop(target);
+        assert!(
+            weak.upgrade().is_none(),
+            "no unrelated owner may retain a deleted parent"
+        );
+    }
+
+    #[test]
+    fn buffer_target_publication_invalidates_parent_texture_and_outer_view() {
+        let (mut rig, descriptor) = fixture();
+        let target = resolve(&rig, descriptor).unwrap().buffer_texture.unwrap();
+        let before = [6, 7, 8].map(|reference| rig.state.buffer_write_gen.stamp(1, reference));
+        target.published(&mut rig.state, 1, 8);
+        for (reference, stamp) in [6, 7, 8].into_iter().zip(before) {
+            assert_ne!(rig.state.buffer_write_gen.stamp(1, reference), stamp);
+        }
+    }
+
+    #[test]
+    fn buffer_target_rejects_unqualified_wider_standalone_clear() {
+        let (rig, mut descriptor) = fixture();
+        assert!(resolve(&rig, descriptor)
+            .unwrap()
+            .buffer_texture
+            .unwrap()
+            .clear_is_exact());
+        descriptor.desc.pixel_format = pixel_format::MTL_FORMAT_RGBA16_FLOAT;
+        assert!(!resolve(&rig, descriptor)
+            .unwrap()
+            .buffer_texture
+            .unwrap()
+            .clear_is_exact());
+    }
+}
 
