+                        .map_or("-", |hint| hint.file_name.as_str())
+                )
+            },
+        )
+    };
+    let shaders = format!(
+        "vertex={} fragment={}",
+        describe(Some(vertex)),
+        describe(fragment)
+    );
+    let fresh = SEEN
+        .get_or_init(Default::default)
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .insert((pipeline_ref, shaders.clone()));
+    if fresh {
+        append_draw_line(
+            task_id,
+            &format!(
+                "t={} pipeline pipe={pipeline_ref} {shaders}\n",
