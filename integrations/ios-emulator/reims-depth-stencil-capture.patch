+/// Record the depth-stencil state a captured task's draw bound, as decoded,
+/// once per distinct (ref, state): a ref the guest deletes and reuses for
+/// another state is written again.
+pub(crate) fn note_depth_stencil(
+    task_id: u32,
+    ds_ref: u32,
+    ds: &crate::runtime::decode::resource::DepthStencilDescriptor,
+) {
+    static SEEN: OnceLock<Mutex<std::collections::HashSet<(u32, String)>>> = OnceLock::new();
+    if !wants(task_id) {
+        return;
+    }
+    let face = |f: &crate::runtime::decode::resource::DepthStencilFace| {
+        format!(
+            "cmp={} fail={} dfail={} pass={} read={:#x} write={:#x}",
+            f.compare_function,
+            f.stencil_failure_operation,
+            f.depth_failure_operation,
+            f.depth_stencil_pass_operation,
+            f.read_mask,
+            f.write_mask
+        )
+    };
+    let state = format!(
+        "depth_cmp={} depth_write={} front_en={} back_en={} front=[{}] back=[{}]",
+        ds.depth_compare_function,
+        ds.depth_write_enabled as u8,
+        ds.front_stencil_enabled as u8,
+        ds.back_stencil_enabled as u8,
+        face(&ds.front_face),
+        face(&ds.back_face)
+    );
+    let fresh = SEEN
+        .get_or_init(Default::default)
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .insert((ds_ref, state.clone()));
+    if fresh {
+        append_draw_line(
+            task_id,
+            &format!(
+                "t={} depth_stencil ds={ds_ref} {state}\n",
+                crate::observe::elapsed_us() / 1000
+            ),
+        );
+    }
+}
