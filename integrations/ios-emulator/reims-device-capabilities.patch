 use alloc::{sync::Arc, vec::Vec};
 
+/// Texture-write rounding requested by a pipeline. These are the ordinals
+/// used by the device-info key 41 mask and the render/compute descriptor tags.
+/// `Default` leaves conversion to the device; neither explicit mode is an
+/// alias for it. Shader arithmetic rounding is a separate contract.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u32)]
+pub enum TextureWriteRoundingMode {
+    Default = 0,
+    TowardZero = 1,
+    NearestEven = 2,
+}
+
+impl TextureWriteRoundingMode {
+    pub const fn from_ordinal(value: u32) -> Option<Self> {
+        match value {
+            0 => Some(Self::Default),
+            1 => Some(Self::TowardZero),
+            2 => Some(Self::NearestEven),
+            _ => None,
+        }
+    }
+
+    pub const fn capability_bit(self) -> u32 {
+        1 << self as u32
+    }
+}
