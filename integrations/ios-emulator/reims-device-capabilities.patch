+#[test]
+fn texture_rounding_advertisement_agrees_with_both_pipeline_decoders() {
+    use crate::model::DEVICE_INFO_TEXTURE_WRITE_ROUNDING_MODES;
+    for mode in [0, 1, 2, 3, 31, 32, u32::MAX] {
+        let render = render_pipeline_desc(
+            9,
+            &[
+                (PIPELINE_TAG_VERTEX_FUNC, 2),
+                (RENDER_PIPELINE_TAG_TEXTURE_WRITE_ROUNDING, mode),
+            ],
+        );
+        let mut compute = render_pipeline_desc(
+            10,
+            &[
+                (PIPELINE_TAG_KERNEL_FUNC, 3),
+                (COMPUTE_PIPELINE_TAG_TEXTURE_WRITE_ROUNDING, mode),
+            ],
+        );
+        st32(&mut compute, SERIALIZER_OBJECT_COMPUTE_PIPELINE);
+        let advertised = mode < 32 && DEVICE_INFO_TEXTURE_WRITE_ROUNDING_MODES & (1 << mode) != 0;
+        assert_eq!(
+            decode_render_pipeline_descriptor(&render).is_ok(),
+            advertised,
+            "render mode {mode}"
+        );
+        assert_eq!(
+            decode_compute_pipeline_descriptor(&compute).is_ok(),
+            advertised,
+            "compute mode {mode}"
+        );
+        let expected = match mode {
+            0 => continue,
+            1 | 2 => "res_pipeline_texture_rounding_unimplemented",
+            _ => "res_pipeline_texture_rounding_unknown",
+        };
+        assert_eq!(
+            decode_render_pipeline_descriptor(&render),
+            Err(DecodeStatus::ErrUnsupported(expected))
+        );
+        assert_eq!(
+            decode_compute_pipeline_descriptor(&compute),
+            Err(DecodeStatus::ErrUnsupported(expected))
+        );
+    }
+}
+
+#[test]
+fn explicit_default_texture_rounding_preserves_the_pipeline() {
+    let render_fields = [
+        (PIPELINE_TAG_VERTEX_FUNC, 2),
+        (PIPELINE_TAG_FRAGMENT_FUNC, 3),
+    ];
+    let baseline = render_pipeline_desc(9, &render_fields);
+    let mut explicit_fields = render_fields.to_vec();
+    explicit_fields.push((RENDER_PIPELINE_TAG_TEXTURE_WRITE_ROUNDING, 0));
+    let explicit = render_pipeline_desc(9, &explicit_fields);
+    let baseline = decode_render_pipeline_descriptor(&baseline).unwrap();
+    let mut explicit = decode_render_pipeline_descriptor(&explicit).unwrap();
+    assert_eq!(explicit.serialized_payload_len, baseline.serialized_payload_len + 6);
+    explicit.serialized_payload_len = baseline.serialized_payload_len;
+    assert_eq!(baseline, explicit);
+
+    let mut baseline = render_pipeline_desc(10, &[(PIPELINE_TAG_KERNEL_FUNC, 3)]);
+    let mut explicit = render_pipeline_desc(
+        10,
+        &[
+            (PIPELINE_TAG_KERNEL_FUNC, 3),
+            (COMPUTE_PIPELINE_TAG_TEXTURE_WRITE_ROUNDING, 0),
+        ],
+    );
+    st32(&mut baseline, SERIALIZER_OBJECT_COMPUTE_PIPELINE);
+    st32(&mut explicit, SERIALIZER_OBJECT_COMPUTE_PIPELINE);
+    assert_eq!(
+        decode_compute_pipeline_descriptor(&baseline).unwrap(),
+        decode_compute_pipeline_descriptor(&explicit).unwrap()
+    );
+}
