+#[cfg(test)]
+mod device_info_limits_tests {
+    use super::*;
+
+    /// The guest keeps its device-info reply for the whole boot and asks for it
+    /// before its first draw, so the reply has to come from the device even
+    /// when no draw has brought one up. Run alone, this test starts with no
+    /// device in the process, which is the boot's situation; in a full run an
+    /// earlier test may already have resolved one. Skips without a device.
+    #[test]
+    fn the_device_info_reply_is_the_devices_before_any_draw() {
+        let limits = device_info_limits();
+        let mut guard = lock_engine();
+        let EngineState {
+            ref mut owner,
+            ref counters,
+            ..
+        } = &mut *guard;
+        let Ok(ctx) = owner.ensure(counters) else {
+            eprintln!("skip: no Vulkan device");
+            return;
+        };
+        assert_eq!(limits.max_sample_count, ctx.features.max_sample_count);
+        assert_eq!(limits.d24_stencil8, ctx.features.d24_unorm_s8_attachment);
+        assert_eq!(
+            limits.max_threads_per_threadgroup,
+            ctx.features.max_compute_workgroup_size
+        );
+        assert_eq!(
+            limits.max_threadgroup_memory_bytes,
+            ctx.features.max_compute_shared_memory_bytes
+        );
+        assert_eq!(limits.native_fp16, ctx.features.float16);
+    }
+}
