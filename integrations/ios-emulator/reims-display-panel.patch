+#[test]
+fn display_panel_publishes_one_portrait_timing_and_both_physical_size_encodings() {
+    let mut host = FakeHost::new();
+    let gpa = 0x7a000000u64;
+    host.map_range(gpa, PAGE_SIZE_ARM64E as usize, 0);
+    let panel =
+        reims_vgpu_config::Panel::parse("1170x2532@60:65x141", MAX_SCANOUT_DIM, DISPLAY_REFRESH_HZ)
+            .unwrap();
+    fill_display_descriptor_for_panel(&mut host, gpa, 0, PAGE_SIZE_ARM64E, Some(panel));
+    let read16 = |host: &mut FakeHost, off: u64| {
+        let mut bytes = [0; 2];
+        host.read_gpa(gpa + off, &mut bytes).unwrap();
+        u16::from_le_bytes(bytes)
+    };
+    let read32 = |host: &mut FakeHost, off: u64| {
+        let mut bytes = [0; 4];
+        host.read_gpa(gpa + off, &mut bytes).unwrap();
+        u32::from_le_bytes(bytes)
+    };
+    assert_eq!(read16(&mut host, DISPLAY_DESC_TIMING_COUNT), 1);
+    assert_eq!(read16(&mut host, 0x210), 1170);
+    assert_eq!(read16(&mut host, 0x212), 2532);
+    assert_eq!(read32(&mut host, 0x214), 60 << 16);
+    assert_eq!(read16(&mut host, DISPLAY_DESC_WIDTH_MM), 65);
+    assert_eq!(read16(&mut host, DISPLAY_DESC_HEIGHT_MM), 141);
+    assert_eq!(
+        f32::from_bits(read32(&mut host, DISPLAY_DESC_WIDTH_MM_F32)),
+        65.0
+    );
+    assert_eq!(
+        f32::from_bits(read32(&mut host, DISPLAY_DESC_HEIGHT_MM_F32)),
+        141.0
+    );
+}
+
+#[test]
+fn display_panel_vbl_uses_the_selected_refresh_without_double_delivery() {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    for hz in [1, 30, 60, 120] {
+        let interval = 1_000_000 / hz;
+        let base = 10_000_000;
+        let last = AtomicU64::new(base);
+        assert!(!claim_display_vbl_interval(
+            &last,
+            base + interval - 1,
+            interval
+        ));
+        assert!(claim_display_vbl_interval(
+            &last,
+            base + interval + 500,
+            interval
+        ));
+        assert_eq!(last.load(Ordering::Relaxed), base + interval);
+        assert!(!claim_display_vbl_interval(
+            &last,
+            base + interval + 501,
+            interval
+        ));
+        assert!(claim_display_vbl_interval(
+            &last,
+            base + 2 * interval,
+            interval
+        ));
+        assert_eq!(last.load(Ordering::Relaxed), base + 2 * interval);
+    }
+}
