+/// A validated fixed panel. Private fields prevent a caller from bypassing the
+/// scanout/refresh limits or publishing a physical aspect unrelated to its pixels.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Panel {
+    pixels: (u16, u16),
+    millimetres: (u16, u16),
+    refresh_hz: u32,
+}
+
+impl Panel {
+    pub fn parse(raw: &str, max_dimension: u32, max_refresh: u32) -> Result<Self, &'static str> {
+        fn number(raw: &str) -> Result<u32, &'static str> {
+            if raw.is_empty() || raw.len() > 5 || !raw.bytes().all(|b| b.is_ascii_digit()) {
+                return Err("panel_number");
+            }
+            raw.parse().map_err(|_| "panel_number")
+        }
+        fn pair(raw: &str) -> Result<(u32, u32), &'static str> {
+            let (a, b) = raw.split_once('x').ok_or("panel_pair")?;
+            Ok((number(a)?, number(b)?))
+        }
+        let (timing, physical) = raw.split_once(':').ok_or("panel_syntax")?;
+        let (pixels, hz) = timing.split_once('@').ok_or("panel_syntax")?;
+        let (width, height) = pair(pixels)?;
+        let (width_mm, height_mm) = pair(physical)?;
+        let refresh_hz = number(hz)?;
+        let ceiling = max_dimension.min(u32::from(u16::MAX));
+        if !(64..=ceiling).contains(&width) || !(64..=ceiling).contains(&height) {
+            return Err("panel_scanout_extent");
+        }
+        if !(1..=max_refresh).contains(&refresh_hz) {
+            return Err("panel_refresh");
+        }
+        // EDID's integer centimetres must not become zero. The modern display
+        // protocol also publishes the same dimensions as floating-point mm.
+        if !(10..=2000).contains(&width_mm) || !(10..=2000).contains(&height_mm) {
+            return Err("panel_physical_extent");
+        }
+        // Each physical dimension may have been rounded to the nearest mm.
+        // Accept precisely that tolerance, not arbitrary stretched pixels.
+        let difference = (u64::from(width) * u64::from(height_mm))
+            .abs_diff(u64::from(height) * u64::from(width_mm));
+        if difference * 2 > u64::from(width) + u64::from(height) {
+            return Err("panel_physical_aspect");
+        }
+        Ok(Self {
+            pixels: (width as u16, height as u16),
+            millimetres: (width_mm as u16, height_mm as u16),
+            refresh_hz,
+        })
+    }
+
+    pub const fn pixels(self) -> (u16, u16) {
+        self.pixels
+    }
+    pub const fn millimetres(self) -> (u16, u16) {
+        self.millimetres
+    }
+    pub const fn refresh_hz(self) -> u32 {
+        self.refresh_hz
+    }
+}
