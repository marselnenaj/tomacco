+++ b/reims-vgpu/crates/reims-vgpu/src/runtime/decode/resource/tests.rs
@@ -3750,6 +3750,39 @@ fn a_dual_plane_descriptor_decodes_both_planes_and_the_shared_trailer() {
     );
 }
 
+/// A depth/stencil pair is the other dual-plane shape the guest sends: a
+/// `Depth32Float_Stencil8` texture is one allocation described as a depth
+/// plane and a stencil plane. The depth rail attaches it by identity -- a named
+/// depth attachment is `TargetIdentity::Texture { ref_, .. }` and no descriptor
+/// is read for it -- so no pass is lost to the shape, and the first-sight note
+/// must not say one is. It used to be the `dual_plane_texture_unexecutable`
+/// line, which told a log reader that a bind "refuses at the type gate": 38
+/// such lines in one iOS 27 boot, every one pf=0x104, none of them a refusal.
+#[test]
+fn a_depth_stencil_dual_plane_descriptor_is_noted_as_attached_not_refused() {
+    use crate::protocol::pixel_format::MTL_FORMAT_DEPTH32_FLOAT_STENCIL8;
+    let b = dual_plane_body([1, 1], (608, 224), MTL_FORMAT_DEPTH32_FLOAT_STENCIL8);
+    let cap = crate::observe::FailCapture::start();
+    let d = decode_dual_plane_texture_descriptor(&b).expect("a well-formed body decodes");
+    assert_eq!(d.pixel_format(), MTL_FORMAT_DEPTH32_FLOAT_STENCIL8);
+    let lines = cap.lines();
+    assert!(
+        !lines
+            .iter()
+            .any(|l| l.starts_with("dual_plane_texture_unexecutable")),
+        "a depth/stencil pair is bound by identity; nothing may call it unexecutable: {lines:?}"
+    );
+    let note = cap.one("dual_plane_depth_stencil_texture");
+    assert!(
+        note.contains("pf=0x104") && note.contains("plane0=608x224"),
+        "{note}"
+    );
+    assert!(
+        !note.contains("refuse"),
+        "the note must not read as a refusal: {note}"
+    );
+}
+
 /// A dual-plane texture names the one allocation its two planes share, and it
 /// is the same window a single-plane texture over that handle names.
 ///
