+                level.format,
+                &native[0],
+                &native[1],
+            )
+            .map_err(PlanarXrMemoRefusal::Upload)?;
+            let (_, bytes) = upload.into_parts();
+            let linear = Arc::new(bytes);
+            // One device-wide allocator serves all sampled producers, so a
+            // recycled or colliding key cannot claim an older image's bytes.
+            let generation = next_generation();
+            held.planar_xr_samples.insert(
+                mip_level,
+                PlanarXrSampleMemo {
+                    level,
+                    native,
+                    linear: Arc::clone(&linear),
+                    generation,
+                },
+            );
+            crate::runtime::drain::note_store_route("dual_xr_convert_new_n");
+            Ok((linear, generation))
+        })
