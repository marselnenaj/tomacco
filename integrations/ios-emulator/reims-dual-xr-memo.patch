+pub(crate) fn planar_xr_sample_bytes(
+    resource: &TaskResource,
+    mip_level: u32,
+    level: crate::runtime::decode::resource::PlanarXrLevel,
+    native: [Vec<u8>; 2],
+    next_generation: impl FnOnce() -> u64,
+) -> Result<(Arc<Vec<u8>>, u64), PlanarXrMemoRefusal> {
+    resource
+        .with_rail_state(|held: &mut ResidentTargets| {
+            if let Some(memo) = held.planar_xr_samples.get(&mip_level) {
+                if memo.level == level && memo.native == native {
+                    crate::runtime::drain::note_store_route("dual_xr_convert_reused_n");
