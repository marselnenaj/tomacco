+    Upload(reims_vgpu_vulkan::pixel::SampledUploadRefusal),
+    ForeignRail,
+}
+
+impl crate::observe::Decline for PlanarXrMemoRefusal {
+    fn slug(&self) -> &'static str {
+        match self {
+            Self::Upload(why) => why.slug(),
+            Self::ForeignRail => "dual_xr_memo_foreign_rail",
+        }
+    }
+}
