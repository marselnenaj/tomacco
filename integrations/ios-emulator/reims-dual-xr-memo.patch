+#[derive(Debug)]
+struct PlanarXrSampleMemo {
+    level: crate::runtime::decode::resource::PlanarXrLevel,
+    native: [Vec<u8>; 2],
+    linear: Arc<Vec<u8>>,
+    generation: u64,
+}
+
+#[derive(Debug)]
