+/// Merge tightly packed APV RGB/ARGB storage at the original paging boundary.
+/// Both planes must cover the same texels. The result carries linear colour
+/// and normalized alpha; sRGB has already been expanded before filtering.
+/// Host filtering support and guest-memory geometry belong to the caller.
+pub fn sampled_planar_xr_upload_bytes(
+    format: PlanarXrFormat,
+    rgb: &[u8],
+    alpha: &[u8],
+) -> Result<SampledUpload, SampledUploadRefusal> {
+    if rgb.len() != alpha.len() {
+        return Err(SampledUploadRefusal::PlanarPlaneSizeMismatch);
+    }
+    if !rgb.len().is_multiple_of(4) {
+        return Err(SampledUploadRefusal::IncompleteXrTexel);
+    }
+    let length = (rgb.len() / 4)
+        .checked_mul(16)
+        .ok_or(SampledUploadRefusal::ExpandedSizeOverflow)?;
+    let mut decoded = Vec::new();
+    decoded
+        .try_reserve_exact(length)
+        .map_err(|_| SampledUploadRefusal::AllocationFailed)?;
+    let colour = planar_colour_values(format);
+    static ALPHA: OnceLock<[f32; 256]> = OnceLock::new();
+    let alpha_values = ALPHA.get_or_init(|| {
+        std::array::from_fn(|code| {
+            // Metal normalized integer writes use intRTNE after saturation.
+            (paging_half_read(code as f32 / 255.0) * 255.0)
+                .round_ties_even()
+                .clamp(0.0, 255.0)
+                / 255.0
+        })
+    });
+    for (rgb, alpha) in rgb.chunks_exact(4).zip(alpha.chunks_exact(4)) {
+        let codes = format
+            .component_codes(rgb, alpha)
+            .ok_or(SampledUploadRefusal::IncompleteXrTexel)?;
+        for code in codes.rgb {
+            decoded.extend_from_slice(&colour[usize::from(code)].to_le_bytes());
+        }
+        decoded.extend_from_slice(&alpha_values[usize::from(codes.alpha)].to_le_bytes());
+    }
+    Ok(SampledUpload {
+        format: StorageImageFormat::Rgba32Float,
+        bytes: decoded,
     })
 }
 
