+    let (_, bytes) = upload.into_parts();
+    crate::runtime::drain::note_store_route("dual_xr_sample_n");
+    Ok(PlanarXrSample {
+        width,
+        height,
+        bytes,
+        byte_format: SampledByteFormat::linearized_from_source(
+            TexelLayout::Rgba32Float,
+            descriptor.pixel_format(),
+        ),
+    })
 }
 
