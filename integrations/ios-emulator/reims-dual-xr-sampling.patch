+/// The paging shader reads half values. Every nonzero value in the closed XR
+/// and alpha code tables is a normal binary16: the smallest magnitude is
+/// 1/(510*12.92), above 2^-14; the largest is below 2. Thus rounding the f32
+/// significand to ten fraction bits is exactly binary16 RNE here. This is not
+/// a general float-to-half conversion accepting arbitrary render output.
+fn paging_half_read(value: f32) -> f32 {
+    let bits = value.to_bits();
+    f32::from_bits((bits + 0xfff + ((bits >> 13) & 1)) & !0x1fff)
+}
