+fn planar_colour_values(format: PlanarXrFormat) -> &'static [f32; 1024] {
+    static LINEAR: OnceLock<[f32; 1024]> = OnceLock::new();
+    static SRGB: OnceLock<[f32; 1024]> = OnceLock::new();
+    let srgb = format.is_srgb();
+    let values = if srgb { srgb_values() } else { linear_values() };
+    let table = if srgb { &SRGB } else { &LINEAR };
+    table.get_or_init(|| {
+        values.map(|value| {
+            // Paging writes the half read into the native XR texture, which
+            // re-encodes and quantizes RGB before a later shader samples it.
+            let value = paging_half_read(value);
+            let encoded = if srgb {
+                let magnitude = value.abs();
+                let encoded = if magnitude <= 0.0031308 {
+                    magnitude * 12.92
+                } else {
+                    1.055 * magnitude.powf(1.0 / 2.4) - 0.055
+                };
+                encoded.copysign(value)
+            } else {
+                value
+            };
+            let code = encoded
+                .mul_add(510.0, 384.0)
+                .round_ties_even()
+                .clamp(0.0, 1023.0) as usize;
+            values[code]
+        })
+    })
+}
