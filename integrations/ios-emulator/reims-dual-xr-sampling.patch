+/// Read both pieces of one immutable XR construction descriptor. Each plane
+/// settles its own physical-page writeback debt before either read starts;
+/// each read touches only tight texel rows, including for padded allocations.
+/// The returned upload owns the merged bytes through ordinary sampled-image
+/// submission, so no borrowed guest pointer escapes the task walk.
+#[cfg(feature = "backend-vulkan")]
+pub(crate) fn load_planar_xr_sample<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    task_id: u32,
+    texture_ref: u32,
+    descriptor: &crate::runtime::decode::resource::DualPlaneTextureDescriptor,
+    native: NativeUploads,
+) -> Result<PlanarXrSample, LinearLoadRefusal> {
+    use LinearLoadRefusal as R;
+    let level = descriptor
+        .xr_level(0, state.page_shift)
+        .map_err(|why| R::PlanarXr { reason: why.slug() })?;
+    if level.planes.iter().any(|plane| plane.layout.planes() != 1) {
+        return Err(R::PlanarXr {
+            reason: "dual_xr_sample_non_2d",
+        });
+    }
+    if !native.float32 {
+        return Err(R::PlanarXr {
+            reason: "dual_xr_sample_float32_filter_unsupported",
+        });
+    }
+    let width = level.planes[0].layout.width;
+    let height = level.planes[0].layout.height;
+    let packed_len = u64::from(level.planes[0].tight_row)
+        .checked_mul(u64::from(height))
+        .and_then(host_alloc_len)
+        .ok_or(R::SizeOverflow)?;
+    // Reject an expanded upload that cannot be addressed before reading RAM.
+    u64::from(width)
+        .checked_mul(u64::from(height))
+        .and_then(|size| size.checked_mul(16))
+        .and_then(host_alloc_len)
+        .ok_or(R::SizeOverflow)?;
+    for plane in level.planes {
+        crate::runtime::writeback_debt::settle_for_texture(
+            state,
+            host,
+            task_id,
+            texture_ref,
+            plane.gva,
+            plane.touched_span,
+            crate::runtime::render_writeback::SettleSite::LinearTextureSampled,
+        );
+    }
+    let mut packed = [Vec::new(), Vec::new()];
+    for (index, (plane, bytes)) in level.planes.iter().zip(&mut packed).enumerate() {
+        bytes
+            .try_reserve_exact(packed_len)
+            .map_err(|_| R::PlanarXr {
+                reason: "dual_xr_sample_allocation_failed",
+            })?;
+        bytes.resize(packed_len, 0);
+        if plane.layout.row_stride == u64::from(plane.tight_row) {
+            gva_mem::read_task_gva_by_id(
+                host,
+                &state.tasks,
+                task_id,
+                plane.gva,
+                bytes,
+                state.page_shift,
+            )
+            .map_err(|_| R::PlanarRowUnreadable {
+                plane: index as u8,
+                row: 0,
+            })?;
+        } else {
+            let row_len = plane.tight_row as usize;
+            for row in 0..height {
