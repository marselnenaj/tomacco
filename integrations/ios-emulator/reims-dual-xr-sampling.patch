+                    .gva
+                    .checked_add(u64::from(row) * plane.layout.row_stride)
+                    .ok_or(R::SizeOverflow)?;
+                let offset = row as usize * row_len;
+                gva_mem::read_task_gva_by_id(
+                    host,
+                    &state.tasks,
+                    task_id,
+                    gva,
+                    &mut bytes[offset..offset + row_len],
+                    state.page_shift,
+                )
+                .map_err(|_| R::PlanarRowUnreadable {
+                    plane: index as u8,
+                    row,
+                })?;
+            }
+        }
+    }
+    let upload = reims_vgpu_vulkan::pixel::sampled_planar_xr_upload_bytes(
+        level.format,
+        &packed[0],
+        &packed[1],
+    )
