+    /// `REIMS_VGPU_LAZY_WRITEBACK=off` narrows a GVA Store to the eager copy
+    /// too, not only a surface Store.
+    ///
+    /// An iOS guest reads rendered icons with its CPU after completion and names
+    /// no resource first, so a frame held back from a plane's pages is a stale
+    /// read whichever ledger holds it. The plane here is one the lazy rail
+    /// defers, so the only thing that can refuse it is the switch.
+    #[cfg(feature = "backend-vulkan")]
+    #[test]
+    fn the_eager_switch_declines_a_gva_deferral_the_lazy_rail_takes() {
+        fn arm(lazy: bool) -> (bool, DeviceState) {
+            let mut state = DeviceState::new(crate::model::DeviceId::default(), 12);
+            let mut host = crate::runtime::FakeHost::new();
+            let debt = gva_debt(9);
+            let key = GvaResourceKey {
+                task_id: 3,
+                texture_ref: 12,
+            };
+            let span = u64::from(debt.row_stride) * u64::from(debt.height);
+            let pages: Vec<u64> = (0..span.div_ceil(state.page_size()))
+                .map(|i| 0x40_000 + i * state.page_size())
+                .collect();
+            let _ = state
+                .pending_writebacks
+                .ensure_gva_resource(key, debt.gva, span, Some(pages));
+            let c0 = crate::runtime::draw::ColorRtRequest {
+                texture_ref: key.texture_ref,
+                target_gva: debt.gva,
+                row_stride: debt.row_stride,
+                width: debt.width,
+                height: debt.height,
+                format: debt.format,
+                ..Default::default()
+            };
+            let armed = arm_gva_on(
+                lazy,
+                crate::backend::vulkan::VulkanBackend,
+                &mut state,
+                &mut host,
+                key.task_id,
+                &c0,
+                debt.window(),
+            );
+            (armed, state)
+        }
+
+        let (armed, state) = arm(true);
+        assert!(armed, "the lazy rail defers this plane");
+        assert_eq!(state.pending_writebacks.len(), 1);
+
+        let (armed, state) = arm(false);
+        assert!(!armed, "the eager switch lands the frame at its Store");
+        assert_eq!(
+            state.pending_writebacks.len(),
+            0,
+            "a declined deferral must leave no debt for the eager Store to fight with"
+        );
+    }
