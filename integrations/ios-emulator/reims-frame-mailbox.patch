+/// Optional path of the file this process publishes each changed present
+/// frame into, for a viewer that reads frames without the emulator's monitor
+/// (`runtime::frame_mailbox`). The launcher names a file in a directory private
+/// to its owner; the device creates it and refuses one that already exists.
+/// This affects only observation: unset, no frame leaves the device this way.
+pub const FRAME_MAILBOX: &str = "REIMS_VGPU_FRAME_MAILBOX";
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum FrameMailbox {
+    Unset,
+    File(std::path::PathBuf),
+    Refused(std::ffi::OsString),
+}
+
+/// What a [`FRAME_MAILBOX`] value names: an absolute path, nothing (unset or
+/// empty), or a refusal carrying the value.
+pub fn parse_frame_mailbox(value: Option<std::ffi::OsString>) -> FrameMailbox {
+    match value {
+        None => FrameMailbox::Unset,
+        Some(value) if value.is_empty() => FrameMailbox::Unset,
+        Some(value) => {
+            let path = std::path::PathBuf::from(&value);
+            if path.is_absolute() {
+                FrameMailbox::File(path)
+            } else {
+                FrameMailbox::Refused(value)
+            }
+        }
+    }
+}
+
+pub fn frame_mailbox() -> FrameMailbox {
+    parse_frame_mailbox(std::env::var_os(FRAME_MAILBOX))
+}
