+/// Whether the translated module declares a built-in, including a struct member
+/// or a decoration group. Malformed modules are not safe to subdivide into draws.
+pub(crate) fn declares_builtin(words: &[u32], builtin: u32) -> Option<bool> {
+    let decoded = instructions(words)?;
+    Some(decoded.iter().any(|instruction| {
+        let operands = &words[instruction.at + 1..instruction.at + instruction.word_count];
+        match instruction.opcode {
+            OP_DECORATE => operands.len() == 3 && operands[1] == 11 && operands[2] == builtin,
+            OP_MEMBER_DECORATE => {
+                operands.len() == 4 && operands[2] == 11 && operands[3] == builtin
+            }
+            _ => false,
+        }
+    }))
+}
