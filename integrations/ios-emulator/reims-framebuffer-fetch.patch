+// Test-owned GLSL, compiled locally; no captured shader or SPIR-V is embedded.
+// These native conformance cases require glslc and an executable Vulkan device.
+fn framebuffer_fetch_glsl(stage: &str, source: &str) -> Vec<u32> {
+    static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    let nonce = NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let path = std::env::temp_dir().join(format!("reims-fetch-{}-{nonce}", std::process::id()));
+    std::fs::create_dir(&path).expect("unique shader directory");
+    struct Cleanup(std::path::PathBuf);
+    impl Drop for Cleanup {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_dir_all(&self.0);
+        }
+    }
+    let _cleanup = Cleanup(path.clone());
+    let input = path.join("source.glsl");
+    let output = path.join("shader.spv");
+    std::fs::write(&input, source).unwrap();
+    let result = std::process::Command::new("glslc")
+        .args(["--target-env=vulkan1.2", &format!("-fshader-stage={stage}")])
+        .arg(&input)
+        .arg("-o")
+        .arg(&output)
+        .output()
+        .expect("glslc must be installed");
+    assert!(
+        result.status.success(),
+        "{}",
+        String::from_utf8_lossy(&result.stderr)
+    );
+    let bytes = std::fs::read(output).unwrap();
+    metal2vulkan::tools::spirv_val_bytes(&bytes, &path).expect("Vulkan 1.2 shader validation");
+    bytes
+        .as_chunks::<4>()
+        .0
+        .iter()
+        .map(|w| u32::from_le_bytes(*w))
+        .collect()
+}
