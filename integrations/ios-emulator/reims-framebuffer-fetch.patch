+        // Two identical triangles in instance 3, then two in instance 4.
+        let expected = (14.0f32 / 64.0).to_le_bytes().repeat(64);
+        assert_eq!(
+            engine::read_target(&identity).unwrap().pixels,
+            expected,
+            "indexed={indexed}"
+        );
+    }
+}
