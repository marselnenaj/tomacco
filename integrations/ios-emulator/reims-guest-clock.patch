+#[test]
+fn display_vbl_tracks_guest_time_across_pause_resume_and_slow_emulation() {
+    let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_ARM64E);
+    let mut host = FakeHost::new();
+    let last_us = std::sync::atomic::AtomicU64::new(0);
+    let gpa = 0x7c000000u64;
+    host.map_range(gpa, PAGE_SIZE_ARM64E as usize, 0);
+    host.put_u32(gpa + DISPLAY_SHARED_ENABLE_MASK, DISPLAY_VBL_EVENT_MASK);
+    state.display.shared_gpa = gpa;
+    state.display.online_acked = true;
+    let interval_ns = display_vbl_interval_us() * 1_000;
+    host.mono_ns = 5_000_000_000;
+    signal_display_vbl(&mut state, &mut host, &last_us);
+    assert_eq!(host.actions.len(), 1, "the guest clock starts the first VBL");
+    // Host polling continues during pause. It cannot advance the device clock.
+    for _ in 0..1_000 {
+        signal_display_vbl(&mut state, &mut host, &last_us);
+    }
+    assert_eq!(host.actions.len(), 1, "a paused VM receives no new VBL");
+    host.mono_ns += interval_ns - 1;
+    signal_display_vbl(&mut state, &mut host, &last_us);
+    assert_eq!(host.actions.len(), 1);
+    host.mono_ns += 1;
+    signal_display_vbl(&mut state, &mut host, &last_us);
+    assert_eq!(host.actions.len(), 2, "resume observes the full guest interval");
+    host.mono_ns += interval_ns * 100;
+    signal_display_vbl(&mut state, &mut host, &last_us);
+    for _ in 0..100 {
+        signal_display_vbl(&mut state, &mut host, &last_us);
+    }
+    assert_eq!(host.actions.len(), 3, "no catch-up burst after a long stall");
+    // Eight host polls per interval emulate a guest running at 1/8 host speed.
+    let base = host.mono_ns;
+    for n in 1..=80 {
+        host.mono_ns = base + interval_ns * n / 8;
+        signal_display_vbl(&mut state, &mut host, &last_us);
+    }
+    assert_eq!(host.actions.len(), 13, "ten guest intervals produce ten VBLs");
+}
