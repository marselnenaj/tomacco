@@ -0,0 +1,268 @@
+//! Whether guest RAM may reach this device as dma-bufs cut from the memfd
+//! behind each RAMBlock, and the largest piece the kernel will cut.
+//!
+//! # Why a second route
+//!
+//! [`super::host_pointer`] is the route every host shares, and on Linux
+//! `radv`/`amdgpu` takes it only for private anonymous memory: the kernel's
+//! userptr import refuses a mapping that has a file behind it. Guest RAM that
+//! a vhost-user device must also map is exactly such a mapping — a memfd mapped
+//! shared — so on that host every RAMBlock import fails at `vkAllocateMemory`
+//! with `ERROR_INVALID_EXTERNAL_HANDLE` while the pointer probe before it
+//! succeeds. Measured on an RX 6900 XT under Mesa 26.2.5: a 2 GiB private
+//! anonymous mapping imports; 2 GiB of shared anonymous memory, of a memfd
+//! mapped shared or private, and of a `/dev/shm` file are all refused.
+//!
+//! The same pages import fine as a dma-buf. `/dev/udmabuf` turns a range of a
+//! memfd sealed against shrinking into one, and the device imports that through
+//! `VK_EXT_external_memory_dma_buf`. The bytes are the guest's own pages, so
+//! the GPU and the guest see each other's writes with no copy.
+//!
+//! # A request, then a measurement
+//!
+//! [`crate::config::GUEST_IMPORT_DMA_BUF`] asks for the route; every check here
+//! can still refuse it, and a refusal only leaves the host-pointer route as it
+//! was. The kernel's `udmabuf.size_limit_mb` bounds one dma-buf (64 MiB unless
+//! an administrator raised it), so an armed route also narrows the import span
+//! the guest-RAM map cuts RAMBlocks into.
+
+use ash::vk;
+
+/// Whether the dma-buf route may run, and when not, which check said so.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum DmaBufImport {
+    /// Requested, both extensions advertised, the handle type importable for
+    /// guest-import usage, `/dev/udmabuf` opened and its size limit read. The
+    /// only rung on which the route runs.
+    Armed,
+    /// Nobody asked. The default, and the answer on every host whose guest
+    /// RAM is not laid on a memfd for this route.
+    #[default]
+    NotRequested,
+    /// Not a Linux build: there is no `/dev/udmabuf` to cut a dma-buf with.
+    NotLinux,
+    /// The host-pointer rail is not available, and the guest-RAM map that
+    /// both routes feed is gated on it.
+    NoImportRail,
+    /// `VK_KHR_external_memory_fd` or `VK_EXT_external_memory_dma_buf` absent.
+    NoDmaBufExtension,
+    /// Both extensions advertised, and the device still declines the dma-buf
+    /// handle type for guest-import usage.
+    NotImportable,
+    /// `/dev/udmabuf` did not open for reading and writing.
+    NoUdmabuf,
+    /// The kernel's per-buffer limit could not be read, or is smaller than one
+    /// import granule.
+    NoSizeLimit,
+}
+
+impl DmaBufImport {
+    pub fn is_armed(self) -> bool {
+        matches!(self, Self::Armed)
+    }
+
+    /// Stable slug for the capability line.
+    pub fn slug(self) -> &'static str {
+        match self {
+            Self::Armed => "armed",
+            Self::NotRequested => "not_requested",
+            Self::NotLinux => "not_linux",
+            Self::NoImportRail => "no_import_rail",
+            Self::NoDmaBufExtension => "no_dma_buf_extension",
+            Self::NotImportable => "not_importable",
+            Self::NoUdmabuf => "no_udmabuf",
+            Self::NoSizeLimit => "no_size_limit",
+        }
+    }
+
+    /// Device extensions the rung requires; none unless armed.
+    pub fn required_extensions(self) -> Vec<*const std::os::raw::c_char> {
+        if self.is_armed() {
+            vec![
+                vk::KHR_EXTERNAL_MEMORY_FD_NAME.as_ptr(),
+                vk::EXT_EXTERNAL_MEMORY_DMA_BUF_NAME.as_ptr(),
+            ]
+        } else {
+            Vec::new()
+        }
+    }
+}
+
+/// The rung together with the largest single dma-buf this route will cut.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct DmaBufCaps {
+    pub rung: DmaBufImport,
+    /// Bytes in the largest dma-buf `/dev/udmabuf` will make, rounded down to
+    /// the import granule. Zero unless armed.
+    pub window: u64,
+}
+
+impl DmaBufCaps {
+    fn refused(rung: DmaBufImport) -> Self {
+        Self { rung, window: 0 }
+    }
+
+    pub fn is_armed(self) -> bool {
+        self.rung.is_armed()
+    }
+
+    /// The import span the guest-RAM map may cut: the host-pointer span, or
+    /// the dma-buf window when the route is armed and that is smaller.
+    pub fn narrow_span(self, span_max: u64) -> u64 {
+        if self.is_armed() && self.window != 0 {
+            span_max.min(self.window)
+        } else {
+            span_max
+        }
+    }
+}
+
+/// `/sys/module/udmabuf/parameters/size_limit_mb` as bytes.
+pub const UDMABUF_SIZE_LIMIT: &str = "/sys/module/udmabuf/parameters/size_limit_mb";
+
+/// The window for a size limit of `limit_mb` megabytes at granule `align`:
+/// the limit rounded down to the granule, or `None` when nothing fits.
+pub fn window_for_limit(limit_mb: u64, align: u64) -> Option<u64> {
+    if align == 0 || !align.is_power_of_two() {
+        return None;
+    }
+    let bytes = limit_mb.checked_mul(1 << 20)? & !(align - 1);
+    (bytes != 0).then_some(bytes)
+}
+
+/// Parse the module parameter's text.
+pub fn parse_size_limit(text: &str) -> Option<u64> {
+    text.trim().parse().ok()
+}
+
+/// Resolve the route against one physical device.
+///
+/// `import_rail` is whether the host-pointer rail resolved to supported, and
+/// `align` its granule.
+///
+/// # Safety
+///
+/// `pd` must be a physical device belonging to `instance`.
+pub unsafe fn query(
+    instance: &ash::Instance,
+    pd: vk::PhysicalDevice,
+    has_extension: &dyn Fn(&std::ffi::CStr) -> bool,
+    import_rail: bool,
+    align: u64,
+) -> DmaBufCaps {
+    match crate::config::read(crate::config::GUEST_IMPORT_DMA_BUF) {
+        (crate::config::Switch::On, _) => {}
+        (crate::config::Switch::Unrecognized, value) => {
+            crate::observe::fail(format!(
+                "vk_guest_dma_buf_env_unrecognized var={} value={:?} (expected on|off; the route \
+                 stays off)",
+                crate::config::GUEST_IMPORT_DMA_BUF,
+                value.unwrap_or_default()
+            ));
+            return DmaBufCaps::refused(DmaBufImport::NotRequested);
+        }
+        _ => return DmaBufCaps::refused(DmaBufImport::NotRequested),
+    }
+    if !cfg!(target_os = "linux") {
+        return DmaBufCaps::refused(DmaBufImport::NotLinux);
+    }
+    if !import_rail {
+        return DmaBufCaps::refused(DmaBufImport::NoImportRail);
+    }
+    if !has_extension(vk::KHR_EXTERNAL_MEMORY_FD_NAME)
+        || !has_extension(vk::EXT_EXTERNAL_MEMORY_DMA_BUF_NAME)
+    {
+        return DmaBufCaps::refused(DmaBufImport::NoDmaBufExtension);
+    }
+    let info = vk::PhysicalDeviceExternalBufferInfo::default()
+        .usage(super::host_pointer::GUEST_IMPORT_USAGE)
+        .handle_type(vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT);
+    let mut props = vk::ExternalBufferProperties::default();
+    unsafe { instance.get_physical_device_external_buffer_properties(pd, &info, &mut props) };
+    if !props
+        .external_memory_properties
+        .external_memory_features
+        .contains(vk::ExternalMemoryFeatureFlags::IMPORTABLE)
+    {
+        return DmaBufCaps::refused(DmaBufImport::NotImportable);
+    }
+    if std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open("/dev/udmabuf")
+        .is_err()
+    {
+        return DmaBufCaps::refused(DmaBufImport::NoUdmabuf);
+    }
+    let Some(window) = std::fs::read_to_string(UDMABUF_SIZE_LIMIT)
+        .ok()
+        .as_deref()
+        .and_then(parse_size_limit)
+        .and_then(|mb| window_for_limit(mb, align))
+    else {
+        return DmaBufCaps::refused(DmaBufImport::NoSizeLimit);
+    };
+    DmaBufCaps {
+        rung: DmaBufImport::Armed,
+        window,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_the_armed_rung_names_extensions_or_narrows_the_span() {
+        for rung in [
+            DmaBufImport::Armed,
+            DmaBufImport::NotRequested,
+            DmaBufImport::NotLinux,
+            DmaBufImport::NoImportRail,
+            DmaBufImport::NoDmaBufExtension,
+            DmaBufImport::NotImportable,
+            DmaBufImport::NoUdmabuf,
+            DmaBufImport::NoSizeLimit,
+        ] {
+            let caps = DmaBufCaps {
+                rung,
+                window: 64 << 20,
+            };
+            let armed = rung == DmaBufImport::Armed;
+            assert_eq!(caps.is_armed(), armed, "{}", rung.slug());
+            assert_eq!(rung.required_extensions().len(), if armed { 2 } else { 0 });
+            assert_eq!(
+                caps.narrow_span(2 << 30),
+                if armed { 64 << 20 } else { 2 << 30 },
+                "{}",
+                rung.slug()
+            );
+        }
+        assert_eq!(DmaBufCaps::default().rung, DmaBufImport::NotRequested);
+    }
+
+    #[test]
+    fn an_armed_window_never_widens_a_smaller_span() {
+        let caps = DmaBufCaps {
+            rung: DmaBufImport::Armed,
+            window: 2 << 30,
+        };
+        assert_eq!(caps.narrow_span(64 << 20), 64 << 20);
+    }
+
+    #[test]
+    fn the_size_limit_becomes_a_granule_aligned_window() {
+        assert_eq!(parse_size_limit("64\n"), Some(64));
+        assert_eq!(parse_size_limit(" 2048 "), Some(2048));
+        assert_eq!(parse_size_limit("lots"), None);
+        assert_eq!(window_for_limit(64, 4096), Some(64 << 20));
+        assert_eq!(window_for_limit(2048, 4096), Some(2 << 30));
+        // A limit below one granule cuts nothing.
+        assert_eq!(window_for_limit(0, 4096), None);
+        assert_eq!(window_for_limit(1, 4 << 20), None);
+        // A granule that is not a power of two is not one.
+        assert_eq!(window_for_limit(64, 0), None);
+        assert_eq!(window_for_limit(64, 3000), None);
+        assert_eq!(window_for_limit(u64::MAX, 4096), None);
+    }
+}
