+/// Whether `import` goes through the dma-buf route: the route is armed and
+/// the import is a RAMBlock window rather than a packed task alias, whose
+/// mapping is the shim's own and has no memfd behind it.
+fn dma_buf_route(ctx: &super::context::DeviceContext, import: &GuestRamImport) -> bool {
+    cfg!(target_os = "linux") && ctx.caps.dma_buf.is_armed() && import.gpa_base().is_some()
+}
+
+/// Why a RAMBlock window did not import as a dma-buf. Each is logged once per
+/// window and the host-pointer route runs next.
+#[cfg(target_os = "linux")]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum DmaBufRefusal {
+    /// The fd entry points were not loaded, although the route is armed.
+    NoLoader,
+    /// No memfd, no seal, or no dma-buf; see the inner refusal.
+    Backing(super::guest_dma_buf::BackingRefusal),
+    FdProperties(vk::Result),
+    CreateBuffer(vk::Result),
+    TooSmall,
+    NoMemoryType {
+        fd_types: u32,
+        buffer_types: u32,
+    },
+    AllocateMemory(vk::Result),
+    BindBuffer(vk::Result),
+}
+
+#[cfg(target_os = "linux")]
+impl DmaBufRefusal {
+    fn describe(self) -> (&'static str, String) {
+        match self {
+            Self::NoLoader => ("dma_buf_no_loader", String::new()),
+            Self::Backing(inner) => (inner.slug(), inner.detail().to_string()),
+            Self::FdProperties(r) => ("dma_buf_fd_properties", format!("{r:?}")),
+            Self::CreateBuffer(r) => ("dma_buf_create_buffer", format!("{r:?}")),
+            Self::TooSmall => ("dma_buf_too_small", String::new()),
+            Self::NoMemoryType {
+                fd_types,
+                buffer_types,
+            } => (
+                "dma_buf_no_memory_type",
+                format!("fd_types={fd_types:#x},buffer_types={buffer_types:#x}"),
+            ),
+            Self::AllocateMemory(r) => ("dma_buf_allocate_memory", format!("{r:?}")),
+            Self::BindBuffer(r) => ("dma_buf_bind_buffer", format!("{r:?}")),
+        }
+    }
+}
+
+/// Import one RAMBlock window as a dma-buf cut from the memfd behind it.
+///
+/// The window's bytes are the guest's own pages, exactly as with a host
+/// pointer: the buffer spans the window and nothing past it, because the
+/// dma-buf is cut to the window's length.
+///
+/// # Safety
+///
+/// As [`HostRamImports::bind`].
+#[cfg(target_os = "linux")]
+unsafe fn import_dma_buf(
+    ctx: &super::context::DeviceContext,
+    import: &GuestRamImport,
+) -> Result<ImportedHostRam, DmaBufRefusal> {
+    use crate::backend::vulkan::caps::host_pointer::GUEST_IMPORT_USAGE;
+    use std::os::fd::{AsFd, FromRawFd, IntoRawFd, OwnedFd};
+    use std::time::Instant;
+    const HANDLE_TYPE: vk::ExternalMemoryHandleTypeFlags =
+        vk::ExternalMemoryHandleTypeFlags::DMA_BUF_EXT;
+
+    let loader = ctx
+        .external_memory_fd
+        .as_ref()
+        .ok_or(DmaBufRefusal::NoLoader)?;
+    let size = import.len();
+    let started = Instant::now();
+    let (memfd, offset) = super::guest_dma_buf::memfd_backing(import.host_base(), size)
+        .map_err(DmaBufRefusal::Backing)?;
+    let dma_buf = super::guest_dma_buf::udmabuf_create(memfd.as_fd(), offset, size)
+        .map_err(DmaBufRefusal::Backing)?;
+    let cut_us = started.elapsed().as_micros() as u64;
+
+    let mut fd_props = vk::MemoryFdPropertiesKHR::default();
+    unsafe {
+        loader.get_memory_fd_properties(
+            HANDLE_TYPE,
+            std::os::fd::AsRawFd::as_raw_fd(&dma_buf),
+            &mut fd_props,
+        )
+    }
+    .map_err(DmaBufRefusal::FdProperties)?;
+
+    let mut external = vk::ExternalMemoryBufferCreateInfo::default().handle_types(HANDLE_TYPE);
+    let create = vk::BufferCreateInfo::default()
+        .size(size)
+        .usage(GUEST_IMPORT_USAGE)
+        .sharing_mode(vk::SharingMode::EXCLUSIVE)
+        .push_next(&mut external);
+    let buffer =
+        unsafe { ctx.device.create_buffer(&create, None) }.map_err(DmaBufRefusal::CreateBuffer)?;
+
+    let alloc_started = Instant::now();
+    let bound = (|| {
+        let reqs = unsafe { ctx.device.get_buffer_memory_requirements(buffer) };
+        if reqs.size > size {
+            return Err(DmaBufRefusal::TooSmall);
+        }
+        let types = fd_props.memory_type_bits & reqs.memory_type_bits;
+        let req = ctx
+            .caps
+            .memory_request(crate::backend::vulkan::caps::MemoryClass::Upload);
+        let pick = crate::backend::vulkan::caps::memory_topology::select_memory_type(
+            &ctx.memory_properties,
+            types,
+            &req,
+            size,
+            ctx.caps.max_allocation_size,
+        )
+        .map_err(|_| DmaBufRefusal::NoMemoryType {
+            fd_types: fd_props.memory_type_bits,
+            buffer_types: reqs.memory_type_bits,
+        })?;
+        // Vulkan owns the descriptor once the import succeeds, and only then.
+        let raw = dma_buf.into_raw_fd();
+        let mut fd_import = vk::ImportMemoryFdInfoKHR::default()
+            .handle_type(HANDLE_TYPE)
+            .fd(raw);
+        let allocate = vk::MemoryAllocateInfo::default()
+            .allocation_size(size)
+            .memory_type_index(pick.index)
+            .push_next(&mut fd_import);
+        let memory = unsafe { ctx.device.allocate_memory(&allocate, None) }.map_err(|result| {
+            // SAFETY: the failed import did not take `raw`, so it is still ours.
+            drop(unsafe { OwnedFd::from_raw_fd(raw) });
+            DmaBufRefusal::AllocateMemory(result)
+        })?;
