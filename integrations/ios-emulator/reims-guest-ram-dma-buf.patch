+//! The memfd behind a guest-RAM mapping, and a dma-buf cut from it.
+//!
+//! The dma-buf route ([`crate::backend::vulkan::caps::dma_buf`]) needs a file
+//! descriptor and an offset where the host-pointer route needed only an
+//! address. The shim publishes addresses, so the descriptor is found from the
+//! address: `/proc/self/maps` names the file (device and inode) and the file
+//! offset of the mapping, and the one descriptor in `/proc/self/fd` with the
+//! same device and inode is the memfd. Reopening it through `/proc/self/fd`
+//! gives this module its own descriptor, so nothing here depends on the
+//! owner's descriptor staying open.
+//!
+//! `/dev/udmabuf` then cuts `offset..offset + len` of the memfd into a dma-buf.
+//! The kernel pins those pages for as long as the dma-buf lives, which is as
+//! long as the `VkDeviceMemory` that imported it; freeing the memory unpins.
+
+use std::collections::HashMap;
+use std::os::fd::{AsFd, AsRawFd, BorrowedFd, FromRawFd, OwnedFd};
+use std::sync::{Arc, Mutex, OnceLock};
+
+/// One line of `/proc/self/maps`, the fields this module reads.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct MapEntry {
+    pub start: usize,
+    pub end: usize,
+    pub offset: u64,
+    pub dev_major: u32,
+    pub dev_minor: u32,
+    pub inode: u64,
+}
+
+fn parse_line(line: &str) -> Option<MapEntry> {
+    let mut fields = line.split_ascii_whitespace();
+    let (start, end) = fields.next()?.split_once('-')?;
+    let _perms = fields.next()?;
+    let offset = fields.next()?;
+    let (major, minor) = fields.next()?.split_once(':')?;
+    let inode = fields.next()?;
+    Some(MapEntry {
+        start: usize::from_str_radix(start, 16).ok()?,
+        end: usize::from_str_radix(end, 16).ok()?,
+        offset: u64::from_str_radix(offset, 16).ok()?,
+        dev_major: u32::from_str_radix(major, 16).ok()?,
+        dev_minor: u32::from_str_radix(minor, 16).ok()?,
+        inode: inode.parse().ok()?,
+    })
+}
+
+/// Where `addr..addr + len` lives: the file and the file offset of `addr`.
+///
+/// The span may cross several lines when the kernel split one mapping into
+/// several areas (a `madvise` over part of it does), but only while the lines
+/// abut in both the address space and the file. `None` when any byte of the
+/// span is unmapped, anonymous, or in a different file.
+pub(crate) fn find_backing(maps: &str, addr: usize, len: u64) -> Option<(MapEntry, u64)> {
+    let len = usize::try_from(len).ok()?;
+    let end = addr.checked_add(len)?;
+    if len == 0 {
+        return None;
+    }
+    let mut lines = maps.lines().filter_map(parse_line);
+    let first = lines.find(|e| e.start <= addr && addr < e.end)?;
+    if first.inode == 0 {
+        return None;
+    }
+    let file_offset = first.offset.checked_add((addr - first.start) as u64)?;
+    let mut covered = first;
+    while covered.end < end {
+        let next = lines.next()?;
+        let continues = next.start == covered.end
+            && next.inode == first.inode
+            && (next.dev_major, next.dev_minor) == (first.dev_major, first.dev_minor)
+            && next.offset
+                == covered
+                    .offset
+                    .checked_add((covered.end - covered.start) as u64)?;
+        if !continues {
+            return None;
+        }
+        covered = next;
+    }
+    Some((first, file_offset))
+}
+
+/// Why no dma-buf could be cut for a span.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum BackingRefusal {
+    /// `/proc/self/maps` could not be read.
+    MapsUnreadable,
+    /// Some byte of the span is unmapped, anonymous, or in another file.
+    NotOneFile,
+    /// No open descriptor names the mapping's file.
+    NoDescriptor,
+    /// The file is not a memfd sealed against shrinking (or it is sealed
+    /// against writing), which `/dev/udmabuf` requires.
+    NotSealed { seals: i32 },
+    /// `/dev/udmabuf` did not open.
+    NoUdmabuf { errno: i32 },
+    /// `UDMABUF_CREATE` failed.
+    Create { errno: i32 },
+}
+
+impl BackingRefusal {
+    pub(crate) fn slug(self) -> &'static str {
+        match self {
+            Self::MapsUnreadable => "dma_buf_maps_unreadable",
+            Self::NotOneFile => "dma_buf_not_one_file",
+            Self::NoDescriptor => "dma_buf_no_descriptor",
+            Self::NotSealed { .. } => "dma_buf_not_sealed",
+            Self::NoUdmabuf { .. } => "dma_buf_no_udmabuf",
+            Self::Create { .. } => "dma_buf_create",
+        }
+    }
+
+    pub(crate) fn detail(self) -> i32 {
+        match self {
+            Self::NotSealed { seals } => seals,
+            Self::NoUdmabuf { errno } | Self::Create { errno } => errno,
+            _ => 0,
+        }
+    }
+}
+
+/// Whether `seals` are what `/dev/udmabuf` accepts.
+pub(crate) fn seals_admit_udmabuf(seals: i32) -> bool {
+    seals & libc::F_SEAL_SHRINK != 0 && seals & libc::F_SEAL_WRITE == 0
+}
+
+type Key = (u32, u32, u64);
+
+/// Descriptors already found, by file. A RAMBlock is cut into many imports
+/// and every one of them names the same memfd.
+fn found() -> &'static Mutex<HashMap<Key, Arc<OwnedFd>>> {
+    static FOUND: OnceLock<Mutex<HashMap<Key, Arc<OwnedFd>>>> = OnceLock::new();
+    FOUND.get_or_init(Default::default)
+}
+
+fn descriptor_for(entry: &MapEntry) -> Result<Arc<OwnedFd>, BackingRefusal> {
+    use std::os::unix::fs::MetadataExt;
+    let key = (entry.dev_major, entry.dev_minor, entry.inode);
+    let mut found = found().lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(fd) = found.get(&key) {
+        return Ok(fd.clone());
+    }
+    let dir = std::fs::read_dir("/proc/self/fd").map_err(|_| BackingRefusal::NoDescriptor)?;
+    for item in dir.flatten() {
+        let path = item.path();
+        let Ok(meta) = std::fs::metadata(&path) else {
+            continue;
+        };
+        let dev = meta.dev();
+        if meta.ino() != entry.inode
+            || (libc::major(dev), libc::minor(dev)) != (entry.dev_major, entry.dev_minor)
+        {
+            continue;
+        }
+        let Ok(file) = std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(&path)
+        else {
+            continue;
+        };
+        let fd = Arc::new(OwnedFd::from(file));
+        found.insert(key, fd.clone());
+        return Ok(fd);
+    }
+    Err(BackingRefusal::NoDescriptor)
+}
+
+/// The memfd behind `addr..addr + len` and the file offset of `addr`.
+pub(crate) fn memfd_backing(addr: usize, len: u64) -> Result<(Arc<OwnedFd>, u64), BackingRefusal> {
+    let maps =
+        std::fs::read_to_string("/proc/self/maps").map_err(|_| BackingRefusal::MapsUnreadable)?;
+    let (entry, offset) = find_backing(&maps, addr, len).ok_or(BackingRefusal::NotOneFile)?;
+    let fd = descriptor_for(&entry)?;
+    // SAFETY: `fd` is an open descriptor this module owns.
+    let seals = unsafe { libc::fcntl(fd.as_raw_fd(), libc::F_GET_SEALS) };
+    if seals < 0 || !seals_admit_udmabuf(seals) {
+        return Err(BackingRefusal::NotSealed { seals });
+    }
+    Ok((fd, offset))
+}
+
+/// `struct udmabuf_create` from `<linux/udmabuf.h>`.
+#[repr(C)]
+struct UdmabufCreate {
+    memfd: u32,
+    flags: u32,
+    offset: u64,
+    size: u64,
+}
+
+const UDMABUF_FLAGS_CLOEXEC: u32 = 0x01;
+/// `_IOW('u', 0x42, struct udmabuf_create)`.
+const UDMABUF_CREATE: libc::c_ulong = (1 << 30)
+    | ((std::mem::size_of::<UdmabufCreate>() as libc::c_ulong) << 16)
+    | ((b'u' as libc::c_ulong) << 8)
+    | 0x42;
+
+fn udmabuf_device() -> Result<&'static OwnedFd, BackingRefusal> {
+    static DEVICE: OnceLock<Result<OwnedFd, i32>> = OnceLock::new();
+    DEVICE
+        .get_or_init(|| {
+            std::fs::OpenOptions::new()
+                .read(true)
+                .write(true)
+                .open("/dev/udmabuf")
+                .map(OwnedFd::from)
+                .map_err(|e| e.raw_os_error().unwrap_or(0))
+        })
+        .as_ref()
+        .map_err(|&errno| BackingRefusal::NoUdmabuf { errno })
+}
+
+/// Cut `offset..offset + size` of `memfd` into a dma-buf.
+pub(crate) fn udmabuf_create(
+    memfd: BorrowedFd<'_>,
+    offset: u64,
+    size: u64,
+) -> Result<OwnedFd, BackingRefusal> {
+    let device = udmabuf_device()?;
+    let request = UdmabufCreate {
+        memfd: memfd.as_raw_fd() as u32,
+        flags: UDMABUF_FLAGS_CLOEXEC,
+        offset,
+        size,
+    };
+    // SAFETY: `request` is a correctly laid out `struct udmabuf_create` that
+    // outlives the call, and both descriptors are open.
+    let rc = unsafe { libc::ioctl(device.as_fd().as_raw_fd(), UDMABUF_CREATE as _, &request) };
+    if rc < 0 {
+        return Err(BackingRefusal::Create {
+            errno: std::io::Error::last_os_error().raw_os_error().unwrap_or(0),
+        });
+    }
+    // SAFETY: a successful `UDMABUF_CREATE` returns a new descriptor we own.
+    Ok(unsafe { OwnedFd::from_raw_fd(rc) })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MAPS: &str = "\
+55d0c0a00000-55d0c0a21000 r--p 00000000 103:02 1311 /usr/bin/qemu
+7f0000000000-7f0040000000 rw-s 00000000 00:01 4242 /memfd:tomacco-guest-memory (deleted)
+7f0040000000-7f0080000000 rw-s 40000000 00:01 4242 /memfd:tomacco-guest-memory (deleted)
+7f0080000000-7f0080200000 rw-p 00000000 00:00 0
+7f0080200000-7f0080400000 rw-s 00000000 00:01 77 /memfd:other (deleted)
+";
+
+    #[test]
+    fn the_unsplit_ioctl_number_matches_the_kernel_header() {
+        assert_eq!(UDMABUF_CREATE, 0x4018_7542);
+        assert_eq!(std::mem::size_of::<UdmabufCreate>(), 24);
+    }
+
+    #[test]
+    fn a_span_inside_one_area_names_its_file_offset() {
+        let (entry, offset) = find_backing(MAPS, 0x7f00_1000_0000, 64 << 20).expect("mapped");
+        assert_eq!(entry.inode, 4242);
+        assert_eq!((entry.dev_major, entry.dev_minor), (0, 1));
+        assert_eq!(offset, 0x1000_0000);
+        // In the second area, the offset is that area's file offset plus the
+        // distance into it.
+        let (_, offset) = find_backing(MAPS, 0x7f00_5000_0000, 4096).expect("mapped");
+        assert_eq!(offset, 0x5000_0000);
+    }
+
+    #[test]
+    fn a_span_may_cross_areas_only_where_they_continue_one_file() {
+        let (entry, offset) =
+            find_backing(MAPS, 0x7f00_3000_0000, 0x2000_0000).expect("continues the file");
+        assert_eq!((entry.inode, offset), (4242, 0x3000_0000));
+        // Into the anonymous area that follows: refused.
+        assert_eq!(find_backing(MAPS, 0x7f00_7000_0000, 0x2000_0000), None);
+        // Past the anonymous area into another file: refused.
+        assert_eq!(find_backing(MAPS, 0x7f00_8000_0000, 0x40_0000), None);
+    }
+
+    #[test]
+    fn anonymous_unmapped_and_empty_spans_have_no_backing() {
+        assert_eq!(find_backing(MAPS, 0x7f00_8000_0000, 4096), None);
+        assert_eq!(find_backing(MAPS, 0x1000, 4096), None);
+        assert_eq!(find_backing(MAPS, 0x7f00_0000_0000, 0), None);
+        assert_eq!(find_backing(MAPS, usize::MAX - 10, 4096), None);
+        assert_eq!(find_backing("garbage line\n", 0x1000, 1), None);
+    }
+
+    #[test]
+    fn udmabuf_needs_a_shrink_seal_and_no_write_seal() {
+        assert!(seals_admit_udmabuf(
+            libc::F_SEAL_SHRINK | libc::F_SEAL_GROW | libc::F_SEAL_SEAL
+        ));
+        assert!(!seals_admit_udmabuf(libc::F_SEAL_SEAL));
+        assert!(!seals_admit_udmabuf(
+            libc::F_SEAL_SHRINK | libc::F_SEAL_WRITE
+        ));
+    }
+
+    /// The whole walk on a real sealed memfd mapped shared, as a launcher lays
+    /// guest RAM: the descriptor is found from the address alone, and an
+    /// unsealed memfd is refused by name.
+    #[test]
+    fn a_sealed_memfd_mapping_is_found_from_its_address() {
+        unsafe fn map(sealed: bool) -> (OwnedFd, *mut libc::c_void, usize) {
+            let len = 4 << 20;
+            let flags = libc::MFD_CLOEXEC | if sealed { libc::MFD_ALLOW_SEALING } else { 0 };
+            let fd = unsafe { libc::memfd_create(c"reims-dma-buf-test".as_ptr(), flags) };
+            assert!(fd >= 0);
+            let fd = unsafe { OwnedFd::from_raw_fd(fd) };
+            assert_eq!(unsafe { libc::ftruncate(fd.as_raw_fd(), len as i64) }, 0);
+            if sealed {
+                let seals = libc::F_SEAL_SHRINK | libc::F_SEAL_GROW;
+                assert_eq!(
+                    unsafe { libc::fcntl(fd.as_raw_fd(), libc::F_ADD_SEALS, seals) },
+                    0
+                );
+            }
+            let ptr = unsafe {
+                libc::mmap(
+                    std::ptr::null_mut(),
+                    len,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_SHARED,
+                    fd.as_raw_fd(),
+                    0,
+                )
+            };
+            assert_ne!(ptr, libc::MAP_FAILED);
+            (fd, ptr, len)
+        }
+        unsafe {
+            let (_fd, ptr, len) = map(true);
+            let (found, offset) =
+                memfd_backing(ptr as usize + 8192, 8192).expect("a sealed memfd is admitted");
+            assert_eq!(offset, 8192);
+            let seals = libc::fcntl(found.as_raw_fd(), libc::F_GET_SEALS);
+            assert!(seals_admit_udmabuf(seals));
+            libc::munmap(ptr, len);
+
+            let (_fd, ptr, len) = map(false);
+            assert!(matches!(
+                memfd_backing(ptr as usize, 4096),
+                Err(BackingRefusal::NotSealed { .. })
+            ));
+            libc::munmap(ptr, len);
+
+            let anon = libc::mmap(
+                std::ptr::null_mut(),
+                4096,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                -1,
+                0,
+            );
+            assert!(matches!(
+                memfd_backing(anon as usize, 4096),
+                Err(BackingRefusal::NotOneFile)
+            ));
+            libc::munmap(anon, 4096);
+        }
+    }
+}
