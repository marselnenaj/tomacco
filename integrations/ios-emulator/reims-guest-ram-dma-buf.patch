+            Ok(()) => Ok((memory, pick)),
+            Err(result) => {
+                unsafe { ctx.device.free_memory(memory, None) };
+                Err(DmaBufRefusal::BindBuffer(result))
+            }
+        }
+    })();
+    let (memory, pick) = match bound {
+        Ok(made) => made,
+        Err(refusal) => {
+            unsafe { ctx.device.destroy_buffer(buffer, None) };
+            return Err(refusal);
+        }
+    };
+    crate::observe::off(format!(
+        "host_ram_import id={} route=dma_buf bytes={size} mtype={} heap={} heap_mb={} cut_us={cut_us} \
+         alloc_us={} ok=true",
+        import.id().get(),
+        pick.index,
+        pick.heap_index,
+        pick.heap_bytes >> 20,
+        alloc_started.elapsed().as_micros() as u64,
+    ));
+    Ok(ImportedHostRam {
+        buffer,
+        memory,
+        memory_type_index: pick.index,
+        size,
+        alias: None,
+    })
+}
