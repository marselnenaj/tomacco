+    /// The guest resource behind this GVA generation is gone, so nothing can
+    /// name these residents again: the key holds the generation, and generations
+    /// are not reused. Marks them for [`Self::retire_released_residents`], which
+    /// runs between draws; retiring here could free an image a draw holds. A sole
+    /// copy has no reader left, so its pixels are no reason to keep it. A resident
+    /// a lease still holds is released when the lease ends, as any other.
+    pub(crate) fn end_gva_generation(&mut self, gva: u64, generation: u64) -> usize {
+        let ended: Vec<TargetIdentity> = self
+            .registry_order
+            .iter()
+            .filter(|identity| {
+                matches!(identity, TargetIdentity::Gva { gva: address, generation: current, .. }
+                    if *address == gva && *current == generation)
+            })
+            .cloned()
+            .collect();
+        for identity in &ended {
+            self.set_sole_copy(identity, false);
+            if let Some(slot) = self.registry.get_mut(identity) {
+                if slot.resource_owner_count == 0 {
+                    slot.resource_released = true;
+                }
+            }
+        }
+        ended.len()
+    }
