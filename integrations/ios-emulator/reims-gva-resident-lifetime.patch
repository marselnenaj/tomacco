+/// Tell `rail` this resource is gone. Its generations are never used again, so
+/// without this every resident made for them stays until an allocation is
+/// refused: 3,300 images and 21 GiB after two rounds of 18 app launches.
+fn end_gva_residents<B: crate::backend::Backend>(
+    state: &DeviceState,
+    rail: B,
+    key: GvaResourceKey,
+) {
+    let mut ended = 0;
+    for (gva, generation) in state.pending_writebacks.gva_generations(key) {
+        ended += rail.end_gva_generation(gva, generation);
+    }
+    if ended != 0 {
+        crate::runtime::drain::note_store_route_n("gva_residents_ended", ended as u64);
+    }
+}
