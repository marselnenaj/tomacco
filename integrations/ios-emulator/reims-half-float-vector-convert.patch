+            for src_off in 0..17 {
+                for dst_off in 0..17 {
+                    if src_off + n > src.len() {
+                        continue;
+                    }
+                    let mut dst = vec![0xa5u8; n + 40];
+                    // SAFETY: both ranges are inside their vectors.
+                    unsafe {
+                        stream_copy(src.as_ptr().add(src_off), dst.as_mut_ptr().add(dst_off), n)
+                    };
+                    stream_fence();
+                    assert_eq!(&dst[dst_off..dst_off + n], &src[src_off..src_off + n]);
+                    assert!(dst[..dst_off].iter().all(|&b| b == 0xa5), "n={n}");
+                    assert!(dst[dst_off + n..].iter().all(|&b| b == 0xa5), "n={n}");
+                }
+            }
+        }
+    }
+}
