+/// The half-float arm's whole pixels are taken eight lanes at a time by the
+/// CPU's own half-float conversion where it has one (F16C and AVX2), with the
+/// frame's figures in the same pass, and the table converts the rest. Same
+/// bytes and figures: the vector arm computes the table's own rule (see
+/// [`f16c::rgba16f_to_bgra8`]) and `bgra_rgb_stats`'s, and tests hold it to
+/// both for every half-float word in every slot.
+#[cfg(target_arch = "x86_64")]
+mod f16c {
+    /// Whether this CPU has the instructions [`rgba16f_to_bgra8`] uses.
+    pub(super) fn available() -> bool {
+        std::is_x86_feature_detected!("avx2") && std::is_x86_feature_detected!("f16c")
+    }
+
+    /// RGBA16F pixels of `src` into BGRA8 `dst`, four at a time; returns how
+    /// many pixels it wrote (a multiple of four), leaving the rest to the
+    /// table, and those pixels' figures: how many have a non-zero B, G or R,
+    /// and the largest B, G or R byte (`bgra_rgb_stats`'s `rgb_nz` and
+    /// `max_rgb`).
+    ///
+    /// The table's rule for a half `h` is: NaN or `f <= 0` gives 0, `f >= 1`
+    /// gives 255, otherwise `(f * 255.0 + 0.5) as u8`, all in `f32`. Here
+    /// `vcvtph2ps` widens exactly; `max(f, 0)` returns its second operand for
+    /// a NaN, so NaN and every `f <= 0` become 0, and `min(.., 1)` caps the
+    /// rest; the multiply and the add are separate `f32` operations, rounded
+    /// as the scalar ones are; and `vcvttps2dq` truncates as `as u8` does,
+    /// with the result already in 0..=255.
+    ///
+    /// # Safety
+    ///
+    /// The CPU has AVX2 and F16C ([`available`]). With `STREAM`, `dst` is
+    /// 16-byte aligned and the caller fences the streaming stores.
+    #[target_feature(enable = "avx2,f16c")]
+    pub(super) unsafe fn rgba16f_to_bgra8<const STREAM: bool>(
+        src: &[u8],
+        dst: &mut [u8],
+    ) -> (usize, usize, u8) {
+        use std::arch::x86_64::*;
+        let pixels = (src.len() / 8).min(dst.len() / 4) / 4 * 4;
+        let zero = _mm256_setzero_ps();
+        let one = _mm256_set1_ps(1.0);
+        let scale = _mm256_set1_ps(255.0);
+        let half = _mm256_set1_ps(0.5);
+        // RGBA bytes of four pixels into BGRA.
+        let order = _mm_setr_epi8(2, 1, 0, 3, 6, 5, 4, 7, 10, 9, 8, 11, 14, 13, 12, 15);
+        let colour = _mm_set1_epi32(0x00ff_ffff);
+        let mut most = _mm_setzero_si128();
+        let mut black = 0usize;
+        let mut at = 0usize;
+        while at < pixels {
+            // SAFETY: `at + 4 <= pixels`, so 32 source and 16 destination
+            // bytes are in bounds; both accesses are unaligned.
+            unsafe {
+                let lo = _mm_loadu_si128(src.as_ptr().add(at * 8) as *const __m128i);
+                let hi = _mm_loadu_si128(src.as_ptr().add(at * 8 + 16) as *const __m128i);
+                let unorm = |h: __m128i| {
+                    let f = _mm256_cvtph_ps(h);
+                    let f = _mm256_min_ps(_mm256_max_ps(f, zero), one);
+                    _mm256_cvttps_epi32(_mm256_add_ps(_mm256_mul_ps(f, scale), half))
+                };
+                // Pack to 16 bits (lane-wise), put the pixels back in order,
+                // then to 8 bits and swap R and B.
+                let words = _mm256_packus_epi32(unorm(lo), unorm(hi));
+                let words = _mm256_permute4x64_epi64(words, 0b11_01_10_00);
+                let bytes = _mm_packus_epi16(
+                    _mm256_castsi256_si128(words),
+                    _mm256_extracti128_si256(words, 1),
+                );
+                let bgra = _mm_shuffle_epi8(bytes, order);
+                let out = dst.as_mut_ptr().add(at * 4) as *mut __m128i;
+                if STREAM {
+                    _mm_stream_si128(out, bgra);
+                } else {
+                    _mm_storeu_si128(out, bgra);
+                }
+                // The figures: B, G and R only.
+                let rgb = _mm_and_si128(bgra, colour);
+                most = _mm_max_epu8(most, rgb);
+                let zero = _mm_cmpeq_epi32(rgb, _mm_setzero_si128());
+                black += (_mm_movemask_ps(_mm_castsi128_ps(zero)) as u32).count_ones() as usize;
+            }
+            at += 4;
+        }
+        let mut lanes = [0u8; 16];
+        // SAFETY: 16 bytes into a 16-byte array.
+        unsafe { _mm_storeu_si128(lanes.as_mut_ptr() as *mut __m128i, most) };
+        (
+            pixels,
+            pixels - black,
+            lanes.iter().copied().max().unwrap_or(0),
+        )
+    }
+}
