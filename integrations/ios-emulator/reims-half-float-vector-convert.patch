+//! A copy into guest pages that does not read them first.
+//!
+//! An ordinary store to a cache line the CPU does not hold reads that line from
+//! memory before it overwrites it (a read for ownership). A whole-frame write
+//! into the guest's pages — 25 MB for the vphone's RGBA16F front surface —
+//! thus moves every destination byte twice, and the frame then sits in the
+//! last-level cache the guest's processors share, though nothing on the host
+//! reads it again. Each row of that write is a few kilobytes, far below the
+//! size at which the C library's `memcpy` switches to streaming stores itself.
+//!
+//! [`stream_copy`] writes with non-temporal stores instead: no read for
+//! ownership, and the lines go to memory rather than into the cache. Such
+//! stores are weakly ordered, so a writer ends its run with [`stream_fence`]
+//! before anything else may look at the bytes; a thread join alone does not
+//! order them.
+
+/// Below this many bytes a copy is a plain `copy_nonoverlapping`: the head and
+/// tail around the aligned body would be most of it.
+const STREAM_MIN_BYTES: usize = 256;
+
+/// Copy `n` bytes from `src` to `dst` with non-temporal stores where the
+/// target has them, and as `copy_nonoverlapping` elsewhere.
+///
+/// # Safety
+///
+/// As for [`std::ptr::copy_nonoverlapping`]: `src` readable and `dst` writable
+/// for `n` bytes, the two not overlapping. The caller runs [`stream_fence`] on
+/// the same thread before another thread or device may rely on the bytes.
+pub(crate) unsafe fn stream_copy(src: *const u8, dst: *mut u8, n: usize) {
+    #[cfg(target_arch = "x86_64")]
+    {
+        if n >= STREAM_MIN_BYTES {
+            // SAFETY: the caller's contract; SSE2 is part of x86_64.
+            unsafe { stream_copy_sse2(src, dst, n) };
+            return;
+        }
+    }
+    // SAFETY: the caller's contract.
+    unsafe { std::ptr::copy_nonoverlapping(src, dst, n) };
+}
+
+/// Order this thread's earlier [`stream_copy`] stores before its later stores.
+pub(crate) fn stream_fence() {
+    #[cfg(target_arch = "x86_64")]
+    // SAFETY: `sfence` has no operands and SSE is part of x86_64.
+    unsafe {
+        std::arch::x86_64::_mm_sfence()
+    };
+}
+
+#[cfg(target_arch = "x86_64")]
+unsafe fn stream_copy_sse2(src: *const u8, dst: *mut u8, n: usize) {
+    use std::arch::x86_64::{__m128i, _mm_loadu_si128, _mm_stream_si128};
+    // A plain head brings `dst` to 16-byte alignment, which a streaming store
+    // needs; `src` is read unaligned.
+    let head = (16 - (dst as usize & 15)) & 15;
+    // SAFETY (whole body): every offset below stays under `n`, which the
+    // caller vouched for on both pointers, and `dst + head` is 16-aligned.
+    unsafe {
+        std::ptr::copy_nonoverlapping(src, dst, head);
+        let mut at = head;
+        while at + 64 <= n {
+            let a = _mm_loadu_si128(src.add(at) as *const __m128i);
+            let b = _mm_loadu_si128(src.add(at + 16) as *const __m128i);
+            let c = _mm_loadu_si128(src.add(at + 32) as *const __m128i);
+            let d = _mm_loadu_si128(src.add(at + 48) as *const __m128i);
+            _mm_stream_si128(dst.add(at) as *mut __m128i, a);
+            _mm_stream_si128(dst.add(at + 16) as *mut __m128i, b);
+            _mm_stream_si128(dst.add(at + 32) as *mut __m128i, c);
+            _mm_stream_si128(dst.add(at + 48) as *mut __m128i, d);
+            at += 64;
+        }
+        while at + 16 <= n {
+            let a = _mm_loadu_si128(src.add(at) as *const __m128i);
+            _mm_stream_si128(dst.add(at) as *mut __m128i, a);
+            at += 16;
+        }
+        std::ptr::copy_nonoverlapping(src.add(at), dst.add(at), n - at);
+    }
+}
