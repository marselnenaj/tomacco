+/// A packed public XR attachment decodes directly to the canonical Float32
+/// resident. No normalized eight-bit image or native paired-surface codec is
+/// involved. The source owner has already checked physical row geometry.
+fn interleaved_xr_load_seed(format: u16, bytes: Vec<u8>) -> Option<pixel_format::ColorLoadSeed> {
+    let expanded = match reims_vgpu_vulkan::pixel::sampled_upload_bytes(format, bytes) {
+        Ok(expanded) => expanded,
+        Err(why) => {
+            crate::observe::Emit::decline(
+                "interleaved_xr_render_load",
+                &LinearLoadRefusal::XrUpload { reason: why.slug() },
+            )
+            .field("format", format!("{format:#x}"))
+            .fail();
+            return None;
+        }
+    };
+    let (storage, bytes) = expanded.into_parts();
+    if storage != reims_vgpu_vulkan::pixel::StorageImageFormat::Rgba32Float {
+        crate::observe::Emit::decline(
+            "interleaved_xr_render_load",
+            &LinearLoadRefusal::XrUpload {
+                reason: "xr_attachment_load_not_float32",
+            },
+        )
+        .fail();
+        return None;
+    }
+    Some(pixel_format::ColorLoadSeed {
+        pixels: std::sync::Arc::new(bytes),
+        layout: TexelLayout::Rgba32Float,
+    })
+}
