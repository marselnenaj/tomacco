+/// An interleaved XR mapping stores packed codes, not its Float32 resident's
+/// bytes and not an RGBA8 scanout approximation. Capture the original storage
+/// before readback; end the staging lease before guest settlement/publication.
+fn store_interleaved_xr_surface<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    mapping_id: u32,
+    identity: &crate::backend::vulkan::engine::TargetIdentity,
+    width: u32,
+    height: u32,
+) -> Result<usize, InterleavedXrStoreRefusal> {
+    use crate::backend::vulkan::engine::TargetIdentity;
+    use crate::protocol::pixel_format::{TexelLayout, XrFormat};
+    use InterleavedXrStoreRefusal as R;
+    let mapping = state.mappings.get(&mapping_id).ok_or(R::Identity)?;
+    let format = mapping.format;
+    XrFormat::from_mtl(format).ok_or(R::Encode(
+        reims_vgpu_vulkan::pixel::RenderStoreRefusal::NotXr,
+    ))?;
+    if !matches!(identity, TargetIdentity::Surface { id, width: w, height: h, generation, format }
+        if *id == mapping_id && *w == width && *h == height
+            && *generation == u64::from(mapping.map_generation)
+            && *format == ash::vk::Format::R32G32B32A32_SFLOAT)
+    {
+        return Err(R::Identity);
+    }
+    let target = crate::runtime::mapping_write::NativeImageWriteTarget::capture(
+        mapping_id, mapping, width, height, format,
+    )
+    .map_err(R::Mapping)?;
+    let expected =
+        crate::protocol::extent::tight_image_bytes(width, height, 16).ok_or(R::SourceShape)?;
+    let packed = {
+        let source = crate::backend::vulkan::engine::read_target_texels_consumable(identity)
+            .map_err(R::Read)?;
+        if source.texel.native_layout() != Some(TexelLayout::Rgba32Float)
+            || source.bytes().len() != expected
+        {
+            return Err(R::SourceShape);
+        }
+        let started = std::time::Instant::now();
+        let packed = reims_vgpu_vulkan::pixel::render_store_bytes(
+            format,
+            TexelLayout::Rgba32Float,
+            source.bytes(),
+        )
+        .map_err(R::Encode)?;
+        if packed.len() != target.packed_bytes() {
+            return Err(R::SourceShape);
+        }
+        crate::runtime::drain::note_store_route_us(
+            "interleaved_xr_encode_us",
+            started.elapsed().as_micros() as u64,
+        );
+        if source.is_leased() {
+            crate::runtime::drain::note_store_route("interleaved_xr_store_leased_n");
+            crate::runtime::drain::note_store_route_n(
+                "interleaved_xr_cpu_copy_bytes_avoided",
+                expected as u64,
+            );
+        } else {
+            crate::runtime::drain::note_store_route("interleaved_xr_store_copied_n");
+        }
+        packed
+    };
+    let bytes =
+        crate::runtime::mapping_write::write_captured_native_image(state, host, target, &packed)
+            .map_err(R::Mapping)?;
+    crate::runtime::drain::note_store_route("interleaved_xr_render_store_n");
+    crate::runtime::drain::note_store_route_n("interleaved_xr_store_bytes_n", bytes as u64);
+    Ok(bytes)
 }
 
