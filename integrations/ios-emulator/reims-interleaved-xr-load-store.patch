+/// Vulkan's canonical XR GVA LOAD must precede the RGBA8 display-cache doors.
+pub(super) fn seed_interleaved_xr_color_load<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    task_id: u32,
+    span: super::GvaSpan,
+) -> Option<pixel_format::ColorLoadSeed> {
+    let xr = pixel_format::XrFormat::from_mtl(span.format)?;
+    // Match the native Store owner's accepted attachment geometry before
+    // allocating either the packed source or its Float32 expansion.
+    if !crate::model::scanout_extent_ok(span.width, span.height) {
+        return None;
+    }
+    let (tight, len) = reims_vgpu_protocol::extent::tight_image_layout(
+        span.width,
+        span.height,
+        xr.bytes_per_texel() as u32,
+    )?;
+    if span.gva == 0 || span.row_stride < tight {
+        return None;
+    }
+    crate::runtime::writeback_debt::pay_for_texture(state, host, task_id, span.texture_ref);
+    crate::runtime::render_writeback::settle_guest_writes(
+        crate::runtime::render_writeback::SettleSite::LinearTextureSeed,
+    );
+    let mut bytes = Vec::new();
+    if bytes.try_reserve_exact(len).is_err() {
+        crate::observe::Emit::decline(
+            "interleaved_xr_render_load",
+            &LinearLoadRefusal::XrUpload {
+                reason: "sampled_xr_allocation_failed",
+            },
+        )
+        .fail();
+        return None;
+    }
+    bytes.resize(len, 0);
+    for (y, row) in bytes.chunks_exact_mut(tight as usize).enumerate() {
+        let offset = (y as u64).checked_mul(u64::from(span.row_stride))?;
+        if !crate::runtime::gva_view::read_span(
+            state,
+            host,
+            task_id,
+            span.gva.checked_add(offset)?,
+            row,
+        ) {
+            return None;
+        }
+    }
+    let seed = interleaved_xr_load_seed(span.format, bytes)?;
+    crate::runtime::drain::note_store_route("interleaved_xr_gva_render_load_n");
+    Some(seed)
+}
