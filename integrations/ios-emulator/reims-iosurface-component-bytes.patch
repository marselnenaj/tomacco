--- /dev/null
+++ b/reims-vgpu/crates/reims-vgpu-protocol/src/iosurface_pages/components.rs
@@ -0,0 +1,258 @@
+//! Component bytes in compact mapper **plane** records.
+//!
+//! The original arm64e plane producer writes the count at +0x27 and five
+//! four-byte columns at +0x2c/+0x30/+0x34/+0x38/+0x3c. It refuses counts above
+//! four. Each getter result is stored with `strb`: these are serialized bytes,
+//! not complete native enum values. The original property builder binds the
+//! columns to bit depth, bit offset, name, type and range, in that order. Enum
+//! meanings remain unassigned here. The surface header has a different +0x27 field and
+//! must never be decoded as a plane record.
+
+use super::{DEVICE_DESC_LEN, DEVICE_DESC_PLANES, DEVICE_DESC_PLANE_COUNT, DEVICE_PLANE_DESC_LEN};
+use alloc::string::{String, ToString};
+use alloc::vec;
+use alloc::vec::Vec;
+
+pub const DEVICE_PLANE_COMPONENT_COUNT: usize = 0x27;
+pub const DEVICE_PLANE_COMPONENT_FIELD_OFFSETS: [usize; 5] = [0x2c, 0x30, 0x34, 0x38, 0x3c];
+pub const DEVICE_PLANE_MAX_COMPONENTS: usize = 4;
+pub const DEVICE_DESC_MAX_PLANES: usize =
+    (DEVICE_DESC_LEN - DEVICE_DESC_PLANES) / DEVICE_PLANE_DESC_LEN;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DevicePlaneComponentBytes {
+    /// Serialized bit-depth, bit-offset, name, type and range bytes. This does
+    /// not widen the stored bytes back into complete native enum ordinals.
+    pub fields: [u8; DEVICE_PLANE_COMPONENT_FIELD_OFFSETS.len()],
+}
+
+/// Only the declared components are exposed. Bytes in inactive column slots
+/// are neither interpreted nor allowed to masquerade as active metadata.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DevicePlaneComponents {
+    count: u8,
+    components: [DevicePlaneComponentBytes; DEVICE_PLANE_MAX_COMPONENTS],
+}
+
+impl DevicePlaneComponents {
+    pub fn components(&self) -> &[DevicePlaneComponentBytes] {
+        &self.components[..usize::from(self.count)]
+    }
+
+    fn decode_plane(bytes: &[u8]) -> Result<Self, PlaneComponentsRefusal> {
+        let Some(bytes) = bytes.get(..DEVICE_PLANE_DESC_LEN) else {
+            return Err(PlaneComponentsRefusal::ShortPlane);
+        };
+        let count = bytes[DEVICE_PLANE_COMPONENT_COUNT];
+        if usize::from(count) > DEVICE_PLANE_MAX_COMPONENTS {
+            return Err(PlaneComponentsRefusal::ComponentCount { count });
+        }
+        let mut components = [DevicePlaneComponentBytes {
+            fields: [0; DEVICE_PLANE_COMPONENT_FIELD_OFFSETS.len()],
+        }; DEVICE_PLANE_MAX_COMPONENTS];
+        for (index, component) in components[..usize::from(count)].iter_mut().enumerate() {
+            component.fields =
+                DEVICE_PLANE_COMPONENT_FIELD_OFFSETS.map(|offset| bytes[offset + index]);
+        }
+        Ok(Self { count, components })
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PlaneComponentsRefusal {
+    ShortDescriptor,
+    ShortPlane,
+    PlaneCount { count: u8 },
+    PlaneIndex { index: u32, count: u8 },
+    ComponentCount { count: u8 },
+}
+
+impl PlaneComponentsRefusal {
+    pub fn slug(self) -> &'static str {
+        match self {
+            Self::ShortDescriptor => "iosurface_components_descriptor_short",
+            Self::ShortPlane => "iosurface_components_plane_short",
+            Self::PlaneCount { .. } => "iosurface_components_plane_count",
+            Self::PlaneIndex { .. } => "iosurface_components_plane_index",
+            Self::ComponentCount { .. } => "iosurface_components_component_count",
+        }
+    }
+}
+
+impl reims_vgpu_observe::Refusal for PlaneComponentsRefusal {
+    fn refusal(&self) -> Option<&'static str> {
+        Some(self.slug())
+    }
+
+    fn fields(&self) -> Vec<(&'static str, String)> {
+        match *self {
+            Self::ShortDescriptor | Self::ShortPlane => Vec::new(),
+            Self::PlaneCount { count } | Self::ComponentCount { count } => {
+                vec![("count", count.to_string())]
+            }
+            Self::PlaneIndex { index, count } => {
+                vec![("index", index.to_string()), ("count", count.to_string())]
+            }
+        }
+    }
+}
+
+/// Decode only an actually declared plane in the compact descriptor. A zero
+/// plane count describes nonplanar storage; it does not make the surface
+/// header's bytes into a plane-component record.
+pub fn device_desc_plane_components(
+    desc: &[u8],
+    index: u32,
+) -> Result<DevicePlaneComponents, PlaneComponentsRefusal> {
+    if desc.len() < DEVICE_DESC_LEN {
+        return Err(PlaneComponentsRefusal::ShortDescriptor);
+    }
+    let count = desc[DEVICE_DESC_PLANE_COUNT];
+    if usize::from(count) > DEVICE_DESC_MAX_PLANES {
+        return Err(PlaneComponentsRefusal::PlaneCount { count });
+    }
+    if index >= u32::from(count) {
+        return Err(PlaneComponentsRefusal::PlaneIndex { index, count });
+    }
+    // Count and index are bounded before converting or multiplying the index.
+    let start = DEVICE_DESC_PLANES + index as usize * DEVICE_PLANE_DESC_LEN;
+    DevicePlaneComponents::decode_plane(&desc[start..start + DEVICE_PLANE_DESC_LEN])
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn descriptor(planes: u8) -> Vec<u8> {
+        let mut bytes = vec![0; DEVICE_DESC_LEN];
+        bytes[DEVICE_DESC_PLANE_COUNT] = planes;
+        bytes
+    }
+
+    #[test]
+    fn native_columns_are_transposed_into_their_own_components() {
+        let mut desc = descriptor(2);
+        let start = DEVICE_DESC_PLANES + DEVICE_PLANE_DESC_LEN;
+        desc[start + DEVICE_PLANE_COMPONENT_COUNT] = 4;
+        for (column, offset) in DEVICE_PLANE_COMPONENT_FIELD_OFFSETS.into_iter().enumerate() {
+            for index in 0..DEVICE_PLANE_MAX_COMPONENTS {
+                desc[start + offset + index] = (column * 10 + index) as u8;
+            }
+        }
+        let metadata = device_desc_plane_components(&desc, 1).unwrap();
+        assert_eq!(metadata.components().len(), 4);
+        for (index, component) in metadata.components().iter().enumerate() {
+            assert_eq!(
+                component.fields,
+                [
+                    index as u8,
+                    10 + index as u8,
+                    20 + index as u8,
+                    30 + index as u8,
+                    40 + index as u8
+                ]
+            );
+        }
+        assert!(device_desc_plane_components(&desc, 0)
+            .unwrap()
+            .components()
+            .is_empty());
+    }
+
+    #[test]
+    fn inactive_slots_and_unknown_byte_values_do_not_create_components() {
+        let mut desc = descriptor(1);
+        let start = DEVICE_DESC_PLANES;
+        desc[start + DEVICE_PLANE_COMPONENT_COUNT] = 1;
+        for offset in DEVICE_PLANE_COMPONENT_FIELD_OFFSETS {
+            desc[start + offset..start + offset + DEVICE_PLANE_MAX_COMPONENTS].fill(0xff);
+        }
+        let metadata = device_desc_plane_components(&desc, 0).unwrap();
+        assert_eq!(
+            metadata.components(),
+            &[DevicePlaneComponentBytes { fields: [255; 5] }]
+        );
+    }
+
+    #[test]
+    fn a_nonplanar_header_is_never_a_component_plane() {
+        let mut desc = descriptor(0);
+        desc[DEVICE_PLANE_COMPONENT_COUNT] = 1;
+        desc[DEVICE_PLANE_COMPONENT_FIELD_OFFSETS[0]] = 8;
+        assert_eq!(
+            device_desc_plane_components(&desc, 0),
+            Err(PlaneComponentsRefusal::PlaneIndex { index: 0, count: 0 })
+        );
+    }
+
+    #[test]
+    fn oversized_counts_and_indices_are_typed_refusals() {
+        let mut desc = descriptor(1);
+        desc[DEVICE_DESC_PLANES + DEVICE_PLANE_COMPONENT_COUNT] = 5;
+        assert_eq!(
+            device_desc_plane_components(&desc, 0),
+            Err(PlaneComponentsRefusal::ComponentCount { count: 5 })
+        );
+        assert_eq!(
+            device_desc_plane_components(&desc, u32::MAX),
+            Err(PlaneComponentsRefusal::PlaneIndex {
+                index: u32::MAX,
+                count: 1
+            })
+        );
+        desc[DEVICE_DESC_PLANE_COUNT] = (DEVICE_DESC_MAX_PLANES + 1) as u8;
+        assert_eq!(
+            device_desc_plane_components(&desc, 0),
+            Err(PlaneComponentsRefusal::PlaneCount { count: 8 })
+        );
+    }
+
+    #[test]
+    fn the_last_declared_plane_is_within_the_compact_descriptor() {
+        let mut desc = descriptor(DEVICE_DESC_MAX_PLANES as u8);
+        let start = DEVICE_DESC_PLANES + (DEVICE_DESC_MAX_PLANES - 1) * DEVICE_PLANE_DESC_LEN;
+        desc[start + DEVICE_PLANE_COMPONENT_COUNT] = 4;
+        desc[DEVICE_DESC_LEN - 1] = 0xad;
+        assert_eq!(
+            device_desc_plane_components(&desc, (DEVICE_DESC_MAX_PLANES - 1) as u32)
+                .unwrap()
+                .components()[3]
+                .fields[4],
+            0xad
+        );
+    }
+
+    #[test]
+    fn every_short_record_refuses_without_reading_a_field() {
+        for len in 0..DEVICE_DESC_LEN {
+            assert_eq!(
+                device_desc_plane_components(&vec![0xff; len], 0),
+                Err(PlaneComponentsRefusal::ShortDescriptor)
+            );
+        }
+        for len in 0..DEVICE_PLANE_DESC_LEN {
+            assert_eq!(
+                DevicePlaneComponents::decode_plane(&vec![0xff; len]),
+                Err(PlaneComponentsRefusal::ShortPlane)
+            );
+        }
+    }
+
+    #[test]
+    fn every_component_count_preserves_only_admitted_active_slots() {
+        let mut desc = descriptor(1);
+        for count in 0..=u8::MAX {
+            desc[DEVICE_DESC_PLANES + DEVICE_PLANE_COMPONENT_COUNT] = count;
+            match device_desc_plane_components(&desc, 0) {
+                Ok(metadata) => {
+                    assert!(usize::from(count) <= DEVICE_PLANE_MAX_COMPONENTS);
+                    assert_eq!(metadata.components().len(), usize::from(count));
+                }
+                Err(why) => {
+                    assert!(usize::from(count) > DEVICE_PLANE_MAX_COMPONENTS);
+                    assert_eq!(why, PlaneComponentsRefusal::ComponentCount { count });
+                }
+            }
+        }
+    }
+}
