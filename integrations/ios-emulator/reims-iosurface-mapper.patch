+    /// Both page geometries and the single/multi-leaf boundary must resolve
+    /// actual leaf PFNs. Root-table PFNs are never surface backing.
+    #[test]
+    fn extended_layout_resolves_leaf_entries_and_checks_root_geometry() {
+        for shift in [12u32, 14] {
+            let page_size = page_size_of(shift);
+            let per_page = page_size / U32_SIZE as u64;
+            for count in [1u64, per_page, per_page + 1] {
+                let internal = ARM_KERNEL_VA_BASE + 0x10_000;
+                let descriptor = ARM_KERNEL_VA_BASE + 0x20_000;
+                let table = ARM_KERNEL_VA_BASE + 0x40_000;
+                let root_pages = u64::from(count > per_page);
+                let leaf_pages = (count - 1) / per_page + 1;
+                let mut mem = MapMem::new();
+                mem.put_u64(internal + MAPPING_INTERNAL_BACKPTR, 0);
+                mem.put_u32(internal + MAPPING_INTERNAL_ID, 7);
+                mem.put_u32(
+                    internal + MAPPING_INTERNAL_SIZE,
+                    MAPPING_INTERNAL_EXPECTED_SIZE,
+                );
+                // The old fields are deliberately unusable. No pointer probing
+                // or compact-layout fallback can answer this fixture.
+                mem.put_u64(internal + 0x48, 0);
+                mem.put_u64(internal + 0x50, 0);
+                mem.put_u64(internal + 0x58, descriptor);
+                mem.put_u64(internal + 0x60, 0);
+                mem.put_u64(internal + 0x70, root_pages);
+                mem.put_u64(internal + 0x78, leaf_pages);
+                mem.put_u64(internal + 0x80, count);
+                mem.put_u64(descriptor + MAPPING_PAGE_TABLE_FROM_F48, table);
+                if root_pages != 0 {
+                    mem.put_u32(table, 0); // never read as a surface entry
+                }
+                let leaf_base = table + root_pages * page_size;
+                let entries: Vec<u32> = (0..count).map(|i| (((100 + i) as u32) << 2) | 1).collect();
+                for (i, &entry) in entries.iter().enumerate() {
+                    mem.put_u32(leaf_base + i as u64 * U32_SIZE as u64, entry);
+                }
+                let fields =
+                    read_mapper_internal(&mem, internal, false, 0, MapperLayout::Extended).unwrap();
+                let plan = build_table_plan(&mem, 7, &fields, count * page_size, shift).unwrap();
+                assert_eq!(plan.entries, entries);
+                assert_eq!(plan.page_table_kva, leaf_base);
+                assert_eq!(plan.required_pages, count);
+                for (roots, leaves) in [(root_pages ^ 1, leaf_pages), (root_pages, leaf_pages + 1)]
+                {
+                    let mut invalid = fields;
+                    invalid.root_pages = roots;
+                    invalid.leaf_table_pages = Some(leaves);
+                    assert_eq!(
+                        build_table_plan(&mem, 7, &invalid, page_size, shift)
+                            .unwrap_err()
+                            .refusal(),
+                        Some("iosurface_page_table_geometry_invalid")
+                    );
+                }
+                assert!(
+                    build_table_plan(&mem, 7, &fields, (count + 1) * page_size, shift).is_err()
+                );
+                mem.put_u32(leaf_base, 0);
+                assert_eq!(
+                    build_table_plan(&mem, 7, &fields, page_size, shift)
+                        .unwrap_err()
+                        .refusal(),
+                    Some("iosurface_page_table_entry_invalid")
+                );
+            }
+        }
+    }
