+    request[..4].copy_from_slice(&MAPPER_REQUEST_MAP.to_le_bytes());
+    request[4..8].copy_from_slice(&3u32.to_le_bytes());
+    host.map_range(ring, request.len(), 0);
+    host.write_gpa(ring, &request).unwrap();
+    state.iosfc.ring_base = ring;
+    host.set_xreg(19, KVA + 0x1000);
+    host.set_xreg(20, MAPPER_REQUEST_MAP as u64);
+    host.set_xreg(21, KVA);
+    host.set_xreg(22, 0); // the real extended handoff keeps a ring offset here
+    let mut cap = capture_at_producer(&state, &host, 1).unwrap();
+    assert_eq!(cap.mapping_layout, MapperLayout::Extended);
+    assert!(apply_capture(&mut state, &cap, 3));
+    assert!(state.mappings[&3].page_entries.is_empty());
+    assert_ne!(state.mappings[&3].map_generation, compact_generation);
+    assert!(resolve_mapping_backing(&mut state, &host, 3));
+    assert_eq!(state.mappings[&3].page_entries, vec![(0x1e8a0 << 2) | 1]);
+    let generation = state.mappings[&3].map_generation;
+    assert!(apply_capture(&mut state, &cap, 3));
+    assert_eq!(state.mappings[&3].map_generation, generation);
+    assert_eq!(state.mappings[&3].page_entries.len(), 1);
+    cap.request_type = MAPPER_REQUEST_UNMAP;
+    assert!(apply_capture(&mut state, &cap, 3));
+    assert!(!state.mappings[&3].mapped);
+    assert!(state.mappings[&3].page_entries.is_empty());
