+/// Two recovered producer-write calling conventions. Both retain the mapper
+/// device in x19. One retains request type/internal in x21/x22; the other in
+/// x20/x21. In the latter, the same x21 object supplies the ring's mapping ID
+/// from +0x30, while w20 supplies its request type. A kernel pointer and the
+/// MAP/UNMAP ordinal are disjoint, so x21 selects a layout without probing RAM
+/// or scanning registers. Selection is not validation: the ring type, object
+/// owner, mapping ID and structure size must still corroborate the capture.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum MapperLayout {
+    #[default]
+    Compact,
+    Extended,
+}
+
+impl MapperLayout {
+    pub fn from_x21(value: u64) -> Self {
+        if guest_kernel_va(value) {
+            Self::Extended
+        } else {
+            Self::Compact
+        }
+    }
+
+    pub fn request_type_register(self) -> u32 {
+        match self {
+            Self::Compact => MAPPER_CAPTURE_REG_REQUEST_TYPE,
+            Self::Extended => 20,
+        }
+    }
+
+    pub fn internal_register(self) -> u32 {
+        match self {
+            Self::Compact => MAPPER_CAPTURE_REG_MAPPING_INTERNAL,
+            Self::Extended => MAPPER_CAPTURE_REG_REQUEST_TYPE,
+        }
+    }
+}
+
+/// Layout recovered from the same producer implementation as its register
+/// handoff. The extended object inserts an auxiliary descriptor before the
+/// page-table memory descriptor/map, and adds a root-page count. It must not
+/// be selected by trying pointers until a page table happens to parse.
+impl MapperLayout {
+    fn page_fields(self) -> (u64, u64, u64) {
+        match self {
+            Self::Compact => (0x48, 0x50, 0x70),
+            Self::Extended => (0x58, 0x60, 0x80),
+        }
+    }
+}
