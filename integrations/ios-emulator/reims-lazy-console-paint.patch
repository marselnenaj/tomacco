+/// Acknowledge a ScanoutUpdate for a console nobody reads yet, without copying
+/// its pixels (see `device_scanout_account`).
+///
+/// REIMS_VGPU_QEMU_OK: recorded as painted; the surface is stale until
+/// `reims_vgpu_qemu_scanout_reshow`. REIMS_VGPU_QEMU_EMPTY: unchanged.
+/// REIMS_VGPU_QEMU_ERR_STATE: not a re-show of the retained frame (or a
+/// failed one); nothing was acknowledged — call `reims_vgpu_qemu_scanout_copy`.
+#[no_mangle]
+pub extern "C" fn reims_vgpu_qemu_scanout_account(
+    handle: u64,
+    mapping_id: u32,
+    width: u32,
+    height: u32,
+    generation: u32,
+) -> c_int {
+    use crate::runtime::scanout::ScanoutCopyResult;
+    unwind_safe(
+        "reims_vgpu_qemu_scanout_account",
+        || {
+            if handle == 0 || width == 0 || height == 0 {
+                return REIMS_VGPU_QEMU_ERR_ARGS;
+            }
+            // The action's mapping and generation do not choose what a re-show
+            // shows (the retained snapshot); they are part of the call so C
+            // can hand both entry points the same action.
+            let _ = (mapping_id, generation);
+            match device_scanout_account(handle, width, height) {
+                Some(ScanoutCopyResult::Painted) => REIMS_VGPU_QEMU_OK,
+                Some(ScanoutCopyResult::Unchanged) => REIMS_VGPU_QEMU_EMPTY,
+                Some(ScanoutCopyResult::Failed) | None => REIMS_VGPU_QEMU_ERR_STATE,
+            }
+        },
+        REIMS_VGPU_QEMU_ERR_PANIC,
+    )
+}
+
+/// Copy the retained frame a `reims_vgpu_qemu_scanout_account` call recorded
+/// into a QEMU DisplaySurface. REIMS_VGPU_QEMU_OK when copied,
+/// REIMS_VGPU_QEMU_EMPTY when the device holds no frame of that size.
+///
+/// SAFETY: `dst` must be valid for `dst_stride * height` bytes.
+#[no_mangle]
+pub unsafe extern "C" fn reims_vgpu_qemu_scanout_reshow(
+    handle: u64,
+    dst: *mut u8,
+    dst_stride: u32,
+    width: u32,
+    height: u32,
+) -> c_int {
+    unwind_safe(
+        "reims_vgpu_qemu_scanout_reshow",
+        || {
+            if handle == 0 || dst.is_null() || width == 0 || height == 0 || dst_stride == 0 {
+                return REIMS_VGPU_QEMU_ERR_ARGS;
+            }
