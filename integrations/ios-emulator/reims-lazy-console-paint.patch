+#[test]
+fn an_accounted_present_is_acked_like_a_painted_one_and_reshown_on_demand() {
+    use crate::runtime::scanout::ScanoutCopyResult;
+    // An earlier version postponed the whole paint, and with it this ack:
+    // the worker skips every drain while `present_action_pending` is set, so
+    // the guest's display channel stood still after its first present.
+    let painted = device_with_an_unpainted_retained_frame();
+    let accounted = device_with_an_unpainted_retained_frame();
+    let mut dst = [0u8; 8];
+    assert_eq!(device_scanout_copy(painted, 7, &mut dst, 8, 2, 1, 5), ScanoutCopyResult::Painted);
+    assert_eq!(dst, [1, 2, 3, 4, 5, 6, 7, 8]);
+    assert_eq!(device_scanout_account(accounted, 2, 1), Some(ScanoutCopyResult::Painted));
+    let (p, a) = (device_slot(painted).unwrap(), device_slot(accounted).unwrap());
+    assert!(!a.present_action_pending.load(Ordering::Acquire), "the present is released");
+    {
+        let (p, a) = (&p.inner.lock().device.state.present, &a.inner.lock().device.state.present);
+        let record = |s: &crate::model::PresentState| {
+            (s.valid, s.width, s.height, s.generation, s.painted_mapping, s.painted_generation,
+             s.frame_encode_pending, s.unpainted_presents)
+        };
+        assert_eq!(record(a), record(p), "accounting records what the paint records");
+        assert_eq!(a.unpainted_presents, 0);
+    }
+    // The same frame again is Unchanged on both paths.
+    assert_eq!(device_scanout_account(accounted, 2, 1), Some(ScanoutCopyResult::Unchanged));
+    assert_eq!(device_scanout_copy(painted, 7, &mut dst, 8, 2, 1, 5), ScanoutCopyResult::Unchanged);
+    // The bytes come when the console is read, and only at the retained size.
+    let mut shown = [0u8; 8];
+    assert!(device_scanout_reshow(accounted, &mut shown, 8, 2, 1));
+    assert_eq!(shown, [1, 2, 3, 4, 5, 6, 7, 8]);
+    assert!(!device_scanout_reshow(accounted, &mut shown, 4, 1, 1));
+    assert!(device_destroy(painted));
+    assert!(device_destroy(accounted));
+}
