+/// [`device_scanout_copy`] without the copy, for a console nobody reads yet
+/// (reims-lazy-console-paint: a frame mailbox carries the frames and no window
+/// is up).
+///
+/// The QEMU-side paint is not only a paint: it is the entry-side
+/// `waitForPendingFrames` ack. Once a present enqueues its ScanoutUpdate the
+/// worker skips every drain while `present_action_pending` is set
+/// (`device_drain`), and only [`note_scanout_copy_consumed`] clears it, so a
+/// console that postpones the whole call holds the display channel at its
+/// first present for as long as nobody takes a screendump (an earlier version
+/// of this patch: one frame, then a frozen UI). This takes the same lock the copy
+/// would, records what the copy would record and acks the present the same
+/// way, leaving only the bytes to [`device_scanout_reshow`].
+///
+/// `None`: the paint is not a re-show of the retained snapshot (capture retry,
+/// pre-boundary live mapping, no retain); nothing was touched or acked, and C
+/// must call [`device_scanout_copy`] now.
+pub fn device_scanout_account(
+    id: u64,
+    width: u32,
+    height: u32,
+) -> Option<crate::runtime::scanout::ScanoutCopyResult> {
+    use crate::runtime::scanout::ScanoutCopyResult;
+    let Some(slot) = device_slot(id) else {
+        return Some(ScanoutCopyResult::Failed);
+    };
+    let present_action = slot.present_action_pending.load(Ordering::Acquire);
+    let mut d = if present_action {
+        slot.inner.lock()
+    } else {
+        let Some(d) = slot.inner.try_lock() else {
+            // As the copy: a busy device without a present to ack is Unchanged.
+            return Some(ScanoutCopyResult::Unchanged);
+        };
+        d
+    };
+    let rc = crate::runtime::scanout::account_bgra8(&mut d.device.state, width, height)?;
+    if let Some(ops) = slot.ops {
+        let DeviceInner { device, actions } = &mut *d;
+        let mut host = QemuHost::new(&ops, actions, &slot.prompt_actions);
+        note_scanout_copy_consumed(&mut device.state, &mut host, &slot, rc, present_action);
+    } else {
+        let mut host = NullHost;
+        note_scanout_copy_consumed(&mut d.device.state, &mut host, &slot, rc, present_action);
+    }
+    Some(rc)
+}
+
+/// The bytes [`device_scanout_account`] left out: copy the retained snapshot
+/// into `dst` when the console is read. Acks nothing and changes no state;
+/// `false` when the device holds no snapshot of that size.
+pub fn device_scanout_reshow(
+    id: u64,
+    dst: &mut [u8],
+    dst_stride: u32,
+    width: u32,
+    height: u32,
+) -> bool {
+    let Some(slot) = device_slot(id) else {
+        return false;
+    };
+    let d = slot.inner.lock();
+    crate::runtime::scanout::reshow_bgra8(&d.device.state, dst, dst_stride, width, height)
+}
