+#[test]
+fn a_paint_that_is_not_a_reshow_is_declined_without_an_ack() {
+    // No retained frame: the paint must read guest memory, which only
+    // `device_scanout_copy` does, so accounting leaves the present to it.
+    let id = device_with_an_unpainted_retained_frame();
+    let slot = device_slot(id).expect("slot");
+    slot.inner.lock().device.state.present.frame_valid = false;
+    assert_eq!(device_scanout_account(id, 2, 1), None);
+    assert!(slot.present_action_pending.load(Ordering::Acquire));
+    assert_eq!(slot.inner.lock().device.state.present.unpainted_presents, 3);
+    // Nor at another size than the retained one.
+    slot.inner.lock().device.state.present.frame_valid = true;
+    assert_eq!(device_scanout_account(id, 4, 1), None);
+    assert!(slot.present_action_pending.load(Ordering::Acquire));
+    let mut dst = [0u8; 16];
+    assert!(!device_scanout_reshow(id, &mut dst, 16, 4, 1));
+    assert!(device_destroy(id));
+}
