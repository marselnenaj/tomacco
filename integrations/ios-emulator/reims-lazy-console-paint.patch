+
+/// `copy_to_bgra8` for a console nobody is looking at yet: when the paint
+/// would re-show the retained snapshot, record exactly what that paint records
+/// (Painted or Unchanged) without copying its bytes; the copy happens in
+/// `reshow_bgra8` when the console is read. Every other paint (capture retry,
+/// pre-boundary live mapping, EFI) reads guest memory or decides from it and
+/// is left to `copy_to_bgra8`: `None` touches nothing.
+pub fn account_bgra8(
+    state: &mut DeviceState,
+    width: u32,
+    height: u32,
+) -> Option<ScanoutCopyResult> {
+    if !scanout_extent_ok(width, height) || !snapshot_matches(state, width, height) {
+        return None;
+    }
+    if !state.present.frame_encode_pending
+        && state.present.painted_mapping == state.present.frame_mapping
+        && state.present.painted_generation == state.present.frame_generation
+    {
+        return Some(ScanoutCopyResult::Unchanged);
+    }
+    note_snapshot_shown(state, width, height);
+    Some(ScanoutCopyResult::Painted)
