+/// A device holding one retained 2x1 frame whose present is waiting for the
+/// console paint, as `capture_present_frame` and `enqueue_present_scanout`
+/// leave it.
+fn device_with_an_unpainted_retained_frame() -> u64 {
+    let id = device_create(None, PAGE_SHIFT_ARM64E).expect("create");
+    let slot = device_slot(id).expect("slot");
+    {
+        let present = &mut slot.inner.lock().device.state.present;
+        present.frame_bgra = vec![1, 2, 3, 4, 5, 6, 7, 8];
+        present.frame_mapping = 7;
+        present.frame_width = 2;
+        present.frame_height = 1;
+        present.frame_generation = 5;
+        present.frame_valid = true;
+        present.frame_encode_pending = true;
+        present.unpainted_presents = 3;
+    }
+    slot.present_action_pending.store(true, Ordering::Release);
+    id
+}
