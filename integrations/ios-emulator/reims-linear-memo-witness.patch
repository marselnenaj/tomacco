@@ -0,0 +1,564 @@
+//! When the guest linear memo may serve a bind without re-reading the span.
+//!
+//! # What it removes
+//!
+//! `load_linear_guest_memoized` keeps a converted copy of every guest-CPU
+//! produced linear texture (icons, glyph atlases, the wallpaper) and, before
+//! serving it, re-reads the texture's whole span out of guest memory and
+//! compares it byte for byte with the copy. That re-read is how it knew the
+//! guest had not written the texture, and on a Home-screen swipe it was the
+//! largest cost in the drain: ~420 binds a second re-reading 1.1-2.9 GiB/s,
+//! `memo_read_us` + `memo_cmp_us` 90-280 ms of a 105-320 ms `resolve_us`
+//! (`sampled_resolve_split`), every one of them a hit.
+//!
+//! # The witness, and why it is the same one the device already trusts
+//!
+//! A bind may skip the read only when two independent accounts both say no
+//! byte of the span can have moved since the read that filled or last confirmed
+//! the memo — exactly the two halves [`crate::runtime::gather_witness`] and
+//! [`crate::runtime::gva_store_witness`] use for their own host-side copies:
+//!
+//! - **the guest CPU**: a tracking token over the span's guest pages
+//!   ([`HostOps::track_guest_writes`], the hypervisor dirty bitmap in
+//!   `reims-vgpu-dirty.c`), whose generation is harvested at every register
+//!   write that hands the device work — so every guest store ordered before a
+//!   submission is observed before that submission's draws run;
+//! - **this device**: [`crate::runtime::host_writes::HostWrites`], the
+//!   page-exact record every writer of guest pages notes into, asked with no
+//!   horizon; plus no submitted-but-unexecuted GPU write reaching the pages.
+//!
+//! Both baselines are taken **before** the read they vouch for, after the
+//! span's writeback debt is settled, so a write that races the read can only
+//! make the next bind refuse. The page list is part of the entry, so a guest
+//! that remaps the span to other pages is a re-point, not a stale answer. The
+//! memo's own content generation is part of it too, so a memo evicted or
+//! refilled in between cannot be served under an older vouch.
+//!
+//! # Everything undecidable reads
+//!
+//! No token (host without a dirty bitmap), a token still in its arming window,
+//! an unreadable generation, a short page walk, a moved page list, a moved
+//! memo, any guest store, any host write, any outstanding GPU write: each one
+//! refuses, and a refusal is the old read + compare, never a wrong frame.
+//!
+//! # The standing alarm
+//!
+//! One vouched bind in [`AUDIT_STRIDE`] per entry reads and compares anyway.
+//! Bytes that moved under a vouch fail through the always-on log
+//! (`lin_memo_witness_unsound`) and drop the entry. `REIMS_VGPU_LINEAR_MEMO_WITNESS=off`
+//! restores the read on every bind.
+
+use std::collections::HashMap;
+
+use crate::model::DeviceState;
+use crate::runtime::host::HostOps;
+use crate::runtime::host_writes::HostWriteVerdict;
+
+/// The guest linear memo's own key: (task, level-0 GVA, width, height, depth
+/// planes, sample format).
+pub type MemoKey = (u32, u64, u32, u32, u32, u16);
+
+/// Tracked spans at once. Each armed span adds its pages to the hypervisor
+/// harvest the BQL thread runs at every doorbell, so this is a harvest budget
+/// beside `gather_witness`'s 256 and `gva_store_witness`'s 128, sized to the
+/// working set the memo serves (a few dozen textures on a Home screen).
+const MAX_TRACKED_SPANS: usize = 64;
+
+/// Vouched binds of one span between audits: the same stride and the same
+/// reasoning as `gather_witness::AUDIT_STRIDE` — about a second of stale
+/// pixels at frame rate, at 1.6 % of the bytes the witness saves.
+pub const AUDIT_STRIDE: u32 = 64;
+
+#[derive(Debug)]
+struct Entry {
+    /// The span's guest pages, in GVA order, as walked when the token was armed.
+    gpas: Vec<u64>,
+    /// The span's byte length (`bpr * rows * planes`).
+    span: u64,
+    /// Host tracking token over `gpas`. Never 0.
+    token: u64,
+    /// Guest-write generation read before the read this entry vouches for. 0:
+    /// not armed — no read under a readable generation has confirmed the memo.
+    guest_gen: u64,
+    /// `host_writes.epoch()` read at the same moment.
+    host_epoch: u64,
+    /// The memo content generation those bytes are.
+    memo_generation: u64,
+    /// Vouches since the last audit.
+    vouches: u32,
+    last_seen: u64,
+}
+
+/// Per-device state: one entry per memo span worth tracking.
+#[derive(Debug, Default)]
+pub struct LinearMemoWitness {
+    entries: HashMap<MemoKey, Entry>,
+    binds: u64,
+}
+
+impl LinearMemoWitness {
+    /// Detach every token, for release through `retired_guest_write_tokens`.
+    pub fn take_tokens(&mut self) -> Vec<u64> {
+        let tokens = self.entries.values().map(|e| e.token).collect();
+        self.entries.clear();
+        tokens
+    }
+
+    fn touch(&mut self) -> u64 {
+        self.binds = self.binds.wrapping_add(1);
+        self.binds
+    }
+
+    #[cfg(test)]
+    fn len(&self) -> usize {
+        self.entries.len()
+    }
+}
+
+/// Why a bind may not skip its read.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Refusal {
+    /// No entry: the span has not been confirmed under a token yet.
+    NoEntry,
+    /// The page list or span length differs from the one the token watches.
+    Repointed,
+    /// Tracked, but no read has confirmed the memo under a readable generation.
+    Unarmed,
+    /// The memo is absent, refilled, or a different length than the entry's.
+    MemoMoved,
+    /// The hypervisor saw a guest store into the pages.
+    GuestWrote,
+    /// The host cannot read the token's generation.
+    GuestUnreadable,
+    /// This device's page record cannot call the pages quiet.
+    HostWrote(HostWriteVerdict),
+    /// A submitted GPU write could still land in the pages.
+    Pending,
+}
+
+impl Refusal {
+    pub fn route(self) -> &'static str {
+        match self {
+            Self::NoEntry => "lmw_no_entry",
+            Self::Repointed => "lmw_repointed",
+            Self::Unarmed => "lmw_unarmed",
+            Self::MemoMoved => "lmw_memo_moved",
+            Self::GuestWrote => "lmw_guest_wrote",
+            Self::GuestUnreadable => "lmw_guest_unreadable",
+            Self::HostWrote(HostWriteVerdict::Overlap) => "lmw_host_overlap",
+            Self::HostWrote(_) => "lmw_host_unnamed",
+            Self::Pending => "lmw_pending",
+        }
+    }
+}
+
+/// The answer for one bind.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Verdict {
+    /// Both halves quiet: serve the memo without reading.
+    Vouched,
+    /// Both halves quiet, and this bind is the entry's audit: read and compare,
+    /// and report a difference through [`note_audit`].
+    AuditDue,
+    Refused(Refusal),
+}
+
+/// Whether the witness runs at all. `off` is the narrowing arm: every bind
+/// reads, exactly as before the witness existed.
+pub fn enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        !matches!(
+            crate::config::switch(crate::config::LINEAR_MEMO_WITNESS),
+            crate::config::Switch::Off
+        )
+    })
+}
+
+/// Ask both halves about `key` for a bind whose span walks to `gpas`, with the
+/// memo currently at `memo_generation` (`None`: no memo of this span's length).
+///
+/// Call after the span's writeback debt is settled.
+pub fn ask<H: HostOps>(
+    state: &mut DeviceState,
+    host: &H,
+    key: MemoKey,
+    gpas: &[u64],
+    span: u64,
+    memo_generation: Option<u64>,
+    pending_disjoint: impl FnOnce(&[u64]) -> bool,
+) -> Verdict {
+    let DeviceState {
+        linear_memo_witness: witness,
+        host_writes,
+        ..
+    } = state;
+    let now = witness.touch();
+    let Some(e) = witness.entries.get_mut(&key) else {
+        return Verdict::Refused(Refusal::NoEntry);
+    };
+    e.last_seen = now;
+    if e.span != span || e.gpas != gpas {
+        return Verdict::Refused(Refusal::Repointed);
+    }
+    if e.guest_gen == 0 {
+        return Verdict::Refused(Refusal::Unarmed);
+    }
+    if memo_generation != Some(e.memo_generation) {
+        return Verdict::Refused(Refusal::MemoMoved);
+    }
+    match host.guest_write_gen(e.token) {
+        Some(g) if g == e.guest_gen => {}
+        Some(_) => return Verdict::Refused(Refusal::GuestWrote),
+        None => return Verdict::Refused(Refusal::GuestUnreadable),
+    }
+    match host_writes.wrote_any_since(e.host_epoch, gpas) {
+        HostWriteVerdict::Quiet => {}
+        other => return Verdict::Refused(Refusal::HostWrote(other)),
+    }
+    if !pending_disjoint(gpas) {
+        return Verdict::Refused(Refusal::Pending);
+    }
+    e.vouches += 1;
+    if e.vouches >= AUDIT_STRIDE {
+        e.vouches = 0;
+        Verdict::AuditDue
+    } else {
+        Verdict::Vouched
+    }
+}
+
+/// Both accounts as they stand immediately before a read.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Baseline {
+    token: u64,
+    /// `None` inside the host's arming window, or from a host that cannot say.
+    guest_gen: Option<u64>,
+    host_epoch: u64,
+}
+
+/// Take the baseline for a read of `key`'s span, tracking its pages if no live
+/// token watches exactly them. Call after the debt settle and **before** the
+/// read. `None` when the host cannot track the pages: the bind reads, as ever.
+pub fn baseline<H: HostOps>(
+    state: &mut DeviceState,
+    host: &mut H,
+    key: MemoKey,
+    gpas: &[u64],
+    span: u64,
+) -> Option<Baseline> {
+    if gpas.is_empty() {
+        return None;
+    }
+    let page_size = state.page_size() as usize;
+    let now = state.linear_memo_witness.touch();
+    let reusable = state
+        .linear_memo_witness
+        .entries
+        .get(&key)
+        .filter(|e| e.span == span && e.gpas == gpas)
+        .map(|e| e.token);
+    let token = match reusable {
+        Some(token) => token,
+        None => {
+            // A moved page list: the old token watches pages this span no
+            // longer has.
+            if let Some(old) = state.linear_memo_witness.entries.remove(&key) {
+                state.retired_guest_write_tokens.push(old.token);
+            }
+            while state.linear_memo_witness.entries.len() >= MAX_TRACKED_SPANS {
+                let Some(victim) = state
+                    .linear_memo_witness
+                    .entries
+                    .iter()
+                    .min_by_key(|(k, e)| (e.last_seen, **k))
+                    .map(|(k, _)| *k)
+                else {
+                    break;
+                };
+                if let Some(e) = state.linear_memo_witness.entries.remove(&victim) {
+                    crate::runtime::drain::note_store_route("lmw_evict");
+                    state.retired_guest_write_tokens.push(e.token);
+                }
+            }
+            let Some(token) = host.track_guest_writes(gpas, page_size) else {
+                crate::runtime::drain::note_store_route("lmw_untracked");
+                return None;
+            };
+            state.linear_memo_witness.entries.insert(
+                key,
+                Entry {
+                    gpas: gpas.to_vec(),
+                    span,
+                    token,
+                    guest_gen: 0,
+                    host_epoch: 0,
+                    memo_generation: 0,
+                    vouches: 0,
+                    last_seen: now,
+                },
+            );
+            token
+        }
+    };
+    Some(Baseline {
+        token,
+        guest_gen: host.guest_write_gen(token),
+        host_epoch: state.host_writes.epoch(),
+    })
+}
+
+/// The read under `baseline` found the memo's bytes at `memo_generation`: let
+/// later binds vouch for them. A baseline without a readable generation, or one
+/// whose token is no longer this entry's, arms nothing.
+pub fn arm(state: &mut DeviceState, key: MemoKey, baseline: Baseline, memo_generation: u64) {
+    let Some(guest_gen) = baseline.guest_gen.filter(|&g| g != 0) else {
+        crate::runtime::drain::note_store_route("lmw_arm_unarmed");
+        return;
+    };
+    let Some(e) = state.linear_memo_witness.entries.get_mut(&key) else {
+        return;
+    };
+    if e.token != baseline.token {
+        return;
+    }
+    e.guest_gen = guest_gen;
+    e.host_epoch = baseline.host_epoch;
+    e.memo_generation = memo_generation;
+    crate::runtime::drain::note_store_route("lmw_armed");
+}
+
+/// Forget `key`'s vouch (its token stays, re-armed by the next confirming read).
+pub fn disarm(state: &mut DeviceState, key: MemoKey) {
+    if let Some(e) = state.linear_memo_witness.entries.get_mut(&key) {
+        e.guest_gen = 0;
+        e.vouches = 0;
+    }
+}
+
+/// Report an audit read. `agreed`: the bytes were the memo's. A disagreement
+/// is a writer that escaped both halves — the one fault this module exists to
+/// rule out — so it fails visibly, once per span, and disarms the entry.
+pub fn note_audit(state: &mut DeviceState, key: MemoKey, agreed: bool) {
+    if agreed {
+        crate::runtime::drain::note_store_route("lmw_audit_ok");
+        return;
+    }
+    crate::runtime::drain::note_store_route("lmw_audit_unsound");
+    disarm(state, key);
+    let (task, gva, w, h, planes, fmt) = key;
+    if crate::observe::first_sight("lin_memo_witness_unsound", gva ^ u64::from(task) << 48) {
+        crate::observe::fail(format!(
+            "lin_memo_witness_unsound task={task} gva={gva:#x} {w}x{h} planes={planes} \
+             fmt={fmt:#x} (both write witnesses were quiet and the span's bytes moved; \
+             the memo had been served without reading for up to {AUDIT_STRIDE} binds)"
+        ));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::runtime::host::FakeHost;
+    use crate::runtime::host_writes::WriteRail;
+
+    const PAGE: u64 = 1u64 << crate::model::PAGE_SHIFT_X86;
+    const KEY: MemoKey = (3, 0x40_0000, 64, 64, 1, 0x50);
+
+    fn device() -> DeviceState {
+        DeviceState::new(crate::model::DeviceId(1), crate::model::PAGE_SHIFT_X86)
+    }
+
+    fn pages() -> Vec<u64> {
+        vec![7 * PAGE, 8 * PAGE, 12 * PAGE]
+    }
+
+    fn quiet(_: &[u64]) -> bool {
+        true
+    }
+
+    /// A span confirmed once under a readable generation: tracked, read,
+    /// armed at memo generation 5.
+    fn armed(state: &mut DeviceState, host: &mut FakeHost) {
+        let b = baseline(state, host, KEY, &pages(), 3 * PAGE).expect("tracked");
+        arm(state, KEY, b, 5);
+    }
+
+    fn ask_now(state: &mut DeviceState, host: &FakeHost) -> Verdict {
+        ask(state, host, KEY, &pages(), 3 * PAGE, Some(5), quiet)
+    }
+
+    #[test]
+    fn a_span_nobody_wrote_is_vouched() {
+        let (mut state, mut host) = (device(), FakeHost::new());
+        assert_eq!(
+            ask_now(&mut state, &host),
+            Verdict::Refused(Refusal::NoEntry)
+        );
+        armed(&mut state, &mut host);
+        assert_eq!(ask_now(&mut state, &host), Verdict::Vouched);
+        assert_eq!(ask_now(&mut state, &host), Verdict::Vouched);
+    }
+
+    /// The guest CPU half: one store into one page of the span refuses, and
+    /// keeps refusing until a read re-confirms the memo.
+    #[test]
+    fn a_guest_store_into_any_page_refuses_until_reconfirmed() {
+        let (mut state, mut host) = (device(), FakeHost::new());
+        armed(&mut state, &mut host);
+        host.guest_wrote_page(12 * PAGE + 5);
+        assert_eq!(
+            ask_now(&mut state, &host),
+            Verdict::Refused(Refusal::GuestWrote)
+        );
+        assert_eq!(
+            ask_now(&mut state, &host),
+            Verdict::Refused(Refusal::GuestWrote)
+        );
+        // A store outside the span is not this span's.
+        let (mut other, mut host2) = (device(), FakeHost::new());
+        armed(&mut other, &mut host2);
+        host2.guest_wrote_page(9 * PAGE);
+        assert_eq!(ask_now(&mut other, &host2), Verdict::Vouched);
+        // The read that follows a refusal re-arms at the new generation.
+        let b = baseline(&mut state, &mut host, KEY, &pages(), 3 * PAGE).unwrap();
+        arm(&mut state, KEY, b, 6);
+        assert_eq!(
+            ask(&mut state, &host, KEY, &pages(), 3 * PAGE, Some(6), quiet),
+            Verdict::Vouched
+        );
+    }
+
+    /// The device half: a recorded write into the span refuses; one into
+    /// another page does not; a write that could not name its pages refuses.
+    #[test]
+    fn a_device_write_into_the_span_refuses_and_an_unnamed_one_too() {
+        let (mut state, mut host) = (device(), FakeHost::new());
+        armed(&mut state, &mut host);
+        state.note_host_wrote_pages(WriteRail::listed("test"), vec![30 * PAGE]);
+        assert_eq!(ask_now(&mut state, &host), Verdict::Vouched);
+        state.note_host_wrote_pages(WriteRail::listed("test"), vec![8 * PAGE]);
+        assert_eq!(
+            ask_now(&mut state, &host),
+            Verdict::Refused(Refusal::HostWrote(HostWriteVerdict::Overlap))
+        );
+        let (mut s2, mut h2) = (device(), FakeHost::new());
+        armed(&mut s2, &mut h2);
+        s2.note_host_wrote_guest_ram();
+        assert!(matches!(
+            ask_now(&mut s2, &h2),
+            Verdict::Refused(Refusal::HostWrote(_))
+        ));
+    }
+
+    /// A submitted GPU write that could still land in the pages refuses.
+    #[test]
+    fn an_outstanding_gpu_write_refuses() {
+        let (mut state, mut host) = (device(), FakeHost::new());
+        armed(&mut state, &mut host);
+        assert_eq!(
+            ask(&mut state, &host, KEY, &pages(), 3 * PAGE, Some(5), |_| {
+                false
+            }),
+            Verdict::Refused(Refusal::Pending)
+        );
+    }
+
+    /// A remapped span, a different length, and a memo that moved or went.
+    #[test]
+    fn a_moved_page_list_span_or_memo_refuses() {
+        let (mut state, mut host) = (device(), FakeHost::new());
+        armed(&mut state, &mut host);
+        let moved = vec![7 * PAGE, 9 * PAGE, 12 * PAGE];
+        assert_eq!(
+            ask(&mut state, &host, KEY, &moved, 3 * PAGE, Some(5), quiet),
+            Verdict::Refused(Refusal::Repointed)
+        );
+        assert_eq!(
+            ask(&mut state, &host, KEY, &pages(), 2 * PAGE, Some(5), quiet),
+            Verdict::Refused(Refusal::Repointed)
+        );
+        assert_eq!(
+            ask(&mut state, &host, KEY, &pages(), 3 * PAGE, Some(4), quiet),
+            Verdict::Refused(Refusal::MemoMoved)
+        );
+        assert_eq!(
+            ask(&mut state, &host, KEY, &pages(), 3 * PAGE, None, quiet),
+            Verdict::Refused(Refusal::MemoMoved)
+        );
+        // Re-baselining over the moved list retires the old token.
+        let before = state.retired_guest_write_tokens.len();
+        baseline(&mut state, &mut host, KEY, &moved, 3 * PAGE).unwrap();
+        assert_eq!(state.retired_guest_write_tokens.len(), before + 1);
+        assert_eq!(
+            ask(&mut state, &host, KEY, &moved, 3 * PAGE, Some(5), quiet),
+            Verdict::Refused(Refusal::Unarmed)
+        );
+    }
+
+    /// The arming window: a token whose generation is not yet readable arms
+    /// nothing, and no host at all tracks nothing.
+    #[test]
+    fn an_unreadable_generation_or_no_dirty_bitmap_never_vouches() {
+        let (mut state, mut host) = (device(), FakeHost::new());
+        host.guest_write_startup_window = true;
+        let b = baseline(&mut state, &mut host, KEY, &pages(), 3 * PAGE).unwrap();
+        arm(&mut state, KEY, b, 5);
+        assert_eq!(
+            ask_now(&mut state, &host),
+            Verdict::Refused(Refusal::Unarmed)
+        );
+
+        let (mut s2, mut h2) = (device(), FakeHost::new());
+        h2.guest_writes_unobservable = true;
+        assert_eq!(baseline(&mut s2, &mut h2, KEY, &pages(), 3 * PAGE), None);
+        assert_eq!(ask_now(&mut s2, &h2), Verdict::Refused(Refusal::NoEntry));
+    }
+
+    /// A store that lands between the baseline and the read it describes makes
+    /// the *next* bind refuse: the baseline is the generation before the read.
+    #[test]
+    fn a_store_racing_the_read_is_caught_by_the_next_bind() {
+        let (mut state, mut host) = (device(), FakeHost::new());
+        let b = baseline(&mut state, &mut host, KEY, &pages(), 3 * PAGE).unwrap();
+        host.guest_wrote_page(7 * PAGE);
+        arm(&mut state, KEY, b, 5);
+        assert_eq!(
+            ask_now(&mut state, &host),
+            Verdict::Refused(Refusal::GuestWrote)
+        );
+    }
+
+    /// One vouch in `AUDIT_STRIDE` is an audit, and a disagreeing audit
+    /// disarms.
+    #[test]
+    fn every_stride_th_vouch_is_an_audit_and_a_failed_audit_disarms() {
+        let (mut state, mut host) = (device(), FakeHost::new());
+        armed(&mut state, &mut host);
+        for _ in 1..AUDIT_STRIDE {
+            assert_eq!(ask_now(&mut state, &host), Verdict::Vouched);
+        }
+        assert_eq!(ask_now(&mut state, &host), Verdict::AuditDue);
+        assert_eq!(ask_now(&mut state, &host), Verdict::Vouched);
+        note_audit(&mut state, KEY, false);
+        assert_eq!(
+            ask_now(&mut state, &host),
+            Verdict::Refused(Refusal::Unarmed)
+        );
+    }
+
+    /// The map is bounded and an eviction releases its token.
+    #[test]
+    fn the_tracked_set_is_bounded_and_evictions_release_tokens() {
+        let (mut state, mut host) = (device(), FakeHost::new());
+        for i in 0..(MAX_TRACKED_SPANS as u64 + 5) {
+            let key = (1, 0x10_0000 + i * 0x1_0000, 8, 8, 1, 0x50);
+            baseline(&mut state, &mut host, key, &[(100 + i) * PAGE], PAGE).unwrap();
+        }
+        assert_eq!(state.linear_memo_witness.len(), MAX_TRACKED_SPANS);
+        assert_eq!(state.retired_guest_write_tokens.len(), 5);
+        let tokens = state.linear_memo_witness.take_tokens();
+        assert_eq!(tokens.len(), MAX_TRACKED_SPANS);
+        assert_eq!(state.linear_memo_witness.len(), 0);
+    }
+}
