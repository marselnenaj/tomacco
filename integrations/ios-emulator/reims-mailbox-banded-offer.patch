+    /// The banded hand-off copy is the plain copy at every size: below the
+    /// threshold, at it, and at lengths no band count divides.
+    #[test]
+    fn the_banded_copy_is_the_plain_copy() {
+        for len in [
+            0,
+            1,
+            BANDED_COPY_MIN_BYTES - 1,
+            BANDED_COPY_MIN_BYTES,
+            BANDED_COPY_MIN_BYTES + 3,
+            1206 * 2622 * 4,
+        ] {
+            let src: Vec<u8> = (0..len)
+                .map(|i| (i as u32).wrapping_mul(2_654_435_761).rotate_right(7) as u8)
+                .collect();
+            let mut dst = vec![0xa5u8; len];
+            copy_in_bands(&mut dst, &src);
+            assert!(dst == src, "length {len}");
+        }
+    }
+
+    /// Timing, not a check: `cargo test --release -- --ignored --nocapture
+    /// banded_copy_timing`. The vphone's 1206x2622 BGRA8 retain into a reused
+    /// hand-off buffer, one `copy_from_slice` against the banded copy. Median
+    /// of 31 runs each; wall clock on a shared host.
+    #[test]
+    #[ignore]
+    fn banded_copy_timing() {
+        let len = 1206 * 2622 * 4;
+        let src: Vec<u8> = (0..len)
+            .map(|i| (i as u32).wrapping_mul(31) as u8)
+            .collect();
+        let mut dst = vec![0u8; len];
+        let median = |mut runs: Vec<u128>| {
+            runs.sort_unstable();
+            runs[runs.len() / 2]
+        };
+        for _ in 0..2 {
+            let plain: Vec<u128> = (0..31)
+                .map(|_| {
+                    let started = Instant::now();
+                    dst.copy_from_slice(&src);
+                    started.elapsed().as_micros()
+                })
+                .collect();
+            let banded: Vec<u128> = (0..31)
+                .map(|_| {
+                    let started = Instant::now();
+                    copy_in_bands(&mut dst, &src);
+                    started.elapsed().as_micros()
+                })
+                .collect();
+            println!(
+                "banded_copy_timing plain_median_us={} banded_median_us={}",
+                median(plain),
+                median(banded)
+            );
+        }
+    }
+
+    /// An offer of the frame's own geometry reuses the hand-off and still
+    /// carries the newest bytes, also after the writer swapped buffers.
+    #[test]
+    fn a_repeated_offer_carries_the_newest_bytes() {
+        let dir = scratch("banded-offer");
+        let path = dir.0.join("frames");
+        let publisher = Publisher::start(Writer::create(&path, None).unwrap()).unwrap();
+        // 1.2 MB a frame, past the banded threshold.
+        let (w, h) = (640u32, 480u32);
+        for seed in 0..4u8 {
+            publisher.offer(&picture(w, h, seed), w, h, u64::from(seed) + 1);
+            assert!(publisher.settle(Duration::from_secs(5)));
+        }
+        let Read::Frame(frame) = read(&open(&path)).unwrap() else {
+            panic!("no frame after four offers");
+        };
+        assert_eq!((frame.number, frame.generation), (4, 4));
+        assert!(frame.pixels == picture(w, h, 3));
+    }
