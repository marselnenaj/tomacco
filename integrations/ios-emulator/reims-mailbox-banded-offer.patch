+/// A frame at least this large is copied into the hand-off in bands.
+const BANDED_COPY_MIN_BYTES: usize = 1 << 20;
+
+/// The most threads one hand-off copy uses, the drain's own included.
+const BANDED_COPY_MAX_THREADS: usize = 4;
+
+/// Copy `src` into `dst` (the same length), in up to
+/// [`BANDED_COPY_MAX_THREADS`] contiguous bands on scoped threads.
+///
+/// The hand-off is the one whole-frame pass the present drain still makes for
+/// the viewer: 12.6 MB for the vphone's 1206x2622 BGRA8 retain, which one
+/// thread copied in ~1.5 ms a frame on the development host (`frame_mailbox
+/// offer_us / offered`), under the device lock. The bytes are the same in any
+/// split; only how many cores move them changes.
+fn copy_in_bands(dst: &mut [u8], src: &[u8]) {
+    debug_assert_eq!(dst.len(), src.len());
+    let threads = if src.len() >= BANDED_COPY_MIN_BYTES {
+        std::thread::available_parallelism()
+            .map(usize::from)
+            .unwrap_or(1)
+            .clamp(1, BANDED_COPY_MAX_THREADS)
+    } else {
+        1
+    };
+    if threads <= 1 {
+        dst.copy_from_slice(src);
+        return;
+    }
+    let band = src.len().div_ceil(threads);
+    std::thread::scope(|scope| {
+        let mut bands = dst.chunks_mut(band).zip(src.chunks(band));
+        let own = bands.next();
+        for (d, s) in bands {
+            scope.spawn(move || d.copy_from_slice(s));
+        }
+        if let Some((d, s)) = own {
+            d.copy_from_slice(s);
+        }
+    });
+}
