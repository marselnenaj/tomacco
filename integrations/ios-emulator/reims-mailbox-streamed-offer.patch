+/// One band of [`copy_in_bands`], with streaming stores: the hand-off buffer
+/// is read next by the writer thread, not by the drain, so its old contents
+/// need not be read first nor its new ones kept in the drain's cache. Fenced
+/// before the band's thread ends, so the writer, which takes the buffer under
+/// the lock the drain releases after joining every band, sees every byte.
+fn stream_band(dst: &mut [u8], src: &[u8]) {
+    let n = dst.len().min(src.len());
+    // SAFETY: both slices hold `n` bytes and a `&mut` cannot overlap a `&`.
+    unsafe { crate::runtime::stream_copy::stream_copy(src.as_ptr(), dst.as_mut_ptr(), n) };
+    crate::runtime::stream_copy::stream_fence();
+}
