+    /// A session publishes more surface requests than the array holds, and the
+    /// requests past its end are read from the slots the guest wrote them to.
+    ///
+    /// Reading the count as the slot decoded the 1025th request of every long
+    /// session from the memory after the array, which lost every MAP and UNMAP
+    /// from then on.
+    #[test]
+    fn mapper_requests_past_the_array_end_are_read_from_their_slots() {
+        use crate::protocol::iosurface_pages::{MAPPER_REQUEST_MAP, MAPPER_REQUEST_UNMAP};
+        let mut d = dev();
+        let mut h = FakeHost::new();
+        let base = 0x8000_0000u64;
+        let capacity = 4u32;
+        h.map_range(base, 0x1000, 0);
+        d.iosfc_write(&mut h, IOSFC_REG_RING_BASE, base, MMIO_U64);
+        d.iosfc_write(&mut h, IOSFC_REG_CAPACITY, u64::from(capacity), MMIO_U32);
+        let mut published = 0u32;
+        let mut publish = |d: &mut Device, h: &mut FakeHost, kind: u32, mapping_id: u32| {
+            let slot = base + u64::from(published % capacity) * 16;
+            let _ = h.write_gpa(slot, &kind.to_le_bytes());
+            let _ = h.write_gpa(slot + 4, &mapping_id.to_le_bytes());
+            published += 1;
+            d.iosfc_write(h, IOSFC_REG_PRODUCER, u64::from(published), MMIO_U32);
+        };
+        for id in 7..11 {
+            publish(&mut d, &mut h, MAPPER_REQUEST_MAP, id);
+        }
+        // The array is full; these two land in slots 0 and 1 again.
+        publish(&mut d, &mut h, MAPPER_REQUEST_UNMAP, 7);
+        publish(&mut d, &mut h, MAPPER_REQUEST_MAP, 11);
+
+        assert_eq!(d.state.iosfc.consumer, 6);
+        assert!(
+            !d.state.mappings[&7].mapped,
+            "the unmap past the end applied"
+        );
+        assert!(d.state.mappings[&11].mapped, "the map past the end applied");
+        assert!(
+            d.fails().is_empty(),
+            "no request decoded from outside the array"
+        );
+    }
+
+    /// A count further ahead than the array holds names no slot this device
+    /// can trust, so it is caught up rather than decoded.
+    #[test]
+    fn mapper_counts_further_apart_than_the_array_are_not_decoded() {
+        let mut d = dev();
+        let mut h = FakeHost::new();
+        let base = 0x8000_0000u64;
+        h.map_range(base, 0x1000, 0);
+        d.iosfc_write(&mut h, IOSFC_REG_RING_BASE, base, MMIO_U64);
+        d.iosfc_write(&mut h, IOSFC_REG_CAPACITY, 4, MMIO_U32);
+        let _ = h.write_gpa(base, &1u32.to_le_bytes());
+        let _ = h.write_gpa(base + 4, &7u32.to_le_bytes());
+        d.iosfc_write(&mut h, IOSFC_REG_PRODUCER, 9, MMIO_U32);
+        assert_eq!(d.state.iosfc.consumer, 9);
+        assert!(!d.state.mappings.contains_key(&7));
+    }
