+/// The mapper request counts name entries this device cannot locate.
+///
+/// Both arms skip requests, which is a loss of guest surface lifecycle events,
+/// so each says how many and from which counts.
+pub(crate) enum MapperRingDecline {
+    /// The guest published requests before programming the array's capacity,
+    /// so no request has a slot.
+    CapacityUnset { producer: u32, consumer: u32 },
+    /// The guest's count is further ahead of this device's than the array
+    /// holds, so the slots no longer carry the requests between them.
+    CountsDesynced {
+        producer: u32,
+        consumer: u32,
+        capacity: u32,
+    },
+}
+
+impl crate::observe::Decline for MapperRingDecline {
+    fn slug(&self) -> &'static str {
+        match self {
+            Self::CapacityUnset { .. } => "mapper_ring_capacity_unset",
+            Self::CountsDesynced { .. } => "mapper_ring_counts_desynced",
+        }
+    }
+
+    fn fields(&self) -> Vec<(&'static str, String)> {
+        match *self {
+            Self::CapacityUnset { producer, consumer } => vec![
+                ("producer", producer.to_string()),
+                ("consumer", consumer.to_string()),
+                ("skipped", producer.wrapping_sub(consumer).to_string()),
+            ],
+            Self::CountsDesynced {
+                producer,
+                consumer,
+                capacity,
+            } => vec![
+                ("producer", producer.to_string()),
+                ("consumer", consumer.to_string()),
+                ("capacity", capacity.to_string()),
+                ("skipped", producer.wrapping_sub(consumer).to_string()),
+            ],
+        }
+    }
+}
+
