+/// Whether a read in a scope may vouch for later binds in it.
+pub fn scope_enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        !matches!(
+            crate::config::switch(crate::config::LINEAR_MEMO_SCOPE),
+            crate::config::Switch::Off
+        )
+    })
+}
+
+/// A command buffer's walk begins: reads from here on may vouch for later binds
+/// until [`close_scope`] or [`break_scope`].
+pub fn open_scope(state: &mut DeviceState) {
+    let w = &mut state.linear_memo_witness;
+    w.scopes = w.scopes.wrapping_add(1).max(1);
+    w.scope = w.scopes;
+}
+
+/// The walk ended: no read vouches outside the scope it was made in.
+pub fn close_scope(state: &mut DeviceState) {
+    state.linear_memo_witness.scope = 0;
+}
+
+/// An event record: the guest CPU may write between what came before it and
+/// what follows, so what follows starts a scope of its own.
+pub fn break_scope(state: &mut DeviceState) {
+    if state.linear_memo_witness.scope != 0 {
+        open_scope(state);
+    }
+}
