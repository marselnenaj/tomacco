+        assert!(line.contains(" host_us=42000 host_max_us=42000 "), "{line}");
+        assert!(
+            line.contains(" gap_n=1 gap_us=57500 gap_max_us=57500 overlapped=0 "),
+            "{line}"
+        );
+        assert!(line.ends_with(" gpu_busy=card2:99"), "{line}");
+    }
+
+    /// An exec dispatched in the present's own tranche was queued before the
+    /// guest could have seen the stamp: it is an overlap and not a gap, and it
+    /// must not arm a gap that the following frame would be charged with.
+    #[test]
+    fn an_exec_behind_the_present_in_one_tranche_is_an_overlap() {
+        let mut c = FrameCycleCensus::default();
+        c.note_op(0x08, 10_000, 5_000);
+        c.note_op(0x37, 20_000, 10_000);
+        c.tranche_ended(20_100);
+        c.note_op(0x37, 90_000, 10_000);
+        let line = c.take("none").unwrap();
+        assert!(
+            line.contains(" gap_n=0 gap_us=0 gap_max_us=0 overlapped=1 "),
+            "{line}"
+        );
+    }
+
+    /// A window without a present says nothing, and a report keeps the frame
+    /// in progress, so the next window's first interval is measured from the
+    /// last present of this one.
+    #[test]
+    fn the_report_resets_counts_and_keeps_the_frame_in_progress() {
+        let mut c = FrameCycleCensus::default();
+        assert_eq!(c.take("none"), None);
+        c.note_op(0x08, 10_000, 1_000);
+        c.tranche_ended(10_000);
+        assert!(c.take("none").unwrap().contains("presents=1 intervals=0 "));
+        c.note_op(0x37, 50_000, 20_000);
+        c.note_op(0x08, 60_000, 10_000);
+        let line = c.take("none").unwrap();
+        assert!(
+            line.contains("presents=1 intervals=1 interval_us=50000 "),
+            "{line}"
+        );
+        assert!(line.contains(" host_us=30000 "), "{line}");
+        assert!(line.contains(" gap_n=1 gap_us=20000 "), "{line}");
+    }
+}
