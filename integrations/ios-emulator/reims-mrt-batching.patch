+/// Two MRT draws in a row share one command buffer: the first opens a batch,
+/// the second joins it, and both attachments still hold what the draws
+/// recorded when the batch is finally read.
+///
+/// The iOS compositor draws every Home-screen quad into two attachments, and
+/// MRT used to bar batching outright (`nojoin_mrt`), which made each of a
+/// frame's 28-46 draws its own submission and fence. The secondary here is
+/// cleared to blue with every channel masked off, then *loaded* by the joining
+/// draw, so a join that lost the first pass's store or recorded the second
+/// pass against the wrong framebuffer reads back something other than blue.
+#[test]
+fn consecutive_mrt_draws_join_one_batch_and_keep_both_attachments() {
+    use reims_vgpu_core::blend::ColorWriteMask;
+    let _g = engine_test_session();
+    let (v, f) = triangle_spirv();
+    let (w, h) = (16u32, 16u32);
+    let primary = TargetIdentity::Surface {
+        id: 0x1b0,
+        width: w,
+        height: h,
+        generation: 1,
+        format: SURFACE_TEST_FORMAT,
+    };
+    let secondary = TargetIdentity::Surface {
+        id: 0x1b1,
+        width: w,
+        height: h,
+        generation: 1,
+        format: SURFACE_TEST_FORMAT,
+    };
+    let draw = |load_secondary: bool| {
+        let mut req = engine_req(&v, &f, w, h);
+        req.target_identity = Some(primary.clone());
+        req.skip_readback = true;
+        req.secondary_targets.push(SecondaryColorTarget {
+            seed: None,
+            identity: secondary.clone(),
+            width: w,
+            height: h,
+            attachment: color_attachment(
+                reims_vgpu::protocol::pixel_format::MTL_FORMAT_RGBA8_UNORM,
+                [0.0, 0.0, 1.0, 1.0],
+            ),
+            load: load_secondary,
+            blend: None,
+            color_write_mask: ColorWriteMask::NONE,
+        });
+        req
+    };
+    engine::reset_draw_counters();
+    let before = engine::counter_snapshot();
+    match engine::execute_draw_request(engine_device(), &draw(false)) {
+        Ok(_) => {}
+        Err(e) if skip_if_no_gpu(&e.to_string()) => {
+            eprintln!("SKIP consecutive mrt batch: {e}");
+            return;
+        }
+        Err(e) => panic!("first mrt draw: {e}"),
+    }
+    engine::execute_draw_request(engine_device(), &draw(true)).expect("joining mrt draw");
+    let d = engine::counter_snapshot().delta_since(&before);
+    assert!(
+        d.batch_opens >= 1,
+        "the first MRT draw must open a batch: {d:?}"
+    );
+    assert!(
+        d.batch_joins >= 1,
+        "the second MRT draw must join it: {d:?}"
+    );
+
+    let px = engine::read_target(&primary)
+        .expect("read the primary")
+        .into_rgba8()
+        .expect("an eight-bit colour readback");
+    let all_green = (0..(w * h) as usize).all(|p| near(px[p * 4 + 1], 128));
+    assert!(
+        all_green,
+        "the primary must hold the fragment colour everywhere"
+    );
+    let px = engine::read_target(&secondary)
+        .expect("read the secondary")
+        .into_rgba8()
+        .expect("an eight-bit colour readback");
+    let i = ((h / 2) * w + w / 2) as usize * 4;
+    let (c0, g, c2, a) = (px[i], px[i + 1], px[i + 2], px[i + 3]);
+    assert!(
+        g == 0 && a == 255 && ((c0 == 255 && c2 == 0) || (c0 == 0 && c2 == 255)),
+        "the masked secondary must keep the first pass's blue clear through the join: \
+         ({c0},{g},{c2},{a})"
+    );
+}
