+static FRAME_CYCLE: std::sync::Mutex<FrameCycleCensus> =
+    std::sync::Mutex::new(FrameCycleCensus::new());
+
+/// Opcodes that present a frame: op8 `CmdDisplaySwapMapping` on the arm
+/// pathway, op6/op7 on the x86 display pipe.
+const PRESENT_OPCODES: [u16; 3] = [0x06, 0x07, 0x08];
+/// `CmdExecIndirect2`, the packet a frame's GPU work arrives in.
+const EXEC_OPCODE: u16 = 0x37;
+
+/// A frame's lifecycle from the device's side, split at the two hand-offs.
+///
+/// `drain_duty` says how busy the worker was and `drain_ops` which packets it
+/// was busy with, but neither says what the *frame rate* is waiting for. A
+/// guest that renders one frame at a time spends each frame interval in two
+/// alternating places: this device executing the frame's packets (`host_us`),
+/// and the guest between being told the previous frame completed and handing
+/// over the next one (`gap_us`: from the end of the tranche that carried a
+/// present, which is when its stamp is published and the IRQ queued, to the
+/// start of the next `CmdExecIndirect2`). That gap holds the IRQ delivery, the
+/// guest's wake-up and all of its CPU work for the next frame. `host_us +
+/// gap_us` near `interval_us` means the two run serially, and the larger of
+/// the two is the one worth attacking. `overlapped` counts frames whose next
+/// exec had already arrived in the present's own tranche — the guest was ahead
+/// of the device.
+///
+/// `gpu_busy` is the host's own busy figure for every DRM card that publishes
+/// one (amdgpu's `gpu_busy_percent`), sampled at report time. It is not this
+/// device's load: it once read 99 % on the card this device renders on while
+/// `gpu_span busy_us` said this device used 2.5 % of it, because another
+/// process held the GPU — and every fence wait here queues behind that.
+#[derive(Debug, Default)]
+pub(crate) struct FrameCycleCensus {
+    presents: u64,
+    interval_us: u64,
+    interval_max_us: u64,
+    intervals: u64,
+    host_us: u64,
+    host_max_us: u64,
+    gap_n: u64,
+    gap_us: u64,
+    gap_max_us: u64,
+    overlapped: u64,
+    /// Dispatch time of every child packet since the last present.
+    host_acc_us: u64,
+    last_present_end_us: Option<u64>,
+    /// A present was dispatched in the tranche now running.
+    present_in_tranche: bool,
+    /// When the last present's tranche ended, while no exec has followed.
+    present_visible_us: Option<u64>,
+}
+
+impl FrameCycleCensus {
+    const fn new() -> Self {
+        Self {
+            presents: 0,
+            interval_us: 0,
+            interval_max_us: 0,
+            intervals: 0,
+            host_us: 0,
+            host_max_us: 0,
+            gap_n: 0,
+            gap_us: 0,
+            gap_max_us: 0,
+            overlapped: 0,
+            host_acc_us: 0,
+            last_present_end_us: None,
+            present_in_tranche: false,
+            present_visible_us: None,
+        }
+    }
+
+    /// One child packet dispatch that ended at `end_us` and took `dur_us`.
+    pub(crate) fn note_op(&mut self, opcode: u16, end_us: u64, dur_us: u64) {
+        self.host_acc_us = self.host_acc_us.saturating_add(dur_us);
+        if PRESENT_OPCODES.contains(&opcode) {
+            self.presents += 1;
+            if let Some(last) = self.last_present_end_us {
+                let interval = end_us.saturating_sub(last);
+                self.interval_us = self.interval_us.saturating_add(interval);
+                self.interval_max_us = self.interval_max_us.max(interval);
+                self.intervals += 1;
+                self.host_us = self.host_us.saturating_add(self.host_acc_us);
+                self.host_max_us = self.host_max_us.max(self.host_acc_us);
+            }
+            self.host_acc_us = 0;
+            self.last_present_end_us = Some(end_us);
+            self.present_in_tranche = true;
+            self.present_visible_us = None;
+        } else if opcode == EXEC_OPCODE {
+            if self.present_in_tranche {
+                // The next frame was already queued behind the present.
+                self.overlapped += 1;
+                self.present_in_tranche = false;
+            } else if let Some(visible) = self.present_visible_us.take() {
+                let start = end_us.saturating_sub(dur_us);
+                let gap = start.saturating_sub(visible);
+                self.gap_n += 1;
+                self.gap_us = self.gap_us.saturating_add(gap);
+                self.gap_max_us = self.gap_max_us.max(gap);
+            }
+        }
+    }
+
+    /// The tranche now ending published its stamps at `now_us`.
+    pub(crate) fn tranche_ended(&mut self, now_us: u64) {
+        if self.present_in_tranche {
+            self.present_in_tranche = false;
+            self.present_visible_us = Some(now_us);
+        }
+    }
+
+    /// The window's line, or `None` when no present was dispatched in it.
+    pub(crate) fn take(&mut self, gpu_busy: &str) -> Option<String> {
+        if self.presents == 0 {
+            return None;
+        }
+        let line = format!(
+            "frame_cycle presents={} intervals={} interval_us={} interval_max_us={} \
+             host_us={} host_max_us={} gap_n={} gap_us={} gap_max_us={} overlapped={} \
+             gpu_busy={gpu_busy}",
+            self.presents,
+            self.intervals,
+            self.interval_us,
+            self.interval_max_us,
+            self.host_us,
+            self.host_max_us,
+            self.gap_n,
+            self.gap_us,
+            self.gap_max_us,
+            self.overlapped,
+        );
+        let keep = (
+            self.host_acc_us,
+            self.last_present_end_us,
+            self.present_in_tranche,
+            self.present_visible_us,
+        );
+        *self = Self::new();
+        (
+            self.host_acc_us,
+            self.last_present_end_us,
+            self.present_in_tranche,
+            self.present_visible_us,
+        ) = keep;
+        Some(line)
+    }
+}
+
+/// `card<N>:<percent>` for every DRM card that publishes `gpu_busy_percent`,
+/// comma-separated, or `none`. A sysfs read per card once a second.
+fn host_gpu_busy() -> String {
+    #[cfg(target_os = "linux")]
+    {
+        let mut cards: Vec<(u32, String)> = Vec::new();
+        if let Ok(entries) = std::fs::read_dir("/sys/class/drm") {
+            for entry in entries.flatten() {
+                let name = entry.file_name().to_string_lossy().into_owned();
+                let Some(index) = name
+                    .strip_prefix("card")
+                    .and_then(|rest| rest.parse::<u32>().ok())
+                else {
+                    continue;
+                };
+                if let Ok(text) =
+                    std::fs::read_to_string(entry.path().join("device/gpu_busy_percent"))
+                {
+                    cards.push((index, format!("card{index}:{}", text.trim())));
+                }
+            }
+        }
+        cards.sort();
+        if !cards.is_empty() {
+            return cards
+                .into_iter()
+                .map(|(_, s)| s)
+                .collect::<Vec<_>>()
+                .join(",");
+        }
+    }
+    "none".to_string()
+}
