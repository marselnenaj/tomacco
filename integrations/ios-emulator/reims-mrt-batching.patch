+#[cfg(test)]
+mod frame_cycle_tests {
+    use super::{DrainDutyCensus, FrameCycleCensus};
+
+    /// `drain_ops` names the longest dispatch of each opcode beside its sum, and
+    /// the report resets it with the sum.
+    #[test]
+    fn drain_ops_reports_each_opcodes_longest_dispatch() {
+        let c = DrainDutyCensus::default();
+        c.note_proc(0x37, 30_000_000);
+        c.note_proc(0x37, 12_000_000);
+        c.note_proc(0x08, 11_000_000);
+        let line = c.take_proc_ops().expect("packets were dispatched");
+        assert!(
+            line.contains(" op0x37_us=42000 op0x37_n=2 op0x37_max_us=30000"),
+            "{line}"
+        );
+        assert!(
+            line.contains(" op0x08_us=11000 op0x08_n=1 op0x08_max_us=11000"),
+            "{line}"
+        );
+        c.note_proc(0x37, 1_000_000);
+        let line = c.take_proc_ops().unwrap();
+        assert!(line.contains(" op0x37_max_us=1000"), "{line}");
+    }
+
+    /// Two frames rendered one at a time: exec, present, guest gap, exec,
