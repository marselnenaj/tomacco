+    /// The record loop gives every record after the first its pass's LOAD. On a
+    /// multisample pass that is the encoder continuing, which the engine keeps
+    /// open; only an encoder that starts by loading is refused.
+    #[test]
+    fn a_continued_multisample_record_loads_what_its_encoder_rendered() {
+        use crate::backend::vulkan::engine::reason::DrawReason;
+        use reims_vgpu_protocol::pass_action::{
+            MTL_STORE_ACTION_MULTISAMPLE_RESOLVE, MTL_STORE_ACTION_STORE,
+        };
+
+        let mut req = DrawEncodeRequest::default();
+        req.colors.push(ColorRtRequest {
+            width: 8,
+            height: 8,
+            multisample_source_ref: 42,
+            load_action: MTL_LOAD_ACTION_LOAD,
+            store_action: MTL_STORE_ACTION_MULTISAMPLE_RESOLVE,
+            ..Default::default()
+        });
+        assert!(matches!(
+            multisample_admission(&req),
+            Err(DrawReason::MultisampleLoadActionUnsupported { .. })
+        ));
+        req.continues_render_pass = true;
+        assert!(multisample_admission(&req).is_ok());
+        req.colors[0].store_action = MTL_STORE_ACTION_STORE;
+        assert!(matches!(
+            multisample_admission(&req),
+            Err(DrawReason::MultisampleStoreActionUnsupported { .. })
+        ));
+    }
+
     /// A record continuing a serialized pass loads what the records before it
