+/// What a draw resolving a multisample source must look like before anything
+/// is staged for it: one resolving colour target in slot zero, resolved by a
+/// resolve-only store.
+///
+/// A record that *starts* its guest encoder by loading the multisample source
+/// asks for an image this rail cannot import -- the source is a scratch image
+/// that lives only while an encoder is open. A record that *continues* the
+/// encoder loads what the records before it rendered, which is exactly what
+/// that scratch holds: the engine keeps it open for the whole encoder and
+/// resolves after the last draw (`one_multisample_encoder_resolves_after_its_last_draw`).
+/// The record loop gives every record after the first the pass's LOAD, so
+/// refusing a continued record refused every multisample pass of more than one
+/// draw -- iOS's wallpaper among them, whose passes were then cleared instead.
+fn multisample_admission(
+    req: &DrawEncodeRequest,
+) -> Result<(), crate::backend::vulkan::engine::reason::DrawReason> {
+    use crate::backend::vulkan::engine::reason::DrawReason;
+    use reims_vgpu_protocol::pass_action::MTL_STORE_ACTION_MULTISAMPLE_RESOLVE;
+    let resolving_colors = req
+        .colors
+        .iter()
+        .filter(|color| color.multisample_source_ref != 0)
+        .count();
+    if resolving_colors != 0
+        && (resolving_colors != 1
+            || req
+                .colors
+                .first()
+                .is_none_or(|color| color.multisample_source_ref == 0))
+    {
+        return Err(DrawReason::MultisampleResolveShapeUnsupported {
+            color_targets: req.colors.len() as u32,
+            depth: req.depth_attach.is_some(),
+            color_input: false,
+        });
+    }
+    if let Some(color) = req
+        .colors
+        .first()
+        .filter(|color| color.multisample_source_ref != 0)
+    {
+        if color.store_action != MTL_STORE_ACTION_MULTISAMPLE_RESOLVE {
+            return Err(DrawReason::MultisampleStoreActionUnsupported {
+                store_action: color.store_action,
+            });
+        }
+        if color.load_action == MTL_LOAD_ACTION_LOAD && !req.continues_render_pass {
+            return Err(DrawReason::MultisampleLoadActionUnsupported {
+                load_action: color.load_action,
+            });
+        }
+    }
+    Ok(())
+}
