+/// Whether this request's colour 0 is a multisample source at the start of
+/// its guest encoder.
+///
+/// The draw side asks the same question of its own request
+/// (`runtime::draw::vulkan::multisample_source_begins_undefined`) and walks no
+/// seed door for it; this is the engine's half, which decides what the pass
+/// begins with. `continues_render_pass` is the whole distinction: a continued
+/// record's LOAD is the scratch this engine kept open for its encoder.
+pub(crate) fn multisample_source_begins_undefined(req: &DrawRequest) -> bool {
+    req.multisample_resolve && !req.continues_render_pass
+}
+
+/// What a pass may begin its colour 0 with, resolved once from the request.
+///
+/// The request's chain and seed fields are ordered --
+/// [`DrawRequest::load_from_target`] states the order -- and [`Self::resolve`]
+/// reads them in it. It also applies the one rule that overrides all of them:
+/// a multisample source at the start of its encoder
+/// ([`multisample_source_begins_undefined`]) begins undefined, or cleared when
+/// the guest asked for a clear, whatever the request offers.
+///
+/// Every one of those fields names the *resolve target*: `load_from_target`
+/// the resident the draw side chains from, the two seeds its bytes,
+/// `seed_from_target` a resident to copy into it, `load_guest_target_backing`
+/// its imported allocation. The attachment the pass begins is the multisample
+/// scratch, which Metal discards at every resolve-only store and which no guest
+/// storage describes, so there are no prior contents for a LOAD to read on the
+/// device either. Honouring the fields would LOAD whatever an earlier pass left
+/// in a pooled scratch, or copy the resolve target's bytes into it at the wrong
+/// sample count -- and `load_from_target` on a resident nothing has rendered
+/// yet was answered with `LoadTargetContentNotReady`, which refused the first
+/// record of every multisample encoder the guest opened with a LOAD
+/// (`an_encoder_starting_by_loading_its_multisample_source_begins_it_undefined`).
+/// The fields are ignored rather than refused: they are correct descriptions of
+/// the resolve target, and the one rail that needs that target -- the resolve
+/// itself -- reads none of them.
+#[derive(Clone, Copy)]
+struct Color0Sources<'a> {
+    /// Load the live resident of [`DrawRequest::target_identity`].
+    load_from_target: bool,
+    /// CPU seed bytes to stage, borrowed from the request.
+    cpu_seed: Option<&'a [u8]>,
+    /// Guest-page seed.
+    guest_seed: Option<&'a super::types::GuestTargetSeed>,
+    /// Present-boundary copy from another resident.
+    seed_from_target: Option<&'a TargetIdentity>,
+    /// Load the imported guest allocation the target is created over, when it
+    /// is.
+    load_guest_target_backing: bool,
+    /// What the pass begins with, given the above and what the guest declared.
+    load: Color0Load,
+}
+
+impl<'a> Color0Sources<'a> {
+    fn resolve(req: &'a DrawRequest) -> Self {
+        let source_begins_undefined = multisample_source_begins_undefined(req);
+        let load_from_target = req.load_from_target && !source_begins_undefined;
+        // The seed is borrowed from `req`, never copied to the heap: see the
+        // measurement at the call site.
+        let cpu_seed = if load_from_target || source_begins_undefined {
+            None
+        } else {
+            req.target_cpu_seed
+                .as_ref()
+                .map(|seed| seed.pixels.as_slice())
+        };
+        let guest_seed = if source_begins_undefined {
+            None
+        } else {
+            req.target_guest_seed.as_ref()
+        };
+        let seed_from_target = if source_begins_undefined {
+            None
+        } else {
+            req.seed_from_target.as_ref()
+        };
+        let load_guest_target_backing = req.load_guest_target_backing && !source_begins_undefined;
+        let load = if load_from_target
+            || cpu_seed.is_some()
+            || guest_seed.is_some()
+            || seed_from_target.is_some()
+        {
+            Color0Load::Preserve
+        } else if req
+            .color0_declared
+            .is_some_and(|declared| declared.preserves_prior_contents())
+        {
+            Color0Load::Undefined
+        } else {
+            Color0Load::Clear
+        };
+        Self {
+            load_from_target,
+            cpu_seed,
+            guest_seed,
+            seed_from_target,
+            load_guest_target_backing,
+            load,
+        }
+    }
+}
