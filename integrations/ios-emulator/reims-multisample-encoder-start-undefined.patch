+    /// A multisample source at the start of its encoder begins undefined
+    /// whatever the request offers it -- the chain, every seed and the guest
+    /// backing all describe the resolve target -- and cleared when the guest
+    /// asked for a clear. A continued record keeps every door: its LOAD is the
+    /// scratch the engine held open for its encoder.
+    #[test]
+    fn a_multisample_encoder_start_begins_its_source_undefined_whatever_it_is_offered() {
+        use reims_vgpu_protocol::pass_action::LoadAction;
+        let mut req = DrawRequest {
+            multisample_resolve: true,
+            load_from_target: true,
+            load_guest_target_backing: true,
+            seed_from_target: Some(sampled_identity()),
+            target_cpu_seed: Some(vec![0u8; 4].into()),
+            color0_declared: Some(LoadAction::Load),
+            ..DrawRequest::default()
+        };
+        let sources = Color0Sources::resolve(&req);
+        assert_eq!(sources.load, Color0Load::Undefined);
+        assert!(
+            !sources.load_from_target
+                && sources.cpu_seed.is_none()
+                && sources.guest_seed.is_none()
+                && sources.seed_from_target.is_none()
+                && !sources.load_guest_target_backing,
+            "no door reaches the multisample source"
+        );
+        req.color0_declared = Some(LoadAction::DontCare);
+        assert_eq!(Color0Sources::resolve(&req).load, Color0Load::Undefined);
+        req.color0_declared = Some(LoadAction::Clear);
+        assert_eq!(Color0Sources::resolve(&req).load, Color0Load::Clear);
+        req.color0_declared = None;
+        assert_eq!(
+            Color0Sources::resolve(&req).load,
+            Color0Load::Clear,
+            "an unstated action keeps its historical clear"
+        );
+
+        req.color0_declared = Some(LoadAction::Load);
+        req.continues_render_pass = true;
+        let continued = Color0Sources::resolve(&req);
+        assert_eq!(continued.load, Color0Load::Preserve);
+        assert!(
+            continued.load_from_target
+                && continued.load_guest_target_backing
+                && continued.seed_from_target.is_some(),
+            "a continued record loads what its encoder rendered"
+        );
+        assert!(
+            continued.cpu_seed.is_none(),
+            "the resident wins over the seed, as it always did"
+        );
+
+        req.continues_render_pass = false;
+        req.multisample_resolve = false;
+        req.load_from_target = false;
+        req.seed_from_target = None;
+        let seeded = Color0Sources::resolve(&req);
+        assert_eq!(seeded.load, Color0Load::Preserve);
+        assert_eq!(seeded.cpu_seed.map(<[u8]>::len), Some(4));
+    }
