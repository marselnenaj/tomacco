+/// Validate the declared texel and complete image footprint of a CPU Load.
+fn validate_color_load_seed(
+    target: &crate::protocol::pixel_format::ColorLoadSeed,
+    width: u32,
+    height: u32,
+    target_format: vk::Format,
+) -> Result<(), DrawError> {
+    let source_format = super::super::translate::pixel::vk_texel_layout(target.layout);
+    if !target.layout.is_four_byte_color() && source_format != target_format {
+        return Err(DrawError::DrawValidation(
+            DrawValidationDecline::TargetSeedFormat {
+                source: source_format,
+                target: target_format,
+            },
+        ));
+    }
+    let Some(expected) = reims_vgpu_protocol::extent::tight_image_bytes(
+        width,
+        height,
+        target.layout.bytes_per_texel() as usize,
+    ) else {
+        return Err(DrawError::DrawValidation(
+            DrawValidationDecline::UnrepresentableImageBytes {
+                width,
+                height,
+                layers: 1,
+                bytes_per_texel: target.layout.bytes_per_texel(),
+            },
+        ));
+    };
+    if target.pixels.len() != expected {
+        return Err(DrawError::DrawValidation(
+            DrawValidationDecline::TargetSeedLength {
+                actual: target.pixels.len(),
+                expected,
+            },
+        ));
+    }
+    Ok(())
+}
+
+/// Stage attachment contents at their declared physical width. Native seeds
+/// are validated against the destination before any image or buffer is touched.
+unsafe fn stage_color_load_seed(
+    ctx: &super::context::DeviceContext,
+    pools: &mut ResourcePools,
+    counters: &EngineCounters,
+    seed: &crate::protocol::pixel_format::ColorLoadSeed,
+    width: u32,
+    height: u32,
+    target_format: vk::Format,
+) -> Result<BufferSlot, DrawError> {
+    validate_color_load_seed(seed, width, height, target_format)?;
+    use crate::protocol::pixel_format::{expand_rgba8_to_texel, TexelLayout};
+    let Some(layout) = super::super::translate::pixel::texel_layout_of(target_format) else {
+        return Err(DrawError::DrawExecution(
+            DrawExecutionDecline::SeedFormatUnwritable {
+                format: target_format,
+            },
+        ));
+    };
+    let mut converted = Vec::new();
+    let bytes = if seed.layout.is_four_byte_color() && !layout.is_four_byte_color() {
+        let mut semantic;
+        let rgba = if seed.layout == TexelLayout::Bgra8 {
+            semantic = seed.pixels.as_ref().clone();
+            for pixel in semantic.as_chunks_mut::<4>().0 {
+                pixel.swap(0, 2);
+            }
+            semantic.as_slice()
+        } else {
+            seed.pixels.as_slice()
+        };
+        let Some(pixels) = width.checked_mul(height) else {
+            return Err(DrawError::DrawExecution(
+                DrawExecutionDecline::SeedFormatUnwritable {
+                    format: target_format,
+                },
+            ));
+        };
+        let Some(len) = reims_vgpu_protocol::extent::tight_image_bytes(
+            width,
+            height,
+            layout.bytes_per_texel() as usize,
+        ) else {
+            return Err(DrawError::DrawExecution(
+                DrawExecutionDecline::SeedFormatUnwritable {
+                    format: target_format,
+                },
+            ));
+        };
+        converted.resize(len, 0);
+        if !expand_rgba8_to_texel(layout, rgba, pixels, &mut converted) {
+            return Err(DrawError::DrawExecution(
+                DrawExecutionDecline::SeedFormatUnwritable {
+                    format: target_format,
+                },
+            ));
+        }
+        converted.as_slice()
+    } else {
+        seed.pixels.as_slice()
+    };
+    let slot = pools.acquire_staging(ctx, bytes.len() as u64, counters)?;
+    if seed.layout.is_four_byte_color() && layout.is_four_byte_color() && seed.layout != layout {
+        pools.write_staging_swap_rb(ctx, &slot, bytes)?;
+    } else {
+        pools.write_staging(ctx, &slot, bytes)?;
+    }
+    counters.note_seed_upload(bytes.len() as u64);
+    Ok(slot)
+}
