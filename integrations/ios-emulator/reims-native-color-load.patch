+#[test]
+fn r32_secondary_load_can_seed_a_new_resident_and_then_preserve_it() {
+    use reims_vgpu_core::blend::ColorWriteMask;
+    use reims_vgpu_protocol::pixel_format::{ColorLoadSeed, TexelLayout, MTL_FORMAT_R32_FLOAT};
+    let _g = engine_test_session();
+    let (v, f) = triangle_spirv();
+    let primary = TargetIdentity::Surface {
+        id: 208,
+        width: 4,
+        height: 2,
+        generation: 1,
+        format: SURFACE_TEST_FORMAT,
+    };
+    let secondary = TargetIdentity::Gva {
+        gva: 0x209000,
+        width: 4,
+        height: 2,
+        generation: 1,
+        format: ash::vk::Format::R32_SFLOAT,
+    };
+    let mut req = engine_req(&v, &f, 4, 2);
+    req.target_identity = Some(primary);
+    let raw = (-14.125f32).to_le_bytes().repeat(8);
+    req.secondary_targets.push(SecondaryColorTarget {
+        seed: Some(ColorLoadSeed {
+            pixels: std::sync::Arc::new(raw.clone()),
+            layout: TexelLayout::R32Float,
+        }),
+        identity: secondary.clone(),
+        width: 4,
+        height: 2,
+        attachment: color_attachment(MTL_FORMAT_R32_FLOAT, [0.0; 4]),
+        load: true,
+        blend: None,
+        color_write_mask: ColorWriteMask::NONE,
+    });
+    engine::execute_draw_request(engine_device(), &req)
+        .expect("first secondary LOAD has native bytes");
+    assert_eq!(engine::read_target(&secondary).unwrap().pixels, raw);
+    req.secondary_targets[0].seed = None;
+    engine::execute_draw_request(engine_device(), &req)
+        .expect("second secondary LOAD has resident bytes");
+    assert_eq!(engine::read_target(&secondary).unwrap().pixels, raw);
+}
