+impl From<Vec<u8>> for ColorLoadSeed {
+    fn from(pixels: Vec<u8>) -> Self {
+        Self {
+            pixels: Arc::new(pixels),
+            layout: TexelLayout::Rgba8,
+        }
+    }
+}
