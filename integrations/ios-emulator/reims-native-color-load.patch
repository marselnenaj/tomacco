+#[test]
+fn r32_sampled_cpu_upload_retains_float_bits_and_obeys_its_own_capability() {
+    use crate::protocol::pixel_format::MTL_FORMAT_R32_FLOAT;
+    let bytes = [(-4.125f32).to_le_bytes(), 1.00001f32.to_le_bytes()].concat();
+    assert_eq!(
+        linear_native_upload_format(MTL_FORMAT_R32_FLOAT, NativeUploads::BGRA8),
+        None
+    );
+    let mut native = NativeUploads::BGRA8;
+    native.r32_float = true;
+    let (loaded, format) = load_tight_linear_rgba_with(
+        2,
+        1,
+        1,
+        MTL_FORMAT_R32_FLOAT,
+        native,
+        "test_r32_native",
+        |dst| {
+            dst.copy_from_slice(&bytes);
+            true
+        },
+    )
+    .unwrap();
+    assert_eq!(format.layout(), TexelLayout::R32Float);
+    assert_eq!(loaded, bytes);
+    native.r32_float = false;
+    native.float32 = true;
+    assert_eq!(
+        linear_native_upload_format(MTL_FORMAT_R32_FLOAT, native),
+        None
+    );
+}
