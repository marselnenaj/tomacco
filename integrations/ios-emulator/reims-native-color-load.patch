+fn read_mapper_native_color_seed<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    mapping_id: u32,
+    width: u32,
+    height: u32,
+    target_format: ash::vk::Format,
+) -> Option<pixel_format::ColorLoadSeed> {
+    if !mapper::ensure_resolved_for_scanout(state, host, mapping_id) {
+        return None;
+    }
+    let (layout, window) = {
+        let mapping = state.mappings.get(&mapping_id)?;
+        if !mapping.mapped
+            || !mapping.has_geom
+            || mapping.width != width
+            || mapping.height != height
+        {
+            return None;
+        }
+        let layout = pixel_format::store_texel_order(mapping.format)?;
+        if translate::pixel::vk_texel_layout(layout) != target_format {
+            return None;
+        }
+        let (base_off, bpr, span_end) = mapping_write::mapper_ref_texture_sample_window(
+            mapping,
+            width,
+            height,
+            mapping.format,
+        )?;
+        (
+            layout,
+            mapping_write::SurfaceWindow {
+                base_off,
+                bpr,
+                span_end,
+                bpp: layout.bytes_per_texel(),
+            },
+        )
+    };
+    let (tight, len) =
+        reims_vgpu_protocol::extent::tight_image_layout(width, height, layout.bytes_per_texel())?;
+    crate::runtime::writeback_debt::pay_for_mapping(state, host, mapping_id);
+    crate::runtime::render_writeback::settle_guest_writes(
+        crate::runtime::render_writeback::SettleSite::LinearTextureSeed,
+    );
+    let mut pixels = vec![0; len];
+    if !mapping_write::read_rect_raw_at(
+        state,
+        host,
+        mapping_id,
+        window,
+        mapping_write::Rect {
+            origin_x: 0,
+            origin_y: 0,
+            width,
+            height,
+        },
+        &mut pixels,
+        tight,
+    ) {
+        return None;
+    }
+    Some(pixel_format::ColorLoadSeed {
+        pixels: std::sync::Arc::new(pixels),
+        layout,
+    })
+}
