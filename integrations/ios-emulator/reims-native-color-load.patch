+#[test]
+fn r32_color_clear_load_draw_and_blend_preserve_native_precision() {
+    use reims_vgpu_core::blend::ColorWriteMask;
+    use reims_vgpu_protocol::pixel_format::{ColorLoadSeed, TexelLayout, MTL_FORMAT_R32_FLOAT};
+    let _g = engine_test_session();
+    let (v, f) = triangle_spirv();
+    let identity = TargetIdentity::Gva {
+        gva: 0x208000,
+        width: 4,
+        height: 2,
+        generation: 1,
+        format: ash::vk::Format::R32_SFLOAT,
+    };
+    let mut req = engine_req(&v, &f, 4, 2);
+    req.target_identity = Some(identity.clone());
+    req.color_attachment = Some(color_attachment(
+        MTL_FORMAT_R32_FLOAT,
+        [-3.25, 0.0, 0.0, 0.0],
+    ));
+    req.skip_readback = true;
+    req.color_write_mask = ColorWriteMask::NONE;
+    engine::execute_draw_request(engine_device(), &req)
+        .expect("R32 clear must execute on the Vulkan test host");
+    let clear = engine::read_target(&identity).unwrap();
+    assert_eq!(
+        clear.texel,
+        engine::ReadbackTexel::Native(TexelLayout::R32Float)
+    );
+    assert_eq!(clear.pixels, (-3.25f32).to_le_bytes().repeat(8));
+
+    // The copy and Load path must retain even bits that no RGBA8 conversion
+    // represents: signed zero, extended range, a NaN payload and a subnormal.
+    let bits = [
+        0x80000000u32,
+        0x40200000,
+        0xc0480000,
+        0x7f800000,
+        0xff800000,
+        0x7fc12345,
+        1,
+        0x3dfcd6ea,
+    ];
+    let raw: Vec<u8> = bits.iter().flat_map(|word| word.to_le_bytes()).collect();
+    req.target_cpu_seed = Some(ColorLoadSeed {
+        pixels: std::sync::Arc::new(raw.clone()),
+        layout: TexelLayout::R32Float,
+    });
+    engine::execute_draw_request(engine_device(), &req).expect("native CPU seed");
+    assert_eq!(engine::read_target(&identity).unwrap().pixels, raw);
+
+    req.color_write_mask = ColorWriteMask::ALL;
+    req.scissors = vec![engine::ScissorResource {
+        x: 0,
+        y: 0,
+        width: 2,
+        height: 2,
+    }];
+    req.target_cpu_seed = Some(ColorLoadSeed {
+        pixels: std::sync::Arc::new(2.5f32.to_le_bytes().repeat(8)),
+        layout: TexelLayout::R32Float,
+    });
+    req.blend = Some(BlendStateResource {
+        src_rgb: MTL_BLEND_FACTOR_ONE,
+        dst_rgb: MTL_BLEND_FACTOR_ONE,
+        op_rgb: MTL_BLEND_OPERATION_ADD,
+        src_alpha: MTL_BLEND_FACTOR_ONE,
+        dst_alpha: MTL_BLEND_FACTOR_ZERO,
+        op_alpha: MTL_BLEND_OPERATION_ADD,
+    });
+    engine::execute_draw_request(engine_device(), &req).expect("R32 fragment blend");
+    let pixels = engine::read_target(&identity).unwrap().pixels;
+    let values: Vec<f32> = pixels
+        .as_chunks::<4>()
+        .0
+        .iter()
+        .map(|p| f32::from_le_bytes(*p))
+        .collect();
+    assert_eq!(values, [2.75, 2.75, 2.5, 2.5, 2.75, 2.75, 2.5, 2.5]);
+    req.target_cpu_seed = None;
+    req.load_from_target = true;
+    engine::execute_draw_request(engine_device(), &req).expect("resident R32 load");
+    let pixels = engine::read_target(&identity).unwrap().pixels;
+    let values: Vec<f32> = pixels
+        .as_chunks::<4>()
+        .0
+        .iter()
+        .map(|p| f32::from_le_bytes(*p))
+        .collect();
+    assert_eq!(values, [3.0, 3.0, 2.5, 2.5, 3.0, 3.0, 2.5, 2.5]);
+}
