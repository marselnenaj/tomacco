+fn seed_native_color_load<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    task_id: u32,
+    span: GvaSpan,
+) -> Option<pixel_format::ColorLoadSeed> {
+    let layout = pixel_format::store_texel_order(span.format)?;
+    let (tight, len) = reims_vgpu_protocol::extent::tight_image_layout(
+        span.width,
+        span.height,
+        layout.bytes_per_texel(),
+    )?;
+    if span.gva == 0 || span.row_stride < tight {
+        return None;
+    }
+    // Deferred Stores must reach guest RAM before a CPU Load reads it. The
+    // settled native rows remain authoritative; an RGBA8 display cache cannot
+    // stand in for a floating-point render target.
+    crate::runtime::writeback_debt::pay_for_texture(state, host, task_id, span.texture_ref);
+    crate::runtime::render_writeback::settle_guest_writes(
+        crate::runtime::render_writeback::SettleSite::LinearTextureSeed,
+    );
+    let mut pixels = vec![0; len];
+    for (y, row) in pixels.chunks_exact_mut(tight as usize).enumerate() {
+        let offset = (y as u64).checked_mul(u64::from(span.row_stride))?;
+        let address = span.gva.checked_add(offset)?;
+        if !crate::runtime::gva_view::read_span(state, host, task_id, address, row) {
+            return None;
+        }
+    }
+    Some(pixel_format::ColorLoadSeed {
+        pixels: std::sync::Arc::new(pixels),
+        layout,
+    })
