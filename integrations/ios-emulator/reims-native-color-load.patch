+/// Tightly packed colour-attachment contents, including their physical texel.
+/// A four-byte R32Float pixel is not an RGBA8 pixel. Keeping the layout with
+/// the allocation makes both CPU and GPU Load paths validate that distinction.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ColorLoadSeed {
+    pub pixels: Arc<Vec<u8>>,
+    pub layout: TexelLayout,
+}
