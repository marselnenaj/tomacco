+/// The resolver's existing NoCpu/Unmapped cached-plan policy is carried as an
+/// explicit unwitnessed outcome, never a verified re-walk. Other read/contract
+/// failures refuse copying. No CPU substitution or host capability is added.
+pub(crate) enum LiveMappingWitness {
+    Verified,
+    CachedUnwitnessed(CachedMapperAlias),
+}
+
+pub(crate) enum CachedMapperAlias {
+    NoCpu,
+    Unmapped,
+}
+
+impl CachedMapperAlias {
+    pub(crate) fn host_error(&self) -> MemError {
+        match self {
+            Self::NoCpu => MemError::NoCpu,
+            Self::Unmapped => MemError::Unmapped,
