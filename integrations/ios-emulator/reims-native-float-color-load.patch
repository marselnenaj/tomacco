 #[test]
+fn rgba16_native_cpu_and_resident_loads_preserve_primary_and_secondary_bits() {
+    use reims_vgpu_core::blend::ColorWriteMask;
+    use reims_vgpu_protocol::pixel_format::{ColorLoadSeed, TexelLayout, MTL_FORMAT_RGBA16_FLOAT};
+    let _g = engine_test_session();
+    let (v, f) = triangle_spirv();
+    let primary = TargetIdentity::Gva {
+        gva: 0x270000,
+        width: 2,
+        height: 2,
+        generation: 1,
+        format: ash::vk::Format::R16G16B16A16_SFLOAT,
+    };
+    let secondary = TargetIdentity::Gva {
+        gva: 0x274000,
+        width: 2,
+        height: 2,
+        generation: 1,
+        format: ash::vk::Format::R16G16B16A16_SFLOAT,
+    };
+    let words = [
+        0xc280u16, 0x3c01, 0x0001, 0x8000, 0x7e35, 0x7c00, 0xfc00, 0x3555, 0x0401, 0xbc01, 0x4800,
+        0x3bff, 0x3c00, 0x4000, 0x4200, 0x4400,
+    ];
+    let raw: Vec<u8> = words.iter().flat_map(|v| v.to_le_bytes()).collect();
+    let other: Vec<u8> = words.iter().rev().flat_map(|v| v.to_le_bytes()).collect();
+    let seed = |pixels| ColorLoadSeed {
+        pixels: std::sync::Arc::new(pixels),
+        layout: TexelLayout::Rgba16Float,
+    };
+    let mut req = engine_req(&v, &f, 2, 2);
+    req.target_identity = Some(primary.clone());
+    req.color_attachment = Some(color_attachment(MTL_FORMAT_RGBA16_FLOAT, [0.0; 4]));
+    req.target_cpu_seed = Some(seed(raw.clone()));
+    req.skip_readback = true;
+    req.color_write_mask = ColorWriteMask::NONE;
+    req.secondary_targets.push(SecondaryColorTarget {
+        identity: secondary.clone(),
+        width: 2,
+        height: 2,
+        attachment: color_attachment(MTL_FORMAT_RGBA16_FLOAT, [0.0; 4]),
+        load: true,
+        seed: Some(seed(other.clone())),
+        blend: None,
+        color_write_mask: ColorWriteMask::NONE,
+    });
+    engine::execute_draw_request(engine_device(), &req).expect("native half-float CPU Loads");
+    for (identity, expected) in [(&primary, &raw), (&secondary, &other)] {
+        let actual = engine::read_target_texels(identity).unwrap();
+        assert_eq!(
+            actual.texel,
+            engine::ReadbackTexel::Native(TexelLayout::Rgba16Float)
+        );
+        assert_eq!(&actual.pixels, expected);
+    }
+    req.target_cpu_seed = None;
+    req.load_from_target = true;
+    req.secondary_targets[0].seed = None;
+    req.secondary_targets[0].load = true;
+    engine::execute_draw_request(engine_device(), &req).expect("native half-float resident Loads");
+    assert_eq!(engine::read_target_texels(&primary).unwrap().pixels, raw);
+    assert_eq!(
+        engine::read_target_texels(&secondary).unwrap().pixels,
+        other
+    );
+}
