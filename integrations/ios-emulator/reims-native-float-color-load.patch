 #[test]
+#[cfg(feature = "backend-vulkan")]
+fn rgba16_native_load_preserves_bits_padding_and_freshness_over_display_caches() {
+    let mut rig = StoreRig::new(4);
+    let gva = StoreRig::gva(1);
+    let words = [
+        0xc280u16, 0x3c01, 0x0001, 0x8000, 0x7e35, 0x7c00, 0xfc00, 0x3555, 0x0401, 0xbc01, 0x4800,
+        0x3bff, 0x3c00, 0x4000, 0x4200, 0x4400,
+    ];
+    let raw: Vec<u8> = words.iter().flat_map(|v| v.to_le_bytes()).collect();
+    let mut padded = vec![0xa5; 48];
+    padded[..16].copy_from_slice(&raw[..16]);
+    padded[32..48].copy_from_slice(&raw[16..]);
+    write_task_gva_arm64e(&mut rig.host, &rig.state.tasks[1], gva, &padded);
+    let span = GvaSpan {
+        texture_ref: 6,
+        gva,
+        row_stride: 32,
+        width: 2,
+        height: 2,
+        format: pixel_format::MTL_FORMAT_RGBA16_FLOAT,
+    };
+    // Neither of the display-cache identities can express these native half
+    // values. A cache hit must not replace the actual attachment contents.
+    crate::runtime::surface_cache::store_gva_owned(
+        &mut rig.state,
+        gva,
+        2,
+        2,
+        vec![17; 16],
+        1,
+        None,
+        true,
+    );
+    crate::runtime::surface_cache::store_texture(&mut rig.state, 1, 6, 2, 2, vec![29; 16], gva);
+    let seed = seed_color_load(&mut rig.state, &mut rig.host, 1, span).unwrap();
+    assert_eq!(seed.layout, TexelLayout::Rgba16Float);
+    assert_eq!(*seed.pixels, raw);
+
+    // The previous returned seed owns its bytes; a subsequent Load sees a
+    // later guest write without changing that retained seed.
+    write_task_gva_arm64e(
+        &mut rig.host,
+        &rig.state.tasks[1],
+        gva + 32,
+        &0x4821u16.to_le_bytes(),
+    );
+    let fresh = seed_color_load(&mut rig.state, &mut rig.host, 1, span).unwrap();
+    let mut expected = raw.clone();
+    expected[16..18].copy_from_slice(&0x4821u16.to_le_bytes());
+    assert_eq!(*fresh.pixels, expected);
+    assert_eq!(*seed.pixels, raw);
+    assert!(seed_color_load(
+        &mut rig.state,
+        &mut rig.host,
+        1,
+        GvaSpan {
+            row_stride: 15,
+            ..span
+        },
+    )
+    .is_none());
+    // A failed native read must not return the lossy cached picture.
+    rig.point(1, 0);
+    assert!(seed_color_load(&mut rig.state, &mut rig.host, 1, span).is_none());
+}
