+/// Compare a live MappingInternal with the retained CPU Store incarnation.
+/// This reads the existing protocol's identity, descriptor and complete table
+/// plan without updating DeviceState, retiring aliases or touching the engine.
+/// Unreadable live fields are not a cached-plan success. A caller can choose
+/// the owned route before acquiring a lease; after a GPU wait a failed witness
+/// refuses copying into prepared guest spans.
+pub(crate) fn check_live_mapping_storage<H: HostMemory + HostOps>(
+    state: &DeviceState,
+    host: &H,
+    mapping_id: u32,
+) -> Result<(), RectBatchRefusal> {
+    use RectBatchRefusal as R;
+    let m = state.mappings.get(&mapping_id).ok_or(R::StorageChanged)?;
+    if !m.mapped || m.page_entries.is_empty() {
+        return Err(R::StorageChanged);
+    }
+    if m.mapping_internal == 0 {
+        return Ok(());
+    }
+    let mem = MapperMem::new(host);
+    let contract = |why| match mem.last_error() {
+        Some(error) => R::MapperRead(error),
+        None => R::MapperContract(why),
+    };
+    let fields = read_mapper_internal(
+        &mem,
+        m.mapping_internal,
+        state.mapper_device_kva != 0,
+        state.mapper_device_kva,
+        m.mapping_layout,
+    )
+    .map_err(contract)?;
+    let status = validate_mapper_internal(&mem, mapping_id, &fields);
+    if status != iosurface_pages::Status::Ok {
+        return Err(contract(status));
+    }
+    match read_internal_desc_ptr(&mem, m.mapping_internal) {
+        Ok(address) => {
+            let mut desc = [0u8; DEVICE_DESC_LEN];
+            if !mem.read(address, &mut desc) {
+                return Err(R::MapperRead(
+                    mem.last_error().unwrap_or(MemError::Unmapped),
+                ));
+            }
+            if m.device_desc.as_slice() != desc {
+                return Err(R::MapperDescriptorChanged);
+            }
+        }
+        Err(iosurface_pages::Status::ErrInternalFields(
+            "iosurface_mapper_device_desc_pointer_zero",
+        )) if m.device_desc.is_empty() => {}
+        Err(why) => return Err(contract(why)),
+    }
+    let span = (m.page_entries.len() as u64)
+        .checked_mul(state.page_size())
+        .ok_or(R::MapperPlanChanged)?;
+    let plan =
+        build_table_plan(&mem, mapping_id, &fields, span, state.page_shift).map_err(contract)?;
+    if plan.page_table_kva != m.page_table_kva || plan.entries != m.page_entries {
+        return Err(R::MapperPlanChanged);
+    }
+    Ok(())
 }
 
