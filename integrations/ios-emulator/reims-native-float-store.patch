+/// Preserve RGBA16Float's native range and half bits. This compatibility route
+/// owns the readback copy, so the staging owner ends before guest settlement.
+fn store_native_float_surface<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    mapping_id: u32,
+    identity: &crate::backend::vulkan::engine::TargetIdentity,
+    width: u32,
+    height: u32,
+) -> Result<usize, NativeFloatStoreRefusal> {
+    use crate::backend::vulkan::engine::TargetIdentity;
+    use crate::protocol::pixel_format::{TexelLayout, MTL_FORMAT_RGBA16_FLOAT};
+    use NativeFloatStoreRefusal as R;
+    let mapping = state.mappings.get(&mapping_id).ok_or(R::Identity)?;
+    if !matches!(identity, TargetIdentity::Surface { id, width: w, height: h, generation, format }
+        if *id == mapping_id && *w == width && *h == height
+            && *generation == u64::from(mapping.map_generation)
+            && *format == ash::vk::Format::R16G16B16A16_SFLOAT)
+    {
+        return Err(R::Identity);
+    }
+    let target = crate::runtime::mapping_write::NativeImageWriteTarget::capture(
+        mapping_id,
+        mapping,
+        width,
+        height,
+        MTL_FORMAT_RGBA16_FLOAT,
+    )
+    .map_err(R::Mapping)?;
+    let readback = crate::backend::vulkan::engine::read_target_texels(identity).map_err(R::Read)?;
+    if readback.texel.native_layout() != Some(TexelLayout::Rgba16Float)
+        || readback.pixels.len() != target.packed_bytes()
+    {
+        return Err(R::SourceShape);
+    }
+    let bytes = crate::runtime::mapping_write::write_captured_native_image(
+        state,
+        host,
+        target,
+        &readback.pixels,
+    )
+    .map_err(R::Mapping)?;
+    crate::runtime::drain::note_store_route("native_float_render_store_n");
+    crate::runtime::drain::note_store_route_n("native_float_store_bytes_n", bytes as u64);
+    Ok(bytes)
+}
 
