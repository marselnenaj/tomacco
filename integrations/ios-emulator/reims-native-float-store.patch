+//! Native-width image publication into a captured single-plane mapping.
+//!
+//! The producer captures storage before a GPU wait. No conversion, scanout
+//! cache, row padding or replacement mapping can stand in for these texels.
+
+use super::{mapper_ref_texture_sample_window, vouch_for_write, SurfaceWriteRefusal};
+use crate::model::{scanout_extent_ok, DeviceState, MappingEntry};
+use crate::protocol::pixel_format;
+use crate::runtime::host::{HostMemory, HostOps};
+use crate::runtime::mapper::{
+    self, MappingRectCopy, MappingStorageIdentity, RectBatchRefusal, RectStride, RunCopy,
+};
+
+#[derive(Debug)]
+pub enum NativeImageWriteRefusal {
+    Surface(SurfaceWriteRefusal),
+    Transfer(RectBatchRefusal),
+    SourceLength { need: usize, have: usize },
+}
+
+impl crate::observe::Decline for NativeImageWriteRefusal {
+    fn slug(&self) -> &'static str {
+        match self {
+            Self::Surface(why) => why.slug(),
+            Self::Transfer(why) => why.slug(),
+            Self::SourceLength { .. } => "native_image_source_length",
+        }
+    }
+    fn fields(&self) -> Vec<(&'static str, String)> {
+        match self {
+            Self::Surface(why) => why.fields(),
+            Self::Transfer(why) => why.fields(),
+            Self::SourceLength { need, have } => {
+                vec![("need", need.to_string()), ("have", have.to_string())]
+            }
+        }
+    }
+    fn owner(&self) -> &'static str {
+        match self {
+            Self::Surface(why) => why.owner(),
+            Self::Transfer(why) => why.owner(),
+            Self::SourceLength { .. } => std::any::type_name::<Self>(),
+        }
+    }
+}
+
+/// The declared whole-image view and original storage incarnation. This owner
+/// retains only metadata; a staging lease must end before the writer is called.
+pub struct NativeImageWriteTarget {
+    mapping_id: u32,
+    identity: MappingStorageIdentity,
+    offset: u64,
+    rect: RectStride,
+}
+
+impl NativeImageWriteTarget {
+    pub fn capture(
+        mapping_id: u32,
+        mapping: &MappingEntry,
+        width: u32,
+        height: u32,
+        format: u16,
+    ) -> Result<Self, NativeImageWriteRefusal> {
+        use NativeImageWriteRefusal as R;
+        let refused = |why| R::Surface(why);
+        if !scanout_extent_ok(width, height) {
+            return Err(refused(SurfaceWriteRefusal::Geometry { width, height }));
+        }
+        if !mapping.mapped || mapping.page_entries.is_empty() {
+            return Err(refused(SurfaceWriteRefusal::MappingNotResident));
+        }
+        if !mapping.has_geom || mapping.width != width || mapping.height != height {
+            return Err(refused(SurfaceWriteRefusal::GeometryMoved {
+                latched_width: mapping.width,
+                latched_height: mapping.height,
+                frame_width: width,
+                frame_height: height,
+            }));
+        }
+        if mapping.format != format {
+            return Err(refused(SurfaceWriteRefusal::NativeFormatMismatch {
+                source: format,
+                mapping: mapping.format,
+            }));
+        }
+        let tight = pixel_format::tight_row_bytes(width, format)
+            .ok_or_else(|| refused(SurfaceWriteRefusal::FormatRowLength { format }))?;
+        let (offset, stride, end) =
+            mapper_ref_texture_sample_window(mapping, width, height, format).ok_or_else(|| {
+                refused(SurfaceWriteRefusal::WindowUnresolved {
+                    width,
+                    height,
+                    format,
+                })
+            })?;
+        let rect = RectStride::new(u64::from(stride), u64::from(tight), u64::from(height))
+            .filter(|r| {
+                r.span() <= isize::MAX as usize
+                    && r.packed() <= isize::MAX as usize
+                    && offset
+                        .checked_add(r.span() as u64)
+                        .is_some_and(|e| e <= end)
+            })
+            .ok_or_else(|| {
+                refused(SurfaceWriteRefusal::FrameExtent {
+                    bpr: stride as usize,
+                    height,
+                })
+            })?;
+        Ok(Self {
+            mapping_id,
+            identity: MappingStorageIdentity::capture(mapping_id, mapping).map_err(R::Transfer)?,
+            offset,
+            rect,
+        })
+    }
+
+    pub fn packed_bytes(&self) -> usize {
+        self.rect.packed()
+    }
+}
+
+/// Publish tightly packed native texels without an intermediate eight-bit
+/// image. All host views and source bounds are checked before a byte moves;
+/// copies on unmap finish before currency publication. Guest CPUs may run.
+pub fn write_captured_native_image<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    target: NativeImageWriteTarget,
+    src: &[u8],
+) -> Result<usize, NativeImageWriteRefusal> {
+    use NativeImageWriteRefusal as R;
+    let mapping_id = target.mapping_id;
+    let bytes = target.packed_bytes();
+    if src.len() != bytes {
+        return Err(R::SourceLength {
+            need: bytes,
+            have: src.len(),
+        });
+    }
+    mapper::ensure_resolved_for_scanout(state, host, mapping_id);
+    crate::runtime::writeback_debt::settle_for_mapping(
+        state,
+        host,
+        mapping_id,
+        crate::runtime::render_writeback::SettleSite::MappingNativeImageWrite,
+    );
+    let vouched = vouch_for_write(state, host, mapping_id, "captured_native_image")
+        .ok_or(R::Surface(SurfaceWriteRefusal::PagesNotOurs))?;
+    let copy = RunCopy::write_rect(src, target.rect)
+        .ok_or(R::Transfer(RectBatchRefusal::Window { index: 0 }))?;
+    mapper::copy_mapping_rects(
+        state,
+        host,
+        mapping_id,
+        &target.identity,
+        &vouched,
+        &mut [MappingRectCopy::new(target.offset, copy)],
+    )
+    .map_err(R::Transfer)?;
+    state.mark_mapping_written(mapping_id);
+    crate::runtime::surface_cache::forget(state, mapping_id);
+    mapper::stamp_guest_write_gen(state, host, mapping_id);
+    crate::runtime::drain::note_store_route("native_image_captured_write_n");
+    Ok(bytes)
+}
