 #[test]
+fn small_half_float_native_loads_keep_primary_and_secondary_bits() {
+    use reims_vgpu_core::blend::ColorWriteMask;
+    use reims_vgpu_protocol::pixel_format::{self as p, ColorLoadSeed, TexelLayout};
+    let _g = engine_test_session();
+    let (v, f) = triangle_spirv();
+    for (index, mtl, layout, vk, words) in [
+        (
+            0,
+            p::MTL_FORMAT_R16_FLOAT,
+            TexelLayout::R16Float,
+            ash::vk::Format::R16_SFLOAT,
+            vec![0xc280u16, 0x3c01, 0x0001, 0x8000],
+        ),
+        (
+            1,
+            p::MTL_FORMAT_RG16_FLOAT,
+            TexelLayout::Rg16Float,
+            ash::vk::Format::R16G16_SFLOAT,
+            vec![
+                0xc280u16, 0x3c01, 0x0001, 0x8000, 0x7e35, 0x7c00, 0xfc00, 0x3555,
+            ],
+        ),
+    ] {
+        let identity = |gva| TargetIdentity::Gva {
+            gva,
+            width: 2,
+            height: 2,
+            generation: 1,
+            format: vk,
+        };
+        let primary = identity(0x280000 + index * 0x8000);
+        let secondary = identity(0x284000 + index * 0x8000);
+        let raw: Vec<u8> = words.iter().flat_map(|v| v.to_le_bytes()).collect();
+        let other: Vec<u8> = words.iter().rev().flat_map(|v| v.to_le_bytes()).collect();
+        let seed = |pixels| ColorLoadSeed {
+            pixels: std::sync::Arc::new(pixels),
+            layout,
+        };
+        let mut req = engine_req(&v, &f, 2, 2);
+        req.target_identity = Some(primary.clone());
+        req.color_attachment = Some(color_attachment(mtl, [0.0; 4]));
+        req.target_cpu_seed = Some(seed(raw.clone()));
+        req.skip_readback = true;
+        req.color_write_mask = ColorWriteMask::NONE;
+        req.secondary_targets.push(SecondaryColorTarget {
+            identity: secondary.clone(),
+            width: 2,
+            height: 2,
+            attachment: color_attachment(mtl, [0.0; 4]),
+            load: true,
+            seed: Some(seed(other.clone())),
+            blend: None,
+            color_write_mask: ColorWriteMask::NONE,
+        });
+        engine::execute_draw_request(engine_device(), &req)
+            .expect("native small half-float CPU Loads");
+        for (target, expected) in [(&primary, &raw), (&secondary, &other)] {
+            let actual = engine::read_target_texels(target).unwrap();
+            assert_eq!(actual.texel, engine::ReadbackTexel::Native(layout));
+            assert_eq!(&actual.pixels, expected);
+        }
+        req.target_cpu_seed = None;
+        req.load_from_target = true;
+        req.secondary_targets[0].seed = None;
+        engine::execute_draw_request(engine_device(), &req)
+            .expect("native small half-float resident Loads");
+        assert_eq!(engine::read_target_texels(&primary).unwrap().pixels, raw);
+        assert_eq!(
+            engine::read_target_texels(&secondary).unwrap().pixels,
+            other
+        );
+    }
+}
