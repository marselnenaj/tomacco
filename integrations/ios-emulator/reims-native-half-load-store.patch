 #[test]
 #[cfg(feature = "backend-vulkan")]
+fn rg16_native_load_preserves_padded_rows_and_ignores_lossy_display_caches() {
+    let mut rig = StoreRig::new(4);
+    let gva = StoreRig::gva(1);
+    let words = [
+        0xc280u16, 0x3c01, 0x0001, 0x8000, 0x7e35, 0x7c00, 0xfc00, 0x3555,
+    ];
+    let raw: Vec<u8> = words.iter().flat_map(|v| v.to_le_bytes()).collect();
+    let mut padded = vec![0xa5; 24];
+    padded[..8].copy_from_slice(&raw[..8]);
+    padded[16..24].copy_from_slice(&raw[8..]);
+    write_task_gva_arm64e(&mut rig.host, &rig.state.tasks[1], gva, &padded);
+    crate::runtime::surface_cache::store_gva_owned(
+        &mut rig.state,
+        gva,
+        2,
+        2,
+        vec![17; 16],
+        1,
+        None,
+        true,
+    );
+    let span = GvaSpan {
+        texture_ref: 6,
+        gva,
+        row_stride: 16,
+        width: 2,
+        height: 2,
+        format: pixel_format::MTL_FORMAT_RG16_FLOAT,
+    };
+    let seed = seed_color_load(&mut rig.state, &mut rig.host, 1, span).unwrap();
+    assert_eq!(seed.layout, TexelLayout::Rg16Float);
+    assert_eq!(*seed.pixels, raw);
+    write_task_gva_arm64e(
+        &mut rig.host,
+        &rig.state.tasks[1],
+        gva + 16,
+        &0x4821u16.to_le_bytes(),
+    );
+    let fresh = seed_color_load(&mut rig.state, &mut rig.host, 1, span).unwrap();
+    let mut expected = raw.clone();
+    expected[8..10].copy_from_slice(&0x4821u16.to_le_bytes());
+    assert_eq!(*fresh.pixels, expected);
+    assert_eq!(*seed.pixels, raw);
+    assert!(seed_color_load(
+        &mut rig.state,
+        &mut rig.host,
+        1,
+        GvaSpan {
+            row_stride: 7,
+            ..span
+        }
+    )
+    .is_none());
+    rig.point(1, 0);
+    assert!(seed_color_load(&mut rig.state, &mut rig.host, 1, span).is_none());
+}
