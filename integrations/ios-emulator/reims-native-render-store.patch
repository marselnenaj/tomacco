+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RenderStoreRefusal {
+    NotXr,
+    SourceLayout,
+    IncompleteTexel,
+    SizeOverflow,
+    AllocationFailed,
+}
+
+impl RenderStoreRefusal {
+    pub const fn slug(self) -> &'static str {
+        match self {
+            Self::NotXr => "render_store_not_xr",
+            Self::SourceLayout => "render_store_xr_source_layout",
+            Self::IncompleteTexel => "render_store_xr_incomplete_texel",
+            Self::SizeOverflow => "render_store_xr_size_overflow",
+            Self::AllocationFailed => "render_store_xr_allocation_failed",
+        }
+    }
+}
+
+/// Convert a linear float resident directly into the guest's XR packing.
+/// RGB retains negative and above-white values up to the destination's range.
+/// Alpha is clamped to [0, 1], including for the sRGB spellings.
+pub fn render_store_bytes(
+    mtl: u16,
+    layout: TexelLayout,
+    bytes: &[u8],
+) -> Result<Vec<u8>, RenderStoreRefusal> {
+    let xr = XrFormat::from_mtl(mtl).ok_or(RenderStoreRefusal::NotXr)?;
+    let source_stride = match layout {
+        TexelLayout::Rgba16Float => 8,
+        TexelLayout::Rgba32Float => 16,
+        _ => return Err(RenderStoreRefusal::SourceLayout),
+    };
+    if !bytes.len().is_multiple_of(source_stride) {
+        return Err(RenderStoreRefusal::IncompleteTexel);
+    }
+    let size = (bytes.len() / source_stride)
+        .checked_mul(xr.bytes_per_texel())
+        .ok_or(RenderStoreRefusal::SizeOverflow)?;
+    let mut packed = Vec::new();
+    packed
+        .try_reserve_exact(size)
+        .map_err(|_| RenderStoreRefusal::AllocationFailed)?;
+    let code = |value: f32, colour: bool| {
+        let value = if colour && xr.is_srgb() {
+            let magnitude = value.abs();
+            let encoded = if magnitude <= 0.0031308 {
+                magnitude * 12.92
+            } else {
+                1.055 * magnitude.powf(1.0 / 2.4) - 0.055
+            };
+            encoded.copysign(value)
+        } else {
+            value
+        };
+        // NaN has no ordered component; choose black. Infinities saturate at
+        // the representable end points rather than narrowing the whole image.
+        let value = if value.is_nan() { 0.0 } else { value };
+        (value.mul_add(510.0, 384.0).round().clamp(0.0, 1023.0)) as u16
+    };
+    for source in bytes.chunks_exact(source_stride) {
+        let values: [f32; 4] = std::array::from_fn(|channel| {
+            if source_stride == 8 {
+                let lane = &source[channel * 2..channel * 2 + 2];
+                f16_to_f32(u16::from_le_bytes([lane[0], lane[1]]))
+            } else {
+                let lane = &source[channel * 4..channel * 4 + 4];
+                f32::from_le_bytes([lane[0], lane[1], lane[2], lane[3]])
+            }
+        });
+        let mut texel = [0; 8];
+        let codes = [
+            code(values[0], true),
+            code(values[1], true),
+            code(values[2], true),
+            code(values[3].clamp(0.0, 1.0), false),
+        ];
+        xr.write_component_codes(codes, &mut texel[..xr.bytes_per_texel()]);
+        packed.extend_from_slice(&texel[..xr.bytes_per_texel()]);
+    }
+    Ok(packed)
 }
 
