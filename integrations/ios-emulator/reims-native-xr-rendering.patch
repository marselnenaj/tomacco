+    let values = quantized_xr_render_values(xr, color.map(|v| v as f32));
+    let texel: Vec<u8> = values.into_iter().flat_map(f32::to_le_bytes).collect();
+    let size =
+        reims_vgpu_protocol::extent::tight_image_bytes(width, height, 16).ok_or(R::SizeOverflow)?;
+    let mut pixels = Vec::new();
+    pixels
+        .try_reserve_exact(size)
+        .map_err(|_| R::AllocationFailed)?;
+    pixels.resize(size, 0);
