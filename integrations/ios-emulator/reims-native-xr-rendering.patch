+/// Clear both native storage windows using the surface's decoded strides.
+pub(crate) fn clear_native_xr_surface<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    target: &ColorRtRequest,
+    color: [f64; 4],
+) -> bool {
+    let result = (|| {
+        use crate::runtime::mapping_write::PlanarXrMappingRefusal as R;
+        let mapping = state
+            .mappings
+            .get(&target.mapping_id)
+            .ok_or(NativeXrClearRefusal::Mapping(R::MappingAbsent))?;
+        if target.target_gva != 0 || target.format != mapping.format {
+            return Err(NativeXrClearRefusal::Mapping(R::StorageChanged));
+        }
+        let write_target = mapping_write::PlanarXrSurfaceWriteTarget::capture(
+            target.mapping_id,
+            mapping,
+            target.width,
+            target.height,
+        )
+        .map_err(NativeXrClearRefusal::Mapping)?;
+        let layout = write_target.layout();
+        let texel: Vec<u8> = color
+            .into_iter()
+            .flat_map(|v| (v as f32).to_le_bytes())
+            .collect();
+        let encoded = reims_vgpu_vulkan::pixel::render_store_planar_xr_surface_bytes(
+            layout.format,
+            TexelLayout::Rgba32Float,
+            &texel,
+        )
+        .map_err(NativeXrClearRefusal::Encode)?;
+        let count = reims_vgpu_protocol::extent::tight_image_bytes(target.width, target.height, 1)
+            .ok_or(NativeXrClearRefusal::Encode(
+                reims_vgpu_vulkan::pixel::RenderStoreRefusal::SizeOverflow,
+            ))?;
+        let mut planes: [Vec<u8>; 2] = std::array::from_fn(|_| Vec::new());
+        for (plane, value) in planes.iter_mut().zip(&encoded) {
+            let bytes = count
+                .checked_mul(value.len())
+                .ok_or(NativeXrClearRefusal::Encode(
+                    reims_vgpu_vulkan::pixel::RenderStoreRefusal::SizeOverflow,
+                ))?;
+            plane
+                .try_reserve_exact(bytes)
+                .map_err(|_| NativeXrClearRefusal::Mapping(R::Allocation))?;
+            plane.resize(bytes, 0);
+            for texel in plane.chunks_exact_mut(value.len()) {
+                texel.copy_from_slice(value);
+            }
+        }
+        mapping_write::write_planar_xr_surface(state, host, write_target, &planes)
+            .map_err(NativeXrClearRefusal::Mapping)
+    })();
+    match result {
+        Ok(_) => {
+            crate::runtime::drain::note_store_route("native_xr_render_clear_n");
+            true
+        }
+        Err(why) => {
+            crate::observe::Emit::decline("native_xr_render_clear", &why)
+                .field("mapping", target.mapping_id)
+                .fail();
+            false
+        }
+    }
+}
