+    if !bytes.len().is_multiple_of(source_stride) {
+        return Err(RenderStoreRefusal::IncompleteTexel);
+    }
+    let count = bytes.len() / source_stride;
+    let rgb_len = count
+        .checked_mul(4)
+        .ok_or(RenderStoreRefusal::SizeOverflow)?;
+    let mut planes = [Vec::new(), Vec::new()];
+    planes[0]
+        .try_reserve_exact(rgb_len)
+        .map_err(|_| RenderStoreRefusal::AllocationFailed)?;
+    planes[1]
+        .try_reserve_exact(count)
+        .map_err(|_| RenderStoreRefusal::AllocationFailed)?;
+    for source in bytes.chunks_exact(source_stride) {
+        let values = source_values(source);
+        let alpha = if values[3].is_nan() { 0.0 } else { values[3] };
+        let codes = reims_vgpu_core::pixel_format::PlanarXrCodes {
