+/// Native IOSurface storage is BGR10 plus one alpha byte per texel. There is
+/// no APV half-read/merge/requantization boundary on this route.
+pub fn sampled_planar_xr_surface_upload_bytes(
+    format: PlanarXrFormat,
+    rgb: &[u8],
+    alpha: &[u8],
+) -> Result<SampledUpload, SampledUploadRefusal> {
+    if !rgb.len().is_multiple_of(4) {
+        return Err(SampledUploadRefusal::IncompleteXrTexel);
+    }
+    if rgb.len() / 4 != alpha.len() {
+        return Err(SampledUploadRefusal::PlanarPlaneSizeMismatch);
+    }
+    let length = alpha
+        .len()
+        .checked_mul(16)
+        .ok_or(SampledUploadRefusal::ExpandedSizeOverflow)?;
+    let mut bytes = Vec::new();
+    bytes
+        .try_reserve_exact(length)
+        .map_err(|_| SampledUploadRefusal::AllocationFailed)?;
+    let colour = if format.is_srgb() {
+        srgb_values()
+    } else {
+        linear_values()
+    };
+    for (rgb, alpha) in rgb.chunks_exact(4).zip(alpha) {
+        let codes = format
+            .surface_component_codes(rgb, std::slice::from_ref(alpha))
+            .ok_or(SampledUploadRefusal::IncompleteXrTexel)?;
+        for code in codes.rgb {
+            bytes.extend_from_slice(&colour[usize::from(code)].to_le_bytes());
+        }
+        bytes.extend_from_slice(&(f32::from(codes.alpha) / 255.0).to_le_bytes());
+    }
+    Ok(SampledUpload {
+        format: StorageImageFormat::Rgba32Float,
+        bytes,
+    })
+}
