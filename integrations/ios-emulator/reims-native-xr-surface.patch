+impl PlanarXrSurfaceLayout {
+    /// Recover the native, linear two-plane layout from the device descriptor.
+    /// Nonzero surface origins and unequal plane offset/base need a separately
+    /// recovered addressing contract and are refused rather than added together.
+    /// The descriptor's addressing/compression and extended-pixel fields must
+    /// describe ordinary linear rows. This does not admit a render attachment.
+    pub fn decode(
+        desc: &[u8],
+        mtl: u16,
+        width: u32,
+        height: u32,
+    ) -> Result<Self, PlanarXrSurfaceRefusal> {
+        use PlanarXrSurfacePlaneCause as P;
+        use PlanarXrSurfaceRefusal as R;
+        let format = pixel_format::PlanarXrFormat::from_mtl(mtl).ok_or(R::Format)?;
+        let surface = decode_device_surface(desc).ok_or(R::Descriptor)?;
+        if surface.pixel_format != pixel_format::IOSURFACE_FORMAT_BGR10_ALPHA8 {
+            return Err(R::Format);
+        }
+        if width == 0
+            || height == 0
+            || surface.width != width
+            || surface.height != height
+            || surface.plane_count != 2
+            || surface.alloc_size == 0
+        {
+            return Err(R::SurfaceGeometry);
+        }
+        if surface.base_offset != 0 {
+            return Err(R::SurfaceOrigin);
+        }
+        // DeviceDescriptor1 -> Descriptor2 preserves address format at +0x25
+        // and compression type at +0x26. Extended pixels are +0x28..0x2c.
+        if desc[0x25] != 0 || desc[0x26] != 0 || desc[0x28..0x2c].iter().any(|&b| b != 0) {
+            return Err(R::SurfaceAddressing {
+                address_format: desc[0x25],
+                compression_type: desc[0x26],
+                extended_pixels: desc[0x28..0x2c].try_into().map_err(|_| R::Descriptor)?,
+            });
+        }
+        let mut planes = [PlanarXrSurfacePlane::default(); 2];
+        for (index, expected_bpe) in format
+            .surface_plane_bytes_per_element()
+            .into_iter()
+            .enumerate()
+        {
+            let fail = |cause| R::Plane {
+                index: index as u8,
+                cause,
+            };
+            let (plane, _) = device_desc_plane(desc, index as u32).ok_or(R::Descriptor)?;
+            if plane.width != width || plane.height != height {
+                return Err(fail(P::Geometry));
+            }
+            if plane.bytes_per_element != u16::from(expected_bpe) {
+                return Err(fail(P::ElementWidth));
+            }
+            let start = DEVICE_DESC_PLANES + index * DEVICE_PLANE_DESC_LEN;
+            let raw = &desc[start..start + DEVICE_PLANE_DESC_LEN];
+            // +0x24..0x27 expands to compression footprint, address format,
+            // compression type and an additional native plane qualifier.
+            // No compressed, tiled or extended-pixel addressing is invented.
+            // Element dimensions use either a direct positive byte or a
+            // high-bit power-of-two encoding. 0x80 denotes 2^0, hence one
+            // texel, just like the direct encoding 1. Other dimensions cannot
+            // describe this ordinary one-texel-per-element row layout.
+            if raw[0x24..0x2c].iter().any(|&b| b != 0)
+                || !matches!(raw[DEVICE_PLANE_DIMS], 1 | 0x80)
+                || !matches!(raw[DEVICE_PLANE_DIMS + 4], 1 | 0x80)
+            {
+                return Err(fail(P::Addressing {
+                    element_size: [raw[DEVICE_PLANE_DIMS], raw[DEVICE_PLANE_DIMS + 4]],
+                    compression_footprint: raw[0x24],
+                    address_format: raw[0x25],
+                    compression_type: raw[0x26],
+                    qualifier: raw[0x27],
+                    extended_pixels: raw[0x28..0x2c].try_into().map_err(|_| R::Descriptor)?,
+                }));
+            }
+            if plane.plane_offset != plane.plane_base {
+                return Err(fail(P::Origin));
+            }
+            let tight_row = width
+                .checked_mul(u32::from(expected_bpe))
+                .ok_or(fail(P::RowStride))?;
+            if plane.bytes_per_row < tight_row {
+                return Err(fail(P::RowStride));
+            }
+            let offset = u64::from(plane.plane_offset);
+            let touched_end = offset
+                .checked_add(u64::from(height - 1) * u64::from(plane.bytes_per_row))
+                .and_then(|end| end.checked_add(u64::from(tight_row)))
+                .ok_or(fail(P::Bounds))?;
+            let allocation_end = offset
+                .checked_add(u64::from(plane.plane_size))
+                .ok_or(fail(P::Bounds))?;
+            if plane.plane_size == 0
+                || touched_end > allocation_end
+                || allocation_end > u64::from(surface.alloc_size)
+            {
+                return Err(fail(P::Bounds));
+            }
+            planes[index] = PlanarXrSurfacePlane {
+                offset,
+                row_stride: plane.bytes_per_row,
+                tight_row,
+                touched_end,
+                allocation_end,
+                bytes_per_element: expected_bpe,
+            };
+        }
+        if planes[0].offset < planes[1].allocation_end
+            && planes[1].offset < planes[0].allocation_end
+        {
+            return Err(R::PlaneOverlap);
+        }
+        Ok(Self {
+            format,
+            width,
+            height,
+            allocation_size: u64::from(surface.alloc_size),
+            planes,
+        })
+    }
+
+    pub fn touched_end(self) -> u64 {
+        self.planes[0].touched_end.max(self.planes[1].touched_end)
+    }
 }
 
