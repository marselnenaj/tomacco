+    state: &mut DeviceState,
+    host: &mut M,
+    resource: &crate::model::TaskResource,
+    mapping_id: u32,
+    width: u32,
+    height: u32,
+) -> Result<
+    PlanarXrSample,
+    crate::backend::vulkan::engine::resource_lease::PlanarXrMemoRefusal<
+        crate::runtime::mapping_write::PlanarXrMappingRefusal,
+    >,
+> {
+    use crate::backend::vulkan::engine::resource_lease::{
+        planar_xr_surface_sample_bytes, PlanarXrMemoRefusal,
+    };
+    let mut read = crate::runtime::mapping_write::prepare_planar_xr_surface_read(
+        state, host, mapping_id, width, height,
+    )
+    .map_err(PlanarXrMemoRefusal::Read)?;
+    let layout = read.layout();
+    // The mapping describes native storage, while a mapper-ref-texture declares
+    // its logical view. A RGB-only view of a paired mapping must not silently
+    // acquire its alpha plane. Backing references name the whole allocation.
+    if resource.entry.object_type != objects::OBJECT_TYPE_BACKING {
+        let declared = match resource.decoded() {
+            Ok(crate::runtime::decode::resource::Descriptor::IOSurfaceTexture {
+                mapping_id,
+                width,
+                height,
+                pixel_format,
+                ..
+            }) => Some((*mapping_id, *width, *height, *pixel_format)),
+            _ => None,
+        };
+        let expected = (mapping_id, layout.width, layout.height, layout.format.mtl());
