+//! Native RGB10 + alpha8 IOSurface transfers, distinct from APV's 4+4 planes.
+//!
+//! One mapping owns the pair. The allocation and both windows are validated
+//! before either plane is transferred. Guest padding is never staged or
+//! overwritten, and a Store advances the mapping's currency only once, after
+//! both planes and all transient host views are complete.
+
+use super::vouch_for_write;
+use crate::model::{DeviceState, MappingEntry};
+use crate::protocol::iosurface_pages::{PlanarXrSurfaceLayout, PlanarXrSurfaceRefusal};
+use crate::runtime::host::{HostMemory, HostOps};
+use crate::runtime::mapper::{
+    self, MappingRectCopy, MappingStorageIdentity, RectBatchRefusal, RectStride, RunCopy,
+};
+
+#[derive(Debug)]
+pub enum PlanarXrMappingRefusal {
+    MappingAbsent,
+    MappingNotResident,
+    GeometryMoved {
+        requested: [u32; 2],
+        latched: [u32; 2],
+    },
+    TextureView {
+        expected: (u32, u32, u32, u16),
+        declared: Option<(u32, u32, u32, u16)>,
+    },
+    Layout(PlanarXrSurfaceRefusal),
+    Allocation,
+    PlaneShape {
+        index: u8,
+    },
+    SourceLength {
+        index: u8,
+        actual: usize,
+        expected: usize,
+    },
+    StorageChanged,
+    PagesNotOurs,
+    Transfer(RectBatchRefusal),
+}
+
+impl crate::observe::Decline for PlanarXrMappingRefusal {
+    fn slug(&self) -> &'static str {
+        match self {
+            Self::MappingAbsent => "dual_xr_mapping_absent",
+            Self::MappingNotResident => "dual_xr_mapping_not_resident",
+            Self::GeometryMoved { .. } => "dual_xr_mapping_geometry_moved",
+            Self::TextureView { .. } => "dual_xr_surface_sample_texture_view",
+            Self::Layout(why) => why.slug(),
+            Self::Allocation => "dual_xr_mapping_allocation",
+            Self::PlaneShape { .. } => "dual_xr_mapping_plane_shape",
+            Self::SourceLength { .. } => "dual_xr_mapping_source_length",
+            Self::StorageChanged => "dual_xr_mapping_storage_changed",
+            Self::PagesNotOurs => "dual_xr_mapping_pages_not_ours",
+            Self::Transfer(why) => why.slug(),
+        }
+    }
+
+    fn fields(&self) -> Vec<(&'static str, String)> {
+        match self {
+            Self::GeometryMoved { requested, latched } => vec![
+                ("requested", format!("{}x{}", requested[0], requested[1])),
+                ("latched", format!("{}x{}", latched[0], latched[1])),
+            ],
+            Self::TextureView { expected, declared } => vec![
+                ("expected_view", format!("{expected:?}")),
+                ("declared_view", format!("{declared:?}")),
+            ],
+            Self::PlaneShape { index } => vec![("plane", index.to_string())],
+            Self::SourceLength {
+                index,
+                actual,
+                expected,
+            } => vec![
+                ("plane", index.to_string()),
+                ("actual", actual.to_string()),
+                ("expected", expected.to_string()),
+            ],
+            Self::Layout(why) => vec![("layout_refusal", format!("{why:?}"))],
+            Self::Transfer(why) => why.fields(),
+            _ => Vec::new(),
+        }
+    }
+
+    fn owner(&self) -> &'static str {
+        match self {
+            Self::Transfer(why) => why.owner(),
+            _ => std::any::type_name::<Self>(),
+        }
+    }
+}
+
+/// Resolve only the native 4+1 storage windows. APV construction descriptors
+/// have a separate owner and cannot enter this transfer through format alone.
+pub fn planar_xr_mapping_layout(
+    mapping: &MappingEntry,
+    width: u32,
+    height: u32,
+) -> Result<PlanarXrSurfaceLayout, PlanarXrMappingRefusal> {
+    if !mapping.mapped || mapping.page_entries.is_empty() {
+        return Err(PlanarXrMappingRefusal::MappingNotResident);
+    }
+    if !mapping.has_geom || mapping.width != width || mapping.height != height {
+        return Err(PlanarXrMappingRefusal::GeometryMoved {
+            requested: [width, height],
+            latched: [mapping.width, mapping.height],
+        });
+    }
+    PlanarXrSurfaceLayout::decode(&mapping.device_desc, mapping.format, width, height)
+        .map_err(PlanarXrMappingRefusal::Layout)
+}
+
+struct Transfer {
+    layout: PlanarXrSurfaceLayout,
+    identity: MappingStorageIdentity,
+    rects: [RectStride; 2],
+}
+
+impl Transfer {
+    fn capture(
+        state: &DeviceState,
+        mapping_id: u32,
+        width: u32,
+        height: u32,
+    ) -> Result<Self, PlanarXrMappingRefusal> {
+        use PlanarXrMappingRefusal as R;
+        let mapping = state.mappings.get(&mapping_id).ok_or(R::MappingAbsent)?;
+        let layout = planar_xr_mapping_layout(mapping, width, height)?;
+        let identity = MappingStorageIdentity::capture(mapping_id, mapping).map_err(R::Transfer)?;
+        let make_rect = |index: usize| {
+            let plane = layout.planes[index];
+            let rect = RectStride::new(
+                u64::from(plane.row_stride),
+                u64::from(plane.tight_row),
+                u64::from(height),
+            )
+            .filter(|rect| {
+                rect.span() <= isize::MAX as usize && rect.packed() <= isize::MAX as usize
+            })
+            .ok_or(R::PlaneShape { index: index as u8 })?;
+            if plane.offset.checked_add(rect.span() as u64) != Some(plane.touched_end) {
+                return Err(R::PlaneShape { index: index as u8 });
+            }
+            Ok(rect)
+        };
+        Ok(Self {
+            layout,
+            identity,
+            rects: [make_rect(0)?, make_rect(1)?],
+        })
+    }
+}
+
+/// Both tight plane buffers belong to one validated native surface read.
+/// No GPU resident or render support is implied by possession of these bytes.
+pub struct PlanarXrSurfaceRead {
+    pub layout: PlanarXrSurfaceLayout,
+    pub planes: [Vec<u8>; 2],
+}
+
+/// A read keeps exclusive device and host access from debt settlement through
+/// both transfers. No caller can queue a later Store between those two steps.
+pub(crate) struct PlanarXrSurfaceReadTransaction<'a, M: HostMemory + HostOps> {
+    state: &'a mut DeviceState,
+    host: &'a mut M,
+    mapping_id: u32,
+    transfer: Transfer,
+    vouched: mapper::PagesVouched,
+}
+
+impl<M: HostMemory + HostOps> PlanarXrSurfaceReadTransaction<'_, M> {
+    pub(crate) fn layout(&self) -> PlanarXrSurfaceLayout {
+        self.transfer.layout
+    }
+
+    pub(crate) fn next_sampled_generation(&mut self) -> u64 {
+        self.state.next_sampled_content_generation()
+    }
+
+    pub(crate) fn read_into(
+        &mut self,
+        planes: &mut [Vec<u8>; 2],
+    ) -> Result<(), PlanarXrMappingRefusal> {
+        use PlanarXrMappingRefusal as R;
+        for (plane, rect) in planes.iter_mut().zip(self.transfer.rects) {
+            plane
+                .try_reserve_exact(rect.packed().saturating_sub(plane.len()))
+                .map_err(|_| R::Allocation)?;
+            plane.resize(rect.packed(), 0);
+        }
+        let [rgb, alpha] = planes;
+        let mut copies = [
+            MappingRectCopy::new(
+                self.transfer.layout.planes[0].offset,
+                RunCopy::read_rect(rgb, self.transfer.rects[0])
+                    .ok_or(R::PlaneShape { index: 0 })?,
+            ),
+            MappingRectCopy::new(
+                self.transfer.layout.planes[1].offset,
+                RunCopy::read_rect(alpha, self.transfer.rects[1])
+                    .ok_or(R::PlaneShape { index: 1 })?,
+            ),
+        ];
+        mapper::copy_mapping_rects(
+            self.state,
+            self.host,
+            self.mapping_id,
+            &self.transfer.identity,
+            &self.vouched,
+            &mut copies,
+        )
+        .map_err(R::Transfer)?;
+        crate::runtime::drain::note_store_route("dual_xr_surface_read_n");
+        Ok(())
+    }
+}
+
+pub(crate) fn prepare_planar_xr_surface_read<'a, M: HostMemory + HostOps>(
+    state: &'a mut DeviceState,
+    host: &'a mut M,
+    mapping_id: u32,
+    width: u32,
+    height: u32,
+) -> Result<PlanarXrSurfaceReadTransaction<'a, M>, PlanarXrMappingRefusal> {
+    mapper::ensure_resolved_for_scanout(state, host, mapping_id);
+    crate::runtime::writeback_debt::settle_for_mapping(
+        state,
+        host,
+        mapping_id,
+        crate::runtime::render_writeback::SettleSite::MappingRectRead,
+    );
+    let transfer = Transfer::capture(state, mapping_id, width, height)?;
+    // A read has no write footprint, but it must not read a recycled backing.
+    let (_, vouched) = mapper::vouch_mapping_pages_verdict(state, host, mapping_id);
+    let vouched = vouched.ok_or(PlanarXrMappingRefusal::PagesNotOurs)?;
+    Ok(PlanarXrSurfaceReadTransaction {
+        state,
+        host,
+        mapping_id,
+        transfer,
+        vouched,
+    })
+}
+
+pub fn read_planar_xr_surface<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    mapping_id: u32,
+    width: u32,
+    height: u32,
+) -> Result<PlanarXrSurfaceRead, PlanarXrMappingRefusal> {
+    let mut read = prepare_planar_xr_surface_read(state, host, mapping_id, width, height)?;
+    let mut planes = [Vec::new(), Vec::new()];
+    read.read_into(&mut planes)?;
+    Ok(PlanarXrSurfaceRead {
+        layout: read.layout(),
+        planes,
+    })
+}
+
+/// Store a complete native pair. A refusal cannot publish a first-plane-only
+/// result: both sources, layout, live pages and host views are checked before
+/// any guest byte is copied. This API does not admit a float render resident;
+/// its producer must establish native fragment quantization separately.
+pub fn write_planar_xr_surface<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    mapping_id: u32,
+    expected_layout: PlanarXrSurfaceLayout,
+    planes: &[Vec<u8>; 2],
+) -> Result<usize, PlanarXrMappingRefusal> {
+    use PlanarXrMappingRefusal as R;
+    mapper::ensure_resolved_for_scanout(state, host, mapping_id);
+    crate::runtime::writeback_debt::settle_for_mapping(
+        state,
+        host,
+        mapping_id,
+        crate::runtime::render_writeback::SettleSite::MappingRectWrite,
+    );
+    let transfer = Transfer::capture(
+        state,
+        mapping_id,
+        expected_layout.width,
+        expected_layout.height,
+    )?;
+    if transfer.layout != expected_layout {
+        return Err(R::StorageChanged);
+    }
+    for (index, (plane, rect)) in planes.iter().zip(transfer.rects).enumerate() {
+        if plane.len() != rect.packed() {
+            return Err(R::SourceLength {
+                index: index as u8,
+                actual: plane.len(),
+                expected: rect.packed(),
+            });
+        }
+    }
+    let bytes = planes[0]
+        .len()
+        .checked_add(planes[1].len())
+        .ok_or(R::Allocation)?;
+    let vouched =
+        vouch_for_write(state, host, mapping_id, "dual_xr_surface").ok_or(R::PagesNotOurs)?;
+    let mut copies = [
+        MappingRectCopy::new(
+            transfer.layout.planes[0].offset,
+            RunCopy::write_rect(&planes[0], transfer.rects[0]).ok_or(R::PlaneShape { index: 0 })?,
+        ),
+        MappingRectCopy::new(
+            transfer.layout.planes[1].offset,
+            RunCopy::write_rect(&planes[1], transfer.rects[1]).ok_or(R::PlaneShape { index: 1 })?,
+        ),
+    ];
+    mapper::copy_mapping_rects(
+        state,
+        host,
+        mapping_id,
+        &transfer.identity,
+        &vouched,
+        &mut copies,
+    )
+    .map_err(R::Transfer)?;
+    state.mark_mapping_written(mapping_id);
+    crate::runtime::surface_cache::forget(state, mapping_id);
+    mapper::stamp_guest_write_gen(state, host, mapping_id);
+    crate::runtime::drain::note_store_route("dual_xr_surface_write_n");
+    Ok(bytes)
+}
