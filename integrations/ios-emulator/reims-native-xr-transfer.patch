+//! Prepare every host view before moving any bytes of a multi-plane transfer.
+//!
+//! A mapping generation alone cannot prove the geometry: the device descriptor
+//! can be republished without replacing its page list. The transaction retains
+//! both, then rechecks them after settlement and page revalidation. Imports are
+//! local to this call and released before it returns; no CPU alias escapes to a
+//! later GPU submission. The guest CPUs are not stopped by this transaction.
+
+use super::{mapping_page_gpas, PagesVouched, RunCopy};
+use crate::model::{DeviceState, MappingEntry};
+use crate::runtime::guest_ram::GuestRun;
+use crate::runtime::host::{HostMemory, HostOps};
+
+#[derive(Debug)]
+pub enum RectBatchRefusal {
+    Allocation,
+    StorageChanged,
+    PagesNotOurs,
+    Empty,
+    MixedDirections,
+    Window { index: usize },
+    Overlap { first: usize, second: usize },
+    Map { offset: u64, pages: usize },
+    HostBound { offset: u64 },
+}
+
+impl crate::observe::Decline for RectBatchRefusal {
+    fn slug(&self) -> &'static str {
+        match self {
+            Self::Allocation => "mapping_rect_batch_allocation",
+            Self::StorageChanged => "mapping_rect_batch_storage_changed",
+            Self::PagesNotOurs => "mapping_rect_batch_pages_not_ours",
+            Self::Empty => "mapping_rect_batch_empty",
+            Self::MixedDirections => "mapping_rect_batch_mixed_directions",
+            Self::Window { .. } => "mapping_rect_batch_window",
+            Self::Overlap { .. } => "mapping_rect_batch_overlap",
+            Self::Map { .. } => "mapping_rect_batch_map",
+            Self::HostBound { .. } => "mapping_rect_batch_host_bound",
+        }
+    }
+
+    fn fields(&self) -> Vec<(&'static str, String)> {
+        match self {
+            Self::Window { index } => vec![("plane", index.to_string())],
+            Self::Overlap { first, second } => vec![
+                ("first_plane", first.to_string()),
+                ("second_plane", second.to_string()),
+            ],
+            Self::Map { offset, pages } => {
+                vec![("offset", offset.to_string()), ("pages", pages.to_string())]
+            }
+            Self::HostBound { offset } => vec![("offset", offset.to_string())],
+            _ => Vec::new(),
+        }
+    }
+}
+
+/// Identity of the storage whose layout the caller decoded, including its
+/// complete descriptor. Taken after writeback settlement, never before it.
+pub(crate) struct MappingStorageIdentity {
+    mapping_id: u32,
+    generation: u32,
+    descriptor: Vec<u8>,
+    geometry: (bool, u32, u32, u16),
+}
+
+impl MappingStorageIdentity {
+    pub(crate) fn capture(
+        mapping_id: u32,
+        mapping: &MappingEntry,
+    ) -> Result<Self, RectBatchRefusal> {
+        if !mapping.mapped || mapping.page_entries.is_empty() {
+            return Err(RectBatchRefusal::StorageChanged);
+        }
+        let mut descriptor = Vec::new();
+        descriptor
+            .try_reserve_exact(mapping.device_desc.len())
+            .map_err(|_| RectBatchRefusal::Allocation)?;
+        descriptor.extend_from_slice(&mapping.device_desc);
+        Ok(Self {
+            mapping_id,
+            generation: mapping.map_generation,
+            descriptor,
+            geometry: (
+                mapping.has_geom,
+                mapping.width,
+                mapping.height,
+                mapping.format,
+            ),
+        })
+    }
+
+    fn covers(&self, state: &DeviceState, mapping_id: u32) -> bool {
+        self.mapping_id == mapping_id
+            && state.mappings.get(&mapping_id).is_some_and(|m| {
+                m.mapped
+                    && !m.page_entries.is_empty()
+                    && m.map_generation == self.generation
+                    && m.device_desc == self.descriptor
+                    && (m.has_geom, m.width, m.height, m.format) == self.geometry
+            })
+    }
+}
+
+pub(crate) struct MappingRectCopy<'a> {
+    offset: u64,
+    copy: RunCopy<'a>,
+}
+
+impl<'a> MappingRectCopy<'a> {
+    pub(crate) fn new(offset: u64, copy: RunCopy<'a>) -> Self {
+        Self { offset, copy }
+    }
+
+    fn end(&self) -> Option<u64> {
+        self.offset
+            .checked_add(u64::try_from(self.copy.len()).ok()?)
+    }
+}
+
+struct MappedRun {
+    bytes: GuestRun,
+    offset: u64,
+    owned: bool,
+}
+
+/// Local view owner. Any preparation error releases the already acquired views
+/// without copying a prefix. One view per physical run also avoids duplicate
+/// bounce-buffer writeback when planes share a boundary page.
+struct Views<'a, H: HostOps> {
+    host: &'a mut H,
+    runs: Vec<MappedRun>,
+}
+
+impl<H: HostOps> Drop for Views<'_, H> {
+    fn drop(&mut self) {
+        for run in self.runs.iter().rev().filter(|run| run.owned) {
+            self.host
+                .unmap_pages(run.bytes.host_ptr(), run.bytes.len() as usize);
+        }
+    }
+}
+
+struct Piece {
+    copy_index: usize,
+    buffer_offset: usize,
+    bytes: GuestRun,
+}
+
+/// Move disjoint rectangles of one settled mapping as one publication unit.
+///
+/// All windows, proofs, views and piece bounds are prepared before the first
+/// byte moves. Failure therefore neither writes a prefix nor returns a partial
+/// read. Success on the write direction invalidates both windows; the surface
+/// owner advances its content generation once after this function returns.
+/// This is not an atomic store with respect to concurrently running guest CPUs.
+pub(crate) fn copy_mapping_rects<H: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut H,
+    mapping_id: u32,
+    identity: &MappingStorageIdentity,
+    vouched: &PagesVouched,
+    copies: &mut [MappingRectCopy<'_>],
+) -> Result<(), RectBatchRefusal> {
+    use RectBatchRefusal as R;
+    let writing = copies.first().ok_or(R::Empty)?.copy.is_write();
+    for (index, copy) in copies.iter().enumerate() {
+        if copy.copy.is_write() != writing {
+            return Err(R::MixedDirections);
+        }
+        if copy.copy.len() == 0 || copy.copy.len() > isize::MAX as usize || copy.end().is_none() {
+            return Err(R::Window { index });
+        }
+        for (other_index, other) in copies[..index].iter().enumerate() {
+            if copy.offset < other.end().ok_or(R::Window { index: other_index })?
+                && other.offset < copy.end().ok_or(R::Window { index })?
+            {
+                return Err(R::Overlap {
+                    first: other_index,
+                    second: index,
+                });
+            }
+        }
+    }
+    if !identity.covers(state, mapping_id) || !vouched.covers(state, mapping_id) {
+        return Err(R::StorageChanged);
+    }
+    let contig = super::ensure_contig_view(state, host, mapping_id);
+    let mut views = Views {
+        host,
+        runs: Vec::new(),
+    };
+    if let Some((ptr, len)) = contig {
+        if len > isize::MAX as usize {
+            return Err(R::HostBound { offset: 0 });
+        }
+        views.runs.try_reserve_exact(1).map_err(|_| R::Allocation)?;
+        let bytes = GuestRun::whole(ptr, len as u64).ok_or(R::HostBound { offset: 0 })?;
+        views.runs.push(MappedRun {
+            bytes,
+            offset: 0,
+            owned: false,
+        });
+    } else {
+        let gpas = mapping_page_gpas(state, views.host, mapping_id).ok_or(R::PagesNotOurs)?;
+        let page_size = state.page_size();
+        let page_len = usize::try_from(page_size).map_err(|_| R::HostBound { offset: 0 })?;
+        let mapping_span = (gpas.len() as u64)
+            .checked_mul(page_size)
+            .ok_or(R::HostBound { offset: 0 })?;
+        for (index, copy) in copies.iter().enumerate() {
+            if copy.end().ok_or(R::Window { index })? > mapping_span {
+                return Err(R::Window { index });
+            }
+        }
+        let runs = reims_vgpu_paging::runs::contig_page_runs(&gpas, page_size);
+        views
+            .runs
+            .try_reserve_exact(runs.len())
+            .map_err(|_| R::Allocation)?;
+        for run in runs {
+            let offset = (run.start as u64)
+                .checked_mul(page_size)
+                .ok_or(R::HostBound { offset: 0 })?;
+            let end = (run.end as u64)
+                .checked_mul(page_size)
+                .ok_or(R::HostBound { offset })?;
+            if !copies
+                .iter()
+                .any(|copy| copy.offset < end && copy.end().is_some_and(|e| offset < e))
+            {
+                continue;
+            }
+            let page_count = run.end - run.start;
+            let total = page_count
+                .checked_mul(page_len)
+                .filter(|&n| n <= isize::MAX as usize)
+                .ok_or(R::HostBound { offset })?;
+            let ptr = views.host.map_pages(&gpas[run], page_len).ok_or(R::Map {
+                offset,
+                pages: page_count,
+            })?;
+            let Some(bytes) = GuestRun::whole(ptr, total as u64) else {
+                views.host.unmap_pages(ptr, total);
+                return Err(R::HostBound { offset });
+            };
+            views.runs.push(MappedRun {
+                bytes,
+                offset,
+                owned: true,
+            });
+        }
+    }
+    if !identity.covers(state, mapping_id) || !vouched.covers(state, mapping_id) {
+        return Err(R::StorageChanged);
+    }
+    let mut pieces = Vec::new();
+    pieces
+        .try_reserve_exact(
+            copies
+                .len()
+                .checked_mul(views.runs.len())
+                .ok_or(R::Allocation)?,
+        )
+        .map_err(|_| R::Allocation)?;
+    for (copy_index, copy) in copies.iter().enumerate() {
+        let end = copy.end().ok_or(R::Window { index: copy_index })?;
+        let mut covered = 0u64;
+        for run in &views.runs {
+            let run_end = run
+                .offset
+                .checked_add(run.bytes.len())
+                .ok_or(R::HostBound { offset: run.offset })?;
+            let lo = copy.offset.max(run.offset);
+            let hi = end.min(run_end);
+            if lo >= hi {
+                continue;
+            }
+            let len = hi - lo;
+            let bytes =
+                GuestRun::in_mapping(run.bytes.host_ptr(), run.bytes.len(), lo - run.offset, len)
+                    .ok_or(R::HostBound { offset: lo })?;
+            let buffer_offset =
+                usize::try_from(lo - copy.offset).map_err(|_| R::Window { index: copy_index })?;
+            covered = covered
+                .checked_add(len)
+                .ok_or(R::Window { index: copy_index })?;
+            pieces.push(Piece {
+                copy_index,
+                buffer_offset,
+                bytes,
+            });
+        }
+        if covered != copy.copy.len() as u64 {
+            return Err(R::Window { index: copy_index });
+        }
+    }
+    // No fallible operation below. Each copy's packed-row bound was established
+    // by RunCopy's constructor; each host span is a bounded live GuestRun.
+    if writing {
+        state.note_host_wrote_mapping(mapping_id);
+    }
+    for piece in pieces {
+        // SAFETY: the transaction retains each view until after every piece;
+        // GuestRun checked its host bound and the enclosing copy's span is covered.
+        unsafe {
+            copies[piece.copy_index].copy.apply(
+                piece.bytes.host_ptr(),
+                0,
+                piece.buffer_offset,
+                piece.bytes.len() as usize,
+            );
+        }
+    }
+    // Release all transient CPU views before publishing content or stamping the
+    // dirty witness. A host that copies on unmap must finish that work first.
+    drop(views);
+    if writing {
+        for copy in copies {
+            let end = copy.offset + copy.copy.len() as u64; // checked in preparation
+            state.invalidate_storage_residency_window(mapping_id, copy.offset, end);
+            super::note_mapping_write_footprint(state, mapping_id, copy.offset, end - copy.offset);
+        }
+    }
+    Ok(())
+}
