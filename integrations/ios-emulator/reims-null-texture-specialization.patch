+/// **A fragment shader asking `is_null_texture` takes the null path exactly when
+/// the draw names the argument unbound.**
+///
+/// The product path binds a neutral 1x1 transparent-black image where a
+/// declared fragment texture arrived unbound (`frag_neutral_texture_substituted`)
+/// and names the argument in `DrawRequest::frag_null_textures`; the pipeline is
+/// then specialized so the translator's per-argument `OpSpecConstantFalse`
+/// (`NULL_TEXTURE_SPEC_ID_BASE + n`) reads true. The shader here is that shape
+/// in GLSL: a `constant_id` bool at the argument's id, red on the null path, the
+/// sampled texel otherwise. Bound and unnamed, the texel (green) must come
+/// through; substituted and named, the red must, and the substitute's
+/// transparent black must reach nothing. iOS's wallpaper is this shape -- an
+/// optional darkening texture guarded by `is_null_texture` -- and before the
+/// specialization every one of its passes sampled the substitute.
+///
+/// Skips on a host without `glslc`.
+#[test]
+fn a_fragment_shader_asking_is_null_texture_takes_the_null_path_only_when_told() {
+    let _guard = engine_test_lock().lock().unwrap();
+    let vert = translate_words("render_tri.air", Stage::Vertex);
+    let Some(frag) = glsl_words(
+        &format!(
+            r#"#version 450
+layout(constant_id = {id}) const bool tex0_null = false;
+layout(set = 0, binding = 32) uniform texture2D tex0;
+layout(set = 0, binding = 160) uniform sampler smp0;
+layout(location = 0) out vec4 color;
+void main() {{
+    if (tex0_null) {{
+        color = vec4(1.0, 0.0, 0.0, 1.0);
+    }} else {{
+        color = texture(sampler2D(tex0, smp0), vec2(0.5, 0.5));
+    }}
+}}
+"#,
+            id = metal2vulkan::reflect::NULL_TEXTURE_SPEC_ID_BASE
+        ),
+        "fragment",
+        "null_texture_predicate",
+    ) else {
+        return;
+    };
+    let identity = TargetIdentity::Surface {
+        id: 990_409,
+        width: W,
+        height: H,
+        generation: 1,
+        format: SURFACE_TEST_FORMAT,
+    };
+    let texel_image = |rgba: [u8; 4]| SampledImageResource {
+        binding: 32,
+        array_element: 0,
+        descriptor_count: 1,
+        width: 1,
+        height: 1,
+        layers: 1,
+        kind: reims_vgpu_core::texture_shape::TextureKind::D2,
+        multisampled: false,
+        source: SampledSource::Bytes(std::sync::Arc::new(rgba.to_vec())),
+        byte_origin: Default::default(),
+        format: ash::vk::Format::R8G8B8A8_UNORM,
+        identity: None,
+        swizzle: Default::default(),
+    };
+    let draw = |image: SampledImageResource, null_mask: u128| -> Result<Vec<u8>, String> {
+        let mut req = batch_req(&vert, &frag, &identity, false, half_scissor(true));
+        req.sampled_images.push(image);
+        req.samplers.push(SamplerResource::normalized_default(160));
+        req.frag_null_textures = null_mask;
+        engine::execute_draw_request(engine_device(), &req).map_err(|e| e.to_string())?;
+        Ok(engine::read_target(&identity)
+            .expect("read_target flushes the batch")
+            .into_rgba8()
+            .expect("an eight-bit colour readback"))
+    };
+    const GREEN: [u8; 4] = [0, 255, 0, 255];
+    let bound = match draw(texel_image(GREEN), 0) {
+        Ok(px) => px,
+        Err(msg) => {
+            if skip_if_no_gpu(&msg) {
+                eprintln!("skipping: {msg}");
+                return;
+            }
+            panic!("bound draw: {msg}");
+        }
+    };
+    // Inside the scissored half, where the triangle covers the target.
+    let i = (((H / 2) * W + W / 4) * 4) as usize;
+    assert!(
+        near(bound[i], 0) && near(bound[i + 1], 255) && near(bound[i + 2], 0),
+        "a bound argument samples its texel: {:?}",
+        &bound[i..i + 4]
+    );
+    // The product's substitute for an unbound argument, and the argument named.
+    let unbound = draw(texel_image([0, 0, 0, 0]), 1).expect("the specialized draw");
+    assert!(
+        near(unbound[i], 255) && near(unbound[i + 1], 0) && near(unbound[i + 2], 0),
+        "an unbound argument takes the null path: {:?}",
+        &unbound[i..i + 4]
+    );
+    // The same substitute with the argument not named: the sampling path, onto
+    // the substitute's transparent black. This is what every unbound argument
+    // got before the specialization existed, and it is what one that is bound
+    // elsewhere but left unnamed still gets, which is why the draw side names
+    // every argument it substitutes for.
+    let unnamed = draw(texel_image([0, 0, 0, 0]), 0).expect("the unspecialized draw");
+    assert!(
+        near(unnamed[i], 0) && near(unnamed[i + 1], 0) && near(unnamed[i + 2], 0),
+        "an unnamed argument samples the substitute: {:?}",
+        &unnamed[i..i + 4]
+    );
+    engine::test_quiesce_ring();
+}
