+    /// for -- [`super::types::DrawRequest::frag_null_textures`] -- as the
+    /// specialization constants `NULL_TEXTURE_SPEC_ID_BASE + n`. In the key
+    /// because a specialization is pipeline state: the same shaders with a
+    /// different set of unbound arguments are a different pipeline.
+    pub frag_null_textures: u128,
+}
+
+/// The specialization a pipeline's fragment stage is created with for
+/// [`PipelineKey::frag_null_textures`]: one `VK_TRUE` (a `VkBool32`, four bytes)
+/// per set bit `n`, mapped to constant id `NULL_TEXTURE_SPEC_ID_BASE + n`, which
+/// is where the translator put the `OpSpecConstantFalse` answering
+/// `is_null_texture` for `[[texture(n)]]`. An id the module does not declare is
+/// ignored by the driver, so a draw may name every argument it left unbound
+/// without asking which ones the shader asks about. Empty for a zero mask, and
+/// then not attached at all.
+pub(crate) fn null_texture_specialization(
+    mask: u128,
+) -> (Vec<vk::SpecializationMapEntry>, Vec<u8>) {
+    let value = vk::TRUE.to_ne_bytes();
+    let mut entries = Vec::new();
+    let mut data = Vec::new();
+    for index in 0..u128::BITS {
+        if mask & (1u128 << index) == 0 {
+            continue;
+        }
+        entries.push(
+            vk::SpecializationMapEntry::default()
+                .constant_id(metal2vulkan::reflect::NULL_TEXTURE_SPEC_ID_BASE + index)
+                .offset(data.len() as u32)
+                .size(value.len()),
+        );
+        data.extend_from_slice(&value);
+    }
+    (entries, data)
+}
+
+#[cfg(test)]
+mod null_texture_specialization_tests {
+    use super::*;
+
+    /// Each set bit of the mask becomes one `VK_TRUE` at the argument's own
+    /// id, packed in index order, and a zero mask specializes nothing.
+    #[test]
+    fn a_null_texture_mask_specializes_exactly_its_arguments_true() {
+        let (entries, data) = null_texture_specialization(0);
+        assert!(entries.is_empty() && data.is_empty());
+
+        let (entries, data) = null_texture_specialization((1 << 0) | (1 << 11) | (1 << 127));
+        let base = metal2vulkan::reflect::NULL_TEXTURE_SPEC_ID_BASE;
+        let map: Vec<(u32, u32, usize)> = entries
+            .iter()
+            .map(|entry| (entry.constant_id, entry.offset, entry.size))
+            .collect();
+        assert_eq!(
+            map,
+            vec![(base, 0, 4), (base + 11, 4, 4), (base + 127, 8, 4)]
+        );
+        assert_eq!(data, [vk::TRUE.to_ne_bytes(); 3].concat());
+    }
 }
 
