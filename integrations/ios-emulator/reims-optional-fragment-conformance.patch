+#[test]
+fn optional_fragment_masks_every_mrt_color_attachment_on_the_gpu() {
+    let _g = engine_test_session();
+    let (v, f) = triangle_spirv();
+    let target = |id| TargetIdentity::Surface {
+        id,
+        width: 16,
+        height: 16,
+        generation: 1,
+        format: ash::vk::Format::R8G8B8A8_UNORM,
+    };
+    let secondary = target(0x6204);
+    let mut req = engine_req(&v, &f, 16, 16);
+    req.frag_spirv = None;
+    req.target_identity = Some(target(0x6203));
+    req.color_attachment = Some(color_attachment(
+        reims_vgpu::protocol::pixel_format::MTL_FORMAT_RGBA8_UNORM,
+        [0.2, 0.4, 0.6, 1.0],
+    ));
+    req.secondary_targets.push(SecondaryColorTarget {
+        identity: secondary.clone(),
+        width: 16,
+        height: 16,
+        attachment: color_attachment(
+            reims_vgpu::protocol::pixel_format::MTL_FORMAT_RGBA8_UNORM,
+            [0.8, 0.1, 0.3, 1.0],
+        ),
+        load: false,
+        blend: None,
+        color_write_mask: Default::default(),
+    });
+    let pixels = semantic_rgba(
+        &engine::execute_draw_request(engine_device(), &req)
+            .expect("working Vulkan device required"),
+    );
+    assert!(pixels.chunks_exact(4).all(|p| p
+        .iter()
+        .zip([51, 102, 153, 255])
+        .all(|(got, want)| near(*got, want))));
+    let pixels = engine::read_target(&secondary)
+        .expect("secondary resident")
+        .into_rgba8()
+        .expect("RGBA8 secondary");
+    assert!(
+        pixels.chunks_exact(4).all(|p| p
+            .iter()
+            .zip([204, 26, 77, 255])
+            .all(|(got, want)| near(*got, want))),
+        "nil stage wrote an undefined secondary fragment output"
+    );
+}
