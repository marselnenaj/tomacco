+#[test]
+fn optional_fragment_native_absence_is_not_a_zero_or_malformed_reference() {
+    use reims_vgpu_protocol::render_pipeline::{FragmentFunction, Rasterization};
+    let absent = render_pipeline_desc(62, &[(PIPELINE_TAG_VERTEX_FUNC, 7)]);
+    let decoded = decode_render_pipeline_descriptor(&absent).unwrap();
+    assert_eq!(decoded.fragment_function, FragmentFunction::Absent);
+    assert_eq!(decoded.rasterization, Rasterization::Enabled);
+    let zero = render_pipeline_desc(
+        62,
+        &[
+            (PIPELINE_TAG_VERTEX_FUNC, 7),
+            (PIPELINE_TAG_FRAGMENT_FUNC, 0),
+        ],
+    );
+    assert_eq!(
+        decode_render_pipeline_descriptor(&zero),
+        Err(DecodeStatus::ErrUnsupported(
+            "res_render_pipeline_fragment_reference_zero"
+        ))
+    );
+    let duplicate = render_pipeline_desc(
+        62,
+        &[
+            (PIPELINE_TAG_VERTEX_FUNC, 7),
+            (PIPELINE_TAG_FRAGMENT_FUNC, 3),
+            (PIPELINE_TAG_FRAGMENT_FUNC, 4),
+        ],
+    );
+    assert_eq!(
+        decode_render_pipeline_descriptor(&duplicate),
+        Err(DecodeStatus::ErrUnsupported(
+            "res_render_pipeline_duplicate_stage_field"
+        ))
+    );
+    let mut short = render_pipeline_desc(
+        62,
+        &[
+            (PIPELINE_TAG_VERTEX_FUNC, 7),
+            (PIPELINE_TAG_FRAGMENT_FUNC, 3),
+        ],
+    );
+    short[24] = 3;
+    short.pop();
+    let length = short.len() as u32;
+    st32(&mut short[4..], length);
+    st32(&mut short[12..], length - 16);
+    assert_eq!(
+        decode_render_pipeline_descriptor(&short),
+        Err(DecodeStatus::ErrUnsupported(
+            "res_render_pipeline_fragment_width"
+        ))
+    );
+    let disabled = render_pipeline_desc(62, &[(PIPELINE_TAG_VERTEX_FUNC, 7), (0x07, 0)]);
+    assert_eq!(
+        decode_render_pipeline_descriptor(&disabled)
+            .unwrap()
+            .rasterization,
+        Rasterization::Disabled
+    );
+    let invalid = render_pipeline_desc(62, &[(PIPELINE_TAG_VERTEX_FUNC, 7), (0x07, 2)]);
+    assert_eq!(
+        decode_render_pipeline_descriptor(&invalid),
+        Err(DecodeStatus::ErrUnsupported(
+            "res_render_pipeline_rasterization_value"
+        ))
+    );
+}
