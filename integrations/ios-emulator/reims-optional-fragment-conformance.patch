+/// Native nil fragment semantics: the vertex stage still rasterizes and writes
+/// depth, while all color channels retain their contents. A later real fragment
+/// must consume that depth and must not reuse a pipeline with color writes off.
+#[test]
+fn optional_fragment_preserves_color_and_writes_depth_on_the_gpu() {
+    let _g = engine_test_session();
+    let (v, f) = triangle_spirv();
+    let identity = TargetIdentity::Surface {
+        id: 0x6201,
+        width: 16,
+        height: 16,
+        generation: 1,
+        format: ash::vk::Format::R8G8B8A8_UNORM,
+    };
+    let depth = TargetIdentity::Texture {
+        ref_: 0x6202,
+        width: 16,
+        height: 16,
+        generation: 1,
+        stencil: false,
+    };
+    let mut req = engine_req(&v, &f, 16, 16);
+    req.target_identity = Some(identity);
+    req.color_attachment = Some(color_attachment(
+        reims_vgpu::protocol::pixel_format::MTL_FORMAT_RGBA8_UNORM,
+        [0.2, 0.4, 0.6, 1.0],
+    ));
+    req.frag_spirv = None;
+    req.depth = Some(DepthState {
+        identity: Some(depth),
+        test_enable: true,
+        write_enable: true,
+        compare: SamplerCompareFunction::Always,
+        clear_value: 0.1234567,
+        load: false,
+        stencil: None,
+    });
+    let pixels = semantic_rgba(
+        &engine::execute_draw_request(engine_device(), &req)
+            .expect("working Vulkan device required"),
+    );
+    assert!(
+        pixels.chunks_exact(4).all(|p| p
+            .iter()
+            .zip([51, 102, 153, 255])
+            .all(|(got, want)| near(*got, want))),
+        "absent fragment changed the color clear"
+    );
+    // Equal only passes if the first draw actually wrote its vertex depth. The
+    // deliberately nonstandard clear differs from the fullscreen fixture's z.
+    req.frag_spirv = Some(std::sync::Arc::new(f));
+    req.load_from_target = true;
+    let depth = req.depth.as_mut().unwrap();
+    depth.load = true;
+    depth.write_enable = false;
+    depth.compare = SamplerCompareFunction::Equal;
+    let pixels = semantic_rgba(
+        &engine::execute_draw_request(engine_device(), &req).expect("depth consumer"),
+    );
+    assert_fullscreen_fragment_color(
+        "fragment restored after nil depth producer",
+        &pixels,
+        16,
+        16,
+    );
+    req.frag_spirv = None;
+    let preserved = semantic_rgba(
+        &engine::execute_draw_request(engine_device(), &req)
+            .expect("nil stage after real fragment"),
+    );
+    assert_eq!(
+        preserved, pixels,
+        "cache must restore no-color-write semantics"
+    );
+}
