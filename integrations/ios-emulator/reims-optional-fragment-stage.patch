+
+fn unique_pipeline_value<'a>(
+    bytes: &'a [u8],
+    fields: &[CompactTlv],
+    tag: u8,
+) -> Result<Option<&'a [u8]>, DecodeStatus> {
+    let mut matches = fields.iter().filter(|field| field.tag == tag);
+    let Some(field) = matches.next() else {
+        return Ok(None);
+    };
+    if matches.next().is_some() {
+        return Err(DecodeStatus::ErrUnsupported(
+            "res_render_pipeline_duplicate_stage_field",
+        ));
+    }
+    bytes
+        .get(field.value_offset..field.value_offset + usize::from(field.length))
+        .map(Some)
+        .ok_or(DecodeStatus::ErrShort(
+            "res_render_pipeline_stage_value_short",
+        ))
+}
+
+fn pipeline_stage_refusal(refusal: reims_vgpu_protocol::render_pipeline::Refusal) -> DecodeStatus {
