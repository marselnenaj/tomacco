+++ b/reims-vgpu/crates/reims-vgpu-protocol/src/render_pipeline.rs
@@ -0,0 +1,63 @@
+//! Classic Metal render-pipeline optional stages and rasterization.
+//!
+//! The native Metal 27 serializer omits tag 2 for fragmentFunction == nil.
+//! A non-nil function always publishes a four-byte functionRef, including zero:
+//! presence with zero is therefore not the absence contract. Mesh role remapping
+//! is handled by the descriptor adapter and does not inherit classic omission.
+
+use core::num::NonZeroU32;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum FragmentFunction {
+    #[default]
+    Absent,
+    Present(NonZeroU32),
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Rasterization {
+    #[default]
+    Enabled,
+    Disabled,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Refusal {
+    FunctionWidth,
+    FunctionReferenceZero,
+    RasterizationWidth,
+    RasterizationValue,
+}
+
+impl FragmentFunction {
+    pub fn decode(value: Option<&[u8]>) -> Result<Self, Refusal> {
+        let Some(value) = value else {
+            return Ok(Self::Absent);
+        };
+        let bytes: [u8; 4] = value.try_into().map_err(|_| Refusal::FunctionWidth)?;
+        NonZeroU32::new(u32::from_le_bytes(bytes))
+            .map(Self::Present)
+            .ok_or(Refusal::FunctionReferenceZero)
+    }
+
+    pub const fn reference(self) -> Option<NonZeroU32> {
+        match self {
+            Self::Absent => None,
+            Self::Present(reference) => Some(reference),
+        }
+    }
+}
+
+impl Rasterization {
+    pub fn decode(value: Option<&[u8]>) -> Result<Self, Refusal> {
+        let Some(value) = value else {
+            return Ok(Self::Enabled);
+        };
+        let bytes: [u8; 4] = value.try_into().map_err(|_| Refusal::RasterizationWidth)?;
+        match u32::from_le_bytes(bytes) {
+            0 => Ok(Self::Disabled),
+            1 => Ok(Self::Enabled),
+            _ => Err(Refusal::RasterizationValue),
+        }
+    }
+}
