+/// The present capture's form of [`read_resident_bgra`]: the same frame, the
+/// same refusals, written straight into the caller's recycled buffer.
+///
+/// [`read_resident_bgra`] copies the staging buffer out into a `Vec`, narrows
+/// that into a second one and exchanges R and B across it, after which the
+/// drain walks the result for `present_content`'s figures — four whole-frame
+/// passes and two fresh allocations per accepted present, 11-22 ms of
+/// `op0x08_us` at the vphone's 1206x2622 RGBA16F front. This borrows the
+/// staging buffer in place and writes `dst` once, in bands across a few
+/// threads, with the figures taken on the way (see [`present_capture`]).
+///
+/// The bytes are the old rail's by construction: the narrowing is the same
+/// `Rgba8Narrowing` table and the exchange is the same slot swap
+/// ([`crate::protocol::pixel_format::Rgba8Narrowing::convert_to_bgra8`]), a
+/// four-byte colour readback is copied or exchanged exactly as
+/// `TargetReadback::into_bgra8` did, and `dst` taking `dst.len()` bytes is the
+/// old `truncate(need)`.
+///
+/// `Some((rgb_nz, max_rgb, px0))` on success, the figures
+/// `observe::bgra_rgb_stats` returns for `dst`. `None` exactly where
+/// [`read_resident_bgra`] answers `None`, with the same decline lines; `dst`
+/// is then not a frame and the caller keeps its prior retain.
+///
+/// The lease is dropped before this returns and nothing here takes the engine
+/// lock while it is held — the rule [`ConsumableTargetTexels`] states.
+pub fn capture_resident_bgra_into(
+    identity: &TargetIdentity,
+    dst: &mut [u8],
+) -> Option<(usize, u8, [u8; 4])> {
+    use crate::protocol::pixel_format::Rgba8Narrowing;
+    {
+        let guard = lock_engine();
+        let slot = guard.pools.registry_get(identity)?;
+        if !slot.content_ready {
+            return None;
+        }
+    }
+    let decline = |e: &DrawError| {
+        let mut emit = crate::observe::Emit::decline("present_capture", e);
+        for (key, value) in draw_execution::identity_fields(identity) {
+            emit = emit.field(key, value);
+        }
+        emit.off();
+    };
+    let texels = match read_target_texels_consumable(identity) {
+        Ok(texels) => texels,
+        Err(e) => {
+            decline(&e);
+            return None;
+        }
+    };
+    let texel = texels.texel;
+    let plan = match texel {
+        ReadbackTexel::Bgra8 => Rgba8Narrowing::Bgra8,
+        ReadbackTexel::Rgba8 => Rgba8Narrowing::Rgba8,
+        ReadbackTexel::Native(layout) => {
+            // The old rail's shape check, refused under the old rail's error.
+            if let Err(e) = readback_pixel_count(texels.bytes().len(), layout) {
+                decline(&e);
+                return None;
+            }
+            match Rgba8Narrowing::for_layout(layout) {
+                Some(plan) => plan,
+                None => {
+                    crate::runtime::drain::note_store_route(
+                        "target_read_narrow_allocation_avoided",
+                    );
+                    crate::observe::off(format!(
+                        "present_capture reason=readback_texel_not_scanout texel={texel:?}"
+                    ));
+                    return None;
+                }
+            }
+        }
+    };
+    let bpt = plan.source_layout().bytes_per_texel() as usize;
+    let pixels = texels.bytes().len() / bpt;
+    // `narrow_colour_bytes` refused a native frame whose pixel count does not
+    // fit a `u32`, before it looked at the caller's length.
+    if matches!(texel, ReadbackTexel::Native(_)) && u32::try_from(pixels).is_err() {
+        decline(&DrawError::TargetRead(
+            reason::TargetReadDecline::ColourPixelCount {
+                pixels: pixels as u64,
+            },
+        ));
+        return None;
+    }
+    // The old `px.len() < need` refusal: the resident holds fewer pixels than
+    // the present names.
+    if pixels.checked_mul(RESIDENT_READ_BYTES_PER_TEXEL as usize)? < dst.len() {
+        return None;
+    }
+    let stats = present_capture::convert_with_stats(plan, texels.bytes(), dst)?;
+    drop(texels);
+    if matches!(texel, ReadbackTexel::Native(_)) {
+        crate::runtime::drain::note_store_route("target_read_narrowed");
+    }
+    crate::runtime::drain::note_store_route("present_capture_fused");
+    Some(stats)
+}
