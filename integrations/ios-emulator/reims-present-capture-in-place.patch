+    /// [`Self::convert`] followed by an exchange of R and B, written straight
+    /// into scanout (BGRA8) order.
+    ///
+    /// The present capture used to narrow a half-float frame into a fresh RGBA8
+    /// `Vec` and then walk it again to exchange R and B. Both passes are one
+    /// here for `Rgba16Float`, the compositor's front format, and the bytes are
+    /// the same table lookups landing in the exchanged slots: `dst[0]` is the
+    /// LUT of the source's blue half, and so on. Every other layout is the
+    /// two-step form spelled out, so there is one conversion per layout and
+    /// this cannot disagree with `convert` on any value.
+    pub fn convert_to_bgra8(self, src: &[u8], pixels: u32, dst_bgra: &mut [u8]) -> bool {
+        let px = pixels as usize;
+        let Some(src_len) = px.checked_mul(self.source_layout().bytes_per_texel() as usize) else {
+            return false;
+        };
+        let Some(dst_len) = px.checked_mul(RGBA8_BPP as usize) else {
+            return false;
+        };
+        if src.len() < src_len || dst_bgra.len() < dst_len {
+            return false;
+        }
+        match self {
+            Self::Rgba16Float => {
+                // Fixed-size chunks and a `u16` index into a 65 536-entry
+                // table: every access is in bounds by type, so the loop carries
+                // no checks. This is the capture's whole per-pixel cost.
+                let lut = f16_to_unorm8_lut();
+                let half = |s: &[u8; 8], c: usize| {
+                    lut[usize::from(u16::from_le_bytes([s[c * 2], s[c * 2 + 1]]))]
+                };
+                for (s, d) in src[..src_len]
+                    .as_chunks::<8>()
+                    .0
+                    .iter()
+                    .zip(dst_bgra[..dst_len].as_chunks_mut::<4>().0.iter_mut())
+                {
+                    d[COMPONENT_R] = half(s, COMPONENT_B);
+                    d[COMPONENT_G] = half(s, COMPONENT_G);
+                    d[COMPONENT_B] = half(s, COMPONENT_R);
+                    d[COMPONENT_A] = half(s, COMPONENT_A);
+                }
+            }
+            // A BGRA8 source narrowed to RGBA and exchanged back is its own bytes.
+            Self::Bgra8 => dst_bgra[..dst_len].copy_from_slice(&src[..dst_len]),
+            _ => {
+                if !self.convert(src, pixels, dst_bgra) {
+                    return false;
+                }
+                for d in dst_bgra[..dst_len].as_chunks_mut::<4>().0 {
+                    d.swap(COMPONENT_R, COMPONENT_B);
+                }
+            }
+        }
+        true
+    }
+}
