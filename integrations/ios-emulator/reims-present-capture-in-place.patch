+    /// Every half-float bit pattern, in every channel slot, through the fused
+    /// arm: NaNs, infinities, negatives, subnormals and the 0.5 tie included.
+    /// A slot mix-up or a different rounding fails on the first word it moves.
+    #[test]
+    fn the_fused_half_float_arm_is_convert_then_exchange_for_every_word() {
+        let pixels = 65536u32;
+        for rotate in 0..4usize {
+            let mut src = Vec::with_capacity(pixels as usize * 8);
+            for word in 0..pixels {
+                for channel in 0..4usize {
+                    // Each channel walks the whole table at its own offset, so
+                    // no two channels of a pixel carry the same word.
+                    let value = (word as usize + (channel + rotate) * 16411) as u16;
+                    src.extend_from_slice(&value.to_le_bytes());
+                }
+            }
+            let mut fused = vec![0xa5u8; pixels as usize * 4];
+            assert!(Rgba8Narrowing::Rgba16Float.convert_to_bgra8(&src, pixels, &mut fused));
+            assert_eq!(fused, two_step(Rgba8Narrowing::Rgba16Float, &src, pixels));
+        }
+    }
