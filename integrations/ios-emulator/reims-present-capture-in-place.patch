+    /// The old two-step answer: `convert` into RGBA8, then exchange R and B.
+    fn two_step(plan: Rgba8Narrowing, src: &[u8], pixels: u32) -> Vec<u8> {
+        let mut rgba = vec![0u8; pixels as usize * 4];
+        assert!(plan.convert(src, pixels, &mut rgba));
+        for px in rgba.as_chunks_mut::<4>().0 {
+            px.swap(0, 2);
+        }
