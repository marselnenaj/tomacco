+/// The present capture's in-place rail reads the same frame as the copying
+/// rail it replaced, on a real resident, and leaves the frame readable again.
+///
+/// Two residents: the compositor's RGBA16F front at a size that takes the
+/// banded multi-thread conversion, seeded with every class of half float a
+/// composite can hold (NaN, infinities, negatives, subnormals, the 0.5 tie,
+/// values past one), and a scanout-order BGRA8 surface. For each,
+/// `capture_resident_bgra_into` must write exactly the bytes
+/// `read_resident_bgra` returns and report `bgra_rgb_stats`'s figures for
+/// them; a destination shorter than the frame is the old `truncate(need)`.
+/// Fails on a tree without the fused capture (the function does not exist),
+/// and on any slot, rounding or band-edge difference in it.
+#[test]
+fn the_in_place_present_capture_is_the_copying_capture() {
+    use reims_vgpu_core::blend::ColorWriteMask;
+    use reims_vgpu_protocol::pixel_format::{
+        ColorLoadSeed, TexelLayout, MTL_FORMAT_BGRA8_UNORM, MTL_FORMAT_RGBA16_FLOAT,
+    };
+    let _g = engine_test_session();
+    let (v, f) = triangle_spirv();
+    let stats = |bgra: &[u8]| {
+        let mut nz = 0usize;
+        let mut max = 0u8;
+        for px in bgra.as_chunks::<4>().0 {
+            let m = px[0].max(px[1]).max(px[2]);
+            nz += usize::from(m != 0);
+            max = max.max(m);
+        }
+        let px0 = [bgra[0], bgra[1], bgra[2], bgra[3]];
+        (nz, max, px0)
+    };
+    let check = |label: &str, identity: &TargetIdentity, pixels: usize| {
+        let need = pixels * 4;
+        let old = engine::read_resident_bgra(identity, need).expect("copying capture");
+        assert_eq!(old.len(), need, "{label}");
+        for round in 0..2 {
+            let mut dst = vec![0x5au8; need];
+            let got = engine::capture_resident_bgra_into(identity, &mut dst)
+                .unwrap_or_else(|| panic!("{label}: in-place capture, round {round}"));
+            assert!(dst == old, "{label}: bytes differ from the copying capture");
+            assert_eq!(got, stats(&old), "{label}: figures");
+        }
+        let short = need / 2 / 4 * 4;
+        let mut dst = vec![0u8; short];
+        let got = engine::capture_resident_bgra_into(identity, &mut dst).expect("short");
+        assert_eq!(&dst[..], &old[..short], "{label}: leading pixels");
+        assert_eq!(got, stats(&old[..short]), "{label}: leading figures");
+        // A destination the resident cannot fill is the old `len < need` refusal.
+        let mut long = vec![0u8; need + 4];
+        assert_eq!(
+            engine::capture_resident_bgra_into(identity, &mut long),
+            None,
+            "{label}"
+        );
+    };
+
+    let (w, h) = (613u32, 431u32);
+    let pixels = (w * h) as usize;
+    let specials = [
+        0x0000u16, 0x8000, 0x0001, 0x03ff, 0x0400, 0x3800, 0x3801, 0x37ff, 0x3c00, 0x3c01, 0x7bff,
+        0x7c00, 0xfc00, 0x7e00, 0xfe01, 0xbc00, 0x2e66, 0x1c00,
+    ];
+    let mut state = 0x2545_f491u32;
+    let words: Vec<u16> = (0..pixels * 4)
+        .map(|i| {
+            state = state.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+            if i % 7 == 0 {
+                specials[(state >> 20) as usize % specials.len()]
+            } else {
+                (state >> 16) as u16
+            }
+        })
+        .collect();
+    let raw: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+    let front = TargetIdentity::Gva {
+        gva: 0x2c0000,
+        width: w,
+        height: h,
+        generation: 1,
+        format: ash::vk::Format::R16G16B16A16_SFLOAT,
+    };
+    let mut req = engine_req(&v, &f, w, h);
+    req.target_identity = Some(front.clone());
+    req.color_attachment = Some(color_attachment(MTL_FORMAT_RGBA16_FLOAT, [0.0; 4]));
+    req.target_cpu_seed = Some(ColorLoadSeed {
+        pixels: std::sync::Arc::new(raw.clone()),
+        layout: TexelLayout::Rgba16Float,
+    });
+    req.skip_readback = true;
+    req.color_write_mask = ColorWriteMask::NONE;
+    match engine::execute_draw_request(engine_device(), &req) {
+        Ok(_) => {}
+        Err(e) if skip_if_no_gpu(&e.to_string()) => {
+            eprintln!("SKIP in-place present capture: {e}");
+            return;
+        }
+        Err(e) => panic!("RGBA16F front seed: {e}"),
+    }
+    assert_eq!(
+        engine::read_target_texels(&front).unwrap().pixels,
+        raw,
+        "precondition: the resident holds the seeded words"
+    );
+    check("rgba16f front", &front, pixels);
+
+    let (sw, sh) = (37u32, 23u32);
+    let surface = TargetIdentity::Surface {
+        id: 4242,
+        width: sw,
+        height: sh,
+        generation: 1,
+        format: SURFACE_TEST_FORMAT,
+    };
+    let bgra: Vec<u8> = (0..(sw * sh) as usize * 4)
+        .map(|i| (i * 37 % 251) as u8)
+        .collect();
+    let mut req = engine_req(&v, &f, sw, sh);
+    req.target_identity = Some(surface.clone());
+    req.color_attachment = Some(color_attachment(MTL_FORMAT_BGRA8_UNORM, [0.0; 4]));
+    req.target_cpu_seed = Some(bgra.into());
+    req.skip_readback = true;
+    req.color_write_mask = ColorWriteMask::NONE;
+    engine::execute_draw_request(engine_device(), &req).expect("BGRA8 surface seed");
+    check("bgra8 surface", &surface, (sw * sh) as usize);
+}
