@@ -0,0 +1,298 @@
+//! The present capture's CPU half: one pass from a resident's readback bytes
+//! to the tight BGRA8 retain, with the frame's occupancy figures on the side.
+//!
+//! # What it replaced, and what it cost
+//!
+//! Every accepted `CmdDisplaySwap` on a host with no engine-presented window
+//! (`window_publish no_window=…`, `capture_sampling light=0`) captured the
+//! compositor's RGBA16F front surface — 1206x2622 on the vphone, 25 MiB of
+//! half floats — through four whole-frame passes and two fresh allocations,
+//! all on the drain under the device lock:
+//!
+//! 1. the staging buffer copied out into a fresh 25 MiB `Vec`
+//!    (`ReadbackDelivery::Copy`, `readback_split map_us`);
+//! 2. that `Vec` narrowed through the half-float LUT into a fresh 12 MiB RGBA8
+//!    `Vec` (`narrow_colour_bytes`);
+//! 3. R and B exchanged across it (`TargetReadback::into_bgra8`);
+//! 4. moved into the retain, and then walked again by the drain for
+//!    `present_content`'s `rgb_nz` / `max_rgb` (`observe::bgra_rgb_stats`).
+//!
+//! Measured on this host's CPU (i9-13900K) with the product's own conversion
+//! at that geometry: 2-9 ms for the copy (the upper end while the fresh pages
+//! fault), 5-8 ms for the LUT, 1.2 ms for the exchange and 0.9 ms for the walk,
+//! plus the readback fence (~1.6 ms, `readback_split fence_us`) — the 11-22 ms
+//! per present that `drain_ops op0x08_us / op0x08_n` reads on the vphone.
+//!
+//! Now the staging buffer is borrowed in place (`ReadbackDelivery::Lease`) and
+//! [`convert_with_stats`] writes BGRA8 straight into the recycled capture
+//! scratch in pixel-independent bands on up to four scoped threads, folding the
+//! walk into each block while it is still in cache: 1.3-1.9 ms for the same
+//! frame on the same host, the fence unchanged.
+//!
+//! # Why the bytes are the same
+//!
+//! The conversion is [`Rgba8Narrowing::convert_to_bgra8`], which is
+//! `Rgba8Narrowing::convert` followed by the exchange — the same table, the
+//! same slots — and every pixel is converted independently of every other, so
+//! a band boundary cannot change a byte. The figures are `bgra_rgb_stats`'s own
+//! rule (a pixel counts when `max(B, G, R) != 0`) summed and maxed across
+//! bands, which is associative; `px0` is the first pixel of the first band.
+
+use crate::protocol::pixel_format::{Rgba8Narrowing, RGBA8_BPP};
+
+/// `(rgb_nz, max_rgb, px0)`, exactly as `observe::bgra_rgb_stats` spells them.
+pub type FrameStats = (usize, u8, [u8; 4]);
+
+/// Pixels converted before their figures are taken: 64 KiB of BGRA8, so the
+/// walk reads what the conversion just wrote out of L2 rather than DRAM.
+const BLOCK_PIXELS: usize = 16 * 1024;
+
+/// Frames smaller than this are converted on the calling thread; a thread
+/// costs tens of microseconds to start and a small frame is done before that.
+const PARALLEL_MIN_PIXELS: usize = 1 << 18;
+
+/// The most threads one capture uses. The drain already shares the host with
+/// the guest's vCPU threads; four bands bring a 3.2 Mpx frame to about a
+/// millisecond, and more would mostly contend for memory bandwidth.
+const MAX_THREADS: usize = 4;
+
+fn capture_threads() -> usize {
+    static THREADS: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *THREADS.get_or_init(|| {
+        std::thread::available_parallelism()
+            .map(usize::from)
+            .unwrap_or(1)
+            .clamp(1, MAX_THREADS)
+    })
+}
+
+/// The figures for one run of tight BGRA8, and how two runs combine.
+fn stats_of(bgra: &[u8]) -> (usize, u8) {
+    let (nz, max, _) = crate::observe::bgra_rgb_stats(bgra);
+    (nz, max)
+}
+
+/// Convert one band, block by block, taking each block's figures right after
+/// writing it. `false` only on a length the caller has already ruled out.
+fn convert_band(plan: Rgba8Narrowing, src: &[u8], dst: &mut [u8]) -> Option<(usize, u8)> {
+    let bpt = plan.source_layout().bytes_per_texel() as usize;
+    let px = RGBA8_BPP as usize;
+    let mut nz = 0usize;
+    let mut max = 0u8;
+    for (s, d) in src
+        .chunks(BLOCK_PIXELS * bpt)
+        .zip(dst.chunks_mut(BLOCK_PIXELS * px))
+    {
+        let pixels = u32::try_from(d.len() / px).ok()?;
+        if !plan.convert_to_bgra8(s, pixels, d) {
+            return None;
+        }
+        let (block_nz, block_max) = stats_of(d);
+        nz += block_nz;
+        max = max.max(block_max);
+    }
+    Some((nz, max))
+}
+
+/// Write `dst.len() / 4` pixels of `src` (in `plan`'s source layout) into `dst`
+/// as tight BGRA8 and return the frame's figures.
+///
+/// `None` — with `dst` untouched — when `dst` is not a whole number of pixels
+/// or `src` holds fewer of them; the capture treats that as no frame.
+pub fn convert_with_stats(plan: Rgba8Narrowing, src: &[u8], dst: &mut [u8]) -> Option<FrameStats> {
+    let px = RGBA8_BPP as usize;
+    let bpt = plan.source_layout().bytes_per_texel() as usize;
+    if !dst.len().is_multiple_of(px) {
+        return None;
+    }
+    let pixels = dst.len() / px;
+    let src = src.get(..pixels.checked_mul(bpt)?)?;
+    u32::try_from(pixels).ok()?;
+    let threads = if pixels >= PARALLEL_MIN_PIXELS {
+        capture_threads()
+    } else {
+        1
+    };
+    let (nz, max) = if threads <= 1 {
+        convert_band(plan, src, dst)?
+    } else {
+        // Whole blocks per band, so a band boundary is also a block boundary
+        // and each thread's walk covers exactly what it wrote.
+        let band_pixels = pixels.div_ceil(threads).div_ceil(BLOCK_PIXELS) * BLOCK_PIXELS;
+        let results: Vec<Option<(usize, u8)>> = std::thread::scope(|scope| {
+            let handles: Vec<_> = src
+                .chunks(band_pixels * bpt)
+                .zip(dst.chunks_mut(band_pixels * px))
+                .map(|(s, d)| scope.spawn(move || convert_band(plan, s, d)))
+                .collect();
+            handles
+                .into_iter()
+                .map(|handle| handle.join().unwrap_or(None))
+                .collect()
+        });
+        let mut nz = 0usize;
+        let mut max = 0u8;
+        for band in results {
+            let (band_nz, band_max) = band?;
+            nz += band_nz;
+            max = max.max(band_max);
+        }
+        (nz, max)
+    };
+    let px0 = match dst {
+        [b, g, r, a, ..] => [*b, *g, *r, *a],
+        _ => [0; 4],
+    };
+    Some((nz, max, px0))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::protocol::pixel_format::TexelLayout;
+
+    /// The rail this replaced, step for step: narrow to RGBA8 (or keep a
+    /// four-byte colour readback), exchange R and B, then walk the result.
+    fn old_rail(plan: Rgba8Narrowing, src: &[u8], pixels: usize) -> (Vec<u8>, FrameStats) {
+        let mut rgba = vec![0u8; pixels * 4];
+        assert!(plan.convert(src, pixels as u32, &mut rgba));
+        for px in rgba.as_chunks_mut::<4>().0 {
+            px.swap(0, 2);
+        }
+        let stats = crate::observe::bgra_rgb_stats(&rgba);
+        (rgba, stats)
+    }
+
+    fn noise(bytes: usize, seed: u32) -> Vec<u8> {
+        let mut state = seed;
+        (0..bytes)
+            .map(|_| {
+                state = state.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+                (state >> 24) as u8
+            })
+            .collect()
+    }
+
+    /// Half floats a composite actually holds — mostly in [0, 1], some black,
+    /// some past one, some negative — so `rgb_nz` and `max_rgb` are not
+    /// trivially the pixel count and 255.
+    fn composite_like(pixels: usize, seed: u32) -> Vec<u8> {
+        let words = noise(pixels * 8, seed);
+        words
+            .as_chunks::<2>()
+            .0
+            .iter()
+            .map(|w| {
+                let r = u16::from_le_bytes(*w);
+                match r % 8 {
+                    0 => 0u16,
+                    1 => 0x3c00 + (r >> 6),
+                    2 => 0x8000 | (r >> 4),
+                    _ => 0x2000 + (r % 0x1c00),
+                }
+            })
+            .flat_map(u16::to_le_bytes)
+            .collect()
+    }
+
+    /// The vphone's front surface at its own geometry, banded across threads:
+    /// every byte and every figure is the old rail's.
+    #[test]
+    fn a_full_screen_half_float_frame_is_the_old_rails_frame_and_figures() {
+        let pixels = 1206 * 2622;
+        let src = composite_like(pixels, 7);
+        let plan = Rgba8Narrowing::for_layout(TexelLayout::Rgba16Float).unwrap();
+        let mut dst = vec![0xeeu8; pixels * 4];
+        let stats = convert_with_stats(plan, &src, &mut dst).expect("a whole frame");
+        let (want, want_stats) = old_rail(plan, &src, pixels);
+        assert!(dst == want, "converted bytes differ from narrow + exchange");
+        assert_eq!(stats, want_stats);
+        assert!(
+            stats.0 > 0 && stats.0 < pixels,
+            "{stats:?}: the figures must be informative"
+        );
+    }
+
+    /// Band and block edges are where a split would lose or repeat a pixel, so
+    /// frames are taken on both sides of each, for every plan.
+    #[test]
+    fn every_plan_and_split_edge_matches_the_old_rail() {
+        let sizes = [
+            1,
+            BLOCK_PIXELS - 1,
+            BLOCK_PIXELS,
+            BLOCK_PIXELS + 1,
+            PARALLEL_MIN_PIXELS - 1,
+            PARALLEL_MIN_PIXELS,
+            PARALLEL_MIN_PIXELS + 3 * BLOCK_PIXELS + 17,
+        ];
+        let plans = [
+            Rgba8Narrowing::Rgba8,
+            Rgba8Narrowing::Bgra8,
+            Rgba8Narrowing::Rgba16Float,
+            Rgba8Narrowing::R16Float,
+            Rgba8Narrowing::Rg16Float,
+            Rgba8Narrowing::R8,
+            Rgba8Narrowing::Bgr10a2Unorm,
+        ];
+        for (i, &pixels) in sizes.iter().enumerate() {
+            for plan in plans {
+                let bpt = plan.source_layout().bytes_per_texel() as usize;
+                let src = noise(pixels * bpt, 31 + i as u32);
+                let mut dst = vec![0x11u8; pixels * 4];
+                let stats = convert_with_stats(plan, &src, &mut dst)
+                    .unwrap_or_else(|| panic!("{plan:?} {pixels}"));
+                let (want, want_stats) = old_rail(plan, &src, pixels);
+                assert!(dst == want, "{plan:?} {pixels}: bytes");
+                assert_eq!(stats, want_stats, "{plan:?} {pixels}: figures");
+            }
+        }
+    }
+
+    /// A destination shorter than the source is the old `truncate(need)`: the
+    /// leading pixels of the conversion, nothing past them read or written.
+    #[test]
+    fn a_shorter_destination_takes_the_leading_pixels() {
+        let plan = Rgba8Narrowing::Rgba16Float;
+        let src = composite_like(1000, 3);
+        let mut dst = vec![0u8; 600 * 4];
+        let stats = convert_with_stats(plan, &src, &mut dst).unwrap();
+        let (want, _) = old_rail(plan, &src, 1000);
+        assert_eq!(&dst[..], &want[..600 * 4]);
+        assert_eq!(stats, crate::observe::bgra_rgb_stats(&want[..600 * 4]));
+    }
+
+    /// Refusals leave the scratch as it was.
+    #[test]
+    fn a_short_source_or_a_partial_pixel_is_refused_untouched() {
+        let plan = Rgba8Narrowing::Rgba16Float;
+        let src = composite_like(10, 5);
+        let mut dst = vec![9u8; 11 * 4];
+        assert_eq!(convert_with_stats(plan, &src, &mut dst), None);
+        assert_eq!(dst, vec![9u8; 11 * 4]);
+        let mut ragged = vec![9u8; 4 * 4 + 2];
+        assert_eq!(convert_with_stats(plan, &src, &mut ragged), None);
+        assert_eq!(ragged, vec![9u8; 4 * 4 + 2]);
+    }
+
+    #[test]
+    fn a_black_frame_reads_black_and_an_empty_one_reads_zero() {
+        let plan = Rgba8Narrowing::Rgba16Float;
+        // Opaque black: alpha is 1.0, colour is zero, so `rgb_nz` is zero.
+        let src: Vec<u8> = [0u16, 0, 0, 0x3c00]
+            .repeat(PARALLEL_MIN_PIXELS + 5)
+            .into_iter()
+            .flat_map(u16::to_le_bytes)
+            .collect();
+        let mut dst = vec![1u8; (PARALLEL_MIN_PIXELS + 5) * 4];
+        assert_eq!(
+            convert_with_stats(plan, &src, &mut dst),
+            Some((0, 0, [0, 0, 0, 255]))
+        );
+        let mut empty: Vec<u8> = Vec::new();
+        assert_eq!(
+            convert_with_stats(plan, &src, &mut empty),
+            Some((0, 0, [0; 4]))
+        );
+    }
+}
