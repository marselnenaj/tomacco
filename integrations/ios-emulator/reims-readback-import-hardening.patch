+impl HostRamDecline {
+    /// Memory pressure can change while this same import stays alive. Other
+    /// refusals describe this pointer or device and remain memoizable.
+    fn cacheable(self) -> bool {
+        let result = match self {
+            Self::CreateBuffer { result }
+            | Self::AllocateMemory { result }
+            | Self::BindBuffer { result }
+            | Self::NoImportableMemoryType {
+                refusal: ImportTypeRefusal::PointerDeclined { result },
+                ..
+            } => Some(result),
+            _ => None,
+        };
+        !matches!(
+            result,
+            Some(vk::Result::ERROR_OUT_OF_HOST_MEMORY)
+                | Some(vk::Result::ERROR_OUT_OF_DEVICE_MEMORY)
+        )
+    }
 }
 
