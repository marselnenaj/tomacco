+/// Host byte extents are checked before allocating or issuing image copies.
+fn readback_byte_extent(pixels: u64, bytes_per_texel: u32) -> Result<usize, DrawError> {
+    pixels
+        .checked_mul(u64::from(bytes_per_texel))
+        .and_then(|bytes| usize::try_from(bytes).ok())
+        .filter(|bytes| *bytes <= isize::MAX as usize)
+        .ok_or(DrawError::TargetRead(
+            reason::TargetReadDecline::ByteExtent {
+                pixels,
+                bytes_per_texel,
+            },
+        ))
+}
+
+fn target_readback_extent(width: u32, height: u32, bytes_per_texel: u32) -> Result<u64, DrawError> {
+    let pixels = u64::from(width) * u64::from(height);
+    if width == 0 || height == 0 {
+        return Err(DrawError::TargetRead(
+            reason::TargetReadDecline::ByteExtent {
+                pixels,
+                bytes_per_texel,
+            },
+        ));
+    }
+    readback_byte_extent(pixels, bytes_per_texel).map(|bytes| bytes as u64)
+}
