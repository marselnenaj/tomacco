+/// What this device still holds that names a page, read when a finding fires.
+///
+/// The discriminator the residue paragraph above asks for, for the holders the
+/// device keeps itself. A page a live mapping or a registered view still names
+/// is reachable, so a write through it may be legitimate and the finding is the
+/// guard's blind spot rather than the defect; `None` is the reading that
+/// matters, because then nothing this device holds licenses the write. A task-GVA
+/// rail walks the live page table as it writes, so for those rails the walk is
+/// itself the holder and `None` here does not exonerate or implicate them.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PageOwner {
+    /// A mapped surface's current page list names the page.
+    Mapping(u32),
+    /// A surface's condemned page list (fresh MAP, no resolve since) names it.
+    Condemned(u32),
+    /// A registered task-GVA view of this task covers it.
+    View(u32),
+    /// Nothing this device holds names the page.
+    None,
+}
+
+impl PageOwner {
+    pub fn of(state: &crate::model::DeviceState, gpa: u64) -> Self {
+        use crate::protocol::iosurface_pages::entry_gpa_shift;
+        let shift = state.page_shift;
+        let names = |entries: &[u32]| {
+            entries
+                .iter()
+                .any(|&entry| entry_gpa_shift(entry, shift) == Some(gpa))
+        };
+        for (&id, m) in &state.mappings {
+            if m.mapped && names(&m.page_entries) {
+                return Self::Mapping(id);
+            }
+        }
+        for (&id, m) in &state.mappings {
+            if m.condemned_entries.as_deref().is_some_and(names) {
+                return Self::Condemned(id);
+            }
+        }
+        for v in &state.gva_host_views {
+            let len = v.ptr_len as u64;
+            if v.first_gpa != 0 && gpa >= v.first_gpa && gpa - v.first_gpa < len {
+                return Self::View(v.task_id);
+            }
+        }
+        Self::None
+    }
+}
+
+impl std::fmt::Display for PageOwner {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Mapping(id) => write!(f, "mapping:{id}"),
+            Self::Condemned(id) => write!(f, "condemned:{id}"),
+            Self::View(task) => write!(f, "view:task{task}"),
+            Self::None => f.write_str("none"),
+        }
+    }
+}
