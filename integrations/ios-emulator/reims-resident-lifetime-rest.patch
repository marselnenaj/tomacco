+/// Each door that bumps a generation queues the one it ended, and the flush that
+/// releases retired views takes the queue with it.
+#[test]
+fn a_bumped_surface_generation_is_queued_until_the_views_are_flushed() {
+    let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_X86);
+    state.map_surface(5);
+    assert!(state.ended_surface_generations.is_empty());
+    let born = state.mappings[&5].map_generation;
+    state.invalidate_mapping_pages(5);
+    let invalidated = state.mappings[&5].map_generation;
+    assert_ne!(invalidated, born);
+    assert!(state.unmap_surface(5));
+    let unmapped = state.mappings[&5].map_generation;
+    assert_ne!(unmapped, invalidated);
+    assert!(state.attach_mapping_internal(
+        5,
+        0x1000,
+        crate::protocol::iosurface_pages::MapperLayout::Compact
+    ));
+    assert_eq!(
+        state.ended_surface_generations,
+        vec![(5, born), (5, invalidated), (5, unmapped)],
+    );
+
+    let mut host = FakeHost::new();
+    flush_retired_views(&mut state, &mut host);
+    assert!(state.ended_surface_generations.is_empty());
+}
