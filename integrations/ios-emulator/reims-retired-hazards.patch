+    /// A long session must cost the live workload plus bounded maintenance,
+    /// even if its caller never explicitly compacts. Keep one old hazard live
+    /// across every rebuild while a moving window completes out of age order.
+    #[test]
+    fn completed_history_does_not_accumulate_in_admission_scans() {
+        let mut graph = DependencyGraph::new();
+        graph.admit(
+            ord(1),
+            &[intent(AccessKey::Whole(res(1)), AccessMode::Write)],
+        );
+        for n in 2..4098 {
+            if n >= 6 {
+                graph.retire(ord(n - 4));
+                graph.retire(ord(n - 4)); // repeated completion changes no counts
+            }
+            let before = graph.census().domain_only_comparisons;
+            let actual = graph.admit(ord(n), &[intent(AccessKey::DomainOnly, AccessMode::Write)]);
+            let expected: Vec<_> = std::iter::once(ord(1))
+                .chain((2.max(n.saturating_sub(3))..n).map(ord))
+                .collect();
+            assert_eq!(
+                actual, expected,
+                "retired history cannot remove the old live hazard"
+            );
+            assert!(graph.entries.len() <= 260, "history grew at admission {n}");
+            assert!(
+                graph.census().domain_only_comparisons - before <= 520,
+                "completed work was rescanned without bound at admission {n}"
+            );
+            assert_eq!(graph.live_accesses(), (n as usize).min(5));
+        }
+        let census = graph.census();
+        graph.compact();
+        assert_eq!(graph.census(), census);
+        assert_eq!(graph.entries.len(), graph.live_accesses());
+    }
