+
+/// Read and update nonuniform packed ten-bit texels through the shipped
+/// compute entry. Small code differences cannot survive an RGBA8 round trip.
+#[test]
+fn rgb10a2_storage_read_write_preserves_codes_and_resident_generation() {
+    let _g = engine_test_session();
+    let asm = storage_image_write_red_kernel("Rgb10A2")
+        .replace("OpCapability StorageImageWriteWithoutFormat",
+            "OpCapability StorageImageExtendedFormats")
+        .replace("               OpDecorate %img NonReadable\n", "")
+        .replace("%img_ty = OpTypeImage", "    %step = OpConstant %float 0.0019550342\n    %delta = OpConstantComposite %v4float %step %float_0 %float_0 %float_0\n%img_ty = OpTypeImage")
+        .replace("               OpImageWrite %img_l %coord %red",
+            "    %value = OpImageRead %v4float %img_l %coord\n    %added = OpFAdd %v4float %value %delta\n               OpImageWrite %img_l %coord %added");
+    let Some(words) = assemble_spvasm(&asm, "rgb10a2_native") else {
+        return;
+    };
+    let (w, h) = (147u32, 317u32);
+    let packed: Vec<u32> = (0..w * h)
+        .map(|i| {
+            (7 + (i % 200) * 2)
+                | ((511 + i % 251) << 10)
+                | ((999 - (i % 200) * 3) << 20)
+                | ((i % 4) << 30)
+        })
+        .collect();
+    let seed: Vec<u8> = packed.iter().flat_map(|word| word.to_le_bytes()).collect();
+    let identity = ComputeStorageResidencyKey {
+        mapping_id: 113,
+        map_generation: 3,
+        surface_offset: 0,
+        surface_bpr: w * 4,
+        span_end: seed.len() as u64,
+        width: w,
+        height: h,
+        pixel_format: 0x5a,
+        texture_ref: 0,
+    };
+    let mut req = ComputeRequest {
+        spirv: words,
+        entry: "main".into(),
+        dispatch: engine::ComputeDispatch::Workgroups([w, h, 1]),
+        storage_images: vec![ComputeStorageImageResource {
+            destination: Default::default(),
+            binding: 0,
+            array_element: 0,
+            descriptor_count: 1,
+            format: StorageImageFormat::Rgb10a2Unorm,
+            width: w,
+            height: h,
+            bytes: seed,
+            residency: Some(ComputeStorageResidency {
+                identity,
+                seed_generation: 1,
+                output_generation: 2,
+            }),
+            seed_skipped: false,
+        }],
+        ..Default::default()
+    };
+    let first = match engine::execute_compute_request(engine_device(), &req) {
+        Ok(out) => out,
+        Err(error)
+            if skip_if_no_gpu(&error.to_string())
+                || error
+                    .to_string()
+                    .contains("storage_image_format_unsupported") =>
+        {
+            eprintln!("SKIP rgb10a2 optional host storage: {error}");
+            return;
+        }
+        Err(error) => panic!("RGB10A2 native compute: {error}"),
+    };
+    let assert_words = |bytes: &[u8], increment: u32| {
+        assert_eq!(bytes.len(), packed.len() * 4);
+        for (index, raw) in bytes.chunks_exact(4).enumerate() {
+            assert_eq!(
+                u32::from_le_bytes(raw.try_into().unwrap()),
+                packed[index] + increment,
+                "native packed texel {index}, red increment {increment}"
+            );
+        }
+    };
+    assert_words(
+        first.images[0]
+            .bytes()
+            .expect("native packed Host readback"),
+        2,
+    );
+    engine::reset_draw_counters();
+    req.storage_images[0].bytes.fill(0);
+    req.storage_images[0].seed_skipped = true;
+    req.storage_images[0].residency = Some(ComputeStorageResidency {
+        identity,
+        seed_generation: 2,
+        output_generation: 3,
+    });
+    let warm = engine::execute_compute_request(engine_device(), &req).expect("packed resident hit");
+    assert_words(
+        warm.images[0]
+            .bytes()
+            .expect("retained native packed readback"),
+        4,
+    );
+    assert_eq!(
+        engine::counter_snapshot().compute_storage_seed_uploads,
+        0,
+        "the zero placeholder must not overwrite the resident"
+    );
 }
 
