 #[test]
+fn rgb10a2_color_clear_native_load_draw_and_resident_load_preserve_packed_words() {
+    use reims_vgpu_core::blend::ColorWriteMask;
+    use reims_vgpu_protocol::pixel_format::{self as p, ColorLoadSeed, TexelLayout};
+    let _g = engine_test_session();
+    let (v, f) = triangle_spirv();
+    let identity = TargetIdentity::Gva {
+        gva: 0x268000,
+        width: 4,
+        height: 2,
+        generation: 1,
+        format: ash::vk::Format::A2B10G10R10_UNORM_PACK32,
+    };
+    let mut req = engine_req(&v, &f, 4, 2);
+    let clear = [1.0 / 1023.0, 513.0 / 1023.0, 1022.0 / 1023.0, 2.0 / 3.0];
+    req.target_identity = Some(identity.clone());
+    req.color_attachment = Some(color_attachment(p::MTL_FORMAT_RGB10A2_UNORM, clear));
+    req.skip_readback = true;
+    req.color_write_mask = ColorWriteMask::NONE;
+    engine::execute_draw_request(engine_device(), &req).expect("RGB10A2 native GPU clear");
+    let cleared = engine::read_target(&identity).unwrap();
+    assert_eq!(
+        cleared.texel,
+        engine::ReadbackTexel::Native(TexelLayout::Rgb10a2Unorm)
+    );
+    let cpu_clear = p::solid_clear_image(p::MTL_FORMAT_RGB10A2_UNORM, 4, 2, &clear).unwrap();
+    assert_eq!(
+        cleared.pixels,
+        cpu_clear.pixels(),
+        "CPU and GPU clear use the same channel order and width"
+    );
+
+    // Distinct low bits and alpha codes cannot survive an RGBA8 round trip.
+    let words = [
+        0x00100403u32,
+        0x7fe00401,
+        0x803ffffd,
+        0xffd553fe,
+        0xc0200401,
+        0x405557fd,
+        0xbfe00803,
+        0x002ffbfd,
+    ];
+    let raw: Vec<u8> = words.iter().flat_map(|word| word.to_le_bytes()).collect();
+    req.target_cpu_seed = Some(ColorLoadSeed {
+        pixels: std::sync::Arc::new(raw.clone()),
+        layout: TexelLayout::Rgb10a2Unorm,
+    });
+    engine::execute_draw_request(engine_device(), &req).expect("RGB10A2 native CPU Load");
+    assert_eq!(engine::read_target(&identity).unwrap().pixels, raw);
+    req.target_cpu_seed = None;
+    req.load_from_target = true;
+    engine::execute_draw_request(engine_device(), &req).expect("RGB10A2 resident Load");
+    assert_eq!(engine::read_target(&identity).unwrap().pixels, raw);
+
+    req.color_write_mask = ColorWriteMask::ALL;
+    req.scissors = vec![ScissorResource {
+        x: 0,
+        y: 0,
+        width: 2,
+        height: 2,
+    }];
+    engine::execute_draw_request(engine_device(), &req).expect("RGB10A2 fragment write");
+    let drawn = engine::read_target(&identity).unwrap();
+    for (index, bytes) in drawn.pixels.chunks_exact(4).enumerate() {
+        let word = u32::from_le_bytes(bytes.try_into().unwrap());
+        if index % 4 < 2 {
+            // Vulkan permits either neighboring UNORM code. Channel order,
+            // alpha and untouched texels remain exact requirements.
+            for (shift, expected) in [(0, 256u32), (10, 512), (20, 767)] {
+                assert!(((word >> shift) & 1023).abs_diff(expected) <= 1);
+            }
+            assert_eq!(word >> 30, 3);
+        } else {
+            assert_eq!(word, words[index], "scissor must preserve every stored bit");
+        }
+    }
+}
