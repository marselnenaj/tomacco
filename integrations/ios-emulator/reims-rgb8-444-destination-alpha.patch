+/// `_RB4` stores no alpha, and Metal reads one for a format without alpha:
+/// a destination-alpha blend factor is one. The RGBA8 resident is cleared to
+/// one at alpha and no draw writes it, so a `destinationAlpha` source factor
+/// scales the second of two coincident triangles by one rather than by the
+/// clear's alpha or by the alpha the first triangle wrote. As a secondary it
+/// is the same attachment.
+#[test]
+fn an_rgb8_444_blend_reads_destination_alpha_as_one() {
+    use reims_vgpu_core::blend::MTL_BLEND_FACTOR_DESTINATION_ALPHA;
+    use reims_vgpu_protocol::pixel_format::{
+        PlanarRgb8Format, TexelLayout, MTL_FORMAT_RGB8_444_2P,
+    };
+    let _g = engine_test_session();
+    let v = framebuffer_fetch_glsl("vertex", FETCH_VERTEX);
+    let f = framebuffer_fetch_glsl(
+        "fragment",
+        "#version 450
+layout(location=0) out vec4 primary;
+layout(location=1) out vec4 secondary;
+void main() { primary=vec4(1.0,0.5,0.0,0.25); secondary=primary; }
+",
+    );
+    // RGB = source * destination alpha; alpha = source alpha. With the clear's
+    // 0.5 and the shader's 0.25 reaching the resident, the second triangle
+    // would store (64, 32, 0); with Metal's constant one it stores (255, 128, 0).
+    let by_destination_alpha = BlendStateResource {
+        src_rgb: MTL_BLEND_FACTOR_DESTINATION_ALPHA,
+        dst_rgb: MTL_BLEND_FACTOR_ZERO,
+        op_rgb: MTL_BLEND_OPERATION_ADD,
+        src_alpha: MTL_BLEND_FACTOR_ONE,
+        dst_alpha: MTL_BLEND_FACTOR_ZERO,
+        op_alpha: MTL_BLEND_OPERATION_ADD,
+    };
+    let format = PlanarRgb8Format::from_mtl(MTL_FORMAT_RGB8_444_2P).unwrap();
+    for slot in 0..2u64 {
+        let identity = TargetIdentity::Surface {
+            id: 0x5420 + slot as u32,
+            width: 8,
+            height: 8,
+            generation: 1,
+            format: ash::vk::Format::R8G8B8A8_UNORM,
+        };
+        let attachment = color_attachment(MTL_FORMAT_RGB8_444_2P, [0.2, 0.4, 0.6, 0.5]);
+        let mut req = engine_req(&v, &f, 8, 8);
+        req.vertex_count = 6;
+        if slot == 0 {
+            req.target_identity = Some(identity.clone());
+            req.color_attachment = Some(attachment);
+            req.blend = Some(by_destination_alpha);
+            req.color_write_mask = engine::ColorWriteMask::ALL;
+            req.skip_readback = true;
+        } else {
+            req.secondary_targets.push(SecondaryColorTarget {
+                identity: identity.clone(),
+                width: 8,
+                height: 8,
+                attachment,
+                load: false,
+                seed: None,
+                blend: Some(by_destination_alpha),
+                color_write_mask: engine::ColorWriteMask::ALL,
+            });
+        }
+        engine::execute_draw_request(engine_device(), &req).expect("_RB4 blend");
+        let readback = engine::read_target_texels(&identity).unwrap();
+        let layout = readback.texel.storage_layout();
+        assert!(
+            matches!(layout, TexelLayout::Rgba8 | TexelLayout::Bgra8),
+            "slot {slot}: {layout:?}"
+        );
+        let (mut green, mut blue_red) = (vec![0; 64], vec![0; 128]);
+        assert!(format.split_texels(layout, &readback.pixels, &mut green, &mut blue_red));
+        assert_eq!(green, vec![128; 64], "slot {slot}");
+        assert_eq!(blue_red, [0, 255].repeat(64), "slot {slot}");
+        // The resident's own alpha (byte 3 in either order) stayed one through
+        // the clear and both triangles: what a framebuffer fetch of this
+        // target reads.
+        assert!(
+            readback
+                .pixels
+                .as_chunks::<4>()
+                .0
+                .iter()
+                .all(|texel| texel[3] == 255),
+            "slot {slot}: resident alpha left one"
+        );
+    }
+}
