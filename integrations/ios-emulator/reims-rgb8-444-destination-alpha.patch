+/// Whether a colour-renderable Metal format stores no alpha while the resident
+/// [`color_attachment`] renders it into does. Metal reads such a format's
+/// alpha as one: as a destination blend factor, as a framebuffer fetch and as
+/// a sample. The resident must therefore hold one there whatever the fragment
+/// shader writes, which its owner enforces through the clear and the write
+/// mask. Formats whose Vulkan format has no alpha either need nothing here.
+pub fn resident_alpha_unstored(mtl: u16) -> bool {
+    pixel_format::PlanarRgb8Format::from_mtl(mtl).is_some()
+}
