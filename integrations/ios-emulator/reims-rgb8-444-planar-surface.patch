+/// The device descriptor of a linear `_RB4` surface, for owner tests that need
+/// a native eight-bit two-window mapping. `planes` is each window's offset and
+/// row pitch, in that order.
+#[cfg(test)]
+pub(crate) fn rgb8_444_device_desc(
+    width: u32,
+    height: u32,
+    planes: [(u32, u32); 2],
+    allocation: u32,
+) -> Vec<u8> {
+    use crate::protocol::endian::{st16, st32, st64};
+    use crate::protocol::iosurface_pages::{
+        DEVICE_DESC_ALLOC_SIZE, DEVICE_DESC_BPE, DEVICE_DESC_BPR, DEVICE_DESC_DIMS,
+        DEVICE_DESC_LEN, DEVICE_DESC_PIXEL_FORMAT, DEVICE_DESC_PLANES, DEVICE_DESC_PLANE_COUNT,
+        DEVICE_PLANE_BASE, DEVICE_PLANE_BPE, DEVICE_PLANE_BPR, DEVICE_PLANE_DESC_LEN,
+        DEVICE_PLANE_DIMS, DEVICE_PLANE_OFFSET, DEVICE_PLANE_SIZE,
+    };
+    // One-texel elements in both directions, then the two extents.
+    let dims = |w: u32, h: u32| 1 | (u64::from(w) << 8) | (1 << 32) | (u64::from(h) << 40);
+    let mut desc = vec![0; DEVICE_DESC_LEN];
+    st32(
+        &mut desc[DEVICE_DESC_PIXEL_FORMAT..],
+        crate::protocol::pixel_format::IOSURFACE_FORMAT_RGB8_444_2P,
+    );
+    st32(&mut desc[DEVICE_DESC_ALLOC_SIZE..], allocation);
+    st64(&mut desc[DEVICE_DESC_DIMS..], dims(width, height));
+    st32(&mut desc[DEVICE_DESC_BPR..], planes[0].1);
+    st16(&mut desc[DEVICE_DESC_BPE..], 1);
+    desc[DEVICE_DESC_PLANE_COUNT] = 2;
+    for (index, ((offset, stride), bpe)) in planes.into_iter().zip([1u16, 2]).enumerate() {
+        let plane = &mut desc[DEVICE_DESC_PLANES + index * DEVICE_PLANE_DESC_LEN..];
+        st32(&mut plane[DEVICE_PLANE_OFFSET..], offset);
+        st32(&mut plane[DEVICE_PLANE_BASE..], offset);
+        st32(&mut plane[DEVICE_PLANE_SIZE..], stride * height);
+        st64(&mut plane[DEVICE_PLANE_DIMS..], dims(width, height));
+        st32(&mut plane[DEVICE_PLANE_BPR..], stride);
+        st16(&mut plane[DEVICE_PLANE_BPE..], bpe);
+    }
+    desc
+}
