+/// Both `_RB4` windows of one validated read, joined into tight semantic RGBA8
+/// with the alpha the storage does not have reading one. The one reader every
+/// eight-bit two-window consumer shares: a render Load and a sampled bind see
+/// the same texels.
+pub(crate) fn join_native_rgb8_surface<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    mapping_id: u32,
+    width: u32,
+    height: u32,
+) -> Result<Vec<u8>, mapping_write::PlanarXrMappingRefusal> {
+    use mapping_write::PlanarXrMappingRefusal as R;
+    let read = mapping_write::read_planar_surface::<_, pixel_format::PlanarRgb8Format>(
+        state, host, mapping_id, width, height,
+    )?;
+    let len = read.planes[0].len().checked_mul(4).ok_or(R::Allocation)?;
+    let mut pixels = Vec::new();
+    pixels.try_reserve_exact(len).map_err(|_| R::Allocation)?;
+    pixels.resize(len, 0);
+    if !read
+        .layout
+        .format
+        .join_rgba8(&read.planes[0], &read.planes[1], &mut pixels)
+    {
+        return Err(R::PlaneShape { index: 1 });
+    }
+    Ok(pixels)
+}
