+/// Clear both `_RB4` windows to the clear's eight-bit codes. The clear's
+/// alpha has no storage and is dropped, as Metal drops it.
+fn clear_native_rgb8_surface<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    target: &ColorRtRequest,
+    color: [f64; 4],
+) -> bool {
+    use crate::runtime::mapping_write::PlanarXrMappingRefusal as R;
+    let result = (|| {
+        let mapping = state
+            .mappings
+            .get(&target.mapping_id)
+            .ok_or(R::MappingAbsent)?;
+        if target.target_gva != 0 || target.format != mapping.format {
+            return Err(R::StorageChanged);
+        }
+        let write_target = mapping_write::PlanarRgb8SurfaceWriteTarget::capture(
+            target.mapping_id,
+            mapping,
+            target.width,
+            target.height,
+        )?;
+        let planes = write_target
+            .layout()
+            .format
+            .clear_planes(target.width, target.height, &color)
+            .ok_or(R::Allocation)?;
+        mapping_write::write_planar_surface(state, host, write_target, &planes)
+    })();
+    match result {
+        Ok(_) => {
+            crate::runtime::drain::note_store_route("native_rgb8_render_clear_n");
+            true
+        }
+        Err(why) => {
+            crate::observe::Emit::decline("native_rgb8_render_clear", &why)
+                .field("mapping", target.mapping_id)
+                .fail();
+            false
+        }
+    }
+}
