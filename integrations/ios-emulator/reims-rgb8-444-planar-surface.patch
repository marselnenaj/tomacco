+        let mut planes: [Vec<u8>; 2] = [Vec::new(), Vec::new()];
+        for (plane, bytes) in planes.iter_mut().zip([Some(texels), texels.checked_mul(2)]) {
+            let bytes = bytes.ok_or(R::SourceShape)?;
+            plane.try_reserve_exact(bytes).map_err(|_| R::Allocation)?;
+            plane.resize(bytes, 0);
+        }
+        let [green, blue_red] = &mut planes;
+        if !format.split_texels(
+            readback.texel.storage_layout(),
+            readback.bytes(),
+            green,
+            blue_red,
