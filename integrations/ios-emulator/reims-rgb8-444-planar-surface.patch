+    use crate::backend::vulkan::engine::TargetIdentity;
+    use NativeRgb8StoreRefusal as R;
+    let mapping = state.mappings.get(&mapping_id).ok_or(R::Mapping(
+        crate::runtime::mapping_write::PlanarXrMappingRefusal::MappingAbsent,
+    ))?;
+    if !matches!(identity,TargetIdentity::Surface {id,width:w,height:h,generation,format}
+        if *id==mapping_id && *w==width && *h==height
+            && *generation==u64::from(mapping.map_generation)
+            && *format==ash::vk::Format::R8G8B8A8_UNORM)
+    {
+        return Err(R::Identity);
+    }
+    let target = crate::runtime::mapping_write::PlanarRgb8SurfaceWriteTarget::capture(
