+/// Read an eight-bit resident and publish both native `_RB4` windows. Like
+/// the XR pair, this storage has no interleaved GPU import or Store rail: the
+/// resident must name this mapping incarnation, extent and RGBA8 allocation,
+/// and the split into green and blue/red happens once, here.
+fn store_native_rgb8_surface<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
