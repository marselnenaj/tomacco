+/// Private two-plane RGB without alpha (IOSurface `_RB4`): a full-resolution
+/// eight-bit plane and a full-resolution sixteen-bit plane.
+///
+/// Metal ordinal 542 has no public name; this one describes its storage. The
+/// channel contract comes from the guest's own GPU driver, not from a public
+/// table:
+///
+/// * every `_RB4` device descriptor names two equally sized planes with one-
+///   and two-byte elements;
+/// * the driver's texture-format record for 542 selects the read swizzle
+///   `[Blue, Red, Green, One]` (`MTLTextureSwizzle` ordinals `[4, 2, 3, 1]`,
+///   against `[2, 3, 4, 5]` for RGBA8 and `[4, 3, 2, 5]` for BGRA8). That is the
+///   `BRG1` swizzle the hardware's subsampled `GBGR`/`BGRG` layouts are read
+///   with, whose raw channels are green, blue, red in storage order;
+/// * its colour-space-conversion query answers "none" before looking at the
+///   surface, so the codes are RGB, not luma and chroma.
+///
+/// Raw channel 0 is the first plane's byte and raw channels 1 and 2 are the
+/// second plane's bytes in address order, so a texel reads
+/// `(plane1[1], plane0[0], plane1[0], 1)` — Vulkan's
+/// `G8_B8R8_2PLANE_444_UNORM` without a YCbCr conversion. Alpha is not stored.
+pub const MTL_FORMAT_RGB8_444_2P: u16 = 542;
+pub const IOSURFACE_FORMAT_RGB8_444_2P: u32 = u32::from_be_bytes(*b"_RB4");
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum PlanarRgb8Format {
+    Rgb8,
+}
+
+impl PlanarRgb8Format {
+    pub const fn from_mtl(format: u16) -> Option<Self> {
+        match format {
+            MTL_FORMAT_RGB8_444_2P => Some(Self::Rgb8),
+            _ => None,
+        }
+    }
+
+    pub const fn mtl(self) -> u16 {
+        MTL_FORMAT_RGB8_444_2P
+    }
+
+    pub const fn name(self) -> &'static str {
+        "RGB8_444_2P"
+    }
+
+    /// Green, then blue and red.
+    pub const fn surface_plane_bytes_per_element(self) -> [u8; 2] {
+        [1, 2]
+    }
+
+    /// One texel's semantic RGBA8. The format stores no alpha; it reads one.
+    pub const fn rgba8(self, green: u8, blue_red: [u8; 2]) -> [u8; 4] {
+        [blue_red[1], green, blue_red[0], u8::MAX]
+    }
+
+    /// One semantic RGBA8 texel's plane elements. Alpha has no storage.
+    pub const fn plane_elements(self, rgba: [u8; 4]) -> (u8, [u8; 2]) {
+        (rgba[COMPONENT_G], [rgba[COMPONENT_B], rgba[COMPONENT_R]])
+    }
+
+    /// Both tight planes of a solid clear, quantized exactly as an RGBA8 clear
+    /// is. The clear's alpha has no storage.
+    pub fn clear_planes(self, width: u32, height: u32, clear: &[f64; 4]) -> Option<[Vec<u8>; 2]> {
+        let texels = (width as usize).checked_mul(height as usize)?;
+        let (green, blue_red) = self.plane_elements(unorm8_rgba(clear));
+        Some([
+            solid_bytes(texels, &[green])?,
+            solid_bytes(texels.checked_mul(2)?, &blue_red)?,
+        ])
+    }
+
+    /// Expand tight plane rows into tight semantic RGBA8. Every length is
+    /// checked against the first plane's texel count before any byte is written.
+    pub fn join_rgba8(self, green: &[u8], blue_red: &[u8], rgba: &mut [u8]) -> bool {
+        let texels = green.len();
+        if texels.checked_mul(2) != Some(blue_red.len())
+            || texels.checked_mul(4) != Some(rgba.len())
+        {
+            return false;
+        }
+        for ((out, &g), br) in rgba
+            .as_chunks_mut::<4>()
+            .0
+            .iter_mut()
+            .zip(green)
+            .zip(blue_red.as_chunks::<2>().0)
+        {
+            *out = self.rgba8(g, *br);
+        }
+        true
+    }
+
+    /// Split tight eight-bit colour texels into tight plane rows. Only the two
+    /// eight-bit colour orders are sources; any other layout is refused.
+    pub fn split_texels(
+        self,
+        layout: TexelLayout,
+        texels: &[u8],
+        green: &mut [u8],
+        blue_red: &mut [u8],
+    ) -> bool {
+        let count = green.len();
+        if !matches!(layout, TexelLayout::Rgba8 | TexelLayout::Bgra8)
+            || count.checked_mul(2) != Some(blue_red.len())
+            || count.checked_mul(4) != Some(texels.len())
+        {
+            return false;
+        }
+        for ((texel, g), br) in texels
+            .as_chunks::<4>()
+            .0
+            .iter()
+            .zip(green.iter_mut())
+            .zip(blue_red.as_chunks_mut::<2>().0)
+        {
+            let rgba = match layout {
+                TexelLayout::Bgra8 => [texel[2], texel[1], texel[0], texel[3]],
+                _ => *texel,
+            };
+            (*g, *br) = self.plane_elements(rgba);
+        }
+        true
+    }
+}
+
+/// A native two-window IOSurface storage format. One mapping owns both planes,
+/// each with the window its device descriptor names; no transfer may infer an
+/// interleaved row from the pair.
+pub trait PlanarSurfaceStorage: Copy + Eq + core::fmt::Debug {
+    fn from_mtl(format: u16) -> Option<Self>;
+    fn mtl(self) -> u16;
+    /// The IOSurface pixel format every mapping of this storage declares.
+    fn iosurface_format(self) -> u32;
+    fn surface_plane_bytes_per_element(self) -> [u8; 2];
+}
+
+impl PlanarSurfaceStorage for PlanarXrFormat {
+    fn from_mtl(format: u16) -> Option<Self> {
+        Self::from_mtl(format)
+    }
+    fn mtl(self) -> u16 {
+        self.mtl()
+    }
+    fn iosurface_format(self) -> u32 {
+        IOSURFACE_FORMAT_BGR10_ALPHA8
+    }
+    fn surface_plane_bytes_per_element(self) -> [u8; 2] {
+        self.surface_plane_bytes_per_element()
+    }
+}
+
+impl PlanarSurfaceStorage for PlanarRgb8Format {
+    fn from_mtl(format: u16) -> Option<Self> {
+        Self::from_mtl(format)
+    }
+    fn mtl(self) -> u16 {
+        self.mtl()
+    }
+    fn iosurface_format(self) -> u32 {
+        IOSURFACE_FORMAT_RGB8_444_2P
+    }
+    fn surface_plane_bytes_per_element(self) -> [u8; 2] {
+        self.surface_plane_bytes_per_element()
+    }
+}
+
+/// Every native two-window surface a mapping may declare. Callers that only
+/// ask "is this storage two windows" ask here; callers that convert texels
+/// dispatch on the member.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum PlanarSurfaceFormat {
+    Xr(PlanarXrFormat),
+    Rgb8(PlanarRgb8Format),
+}
+
+impl PlanarSurfaceFormat {
+    pub const fn from_mtl(format: u16) -> Option<Self> {
+        match PlanarXrFormat::from_mtl(format) {
+            Some(xr) => Some(Self::Xr(xr)),
+            None => match PlanarRgb8Format::from_mtl(format) {
+                Some(rgb8) => Some(Self::Rgb8(rgb8)),
+                None => None,
+            },
+        }
+    }
+
+    /// The texel a render or sample resident of this storage holds: XR's
+    /// canonical Float32, or semantic RGBA8 for eight-bit codes.
+    pub const fn resident_layout(self) -> TexelLayout {
+        match self {
+            Self::Xr(_) => TexelLayout::Rgba32Float,
+            Self::Rgb8(_) => TexelLayout::Rgba8,
+        }
+    }
+}
+
 /// Extended-range texels have no bit-compatible Vulkan normalized format.
