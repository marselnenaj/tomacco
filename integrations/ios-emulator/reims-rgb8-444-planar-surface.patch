+    /// The `_RB4` descriptor every 542 surface of the qualification boot
+    /// declared: 320x320, a one-byte plane at 0 and a two-byte plane right
+    /// behind it, both with tight rows.
+    fn rgb8_444_desc() -> Vec<u8> {
+        use crate::endian::{st16, st32, st64};
+        let dims = |width: u64, height: u64| 1 | (width << 8) | (1 << 32) | (height << 40);
+        let mut desc = vec![0; DEVICE_DESC_LEN];
+        st32(
+            &mut desc[DEVICE_DESC_PIXEL_FORMAT..],
+            crate::pixel_format::IOSURFACE_FORMAT_RGB8_444_2P,
+        );
+        st32(&mut desc[DEVICE_DESC_ALLOC_SIZE..], 307_200);
+        st64(&mut desc[DEVICE_DESC_DIMS..], dims(320, 320));
+        st32(&mut desc[DEVICE_DESC_BPR..], 320);
+        st16(&mut desc[DEVICE_DESC_BPE..], 1);
+        desc[DEVICE_DESC_PLANE_COUNT] = 2;
+        for (index, (offset, size, stride, bpe)) in
+            [(0u32, 102_400u32, 320u32, 1u16), (102_400, 204_800, 640, 2)]
+                .into_iter()
+                .enumerate()
+        {
+            let plane = &mut desc[DEVICE_DESC_PLANES + index * DEVICE_PLANE_DESC_LEN..];
+            st32(&mut plane[DEVICE_PLANE_OFFSET..], offset);
+            st32(&mut plane[DEVICE_PLANE_BASE..], offset);
+            st32(&mut plane[DEVICE_PLANE_SIZE..], size);
+            st64(&mut plane[DEVICE_PLANE_DIMS..], dims(320, 320));
+            st32(&mut plane[DEVICE_PLANE_BPR..], stride);
+            st16(&mut plane[DEVICE_PLANE_BPE..], bpe);
+        }
+        desc
+    }
