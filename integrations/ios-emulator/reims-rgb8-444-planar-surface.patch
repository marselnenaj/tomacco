+        );
+        assert_eq!(
+            PlanarSurfaceFormat::from_mtl(MTL_FORMAT_RGB10A8_2P_XR10),
+            Some(PlanarSurfaceFormat::Xr(PlanarXrFormat::Rgb10Alpha8))
+        );
+        assert_eq!(PlanarSurfaceFormat::from_mtl(MTL_FORMAT_BGRA8_UNORM), None);
+        // Not a colour target this device serves as one window, and no
