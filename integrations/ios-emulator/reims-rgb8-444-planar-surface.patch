+    /// 542's swizzle contract, texel by texel: red from the second plane's
+    /// high byte, green from the first plane, blue from the second plane's low
+    /// byte, and an alpha the storage does not have reads one.
+    #[test]
+    fn rgb8_444_texels_follow_the_drivers_brg1_read_swizzle() {
+        let format = PlanarRgb8Format::from_mtl(MTL_FORMAT_RGB8_444_2P).unwrap();
+        assert_eq!(format.rgba8(0x22, [0x33, 0x11]), [0x11, 0x22, 0x33, 0xff]);
+        assert_eq!(
