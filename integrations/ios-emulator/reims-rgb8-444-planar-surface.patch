+/// An `_RB4` surface is written and read as one transaction over its two own
+/// windows: each plane lands at its own offset and pitch, the guest's row
+/// padding is never staged or overwritten, and the read returns exactly the
+/// tight rows that were written.
+#[test]
+fn an_rgb8_444_surface_round_trips_both_windows_and_keeps_the_padding() {
+    use crate::model::PAGE_SHIFT_X86;
+    use crate::protocol::pixel_format::MTL_FORMAT_RGB8_444_2P;
+    const PAGE: usize = 1 << PAGE_SHIFT_X86;
+    const W: u32 = 4;
+    const H: u32 = 3;
+    // Green rows of 4 bytes at a pitch of 16; blue/red rows of 8 at 32.
+    const PLANES: [(u32, u32); 2] = [(0, 16), (64, 32)];
+    let mut state = DeviceState::new(DeviceId(2), PAGE_SHIFT_X86);
+    let mut host = FakeHost::new();
+    let base_pfn = 0x40u32;
+    let base = u64::from(base_pfn) << PAGE_SHIFT_X86;
+    host.map_range(base, PAGE, 0xee);
+    state.map_surface(4);
+    state.attach_mapping_internal(
+        4,
+        0,
+        crate::protocol::iosurface_pages::MapperLayout::Compact,
+    );
+    let m = state.mappings.get_mut(&4).unwrap();
+    m.mapping_internal = 1;
+    m.page_entries = vec![(base_pfn << PAGE_ENTRY_PFN_SHIFT) | PAGE_ENTRY_VALID];
+    assert!(state.set_mapping_device_desc(4, &rgb8_444_device_desc(W, H, PLANES, 160)));
+    assert!(state.set_mapping_geom(4, W, H, MTL_FORMAT_RGB8_444_2P));
+
+    let planes = [
+        (0..12).collect::<Vec<u8>>(),
+        (100..124).collect::<Vec<u8>>(),
+    ];
+    let target =
+        PlanarRgb8SurfaceWriteTarget::capture(4, state.mappings.get(&4).unwrap(), W, H).unwrap();
+    assert_eq!(
+        write_planar_surface(&mut state, &mut host, target, &planes).unwrap(),
+        36
+    );
+
+    let mut guest = vec![0; 160];
+    host.read_gpa(base, &mut guest).unwrap();
+    for (index, ((offset, pitch), tight)) in PLANES.into_iter().zip([4usize, 8]).enumerate() {
+        for y in 0..H as usize {
+            let row = offset as usize + y * pitch as usize;
+            assert_eq!(
+                guest[row..row + tight],
+                planes[index][y * tight..(y + 1) * tight],
+                "plane {index} row {y}"
+            );
+            if y + 1 < H as usize {
+                assert!(
+                    guest[row + tight..row + pitch as usize]
+                        .iter()
+                        .all(|&b| b == 0xee),
+                    "plane {index} row {y}'s padding must stay the guest's"
+                );
+            }
+        }
+    }
+    assert!(
+        guest[16 * 2 + 4..64].iter().all(|&b| b == 0xee),
+        "the gap between the windows"
+    );
+
+    let read: PlanarRgb8SurfaceRead = read_planar_surface(&mut state, &mut host, 4, W, H).unwrap();
+    assert_eq!(read.planes, planes);
+    assert_eq!(read.layout.planes[1].offset, 64);
+}
