+    #[test]
+    fn rgb8_444_planes_round_trip_through_either_eight_bit_order() {
+        let format = PlanarRgb8Format::Rgb8;
+        let rgba = [1, 2, 3, 4, 5, 6, 7, 8];
+        let bgra = [3, 2, 1, 4, 7, 6, 5, 8];
+        for (layout, texels) in [(TexelLayout::Rgba8, rgba), (TexelLayout::Bgra8, bgra)] {
+            let (mut green, mut blue_red) = ([0; 2], [0; 4]);
+            assert!(format.split_texels(layout, &texels, &mut green, &mut blue_red));
+            assert_eq!((green, blue_red), ([2, 6], [3, 1, 7, 5]), "{layout:?}");
+            let mut joined = [0; 8];
+            assert!(format.join_rgba8(&green, &blue_red, &mut joined));
+            assert_eq!(joined, [1, 2, 3, 0xff, 5, 6, 7, 0xff], "{layout:?}");
+        }
+        // Lengths are checked before any byte moves, and only eight-bit
+        // colour orders are sources.
+        let (mut green, mut blue_red) = ([9; 2], [9; 3]);
+        assert!(!format.split_texels(TexelLayout::Rgba8, &rgba, &mut green, &mut blue_red));
+        assert_eq!((green, blue_red), ([9; 2], [9; 3]));
