+/// Whether every byte of a sampled serve is zero, for the census above.
+///
+/// A byte-at-a-time `any` stopped at the first non-zero byte, so content paid
+/// little and a blank or mostly transparent span paid its whole length: it
+/// spent ~6.4 ms per blank serve of a 1216x2688 RGBA16F
+/// layer, up to ~670 ms of a drain second in `sampled_phase` resolve with the
+/// memo's own read and compare at ~45 ms. Two things now keep the census off
+/// the frame's time. A serve the memo names by its content generation (device
+/// wide, so one generation is one set of bytes) reuses the verdict its first
+/// serve computed; and the scan ORs 4 KiB blocks without stopping inside one,
+/// which the compiler turns into wide loads instead of one compare per byte.
+fn rung_bytes_blank(rgba: &[u8], content_generation: Option<u64>) -> bool {
+    use std::collections::HashMap;
+    use std::sync::Mutex;
+    /// Verdicts held at once; the memo serves a few dozen spans.
+    const VERDICTS: usize = 1024;
+    static KNOWN: Mutex<Option<HashMap<u64, bool>>> = Mutex::new(None);
+    let scan = || {
+        rgba.chunks(4096)
+            .all(|block| block.iter().fold(0u8, |acc, &b| acc | b) == 0)
+    };
+    let Some(generation) = content_generation else {
+        return scan();
+    };
+    if let Some(blank) = KNOWN
+        .lock()
+        .ok()
+        .and_then(|known| known.as_ref().and_then(|map| map.get(&generation).copied()))
+    {
+        crate::runtime::drain::note_store_route("lin_rung_blank_verdict_reused");
+        return blank;
+    }
+    let blank = scan();
+    if let Ok(mut known) = KNOWN.lock() {
+        let map = known.get_or_insert_with(HashMap::new);
+        if map.len() >= VERDICTS {
+            map.clear();
+        }
+        map.insert(generation, blank);
+    }
+    blank
+}
