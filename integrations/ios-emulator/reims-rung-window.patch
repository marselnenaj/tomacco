+// One immediate line per exact identity, followed by exact repetition counts
+// on the existing census cadence. Typed rung equality keeps different lengths
+// and wrong-type tags distinct without allocating strings on the repeat path.
+const RUNG_WINDOW_CAPACITY: usize = 128;
+static RUNG_WINDOW: std::sync::Mutex<Vec<PendingRung>> = std::sync::Mutex::new(Vec::new());
+
+#[derive(Clone, Copy, Eq, PartialEq)]
+struct RungKey {
+    report: RungReport,
+    task_id: u32,
+    ref_: u32,
+    rung: crate::runtime::objects::LadderRung,
+}
+
+struct PendingRung {
+    key: RungKey,
+    repeated: u64,
+    first_us: u64,
+    last_us: u64,
+}
+
+impl PendingRung {
+    fn emit_repeats(self) {
+        if self.repeated != 0 {
+            let key = self.key;
+            key.report.rung_line(
+                key.task_id,
+                key.ref_,
+                key.rung,
+                &format!(
+                    "summary=true repeated={} first_us={} last_us={}",
+                    self.repeated, self.first_us, self.last_us
+                ),
+            );
+        }
+    }
+}
+
+/// Finish the diagnostic window without holding its mutex during log IO.
+/// Task retirement also calls this before an id can describe a new namespace.
+pub(crate) fn flush_rung_window(task_id: Option<u32>) {
+    let entries = {
+        let Ok(mut pending) = RUNG_WINDOW.lock() else {
+            return;
+        };
+        let mut entries = Vec::new();
+        let mut index = 0;
+        while index < pending.len() {
+            if task_id.is_none_or(|id| pending[index].key.task_id == id) {
+                entries.push(pending.swap_remove(index));
+            } else {
+                index += 1;
+            }
+        }
+        entries
+    };
+    for entry in entries {
+        entry.emit_repeats();
     }
 }
 
