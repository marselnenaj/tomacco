+#[cfg(not(any(test, feature = "testing")))]
+fn product_log_path(kind: &str) -> String {
+    match reims_vgpu_config::log_directory() {
+        reims_vgpu_config::LogDirectory::Directory(directory) => directory
+            .join(format!("{kind}.log"))
+            .to_string_lossy()
+            .into_owned(),
+        reims_vgpu_config::LogDirectory::Refused(value) => {
+            // Resolving the sink cannot log through the unresolved sink. Keep
+            // the fallback usable and report this operator refusal directly.
+            eprintln!("vgpu_log_directory_refused reason=path_not_absolute value={value:?}");
+            format!("/tmp/reims-vgpu-{kind}.log")
+        }
+        reims_vgpu_config::LogDirectory::Unset => format!("/tmp/reims-vgpu-{kind}.log"),
+    }
+}
