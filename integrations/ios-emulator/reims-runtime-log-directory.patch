+/// Optional directory for this process's renderer logs. This affects only
+/// observation; it cannot select or widen an execution path.
+pub const LOG_DIRECTORY: &str = "REIMS_VGPU_LOG_DIRECTORY";
+
+#[derive(Debug)]
+pub enum LogDirectory {
+    Unset,
+    Directory(std::path::PathBuf),
+    Refused(std::ffi::OsString),
+}
+
+pub fn log_directory() -> LogDirectory {
+    match std::env::var_os(LOG_DIRECTORY) {
+        None => LogDirectory::Unset,
+        Some(value) if value.is_empty() => LogDirectory::Unset,
+        Some(value) => {
+            let path = std::path::PathBuf::from(&value);
+            if path.is_absolute() {
+                LogDirectory::Directory(path)
+            } else {
+                LogDirectory::Refused(value)
+            }
+        }
+    }
+}
+
