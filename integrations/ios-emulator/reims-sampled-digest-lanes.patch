+    /// Every byte reaches the digest, wherever it sits: in a 32-byte stripe,
+    /// in the eight-byte tail words, or in the last loose bytes.
+    #[test]
+    fn a_change_anywhere_moves_the_digest() {
+        let len = 4096 + 24 + 5;
+        let base: Vec<u8> = (0..len)
+            .map(|i| (i as u32).wrapping_mul(37) as u8)
+            .collect();
+        let digest = sampled_content_hash(&base);
+        for at in [0, 7, 8, 31, 32, 2048, 4095, 4096, 4103, 4119, 4120, len - 1] {
+            let mut changed = base.clone();
+            changed[at] ^= 0x01;
+            assert_ne!(digest, sampled_content_hash(&changed), "byte {at}");
+        }
+    }
+
+    /// Blobs of zeros that differ only in length differ in digest, and the
+    /// digest is a pure function of the bytes.
+    #[test]
+    fn length_counts_and_the_digest_is_stable() {
+        let digests: Vec<u128> = (0..70)
+            .map(|n| sampled_content_hash(&vec![0u8; n]))
+            .collect();
+        for (i, a) in digests.iter().enumerate() {
+            for b in &digests[i + 1..] {
+                assert_ne!(a, b);
+            }
+        }
+        let blob: Vec<u8> = (0..1000u32).map(|i| (i * 7) as u8).collect();
+        assert_eq!(
+            sampled_content_hash(&blob),
+            sampled_content_hash(&blob.clone())
+        );
+    }
