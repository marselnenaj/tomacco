+/// answers a lookup or a deduplication (`ResidentSampledSlot::content`). So
+/// the digest has to be cheap and well mixed, not collision-resistant against
+/// an adversary — a collision costs one extra compare that fails, never a
+/// wrong image.
+///
+/// # Why not `DefaultHasher`
+///
+/// It was two salted SipHash-1-3 passes, and a lookup hashes the incoming
+/// blob on every bind that misses the identity path. On a busy app second on
+/// the vphone that is ~420 buffer-texture binds of ~2 MB each, every one a
+/// content hit (`sampled_cache_hits`, `sampled_cache_hit_bytes` 843 MB), and
+/// `draw_phase acquire_sampled_us` read ~305 ms of that second: two
+/// cryptographic-strength passes over bytes whose identity a compare settles
+/// anyway. This is four independent lanes of XXH64's round over 32-byte
+/// stripes — a multiply and a rotate per eight bytes, no data-dependent
+/// branch — folded into two halves with different multipliers and each
+/// finished with XXH64's avalanche, the length mixed into both.
 fn sampled_content_hash(bytes: &[u8]) -> u128 {
-    let mut lo = std::collections::hash_map::DefaultHasher::new();
-    bytes.hash(&mut lo);
-    let mut hi = std::collections::hash_map::DefaultHasher::new();
-    // Distinct salt so the two digests are independent (else both hashers see
-    // the same input and finish() to correlated values, collapsing to 64 bits).
-    hi.write_u64(0x9e37_79b9_7f4a_7c15);
-    bytes.hash(&mut hi);
-    ((hi.finish() as u128) << 64) | lo.finish() as u128
+    const P1: u64 = 0x9E37_79B1_85EB_CA87;
+    const P2: u64 = 0xC2B2_AE3D_27D4_EB4F;
+    const P3: u64 = 0x1656_67B1_9E37_79F9;
+    const P4: u64 = 0x85EB_CA77_C2B2_AE63;
+    const P5: u64 = 0x27D4_EB2F_1656_67C5;
+    fn round(acc: u64, input: u64) -> u64 {
+        acc.wrapping_add(input.wrapping_mul(P2))
+            .rotate_left(31)
+            .wrapping_mul(P1)
+    }
+    fn avalanche(mut h: u64) -> u64 {
+        h ^= h >> 33;
+        h = h.wrapping_mul(P2);
+        h ^= h >> 29;
+        h = h.wrapping_mul(P3);
+        h ^ (h >> 32)
+    }
+    fn word(chunk: &[u8; 8]) -> u64 {
+        u64::from_le_bytes(*chunk)
+    }
+    let mut lanes = [P1.wrapping_add(P2), P2, 0, 0u64.wrapping_sub(P1)];
+    let (stripes, rest) = bytes.as_chunks::<32>();
+    for stripe in stripes {
+        let (words, _) = stripe.as_chunks::<8>();
+        for (lane, w) in lanes.iter_mut().zip(words) {
+            *lane = round(*lane, word(w));
+        }
+    }
+    // The tail, eight bytes at a time and then byte by byte, into the lanes in
+    // turn, so a short blob still reaches all four.
+    let (words, bytes_left) = rest.as_chunks::<8>();
+    for (i, w) in words.iter().enumerate() {
+        lanes[i % 4] = round(lanes[i % 4], word(w));
+    }
+    for (i, &b) in bytes_left.iter().enumerate() {
+        lanes[i % 4] = round(lanes[i % 4], u64::from(b) ^ P5);
+    }
+    let len = bytes.len() as u64;
+    let lo = lanes[0].rotate_left(1)
+        ^ lanes[1].rotate_left(7)
+        ^ lanes[2].rotate_left(12)
+        ^ lanes[3].rotate_left(18);
+    let hi = lanes[0].wrapping_mul(P3)
+        ^ lanes[1].wrapping_mul(P4).rotate_left(11)
+        ^ lanes[2].wrapping_mul(P5).rotate_left(23)
+        ^ lanes[3].wrapping_mul(P1).rotate_left(37);
+    let lo = avalanche(lo ^ len.wrapping_mul(P5));
+    let hi = avalanche(hi.wrapping_add(len).wrapping_mul(P4) ^ P2);
+    (u128::from(hi) << 64) | u128::from(lo)
 }
 
