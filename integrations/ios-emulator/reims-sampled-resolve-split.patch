@@ -0,0 +1,184 @@
+//! Inside `sampled_phase`'s `resolve_us`: which rung of the sampled ladder the
+//! time goes to, and how many guest bytes each one moved.
+//!
+//! # Why
+//!
+//! `resolve_us` is the largest single column of the drain on a Home-screen
+//! swipe — 247-308 ms in a busy second, against ~400 sampled draws — and it is
+//! one scope around [`crate::runtime::draw`]'s `resolve_sampled_source`, which
+//! is a ladder. On the vphone's census every linear bind tries, in order, the
+//! GVA-resident rung (`gvaw_no_entry`), the zero-copy gather (`zc_lin_no_alias`)
+//! and then the guest memo (`lin_memo_hit`), which settles the span's
+//! writeback debt, re-reads the whole span out of guest memory and compares it
+//! byte for byte with its copy; a buffer-backed texture (`buftex_*`) reads its
+//! rows instead. Route counters say which rung served. None of them says what
+//! each rung *cost*, so a fix aimed at one of them is a guess.
+//!
+//! These spans nest inside `ResolveSource` and do not partition it: what is
+//! left of `resolve_us` after their sum is the ladder's own lookups and the
+//! surface rungs above the linear ones.
+//!
+//! # Reading it
+//!
+//! `memo_read_mib` over `memo_n` is the mean span a memo bind re-reads; if
+//! `memo_read_us + memo_cmp_us` is most of `resolve_us`, the cost is the
+//! re-read of unchanged texels, and the lever is a witness that lets a bind
+//! skip it. If `gva_resident_us` or `zero_copy_us` is large while the rung
+//! declines (`gvaw_no_entry`, `zc_lin_no_alias`), the cost is a probe that
+//! cannot serve this workload.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+use crate::observe::phase_clock::{charge_ns, to_us};
+
+/// One rung, or one step of the guest memo.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Part {
+    /// `try_gva_resident_sample`, served or declined.
+    GvaResident = 0,
+    /// `try_linear_sample_zero_copy`, served or declined.
+    ZeroCopy = 1,
+    /// `writeback_debt::settle_for_texture` ahead of the memo's read.
+    MemoSettle = 2,
+    /// The memo's whole-span guest read; bytes are the span.
+    MemoRead = 3,
+    /// The memo lookup and its byte-for-byte compare.
+    MemoCompare = 4,
+    /// A memo miss: the pixel-format conversion and the insert.
+    MemoConvert = 5,
+    /// `load_buffer_texture_rows`; bytes are the rows it returned.
+    BufferRows = 6,
+}
+
+const PARTS: usize = Part::BufferRows as usize + 1;
+
+static NS: [AtomicU64; PARTS] = [const { AtomicU64::new(0) }; PARTS];
+static COUNT: [AtomicU64; PARTS] = [const { AtomicU64::new(0) }; PARTS];
+static BYTES: [AtomicU64; PARTS] = [const { AtomicU64::new(0) }; PARTS];
+
+/// Charges one scope's wall clock, one count and its bytes to a [`Part`].
+pub struct Span {
+    part: Part,
+    started: Instant,
+    bytes: u64,
+}
+
+impl Span {
+    pub fn open(part: Part) -> Self {
+        Self {
+            part,
+            started: Instant::now(),
+            bytes: 0,
+        }
+    }
+
+    /// The bytes this scope moved, charged when it closes.
+    pub fn bytes(&mut self, bytes: usize) {
+        self.bytes = bytes as u64;
+    }
+}
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        let i = self.part as usize;
+        NS[i].fetch_add(charge_ns(self.started.elapsed()), Ordering::Relaxed);
+        COUNT[i].fetch_add(1, Ordering::Relaxed);
+        BYTES[i].fetch_add(self.bytes, Ordering::Relaxed);
+    }
+}
+
+fn take(part: Part) -> (u64, u64, u64) {
+    let i = part as usize;
+    (
+        to_us(NS[i].swap(0, Ordering::Relaxed)),
+        COUNT[i].swap(0, Ordering::Relaxed),
+        BYTES[i].swap(0, Ordering::Relaxed),
+    )
+}
+
+fn mib(bytes: u64) -> String {
+    format!("{:.1}", bytes as f64 / f64::from(1u32 << 20))
+}
+
+/// Take and clear the window; `None` when no span closed in it.
+pub fn take_line() -> Option<String> {
+    let gva = take(Part::GvaResident);
+    let zc = take(Part::ZeroCopy);
+    let settle = take(Part::MemoSettle);
+    let read = take(Part::MemoRead);
+    let cmp = take(Part::MemoCompare);
+    let convert = take(Part::MemoConvert);
+    let rows = take(Part::BufferRows);
+    let any = [gva, zc, settle, read, cmp, convert, rows]
+        .iter()
+        .any(|&(_, n, _)| n != 0);
+    any.then(|| {
+        format!(
+            "sampled_resolve_split gva_resident_us={} gva_resident_n={} zero_copy_us={} \
+             zero_copy_n={} memo_settle_us={} memo_read_us={} memo_read_mib={} memo_n={} \
+             memo_cmp_us={} memo_convert_us={} memo_convert_n={} memo_convert_mib={} \
+             buftex_us={} buftex_n={} buftex_mib={} (nested in sampled_phase resolve_us)",
+            gva.0,
+            gva.1,
+            zc.0,
+            zc.1,
+            settle.0,
+            read.0,
+            mib(read.2),
+            read.1,
+            cmp.0,
+            convert.0,
+            convert.1,
+            mib(convert.2),
+            rows.0,
+            rows.1,
+            mib(rows.2),
+        )
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn field(line: &str, name: &str) -> f64 {
+        line.split(&format!(" {name}="))
+            .nth(1)
+            .and_then(|rest| rest.split(' ').next())
+            .and_then(|v| v.parse().ok())
+            .unwrap_or_else(|| panic!("{name} in {line}"))
+    }
+
+    /// The counters are process-wide and other tests drive the sampled ladder,
+    /// so this asserts floors rather than equalities: what it charged must be
+    /// there, under the right names, and taking the window must clear it.
+    #[test]
+    fn a_window_charges_each_part_its_own_time_and_bytes_and_resets() {
+        let _ = take_line();
+        {
+            let mut s = Span::open(Part::MemoRead);
+            s.bytes(64 << 20);
+            std::thread::sleep(std::time::Duration::from_millis(2));
+        }
+        {
+            let mut s = Span::open(Part::BufferRows);
+            s.bytes(32 << 20);
+        }
+        let _ = Span::open(Part::ZeroCopy);
+        let line = take_line().expect("spans closed");
+        assert!(field(&line, "memo_read_mib") >= 64.0, "{line}");
+        assert!(field(&line, "memo_n") >= 1.0, "{line}");
+        assert!(field(&line, "memo_read_us") >= 1_500.0, "{line}");
+        assert!(field(&line, "buftex_mib") >= 32.0, "{line}");
+        assert!(field(&line, "buftex_n") >= 1.0, "{line}");
+        assert!(field(&line, "zero_copy_n") >= 1.0, "{line}");
+        let after = take_line();
+        assert!(
+            after
+                .as_deref()
+                .is_none_or(|l| field(l, "memo_read_mib") < 64.0),
+            "taking the window clears it: {after:?}"
+        );
+    }
+}
