+#[test]
+fn mrt_draw_request_resolves_an_srgb_raster_into_its_linear_drawable() {
+    use crate::protocol::pixel_format::{MTL_FORMAT_BGRA8_UNORM, MTL_FORMAT_BGRA8_UNORM_SRGB};
+    use reims_vgpu_protocol::pass_action::MTL_STORE_ACTION_MULTISAMPLE_RESOLVE;
+
+    let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_ARM64E);
+    let mut host = FakeHost::new();
+    state.define_task(1, 0x1000, 2);
+    for (texture_ref, mapping_id, format) in [
+        (42, 9, MTL_FORMAT_BGRA8_UNORM_SRGB),
+        (43, 10, MTL_FORMAT_BGRA8_UNORM),
+    ] {
+        assert!(state.map_surface(mapping_id));
+        assert!(state.set_mapping_geom(mapping_id, 64, 64, format));
+        state
+            .texture_to_mapping
+            .insert((1, texture_ref), mapping_id);
+    }
+    let mut att = clear_black_attachment(42);
+    att.resolve_texture_ref = 43;
+    att.store_action = MTL_STORE_ACTION_MULTISAMPLE_RESOLVE;
+
+    let req = single_rt_draw_request(&mut state, &mut host, 7, att)
+        .expect("an sRGB raster resolves into its linear drawable");
+    assert_eq!(req.colors[0].texture_ref, 43, "the published target");
+    assert_eq!(
+        req.colors[0].format, MTL_FORMAT_BGRA8_UNORM,
+        "the destination keeps its own declaration"
