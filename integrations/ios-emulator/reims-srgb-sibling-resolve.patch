+/// Whether a multisample source in `source` may resolve into a destination in
+/// `resolve`.
+///
+/// Equal formats always may. Beyond that only the two members of an sRGB/linear
+/// pair over one byte layout do: Metal's validation of a resolve attachment
+/// checks its storage, type, size and sample count but not its pixel format,
+/// and iOS's own wallpaper renderer resolves a `BGRA8Unorm_sRGB` raster into
+/// its `BGRA8Unorm` drawable. The resolved bytes carry the source's encoding --
+/// the drawable is composited as sRGB-encoded content -- so the backend renders
+/// and resolves in the source's format and leaves the destination its own.
+/// Formats whose bytes differ stay refused: that resolve would be a conversion,
+/// and nothing here establishes which.
+pub(crate) fn resolve_format_compatible(source: u16, resolve: u16) -> bool {
+    if source == resolve {
+        return true;
+    }
+    pixel_format::is_srgb(source) != pixel_format::is_srgb(resolve)
+        && pixel_format::store_texel_order(source)
+            .is_some_and(|layout| pixel_format::store_texel_order(resolve) == Some(layout))
 }
 
