+fn a_multisample_resolve_from_an_srgb_raster_stores_encoded_bytes_in_a_linear_target() {
+    use reims_vgpu::protocol::pixel_format::{MTL_FORMAT_BGRA8_UNORM, MTL_FORMAT_BGRA8_UNORM_SRGB};
