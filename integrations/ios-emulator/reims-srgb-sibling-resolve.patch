+/// The two members of an sRGB/linear pair over one byte layout may resolve into
+/// each other; nothing else that differs may. iOS's wallpaper renderer resolves
+/// a `BGRA8Unorm_sRGB` raster into its `BGRA8Unorm` drawable, and Metal's
+/// validation never checks a resolve target's pixel format.
+#[test]
+fn resolve_formats_pair_only_the_srgb_and_linear_members_of_one_layout() {
+    use crate::protocol::pixel_format::{
+        MTL_FORMAT_BGRA8_UNORM, MTL_FORMAT_BGRA8_UNORM_SRGB, MTL_FORMAT_RGBA16_FLOAT,
+        MTL_FORMAT_RGBA8_UNORM, MTL_FORMAT_RGBA8_UNORM_SRGB,
+    };
+    for (source, resolve) in [
+        (MTL_FORMAT_BGRA8_UNORM, MTL_FORMAT_BGRA8_UNORM),
+        (MTL_FORMAT_BGRA8_UNORM_SRGB, MTL_FORMAT_BGRA8_UNORM),
+        (MTL_FORMAT_BGRA8_UNORM, MTL_FORMAT_BGRA8_UNORM_SRGB),
+        (MTL_FORMAT_RGBA8_UNORM_SRGB, MTL_FORMAT_RGBA8_UNORM),
+    ] {
+        assert!(
+            resolve_format_compatible(source, resolve),
+            "{source:#x} -> {resolve:#x}"
+        );
+    }
+    for (source, resolve) in [
+        // Same width, other channel order: a swizzle, not a transfer function.
+        (MTL_FORMAT_RGBA8_UNORM_SRGB, MTL_FORMAT_BGRA8_UNORM),
+        (MTL_FORMAT_RGBA8_UNORM, MTL_FORMAT_BGRA8_UNORM),
+        // Other bytes altogether: a conversion.
+        (MTL_FORMAT_RGBA16_FLOAT, MTL_FORMAT_BGRA8_UNORM),
+    ] {
+        assert!(
+            !resolve_format_compatible(source, resolve),
+            "{source:#x} -> {resolve:#x}"
+        );
+    }
+}
