+/// The Store before banding (`REIMS_VGPU_STORE_PUBLISH_BANDS=off`): one
+/// thread copies the readback into the guest's pages while another converts
+/// the whole readback for the present's stash.
+fn publish_beside_conversion<M: HostMemory + HostOps>(
+    writer: crate::runtime::mapping_write::PreparedNativeImageWrite<'_, M>,
+    identity: &crate::backend::vulkan::engine::TargetIdentity,
+    expected_bytes: usize,
+    stash: bool,
+) -> Result<(usize, bool), NativeFloatStoreRefusal> {
+    use crate::protocol::pixel_format::TexelLayout;
+    use NativeFloatStoreRefusal as R;
+    let read_started = std::time::Instant::now();
+    let (readback, witness) =
+        crate::backend::vulkan::engine::read_target_texels_consumable_witnessed(identity)
+            .map_err(R::Read)?;
+    crate::runtime::drain::note_store_route_us(
+        "native_float_readback_us",
+        read_started.elapsed().as_micros() as u64,
+    );
+    if readback.texel.native_layout() != Some(TexelLayout::Rgba16Float)
+        || readback.bytes().len() != expected_bytes
+    {
+        // The source was declared after the writer: Drop ends its
+        // staging lease before failed preparation releases guest views.
+        return Err(R::SourceShape);
+    }
+    // The present capture that follows would read this same resident
+    // back again. Convert these bytes for it now, while they are in
+    // hand, when the display needs CPU frames and has been presenting
+    // this surface; `seal` at the call site licenses them once the
+    // Store has landed and stamped the resident. The conversion runs
+    // beside the guest publish below rather than before it: both only
+    // read the staging bytes, and the writer joins it before it drops
+    // the readback.
+    let texel = readback.texel;
+    let convert = stash.then_some(move |bytes: &[u8]| {
+        crate::backend::vulkan::engine::store_capture::stash(witness, texel, bytes);
+    });
+    let leased = readback.is_leased();
+    let publish_started = std::time::Instant::now();
+    // Ownership, never readback.bytes(), crosses this boundary. The
+    // writer drops the source before view release/currency publication.
+    let bytes = writer
+        .write_from_alongside(readback, convert)
+        .map_err(R::Mapping)?;
+    crate::runtime::drain::note_store_route_us(
+        "native_float_publish_us",
+        publish_started.elapsed().as_micros() as u64,
+    );
+    Ok((bytes, leased))
+}
