+/// The banded Store: read the resident back, then copy it into the guest's
+/// pages in row bands written at once, each band converting its rows for the
+/// present's stash right after copying them. The stash buffer is taken before
+/// the readback, so nothing is allocated while the staging lease is held, and
+/// the frame is stashed after the lease has ended.
+fn publish_banded<M: HostMemory + HostOps>(
+    writer: crate::runtime::mapping_write::PreparedNativeImageWrite<'_, M>,
+    identity: &crate::backend::vulkan::engine::TargetIdentity,
+    expected_bytes: usize,
+    width: u32,
+    height: u32,
+    stash: bool,
+) -> Result<(usize, bool), NativeFloatStoreRefusal> {
+    use crate::backend::vulkan::engine::store_capture;
+    use crate::protocol::pixel_format::TexelLayout;
+    use NativeFloatStoreRefusal as R;
+    let threads = publish_bands(expected_bytes);
+    let (row_count, row_bytes) = writer.rows();
+    let parts = crate::runtime::mapper::banded_parts(row_count, threads);
+    let mut stasher = stash.then(|| store_capture::Stasher::begin(width, height));
+    let mut sinks = match stasher.as_mut() {
+        Some(stasher) => stasher.sinks(row_count, row_bytes, parts),
+        None => Vec::new(),
+    };
+    if stash && sinks.is_empty() {
+        crate::runtime::drain::note_store_route("store_capture_band_shape_n");
+    }
+    let read_started = std::time::Instant::now();
+    let (readback, witness) =
+        crate::backend::vulkan::engine::read_target_texels_consumable_witnessed(identity)
+            .map_err(R::Read)?;
+    crate::runtime::drain::note_store_route_us(
+        "native_float_readback_us",
+        read_started.elapsed().as_micros() as u64,
+    );
+    if readback.texel.native_layout() != Some(TexelLayout::Rgba16Float)
+        || readback.bytes().len() != expected_bytes
+    {
+        // The source was declared after the writer: Drop ends its staging
+        // lease before failed preparation releases guest views.
+        return Err(R::SourceShape);
+    }
+    let leased = readback.is_leased();
+    let publish_started = std::time::Instant::now();
+    // Ownership, never readback.bytes(), crosses this boundary. The writer
+    // drops the source before view release/currency publication.
+    let (bytes, banded) = writer
+        .write_from_banded(readback, threads, parts, &mut sinks)
+        .map_err(R::Mapping)?;
+    crate::runtime::drain::note_store_route_us(
+        "native_float_publish_us",
+        publish_started.elapsed().as_micros() as u64,
+    );
+    crate::runtime::drain::note_store_route_n("native_image_band_parts_n", banded.parts as u64);
+    crate::runtime::drain::note_store_route_n("native_image_band_threads_n", banded.spawned as u64);
+    drop(sinks);
+    if let Some(stasher) = stasher {
+        stasher.commit(witness);
+    }
+    Ok((bytes, leased))
+}
