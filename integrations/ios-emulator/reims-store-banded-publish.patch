+fn a_page_list_that_names_one_page_twice_is_written_on_one_thread() {
+    use crate::model::PAGE_SHIFT_X86;
+    use crate::protocol::pixel_format::MTL_FORMAT_RGBA16_FLOAT;
+    let (w, h) = (512u32, 600u32);
