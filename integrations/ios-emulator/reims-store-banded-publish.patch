+    let pages = (tight * h as usize + (64 << PAGE_SHIFT_X86)) >> PAGE_SHIFT_X86;
+    let mut order: Vec<u64> = (0..pages as u64).map(|n| n * 2).collect();
+    // The last page of the surface is the first one again.
+    let last = (tight * h as usize - 1) >> PAGE_SHIFT_X86;
+    order[last] = order[0];
+    let src: Vec<u8> = (0..tight * h as usize)
+        .map(|i| (i as u32).wrapping_mul(2_246_822_519).rotate_right(7) as u8)
