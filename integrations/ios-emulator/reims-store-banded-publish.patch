+/// Write rows `rows` of `rect` from the packed `src` into the pieces, block
+/// by block, calling `sink` after each block, and fence the streaming stores.
+///
+/// # Safety
+///
+/// Every piece's host run is live and writable, the pieces ascend through the
+/// span without overlapping, and no other thread writes the host bytes of
+/// these rows meanwhile. `src` holds `rect.packed()` bytes.
+unsafe fn write_band(
+    pieces: &[Piece],
+    src: &[u8],
+    rect: super::RectStride,
+    rows: std::ops::Range<usize>,
+    mut sink: Option<&mut dyn BandSink>,
+) {
+    let mut first = 0usize;
+    let mut row = rows.start;
+    while row < rows.end {
+        let end = (row + BANDED_BLOCK_ROWS).min(rows.end);
+        let lo = row * rect.row_stride;
+        let hi = (end - 1) * rect.row_stride + rect.row_bytes;
+        first +=
+            pieces[first..].partition_point(|p| p.buffer_offset + p.bytes.len() as usize <= lo);
+        for piece in pieces[first..].iter().take_while(|p| p.buffer_offset < hi) {
+            let piece_end = piece.buffer_offset + piece.bytes.len() as usize;
+            let (a, b) = (lo.max(piece.buffer_offset), hi.min(piece_end));
+            let host = piece.bytes.host_ptr() as *mut u8;
+            rect.for_each_piece(a, a - piece.buffer_offset, b - a, |packed, at, len| {
+                // SAFETY: the caller's contract; `for_each_piece` keeps both
+                // offsets inside the row bytes of `[a, b)`.
+                unsafe {
+                    crate::runtime::stream_copy::stream_copy(
+                        src.as_ptr().add(packed),
+                        host.add(at),
+                        len,
+                    )
+                };
+            });
+        }
+        if let Some(sink) = sink.as_deref_mut() {
+            let packed = row * rect.row_bytes..end * rect.row_bytes;
+            sink.rows(packed.clone(), &src[packed]);
+        }
+        row = end;
+    }
+    crate::runtime::stream_copy::stream_fence();
 }
 
