+/// One band's share of a [`Stasher`]: what it converted and the figures.
+#[derive(Clone, Copy, Debug, Default)]
+struct BandTally {
+    nz: usize,
+    max: u8,
+    bytes: usize,
+    us: u64,
+    refused: bool,
+}
+
+/// A stash being converted band by band inside a banded render Store
+/// (`PreparedNativeImageWrite::write_from_banded`): each band converts each
+/// block of rows right after copying it into the guest's pages, into its own
+/// part of one BGRA8 buffer. [`Stasher::commit`] then stashes the frame —
+/// exactly [`stash`]'s frame and figures, the conversion being the same
+/// function per pixel and the figures a sum and a maximum — or, when any band
+/// refused or did not run, gives the buffer back and stashes nothing.
+pub struct Stasher {
+    bgra: Vec<u8>,
+    tallies: Vec<BandTally>,
+    committed: bool,
+}
+
+/// One band's sink: its rows' part of the [`Stasher`]'s buffer.
+pub struct StashBand<'a> {
+    dst: &'a mut [u8],
+    /// Where this band's rows start in the packed source.
+    base: usize,
+    tally: &'a mut BandTally,
+}
+
+impl Stasher {
+    /// Take a buffer for a `width` x `height` frame, as [`stash`] does: the
+    /// waiting stash's (which a newer frame replaces) or the spare. Sized, not
+    /// cleared: the bands overwrite every byte before it can be stashed.
+    pub fn begin(width: u32, height: u32) -> Stasher {
+        let need = (width as usize)
+            .saturating_mul(height as usize)
+            .saturating_mul(crate::protocol::pixel_format::RGBA8_BPP as usize);
+        let mut shelf = SHELF.lock();
+        let mut bgra = match shelf.stash.take() {
+            Some(old) => old.bgra,
+            None => std::mem::take(&mut shelf.spare),
+        };
+        drop(shelf);
+        if bgra.len() != need {
+            bgra.clear();
+            bgra.resize(need, 0);
+        }
+        Stasher {
+            bgra,
+            tallies: Vec::new(),
+            committed: false,
+        }
+    }
+
+    /// One sink per part for a source of `row_count` RGBA16F rows of
+    /// `row_bytes` each cut into `parts` parts, as the banded write cuts it
+    /// (`band_rows`). Empty — and nothing will be stashed — when the rows do
+    /// not describe this buffer's frame.
+    pub fn sinks(
+        &mut self,
+        row_count: usize,
+        row_bytes: usize,
+        parts: usize,
+    ) -> Vec<StashBand<'_>> {
+        use crate::runtime::mapper::band_rows;
+        let dst_row = row_bytes / 8 * 4;
+        if parts == 0
+            || parts > row_count
+            || !row_bytes.is_multiple_of(8)
+            || row_count.checked_mul(dst_row) != Some(self.bgra.len())
+        {
+            return Vec::new();
+        }
+        self.tallies.clear();
+        self.tallies.resize(parts, BandTally::default());
+        let mut sinks = Vec::with_capacity(parts);
+        let mut rest: &mut [u8] = &mut self.bgra;
+        for (index, tally) in self.tallies.iter_mut().enumerate() {
+            let rows = band_rows(row_count, parts, index);
+            let (dst, tail) = std::mem::take(&mut rest).split_at_mut(rows.len() * dst_row);
+            rest = tail;
+            sinks.push(StashBand {
+                dst,
+                base: rows.start * row_bytes,
+                tally,
+            });
+        }
+        sinks
+    }
+
+    /// Stash the converted frame as read by `witness`, when every band
+    /// converted all of its rows. `false`, with the buffer kept as the spare,
+    /// otherwise.
+    pub fn commit(mut self, witness: ReadWitness) -> bool {
+        self.committed = true;
+        let converted: usize = self.tallies.iter().map(|t| t.bytes).sum();
+        let refused = self.tallies.iter().any(|t| t.refused);
+        let us: u64 = self.tallies.iter().map(|t| t.us).sum();
+        let bgra = std::mem::take(&mut self.bgra);
+        let mut shelf = SHELF.lock();
+        if refused || bgra.is_empty() || converted != bgra.len() {
+            crate::runtime::drain::note_store_route("store_capture_convert_refused_n");
+            shelf.spare = bgra;
+            return false;
+        }
+        let nz = self.tallies.iter().map(|t| t.nz).sum();
+        let max = self.tallies.iter().map(|t| t.max).max().unwrap_or(0);
+        let px0 = [bgra[0], bgra[1], bgra[2], bgra[3]];
+        crate::runtime::drain::note_store_route_us("store_capture_convert_us", us);
+        crate::runtime::drain::note_store_route("store_capture_stashed_n");
+        crate::runtime::drain::note_store_route("store_capture_banded_n");
+        shelf.stash = Some(Stash {
+            witness,
+            sealed: None,
+            bgra,
+            stats: (nz, max, px0),
+        });
+        true
+    }
+}
+
+impl Drop for Stasher {
+    /// A Store that failed before [`Stasher::commit`] gives the buffer back.
+    fn drop(&mut self) {
+        if !self.committed && !self.bgra.is_empty() {
+            SHELF.lock().spare = std::mem::take(&mut self.bgra);
+        }
+    }
+}
+
+impl crate::runtime::mapper::BandSink for StashBand<'_> {
+    fn rows(&mut self, packed: std::ops::Range<usize>, src: &[u8]) {
+        if self.tally.refused {
+            return;
+        }
+        let started = std::time::Instant::now();
+        let at = packed.start.checked_sub(self.base).map(|off| off / 8 * 4);
+        let dst = at.and_then(|at| self.dst.get_mut(at..at + src.len() / 8 * 4));
+        let figures = match dst {
+            Some(dst) if src.len().is_multiple_of(8) && packed.start.is_multiple_of(8) => {
+                super::present_capture::convert_band_streamed(
+                    crate::protocol::pixel_format::Rgba8Narrowing::Rgba16Float,
+                    src,
+                    dst,
+                )
+            }
+            _ => None,
+        };
+        match figures {
+            Some((nz, max)) => {
+                self.tally.nz += nz;
+                self.tally.max = self.tally.max.max(max);
+                self.tally.bytes += src.len() / 8 * 4;
+            }
+            None => self.tally.refused = true,
+        }
+        self.tally.us += started.elapsed().as_micros() as u64;
+    }
+}
