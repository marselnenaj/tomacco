+        for bands in [1usize, 2, 3, 4, 8, 23] {
+            let mut stasher = Stasher::begin(width as u32, height as u32);
+            {
+                let mut sinks = stasher.sinks(height, row, bands);
+                assert_eq!(sinks.len(), bands);
+                for (index, sink) in sinks.iter_mut().enumerate() {
+                    let rows = band_rows(height, bands, index);
