+/// A large native Store written on one to four threads in one to 1100 parts,
+/// over a page list scattered through guest RAM: the guest's span ends up
+/// exactly as the one-thread copy leaves it — every row at its own offset,
+/// the padding between rows the guest's — and the parts' sinks between them
+/// see every packed byte once, in whole rows, each part its own rows in order.
+#[test]
+fn a_banded_native_store_lands_every_row_and_hands_each_block_to_its_band() {
+    use crate::model::PAGE_SHIFT_X86;
+    use crate::protocol::pixel_format::MTL_FORMAT_RGBA16_FLOAT;
+    let (w, h) = (1000u32, 1100u32);
+    let tight = w as usize * 8;
+    let base = 0x4000_0000u64;
+    let pages = (tight * h as usize * 2) >> PAGE_SHIFT_X86;
+    let mut order: Vec<u64> = (0..pages as u64).collect();
+    for i in 0..pages {
+        order.swap(i, (i * 7 + 3) % pages);
+    }
+    let src: Vec<u8> = (0..tight * h as usize)
+        .map(|i| (i as u32).wrapping_mul(2_654_435_761).rotate_right(13) as u8)
+        .collect();
+    for (threads, parts) in [(1usize, 1usize), (1, 5), (2, 2), (3, 24), (4, 32), (4, 1100)] {
+        let (mut state, mut host, offset, stride) =
+            banded_store_surface(PAGE_SHIFT_X86, 21, (w, h), base, &order);
+        let target = {
+            let m = state.mappings.get(&21).unwrap();
+            NativeImageWriteTarget::capture(21, m, w, h, MTL_FORMAT_RGBA16_FLOAT).unwrap()
+        };
+        let plan = target.prepared_source_plan(&state, &mut host).unwrap();
+        let writer = prepare_native_image_write(&mut state, &mut host, target, plan).unwrap();
+        assert_eq!(writer.rows(), (h as usize, tight));
+        let mut sinks: Vec<RecordingSink> = (0..parts)
+            .map(|_| RecordingSink { blocks: Vec::new() })
+            .collect();
+        let (bytes, banded) = writer
+            .write_from_banded(src.clone(), threads, parts, &mut sinks)
+            .unwrap();
+        assert_eq!(bytes, src.len());
+        assert_eq!((banded.threads, banded.parts), (threads, parts));
+        assert_eq!(banded.spawned, threads - 1, "the pages are disjoint");
+        let mut covered = 0usize;
+        for (index, sink) in sinks.iter().enumerate() {
+            let rows = crate::runtime::mapper::band_rows(h as usize, parts, index);
+            let mut at = rows.start * tight;
+            for (packed, sum) in &sink.blocks {
+                assert_eq!(packed.start, at, "part {index} hands its rows in order");
+                assert!(packed.len().is_multiple_of(tight), "whole rows");
+                let want: u64 = src[packed.clone()].iter().map(|&b| u64::from(b)).sum();
+                assert_eq!(*sum, want);
+                at = packed.end;
+            }
+            assert_eq!(at, rows.end * tight, "part {index} saw all its rows");
+            covered += at - rows.start * tight;
+        }
+        assert_eq!(covered, src.len());
+        let span = stride * (h as usize - 1) + tight;
+        let guest = banded_store_span(&mut host, PAGE_SHIFT_X86, base, &order, offset, span);
+        for row in 0..h as usize {
+            assert!(
+                guest[row * stride..row * stride + tight] == src[row * tight..(row + 1) * tight],
+                "parts={parts} row {row} differs"
+            );
+            if row + 1 < h as usize {
+                assert!(
+                    guest[row * stride + tight..(row + 1) * stride]
+                        .iter()
+                        .all(|&b| b == 0xee),
+                    "parts={parts} padding after row {row} was written"
+                );
+            }
+        }
+    }
