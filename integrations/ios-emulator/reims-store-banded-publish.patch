+                .write_from_banded(src.clone(), 4, 32, &mut [] as &mut [RecordingSink])
+                .unwrap();
+            assert_eq!((done.threads, done.spawned), (4, 0));
+        } else {
+            writer.write_from(src.clone()).unwrap();
