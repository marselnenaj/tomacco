+/// Timing, not a check: `cargo test --release -- --ignored --nocapture
+/// store_banded_timing`. The render Store of the vphone's front surface
+/// (1206x2622 RGBA16F, 16 KiB pages scattered through guest RAM) with its
+/// present conversion: the copy with the conversion beside it on another
+/// thread (the Store before banding) against the banded copy with the
+/// conversion in each band, for one to four bands, and the banded copy alone.
+/// Median of 31 runs each, alternating, caches evicted before each; wall
+/// clock on a shared host.
+#[cfg(feature = "backend-vulkan")]
+#[test]
+#[ignore]
+fn store_banded_timing() {
+    use crate::backend::vulkan::engine::store_capture::Stasher;
+    use crate::backend::vulkan::engine::{readback_bytes_into_bgra, ReadbackTexel};
+    use crate::protocol::pixel_format::{TexelLayout, MTL_FORMAT_RGBA16_FLOAT};
+    struct Borrowed<'a>(&'a [u8]);
+    impl NativeImageSource for Borrowed<'_> {
+        fn native_bytes(&self) -> &[u8] {
+            self.0
+        }
+    }
+    let (w, h) = (1206u32, 2622u32);
+    let tight = w as usize * 8;
+    let base = 0x8000_0000u64;
+    let pages = (tight * h as usize * 3 / 2) >> PAGE_SHIFT_ARM64E;
+    let mut order: Vec<u64> = (0..pages as u64).collect();
+    for i in 0..pages {
+        order.swap(i, (i * 7 + 3) % pages);
+    }
+    let (mut state, mut host, _, _) =
+        banded_store_surface(PAGE_SHIFT_ARM64E, 22, (w, h), base, &order);
+    let src: Vec<u8> = (0..tight * h as usize / 2)
+        .flat_map(|i| (0x2000u16 + (i as u16 % 0x1c00)).to_le_bytes())
+        .collect();
+    let mut bgra = vec![0u8; w as usize * h as usize * 4];
+    let texel = ReadbackTexel::Native(TexelLayout::Rgba16Float);
+    let mut run = |bands: usize, bgra: &mut Vec<u8>| -> u128 {
+        let target = {
+            let m = state.mappings.get(&22).unwrap();
+            NativeImageWriteTarget::capture(22, m, w, h, MTL_FORMAT_RGBA16_FLOAT).unwrap()
+        };
+        let plan = target.prepared_source_plan(&state, &mut host).unwrap();
+        let writer = prepare_native_image_write(&mut state, &mut host, target, plan).unwrap();
+        if bands == 0 {
+            let started = std::time::Instant::now();
+            let convert = |bytes: &[u8]| {
+                assert!(readback_bytes_into_bgra(texel, bytes, bgra, &|_| {}).is_some());
+            };
+            writer
+                .write_from_alongside(Borrowed(&src), Some(convert))
+                .unwrap();
+            started.elapsed().as_micros()
+        } else if bands >= 10 {
+            // The banded copy alone, with no conversion.
+            let started = std::time::Instant::now();
+            let threads = bands - 10;
+            let parts = crate::runtime::mapper::banded_parts(h as usize, threads);
+            writer
+                .write_from_banded(Borrowed(&src), threads, parts, &mut [] as &mut [RecordingSink])
+                .unwrap();
+            started.elapsed().as_micros()
+        } else {
+            let mut stasher = Stasher::begin(w, h);
+            let started = std::time::Instant::now();
+            let parts = crate::runtime::mapper::banded_parts(h as usize, bands);
+            let mut sinks = stasher.sinks(h as usize, tight, parts);
+            writer
+                .write_from_banded(Borrowed(&src), bands, parts, &mut sinks)
+                .unwrap();
+            started.elapsed().as_micros()
+        }
+    };
+    // A live Store's staging bytes come from the GPU and its guest pages were
+    // last touched a frame ago, so 96 MB of other writes before each run keep
+    // both out of the cache, as they are there.
+    let mut evict = vec![0u8; 96 << 20];
+    let mut runs: std::collections::BTreeMap<usize, Vec<u128>> = Default::default();
+    for _ in 0..31 {
+        for bands in [0usize, 1, 2, 3, 4, 11, 14] {
+            for (i, page) in evict.chunks_mut(4096).enumerate() {
+                page.fill(i as u8);
+            }
+            let us = run(bands, &mut bgra);
+            runs.entry(bands).or_default().push(us);
+        }
+    }
+    for (bands, mut us) in runs {
+        us.sort_unstable();
+        println!(
+            "store_banded_timing {} median_us={} p25_us={} p75_us={}",
+            match bands {
+                0 => "beside".to_string(),
+                10.. => format!("copy_only_bands={}", bands - 10),
+                _ => format!("bands={bands}"),
+            },
+            us[us.len() / 2],
+            us[us.len() / 4],
+            us[us.len() * 3 / 4]
+        );
+    }
+}
