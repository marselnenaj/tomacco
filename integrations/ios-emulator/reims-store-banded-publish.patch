+/// Whether [`crate::config::STORE_PUBLISH_BANDS`] is switched off, read once.
+fn banded_publish_disabled() -> bool {
+    use std::sync::OnceLock;
+    static OFF: OnceLock<bool> = OnceLock::new();
+    *OFF.get_or_init(|| {
+        let (state, value) = crate::config::read(crate::config::STORE_PUBLISH_BANDS);
+        match state {
+            crate::config::Switch::Off => {
+                crate::observe::off("store_publish reason=store_publish_bands_disabled_by_env");
+                true
+            }
+            crate::config::Switch::Unrecognized => {
+                crate::observe::fail(format!(
+                    "store_publish reason=store_publish_bands_env_unrecognized value={}",
+                    value.unwrap_or_default()
+                ));
+                false
+            }
+            crate::config::Switch::On | crate::config::Switch::Unset => false,
+        }
+    })
+}
+
+/// Threads for a Store of `bytes`: up to `BANDED_MAX_BANDS`, as many as the
+/// host has, and one below a mebibyte, where starting threads would cost more
+/// than the copy.
+fn publish_bands(bytes: usize) -> usize {
+    use std::sync::OnceLock;
+    static THREADS: OnceLock<usize> = OnceLock::new();
+    if bytes < 1 << 20 {
+        return 1;
+    }
+    *THREADS.get_or_init(|| {
+        std::thread::available_parallelism()
+            .map(usize::from)
+            .unwrap_or(1)
+            .clamp(1, crate::runtime::mapper::BANDED_MAX_BANDS)
+    })
+}
