+/// Whether one window's pieces ascend through it without overlapping and no
+/// two of them write the same host byte — what lets disjoint row bands of the
+/// window be written by several threads at once. Two guest pages naming one
+/// host page would make two bands race for it, so that refuses, as does a
+/// list too long to sort here.
+fn pieces_band_disjoint(pieces: &[Piece]) -> bool {
+    let ascending = pieces
+        .windows(2)
+        .all(|pair| pair[0].buffer_offset + pair[0].bytes.len() as usize <= pair[1].buffer_offset);
+    if !ascending {
+        return false;
+    }
+    let mut host: Vec<(usize, usize)> = Vec::new();
+    if host.try_reserve_exact(pieces.len()).is_err() {
+        return false;
+    }
+    host.extend(
+        pieces
+            .iter()
+            .map(|p| (p.bytes.host_ptr(), p.bytes.len() as usize)),
+    );
+    host.sort_unstable();
+    host.windows(2).all(|pair| {
+        pair[0]
+            .0
+            .checked_add(pair[0].1)
+            .is_some_and(|end| end <= pair[1].0)
     })
 }
 
