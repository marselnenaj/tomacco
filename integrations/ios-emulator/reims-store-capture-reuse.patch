+/// The render Store's readback serves the present capture that follows it —
+/// the same bytes a fresh capture reads — and only while nothing can have
+/// changed the resident in between.
+///
+/// An RGBA16F front at a size that takes the banded conversion, seeded with
+/// every class of half float. Each round plays the Store's half by hand (the
+/// witnessed readback, the stash, the stamp the Store's `finish` makes, the
+/// seal) and then the present's (`store_capture::take`):
+///
+/// - untouched: the stash is taken, and equals both the in-place capture and
+///   the copying capture byte for byte, figures included; it is taken once;
+/// - a draw into the resident between Store and present: refused, and the
+///   fresh capture shows the draw's pixels, not the stash's;
+/// - a draw into another resident: refused all the same (the GPU ran work);
+/// - another readback: refused (a submission);
+/// - the mapping's epoch moved: refused; an unsealed stash: refused; another
+///   incarnation of the mapping: refused.
+///
+/// Fails on a tree without the reuse (no `store_capture`), on any byte the
+/// stash converts differently from the capture, and on any write it lets
+/// through.
+#[test]
+fn the_stores_readback_serves_the_present_only_while_nothing_touched_the_resident() {
+    use engine::store_capture::{self, Fresh};
+    use reims_vgpu_core::blend::ColorWriteMask;
+    use reims_vgpu_protocol::pixel_format::{ColorLoadSeed, TexelLayout, MTL_FORMAT_RGBA16_FLOAT};
+    let _g = engine_test_session();
+    let (v, f) = triangle_spirv();
+    let (w, h) = (613u32, 431u32);
+    let pixels = (w * h) as usize;
+    let need = pixels * 4;
+    let specials = [
+        0x0000u16, 0x8000, 0x0001, 0x03ff, 0x0400, 0x3800, 0x3801, 0x37ff, 0x3c00, 0x3c01, 0x7bff,
+        0x7c00, 0xfc00, 0x7e00, 0xfe01, 0xbc00, 0x2e66, 0x1c00,
+    ];
+    let words = |mut state: u32| -> Vec<u8> {
+        (0..pixels * 4)
+            .map(|i| {
+                state = state.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+                if i % 7 == 0 {
+                    specials[(state >> 20) as usize % specials.len()]
+                } else {
+                    (state >> 16) as u16
+                }
+            })
+            .flat_map(|w| w.to_le_bytes())
+            .collect()
+    };
+    let front = TargetIdentity::Surface {
+        id: 0x7310,
+        width: w,
+        height: h,
+        generation: 1,
+        format: ash::vk::Format::R16G16B16A16_SFLOAT,
+    };
+    let other = TargetIdentity::Surface {
+        id: 0x7311,
+        width: w,
+        height: h,
+        generation: 1,
+        format: ash::vk::Format::R16G16B16A16_SFLOAT,
+    };
+    // Write `raw` into a resident: a CPU seed, then a draw that writes nothing.
+    let seed = |identity: &TargetIdentity, raw: Vec<u8>| {
+        let mut req = engine_req(&v, &f, w, h);
+        req.target_identity = Some(identity.clone());
+        req.color_attachment = Some(color_attachment(MTL_FORMAT_RGBA16_FLOAT, [0.0; 4]));
+        req.target_cpu_seed = Some(ColorLoadSeed {
+            pixels: std::sync::Arc::new(raw),
+            layout: TexelLayout::Rgba16Float,
+        });
+        req.skip_readback = true;
+        req.color_write_mask = ColorWriteMask::NONE;
+        engine::execute_draw_request(engine_device(), &req)
+    };
+    match seed(&front, words(0x2545_f491)) {
+        Ok(_) => {}
+        Err(e) if skip_if_no_gpu(&e.to_string()) => {
+            eprintln!("SKIP store capture reuse: {e}");
+            return;
+        }
+        Err(e) => panic!("RGBA16F front seed: {e}"),
+    }
+    // The Store's half: the readback it lands the guest with, converted on the
+    // way, then the stamp its `finish` makes and the seal after it.
+    let store = |epoch: u32| {
+        let (texels, witness) =
+            engine::read_target_texels_consumable_witnessed(&front).expect("Store readback");
+        assert_eq!(witness.identity(), &front);
+        assert!(store_capture::stash(witness, &texels), "stash");
+        drop(texels);
+        assert!(engine::stamp_resident_content_epoch(&front, epoch), "stamp");
+        assert!(store_capture::seal(&front, epoch), "seal");
+    };
+    let fresh = || {
+        let mut dst = vec![0x5au8; need];
+        let stats = engine::capture_resident_bgra_into(&front, &mut dst).expect("fresh capture");
+        (dst, stats)
+    };
+
+    // Untouched: the stash is the fresh capture, and the copying capture.
+    store(5);
+    let reused = store_capture::take(&front, Some(5), need).expect("an untouched resident reuses");
+    let (now, stats) = fresh();
+    assert!(
+        reused.bgra == now,
+        "reused bytes differ from a fresh capture"
+    );
+    assert_eq!(reused.stats, stats, "reused figures");
+    let copied = engine::read_resident_bgra(&front, need).expect("copying capture");
+    assert!(
+        copied == now,
+        "fresh capture differs from the copying capture"
+    );
+    // A stash is taken once.
+    assert_eq!(
+        store_capture::take(&front, Some(5), need).err(),
+        Some(Fresh::Nothing)
+    );
+
+    // A draw into the resident between the Store and the present.
+    store(6);
+    seed(&front, words(0x0bad_cafe)).expect("rewrite the front");
+    let why = store_capture::take(&front, Some(6), need).err();
+    assert!(
+        matches!(
+            why,
+            Some(Fresh::ResidentRewritten | Fresh::Submitted | Fresh::Recording)
+        ),
+        "a write to the resident must force a fresh readback: {why:?}"
+    );
+    let (rewritten, _) = fresh();
+    assert!(
+        rewritten != reused.bgra,
+        "the fresh capture shows the new draw"
+    );
+
+    // A draw into another resident: the GPU ran work, so no proof is left.
+    store(7);
+    seed(&other, words(0x1234_5678)).expect("draw elsewhere");
+    let why = store_capture::take(&front, Some(7), need).err();
+    assert!(
+        matches!(why, Some(Fresh::Submitted | Fresh::Recording)),
+        "any GPU work since the Store forces a fresh readback: {why:?}"
+    );
+    assert!(fresh().0 == rewritten, "the front itself is unchanged");
+
+    // Another readback of the front is a submission too.
+    store(8);
+    engine::read_target_texels(&front).expect("another readback");
+    assert_eq!(
+        store_capture::take(&front, Some(8), need).err(),
+        Some(Fresh::Submitted)
+    );
+
+    // The mapping's epoch moved on (a guest or host write to the mapping).
+    store(9);
+    assert_eq!(
+        store_capture::take(&front, Some(10), need).err(),
+        Some(Fresh::MappingWritten)
+    );
+
+    // A Store that never sealed (it failed after its readback).
+    let (texels, witness) = engine::read_target_texels_consumable_witnessed(&front).unwrap();
+    assert!(store_capture::stash(witness, &texels));
+    drop(texels);
+    assert_eq!(
+        store_capture::take(&front, Some(9), need).err(),
+        Some(Fresh::Unsealed)
+    );
+
+    // Another incarnation of the same mapping, and another length.
+    store(11);
+    let next = TargetIdentity::Surface {
+        id: 0x7310,
+        width: w,
+        height: h,
+        generation: 2,
+        format: ash::vk::Format::R16G16B16A16_SFLOAT,
+    };
+    assert_eq!(
+        store_capture::take(&next, Some(11), need).err(),
+        Some(Fresh::Identity)
+    );
+    store(12);
+    assert_eq!(
+        store_capture::take(&front, Some(12), need - 4).err(),
+        Some(Fresh::Length)
+    );
+
+    // And after every refusal, the reuse comes back for an untouched resident.
+    store(13);
+    let again = store_capture::take(&front, Some(13), need).expect("reuse resumes");
+    assert!(again.bgra == fresh().0, "reused bytes after refusals");
+}
