+/// Every submission this device has handed to its one graphics queue — guest
+/// work (synchronous and batched), ordered queue work (readbacks, writebacks)
+/// and window present transactions — counted when it is handed over, before
+/// the driver or the queue owner sees it, and whether or not it then succeeds.
+///
+/// The four `DeviceContext` methods that bump it are the only callers of
+/// `vkQueueSubmit` and of the queue owner's submit entries, and this device
+/// creates one `VkDevice` with one queue. So two equal readings of this count
+/// bracket an interval in which the GPU was given nothing to execute: any
+/// resident image read back at the first reading, after a fence that waited for
+/// everything queued before it, still holds exactly those bytes at the second
+/// — unless commands were recorded and not yet submitted, which the open batch
+/// answers and [`super::store_capture`] asks separately.
+///
+/// Process-global because the engine is: one `EngineState` behind one lock.
+static QUEUE_SUBMISSIONS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn note_queue_submission() {
+    QUEUE_SUBMISSIONS.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+}
+
+/// [`QUEUE_SUBMISSIONS`] now.
+pub(crate) fn queue_submissions() -> u64 {
+    QUEUE_SUBMISSIONS.load(std::sync::atomic::Ordering::SeqCst)
+}
