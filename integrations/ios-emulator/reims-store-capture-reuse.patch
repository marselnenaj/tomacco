index 0000000..ee2d279
--- /dev/null
+++ i/reims-vgpu/crates/reims-vgpu/src/backend/vulkan/engine/store_capture.rs
@@ -0,0 +1,642 @@
+//! One readback per frame, where there used to be two.
+//!
+//! # What it removes
+//!
+//! On a host whose window does not carry the frame, every frame of the iOS
+//! compositor read its RGBA16F front surface — 1206x2622, 25 MB of half floats —
+//! back from the GPU twice. The render Store read it to land the guest's pages
+//! (`store_native_float_surface`, `native_float_readback_us` ~9 ms a frame on
+//! in a profile), and the present capture that followed read the same resident
+//! again with its own submission and fence to fill the retained BGRA8 frame
+//! (`capture_resident_bgra_into`). Nothing ran between the two: the second
+//! readback copied bytes the first had just delivered, and paid another GPU
+//! round trip for them — 1-2 ms on an idle GPU, 6-10 ms on one another process
+//! keeps busy.
+//!
+//! Now the Store, when the surface is one the display presented recently,
+//! converts the readback it already holds into BGRA8 on its way to the guest
+//! ([`stash`]), with the same conversion the present capture runs
+//! ([`super::texels_into_bgra`]), and seals it with the epoch it vouched for the
+//! resident at ([`seal`]). The present capture of that resident takes the bytes
+//! ([`take`]) instead of reading the resident again — when, and only when, it
+//! can prove they are what that second readback would return.
+//!
+//! # Why the bytes are the second readback's
+//!
+//! A readback returns the resident image's contents at the point in queue order
+//! where its copy runs, after a fence that waited for everything queued before
+//! it. The reused bytes are the Store readback's, converted by the function the
+//! present capture converts with. So they equal a fresh capture exactly when
+//! the resident image holds the same contents at the present as at the Store's
+//! copy, and the fresh capture would read that same image. [`judge`] accepts
+//! only when every way that could fail is excluded:
+//!
+//! - **The same image.** The present asks for the identity the Store read (the
+//!   mapping, its incarnation, extent and format), the registry still holds a
+//!   slot at it, and that slot names the same `VkImage`, declared format and
+//!   extent, single-sampled, content-ready. A recycled or recreated resident
+//!   cannot pass as the one that was read.
+//! - **Nothing executed on the GPU since.** [`super::context::queue_submissions`]
+//!   counts every handover to the device's one queue — the only way any command
+//!   reaches the GPU — and the witness took it under the engine lock that also
+//!   covered the copy and its fence. Equal at the present, the GPU has been
+//!   given nothing at all since the copy, so no draw, blit, clear, seed, compute
+//!   dispatch or GPU writeback can have written the image, whichever rail
+//!   recorded it and whatever registry bookkeeping it did or did not do.
+//! - **Nothing recorded and waiting.** A fresh readback would append to an open
+//!   draw batch and submit it, so it would see draws recorded since the Store
+//!   that the GPU has not run yet. Any recording batch refuses.
+//! - **Not host-visible memory.** A guest-imported resident is the guest's own
+//!   pages, which a CPU can change with no submission at all. Refused.
+//! - **The registry still vouches for it.** [`seal`] records the epoch the
+//!   Store stamped the resident with (`stamp_resident_content_epoch`, the
+//!   mapping's `surface_content_epoch` after its write). The present requires
+//!   the resident's stamp and the mapping's epoch both still at that value. A
+//!   draw recorded into the resident clears its stamp, and a guest or host
+//!   write to the mapping advances the epoch, so either sends the capture back
+//!   to the GPU even though neither alone could change what a readback returns
+//!   without a submission. A Store that failed after its readback never seals,
+//!   and an unsealed stash is never taken.
+//!
+//! Every refusal is the old rail, not a loss: the capture reads the resident
+//! as it did before, and the census says why (`present_capture_fresh_<why>`).
+//! A stash is taken at most once.
+//!
+//! # Lock order
+//!
+//! The stash mutex is taken before the engine lock wherever both are held, and
+//! [`stash`] — called while the Store holds a staging lease — takes no engine
+//! lock at all (the [`super::ConsumableTargetTexels`] rule).
+
+use super::{ConsumableTargetTexels, TargetIdentity};
+use ash::vk;
+use parking_lot::Mutex;
+
+/// What a readback saw, captured under the lock that covered the copy.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ReadWitness {
+    identity: TargetIdentity,
+    image: vk::Image,
+    format: vk::Format,
+    width: u32,
+    height: u32,
+    submissions: u64,
+}
+
+impl ReadWitness {
+    pub(crate) fn taken(
+        identity: &TargetIdentity,
+        image: vk::Image,
+        format: vk::Format,
+        width: u32,
+        height: u32,
+        submissions: u64,
+    ) -> Self {
+        ReadWitness {
+            identity: identity.clone(),
+            image,
+            format,
+            width,
+            height,
+            submissions,
+        }
+    }
+
+    /// The identity the readback was asked for.
+    pub fn identity(&self) -> &TargetIdentity {
+        &self.identity
+    }
+
+    /// The queue-submission count right after the readback's fence.
+    pub fn submissions(&self) -> u64 {
+        self.submissions
+    }
+}
+
+/// The resident as the registry describes it at the present.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct ResidentNow {
+    pub image: vk::Image,
+    pub format: vk::Format,
+    pub width: u32,
+    pub height: u32,
+    pub sample_count: u32,
+    pub content_ready: bool,
+    pub guest_imported: bool,
+    pub content_epoch: Option<u32>,
+}
+
+/// Why a present capture read its resident back instead of taking the stash.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Fresh {
+    /// [`crate::config::STORE_CAPTURE_REUSE`] is off.
+    Disabled,
+    /// No Store stashed a frame since the last present took or refused one.
+    Nothing,
+    /// The stash is another resident's (another mapping, incarnation, extent
+    /// or format).
+    Identity,
+    /// The Store that stashed it did not finish: no epoch was sealed.
+    Unsealed,
+    /// No resident at this identity any more.
+    Absent,
+    /// A resident is there, but not the image (or extent, format, sample
+    /// count) that was read.
+    Replaced,
+    /// The resident holds no ready content.
+    NotReady,
+    /// Guest-imported memory: host writes need no submission.
+    GuestImported,
+    /// The resident's content stamp moved off the sealed epoch: a draw since.
+    ResidentRewritten,
+    /// The mapping's epoch moved off the sealed epoch: a write since.
+    MappingWritten,
+    /// GPU work was submitted since the readback.
+    Submitted,
+    /// Commands are recorded and not yet submitted.
+    Recording,
+    /// The present asks for another number of bytes than the stash holds.
+    Length,
+}
+
+impl Fresh {
+    /// The census name, one per reason.
+    pub fn census(self) -> &'static str {
+        match self {
+            Fresh::Disabled => "present_capture_fresh_disabled",
+            Fresh::Nothing => "present_capture_fresh_nothing",
+            Fresh::Identity => "present_capture_fresh_identity",
+            Fresh::Unsealed => "present_capture_fresh_unsealed",
+            Fresh::Absent => "present_capture_fresh_absent",
+            Fresh::Replaced => "present_capture_fresh_replaced",
+            Fresh::NotReady => "present_capture_fresh_not_ready",
+            Fresh::GuestImported => "present_capture_fresh_guest_imported",
+            Fresh::ResidentRewritten => "present_capture_fresh_resident_rewritten",
+            Fresh::MappingWritten => "present_capture_fresh_mapping_written",
+            Fresh::Submitted => "present_capture_fresh_submitted",
+            Fresh::Recording => "present_capture_fresh_recording",
+            Fresh::Length => "present_capture_fresh_length",
+        }
+    }
+
+    #[cfg(test)]
+    const ALL: [Fresh; 13] = [
+        Fresh::Disabled,
+        Fresh::Nothing,
+        Fresh::Identity,
+        Fresh::Unsealed,
+        Fresh::Absent,
+        Fresh::Replaced,
+        Fresh::NotReady,
+        Fresh::GuestImported,
+        Fresh::ResidentRewritten,
+        Fresh::MappingWritten,
+        Fresh::Submitted,
+        Fresh::Recording,
+        Fresh::Length,
+    ];
+}
+
+/// The decision, with every input passed in, so a test reaches each refusal.
+///
+/// `sealed` is the epoch [`seal`] recorded, `now` the registry's slot at the
+/// asked identity, `mapping_epoch` the mapping's `surface_content_epoch`,
+/// `submissions` and `recording` the queue count and open-batch state at the
+/// present, `held` the stash's byte count and `need` the present's.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn judge(
+    witness: &ReadWitness,
+    sealed: Option<u32>,
+    asked: &TargetIdentity,
+    now: Option<ResidentNow>,
+    mapping_epoch: Option<u32>,
+    submissions: u64,
+    recording: bool,
+    held: usize,
+    need: usize,
+) -> Result<(), Fresh> {
+    if &witness.identity != asked {
+        return Err(Fresh::Identity);
+    }
+    let Some(sealed) = sealed else {
+        return Err(Fresh::Unsealed);
+    };
+    let Some(now) = now else {
+        return Err(Fresh::Absent);
+    };
+    if now.image != witness.image
+        || now.format != witness.format
+        || now.width != witness.width
+        || now.height != witness.height
+        || now.sample_count != 1
+    {
+        return Err(Fresh::Replaced);
+    }
+    if !now.content_ready {
+        return Err(Fresh::NotReady);
+    }
+    if now.guest_imported {
+        return Err(Fresh::GuestImported);
+    }
+    if now.content_epoch != Some(sealed) {
+        return Err(Fresh::ResidentRewritten);
+    }
+    if mapping_epoch != Some(sealed) {
+        return Err(Fresh::MappingWritten);
+    }
+    if submissions != witness.submissions {
+        return Err(Fresh::Submitted);
+    }
+    if recording {
+        return Err(Fresh::Recording);
+    }
+    if held != need {
+        return Err(Fresh::Length);
+    }
+    Ok(())
+}
+
+/// One converted frame, waiting for its present.
+struct Stash {
+    witness: ReadWitness,
+    sealed: Option<u32>,
+    bgra: Vec<u8>,
+    stats: (usize, u8, [u8; 4]),
+}
+
+/// How many recent present captures the Store asks about. A compositor cycles
+/// two or three buffers; four covers that with one to spare.
+const RECENT_PRESENTS: usize = 4;
+
+struct Shelf {
+    stash: Option<Stash>,
+    /// A buffer to convert the next Store into: the present's previous scratch
+    /// once a present took a stash, so the steady state allocates nothing.
+    spare: Vec<u8>,
+    recent: [(u32, u32, u32); RECENT_PRESENTS],
+    next: usize,
+}
+
+static SHELF: Mutex<Shelf> = Mutex::new(Shelf {
+    stash: None,
+    spare: Vec::new(),
+    recent: [(0, 0, 0); RECENT_PRESENTS],
+    next: 0,
+});
+
+/// Whether [`crate::config::STORE_CAPTURE_REUSE`] is switched off, read once.
+pub fn disabled() -> bool {
+    use std::sync::OnceLock;
+    static OFF: OnceLock<bool> = OnceLock::new();
+    *OFF.get_or_init(|| {
+        let (state, value) = crate::config::read(crate::config::STORE_CAPTURE_REUSE);
+        match state {
+            crate::config::Switch::Off => {
+                crate::observe::off("store_capture reason=store_capture_reuse_disabled_by_env");
+                true
+            }
+            crate::config::Switch::Unrecognized => {
+                crate::observe::fail(format!(
+                    "store_capture reason=store_capture_reuse_env_unrecognized value={}",
+                    value.unwrap_or_default()
+                ));
+                false
+            }
+            crate::config::Switch::On | crate::config::Switch::Unset => false,
+        }
+    })
+}
+
+/// A present capture of `mapping` at this geometry is about to run.
+pub fn note_presented(mapping: u32, width: u32, height: u32) {
+    let mut shelf = SHELF.lock();
+    let entry = (mapping, width, height);
+    if shelf.recent.contains(&entry) {
+        return;
+    }
+    let at = shelf.next;
+    shelf.recent[at] = entry;
+    shelf.next = (at + 1) % RECENT_PRESENTS;
+}
+
+/// Whether a present capture of `mapping` at this geometry ran recently — the
+/// Store's test for whether converting its readback is likely to be used.
+pub fn presented_recently(mapping: u32, width: u32, height: u32) -> bool {
+    mapping != 0 && SHELF.lock().recent.contains(&(mapping, width, height))
+}
+
+/// Convert the Store's readback into the stash, replacing any earlier one.
+///
+/// Takes no engine lock: the caller holds the staging lease. `false` (and no
+/// stash) when the conversion refuses — the present then reads back as before.
+pub fn stash(witness: ReadWitness, texels: &ConsumableTargetTexels) -> bool {
+    let need = (witness.width as usize)
+        .saturating_mul(witness.height as usize)
+        .saturating_mul(crate::protocol::pixel_format::RGBA8_BPP as usize);
+    let mut shelf = SHELF.lock();
+    let mut bgra = match shelf.stash.take() {
+        Some(old) => old.bgra,
+        None => std::mem::take(&mut shelf.spare),
+    };
+    drop(shelf);
+    bgra.clear();
+    bgra.resize(need, 0);
+    let started = std::time::Instant::now();
+    let stats = super::texels_into_bgra(texels, &mut bgra, &|_| {});
+    let mut shelf = SHELF.lock();
+    match stats {
+        Some(stats) if need != 0 => {
+            crate::runtime::drain::note_store_route_us(
+                "store_capture_convert_us",
+                started.elapsed().as_micros() as u64,
+            );
+            crate::runtime::drain::note_store_route("store_capture_stashed_n");
+            shelf.stash = Some(Stash {
+                witness,
+                sealed: None,
+                bgra,
+                stats,
+            });
+            true
+        }
+        _ => {
+            crate::runtime::drain::note_store_route("store_capture_convert_refused_n");
+            shelf.spare = bgra;
+            false
+        }
+    }
+}
+
+/// The Store landed and stamped `identity` with `epoch`: the stash may serve.
+///
+/// Seals only a stash for this identity, and only while the resident really
+/// carries that stamp; otherwise the stash is dropped.
+pub fn seal(identity: &TargetIdentity, epoch: u32) -> bool {
+    let stamped = super::resident_content_state(identity) == super::ResidentContent::Epoch(epoch);
+    let mut shelf = SHELF.lock();
+    let Some(stash) = shelf.stash.as_mut() else {
+        return false;
+    };
+    if &stash.witness.identity != identity {
+        return false;
+    }
+    if !stamped {
+        let dropped = shelf.stash.take().map(|s| s.bgra).unwrap_or_default();
+        shelf.spare = dropped;
+        crate::runtime::drain::note_store_route("store_capture_seal_refused_n");
+        return false;
+    }
+    stash.sealed = Some(epoch);
+    crate::runtime::drain::note_store_route("store_capture_sealed_n");
+    true
+}
+
+/// Drop any stash (a Store of this identity failed after stashing).
+pub fn discard(identity: &TargetIdentity) {
+    let mut shelf = SHELF.lock();
+    if shelf
+        .stash
+        .as_ref()
+        .is_some_and(|s| &s.witness.identity == identity)
+    {
+        let dropped = shelf.stash.take().map(|s| s.bgra).unwrap_or_default();
+        shelf.spare = dropped;
+    }
+}
+
+/// A stashed frame handed to a present.
+pub struct Reused {
+    pub bgra: Vec<u8>,
+    pub stats: (usize, u8, [u8; 4]),
+}
+
+/// Take the stash for a present of `identity` needing `need` bytes, or say why
+/// the present must read the resident back. The stash is consumed either way.
+pub fn take(
+    identity: &TargetIdentity,
+    mapping_epoch: Option<u32>,
+    need: usize,
+) -> Result<Reused, Fresh> {
+    if disabled() {
+        return Err(Fresh::Disabled);
+    }
+    let mut shelf = SHELF.lock();
+    let Some(stash) = shelf.stash.take() else {
+        return Err(Fresh::Nothing);
+    };
+    // Stash before engine: the order every holder of both takes them in.
+    let verdict = {
+        let guard = super::lock_engine();
+        let now = guard.pools.registry_get(identity).map(|slot| ResidentNow {
+            image: slot.image,
+            format: slot.format.declared(),
+            width: slot.width,
+            height: slot.height,
+            sample_count: slot.sample_count,
+            content_ready: slot.content_ready,
+            guest_imported: slot.memory.is_guest_imported(),
+            content_epoch: slot.content_epoch,
+        });
+        let recording = guard.pools.batch_open_recording().is_some();
+        judge(
+            &stash.witness,
+            stash.sealed,
+            identity,
+            now,
+            mapping_epoch,
+            super::context::queue_submissions(),
+            recording,
+            stash.bgra.len(),
+            need,
+        )
+    };
+    match verdict {
+        Ok(()) => Ok(Reused {
+            bgra: stash.bgra,
+            stats: stash.stats,
+        }),
+        Err(why) => {
+            shelf.spare = stash.bgra;
+            Err(why)
+        }
+    }
+}
+
+/// Return a buffer for the next Store to convert into.
+pub fn give_back(buffer: Vec<u8>) {
+    let mut shelf = SHELF.lock();
+    if shelf.spare.capacity() < buffer.capacity() {
+        shelf.spare = buffer;
+    }
+}
