+
+/// A large native Store into a page list scattered across guest RAM, with a
+/// reader of the same source running beside the copy: the reader sees the
+/// whole source, and the guest's pages end up exactly as the copy alone leaves
+/// them — every row at its own offset, the inter-row padding untouched.
+#[test]
+fn a_large_native_store_beside_its_reader_lands_every_row_and_no_padding() {
+    use crate::model::PAGE_SHIFT_X86;
+    use crate::protocol::pixel_format::MTL_FORMAT_RGBA16_FLOAT;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_X86);
+    let mut host = FakeHost::new();
+    let page = 1u64 << PAGE_SHIFT_X86;
+    // 1000x1100 RGBA16F: 8000-byte rows on a wider pitch, 8.8 MB.
+    let (w, h) = (1000u32, 1100u32);
+    let tight = w as usize * 8;
+    let base = 0x4000_0000u64;
+    let pages = (tight * h as usize * 2) / page as usize;
+    host.map_range(base, pages * page as usize, 0xee);
+    // Every page somewhere else in RAM, as a long-lived surface's pages are.
+    let mut order: Vec<u64> = (0..pages as u64).collect();
+    for i in 0..pages {
+        order.swap(i, (i * 7 + 3) % pages);
+    }
+    let mid = 21u32;
+    state.map_surface(mid);
+    {
+        let m = state.mappings.get_mut(&mid).unwrap();
+        m.mapped = true;
+        m.mapping_internal = 0;
+        m.page_entries = order
+            .iter()
+            .map(|n| {
+                ((((base + n * page) >> PAGE_SHIFT_X86) as u32) << PAGE_ENTRY_PFN_SHIFT)
+                    | PAGE_ENTRY_VALID
+            })
+            .collect();
+    }
+    assert!(state.set_mapping_geom(mid, w, h, MTL_FORMAT_RGBA16_FLOAT));
+    let (offset, stride, _) = {
+        let m = state.mappings.get(&mid).unwrap();
+        mapper_ref_texture_sample_window(m, w, h, MTL_FORMAT_RGBA16_FLOAT).unwrap()
+    };
+    let src: Vec<u8> = (0..tight * h as usize)
+        .map(|i| (i as u32).wrapping_mul(2_654_435_761).rotate_right(13) as u8)
+        .collect();
+    let want_sum: u64 = src.iter().map(|&b| u64::from(b)).sum();
+    let target = {
+        let m = state.mappings.get(&mid).unwrap();
+        NativeImageWriteTarget::capture(mid, m, w, h, MTL_FORMAT_RGBA16_FLOAT).unwrap()
+    };
+    let plan = target.prepared_source_plan(&state, &mut host).unwrap();
+    let writer = prepare_native_image_write(&mut state, &mut host, target, plan).unwrap();
+    let seen = AtomicU64::new(0);
+    let side = |bytes: &[u8]| {
+        seen.store(bytes.iter().map(|&b| u64::from(b)).sum(), Ordering::Relaxed);
+    };
+    assert_eq!(
+        writer
+            .write_from_alongside(src.clone(), Some(side))
+            .unwrap(),
+        src.len()
+    );
+    assert_eq!(
+        seen.load(Ordering::Relaxed),
+        want_sum,
+        "the reader saw the whole source"
+    );
+    // Read the span back through the page list and compare row by row.
+    let stride = stride as usize;
+    let span = stride * (h as usize - 1) + tight;
+    let mut guest = vec![0u8; span];
+    let first = offset as usize;
+    let mut at = 0usize;
+    while at < span {
+        let logical = first + at;
+        let (index, within) = (logical / page as usize, logical % page as usize);
+        let len = (page as usize - within).min(span - at);
+        let gpa = base + order[index] * page + within as u64;
+        host.read_gpa(gpa, &mut guest[at..at + len]).unwrap();
+        at += len;
+    }
+    for row in 0..h as usize {
+        let got = &guest[row * stride..row * stride + tight];
+        assert!(
+            got == &src[row * tight..(row + 1) * tight],
+            "row {row} differs"
+        );
+        if row + 1 < h as usize {
+            assert!(
+                guest[row * stride + tight..(row + 1) * stride]
+                    .iter()
+                    .all(|&b| b == 0xee),
+                "padding after row {row} was written"
+            );
+        }
+    }
+}
