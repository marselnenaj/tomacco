+/// Timing, not a check: `cargo test --release -- --ignored --nocapture
+/// store_overlap_timing`. The render Store of the vphone's front surface
+/// (1206x2622 RGBA16F, 16 KiB pages scattered through guest RAM) with the
+/// present conversion first and the publish after it, as before, against the
+/// two side by side. Median of 21 runs each; wall clock on a shared host.
+#[cfg(feature = "backend-vulkan")]
+#[test]
+#[ignore]
+fn store_overlap_timing() {
+    use crate::backend::vulkan::engine::{readback_bytes_into_bgra, ReadbackTexel};
+    use crate::protocol::pixel_format::{TexelLayout, MTL_FORMAT_RGBA16_FLOAT};
+    struct Borrowed<'a>(&'a [u8]);
+    impl NativeImageSource for Borrowed<'_> {
+        fn native_bytes(&self) -> &[u8] {
+            self.0
+        }
+    }
+    let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_ARM64E);
+    let mut host = FakeHost::new();
+    let page = 1u64 << PAGE_SHIFT_ARM64E;
+    let (w, h) = (1206u32, 2622u32);
+    let tight = w as usize * 8;
+    let base = 0x8000_0000u64;
+    let pages = (tight * h as usize * 3 / 2) / page as usize;
+    host.map_range(base, pages * page as usize, 0);
+    let mut order: Vec<u64> = (0..pages as u64).collect();
+    for i in 0..pages {
+        order.swap(i, (i * 7 + 3) % pages);
+    }
+    let mid = 22u32;
+    state.map_surface(mid);
+    {
+        let m = state.mappings.get_mut(&mid).unwrap();
+        m.mapped = true;
+        m.mapping_internal = 0;
+        m.page_entries = order
+            .iter()
+            .map(|n| {
+                ((((base + n * page) >> PAGE_SHIFT_ARM64E) as u32) << PAGE_ENTRY_PFN_SHIFT)
+                    | PAGE_ENTRY_VALID
+            })
+            .collect();
+    }
+    assert!(state.set_mapping_geom(mid, w, h, MTL_FORMAT_RGBA16_FLOAT));
+    // Half floats in [0, 1], as a composite mostly holds.
+    let src: Vec<u8> = (0..tight * h as usize / 2)
+        .flat_map(|i| (0x2000u16 + (i as u16 % 0x1c00)).to_le_bytes())
+        .collect();
+    let mut bgra = vec![0u8; w as usize * h as usize * 4];
+    let texel = ReadbackTexel::Native(TexelLayout::Rgba16Float);
+    let median = |mut runs: Vec<u128>| {
+        runs.sort_unstable();
+        runs[runs.len() / 2]
+    };
+    let mut run = |overlap: bool, bgra: &mut Vec<u8>| -> u128 {
+        let target = {
+            let m = state.mappings.get(&mid).unwrap();
+            NativeImageWriteTarget::capture(mid, m, w, h, MTL_FORMAT_RGBA16_FLOAT).unwrap()
+        };
+        let plan = target.prepared_source_plan(&state, &mut host).unwrap();
+        let writer = prepare_native_image_write(&mut state, &mut host, target, plan).unwrap();
+        let started = std::time::Instant::now();
+        let mut convert = |bytes: &[u8]| {
+            assert!(readback_bytes_into_bgra(texel, bytes, bgra, &|_| {}).is_some());
+        };
+        if overlap {
+            writer
+                .write_from_alongside(Borrowed(&src), Some(convert))
+                .unwrap();
+        } else {
+            convert(&src);
+            writer.write_from(Borrowed(&src)).unwrap();
+        }
+        started.elapsed().as_micros()
+    };
+    let convert_alone: Vec<u128> = (0..21)
+        .map(|_| {
+            let started = std::time::Instant::now();
+            assert!(readback_bytes_into_bgra(texel, &src, &mut bgra, &|_| {}).is_some());
+            started.elapsed().as_micros()
+        })
+        .collect();
+    println!(
+        "store_overlap_timing convert_alone median_us={}",
+        median(convert_alone)
+    );
+    for overlap in [false, true, false, true] {
+        let runs: Vec<u128> = (0..21).map(|_| run(overlap, &mut bgra)).collect();
+        println!(
+            "store_overlap_timing overlap={overlap} median_us={}",
+            median(runs)
+        );
+    }
+}
