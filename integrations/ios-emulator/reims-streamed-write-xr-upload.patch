+
+/// Scalar decoding performed in this one upload. Adjacent reuse never names
+/// a guest resource or persists beyond these original source bytes.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct XrUploadWork {
+    pub decoded_texels: u64,
+    pub reused_texels: u64,
+}
+
+/// One preallocated output; one expanded texel cached on the stack. Keys are
+/// immutable original storage bytes, including both planes on planar routes.
+struct XrUploadBuilder<'a> {
+    bytes: Vec<u8>,
+    previous: Option<(&'a [u8], &'a [u8])>,
+    expanded: [u8; 16],
+    work: XrUploadWork,
+}
+
+impl<'a> XrUploadBuilder<'a> {
+    fn new(length: usize) -> Result<Self, SampledUploadRefusal> {
+        let mut bytes = Vec::new();
+        bytes
+            .try_reserve_exact(length)
+            .map_err(|_| SampledUploadRefusal::AllocationFailed)?;
+        Ok(Self {
+            bytes,
+            previous: None,
+            expanded: [0; 16],
+            work: XrUploadWork::default(),
+        })
+    }
+
+    fn append(
+        &mut self,
+        key: (&'a [u8], &'a [u8]),
+        decode: impl FnOnce() -> Result<[f32; 4], SampledUploadRefusal>,
+    ) -> Result<(), SampledUploadRefusal> {
+        if self.previous == Some(key) {
+            self.work.reused_texels += 1;
+        } else {
+            let values = decode()?;
+            for (lane, value) in self.expanded.chunks_exact_mut(4).zip(values) {
+                lane.copy_from_slice(&value.to_le_bytes());
+            }
+            self.previous = Some(key);
+            self.work.decoded_texels += 1;
+        }
+        self.bytes.extend_from_slice(&self.expanded);
+        Ok(())
+    }
+
+    fn finish(self) -> SampledUpload {
+        SampledUpload {
+            format: StorageImageFormat::Rgba32Float,
+            bytes: self.bytes,
+            work: Some(self.work),
+        }
+    }
 }
 
