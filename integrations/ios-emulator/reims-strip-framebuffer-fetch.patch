+//! Preserve triangle-strip parity while ordering framebuffer fetch primitives.
+//!
+//! An even triangle is a three-index strip. An odd triangle receives one
+//! duplicate prefix index: its first triangle is degenerate and its second
+//! has the original odd winding, vertex ordering and provoking vertex.
+//! PrimitiveId is refused by the shared fetch admission check. This does not
+//! change topology, front-face state, vertex IDs, base vertex or base instance.
+
+use super::draw_execution::DrawExecutionDecline;
+use super::draw_validation::DrawValidationDecline;
+use super::types::{DrawError, DrawRequest, IndexType};
+
+pub(super) struct StripFetchIndices {
+    pub(super) bytes: Vec<u8>,
+    pub(super) primitives: u32,
+    pub(super) vertex_offset: i32,
+}
+
+fn overflow() -> DrawError {
+    DrawError::DrawValidation(DrawValidationDecline::ColorInputDrawRangeOverflow)
+}
+
+impl StripFetchIndices {
+    /// The u32 firstIndex domain bounds the entire generated index sequence.
+    pub(super) fn shape(req: &DrawRequest) -> Result<(u32, u32), DrawError> {
+        let count = req
+            .indexed
+            .as_ref()
+            .map_or(req.vertex_count, |i| i.index_count);
+        let primitives = count.saturating_sub(2);
+        let indices = primitives
+            .checked_mul(3)
+            .and_then(|n| n.checked_add(primitives / 2))
+            .ok_or_else(overflow)?;
+        Ok((primitives, indices))
+    }
+
+    /// Called after validate_v1 has checked index length and guest-run coverage.
+    /// Snapshot once before recording GPU work, never once per primitive.
+    pub(super) fn from_validated(req: &DrawRequest) -> Result<Self, DrawError> {
+        let (primitives, indices) = Self::shape(req)?;
+        let byte_len = (indices as usize).checked_mul(4).ok_or_else(overflow)?;
+        let mut bytes = Vec::new();
+        bytes.try_reserve_exact(byte_len).map_err(|_| {
+            DrawError::DrawExecution(DrawExecutionDecline::ColorInputIndexAllocation {
+                bytes: byte_len,
+            })
+        })?;
+        let source = req
+            .indexed
+            .as_ref()
+            .map(|i| i.content.try_cpu_bytes())
+            .transpose()
+            .map_err(|_| {
+                DrawError::DrawExecution(DrawExecutionDecline::ColorInputIndexAllocation {
+                    bytes: req.indexed.as_ref().map_or(0, |i| i.content.len()),
+                })
+            })?;
+        let index_at = |position: u32| -> Result<u32, DrawError> {
+            let Some(indexed) = &req.indexed else {
+                return req.first_vertex.checked_add(position).ok_or_else(overflow);
+            };
+            let source = source
+                .as_ref()
+                .expect("indexed request retains its snapshot");
+            let start = (position as usize)
+                .checked_mul(indexed.index_type.byte_size())
+                .ok_or_else(overflow)?;
+            let end = start
+                .checked_add(indexed.index_type.byte_size())
+                .ok_or_else(overflow)?;
+            let value = source.get(start..end).ok_or_else(|| {
+                DrawError::DrawValidation(DrawValidationDecline::IndexBytesShort {
+                    actual: source.len(),
+                    expected: end,
+                })
+            })?;
+            Ok(match indexed.index_type {
+                IndexType::U16 => u32::from(u16::from_le_bytes([value[0], value[1]])),
+                IndexType::U32 => u32::from_le_bytes([value[0], value[1], value[2], value[3]]),
+            })
+        };
+        for primitive in 0..primitives {
+            let first = index_at(primitive)?;
+            if primitive & 1 != 0 {
+                bytes.extend_from_slice(&first.to_le_bytes());
+            }
+            bytes.extend_from_slice(&first.to_le_bytes());
+            bytes.extend_from_slice(&index_at(primitive + 1)?.to_le_bytes());
+            bytes.extend_from_slice(&index_at(primitive + 2)?.to_le_bytes());
+        }
+        debug_assert_eq!(bytes.len(), byte_len);
+        Ok(Self {
+            bytes,
+            primitives,
+            vertex_offset: req.indexed.as_ref().map_or(0, |i| i.vertex_offset),
+        })
+    }
+
+    pub(super) fn draw_range(&self, primitive: u32) -> (u32, u32) {
+        debug_assert!(primitive < self.primitives);
+        let odd = primitive & 1;
+        (3 + odd, (primitive / 2) * 7 + odd * 3)
+    }
+}
