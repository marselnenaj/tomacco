+fn an_indexed_strip_restarts_at_the_largest_index() {
+    let _g = engine_test_session();
+    let v = framebuffer_fetch_glsl(
+        "vertex",
+        r#"#version 450
+void main() {
+    vec2 p[8] = vec2[](vec2(-1,-1),vec2(-1,1),vec2(-0.5,-1),vec2(-0.5,1),
+                       vec2(0.5,-1),vec2(0.5,1),vec2(1,-1),vec2(1,1));
+    gl_Position = vec4(gl_VertexIndex < 8 ? p[gl_VertexIndex] : vec2(0), 0, 1);
+}"#,
+    );
+    let f = framebuffer_fetch_glsl(
+        "fragment",
+        r#"#version 450
+layout(location=0) out vec4 color;
+void main() { color = vec4(1, 0, 0, 1); }
+"#,
+    );
+    let (w, h) = (16u32, 16u32);
+    let mut req = engine_req(&v, &f, w, h);
+    req.primitive_topology.0 = reims_vgpu_core::topology::PrimitiveType::TriangleStrip;
+    let indices = [0u16, 1, 2, 3, 0xFFFF, 4, 5, 6, 7];
+    req.vertex_count = indices.len() as u32;
+    req.indexed = Some(IndexedDrawResource {
+        index_type: IndexType::U16,
+        index_count: indices.len() as u32,
+        vertex_offset: 0,
+        content: BufferContent::Bytes(std::sync::Arc::new(
+            indices.iter().flat_map(|i| i.to_le_bytes()).collect(),
+        )),
+    });
+    let Some(px) = draw_or_skip("strip_restart", &req) else {
+        return;
+    };
+    let red = |x: u32, y: u32| {
+        let i = (y * w + x) as usize * 4;
+        px[i] == 255 && px[i + 1] == 0 && px[i + 3] == 255
+    };
+    for y in 0..h {
+        for x in (0..4).chain(12..16) {
+            assert!(red(x, y), "quad pixel ({x},{y}) not drawn");
+        }
+        for x in 5..11 {
+            assert!(
+                !red(x, y),
+                "gap pixel ({x},{y}) drawn: the strip did not restart"
+            );
+        }
+    }
+}
