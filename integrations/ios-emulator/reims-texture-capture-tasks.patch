+/// The ids a list variable names, or why the value was not usable.
+///
+/// Separate from [`Count`] because a list of ids is not a bound: nothing about it
+/// narrows, and `0` is an id rather than a cap that stops the device.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Ids {
+    /// Nothing set.
+    Unset,
+    /// One or more ids, in the order given.
+    Named(Vec<u32>),
+    /// Set to something that is not a comma-separated list of ids, carrying the
+    /// raw text so the refusal can quote what it rejected.
+    Refused(String),
+}
+
+/// Read `name` as one id or a comma-separated list of ids.
+pub fn ids(name: &str) -> Ids {
+    parse_ids(std::env::var_os(name).map(|raw| raw.to_string_lossy().into_owned()))
+}
+
+fn parse_ids(value: Option<String>) -> Ids {
+    let Some(value) = value else {
+        return Ids::Unset;
+    };
+    let trimmed = value.trim();
+    if trimmed.is_empty() {
+        return Ids::Unset;
+    }
+    match trimmed
+        .split(',')
+        .map(|id| id.trim().parse::<u32>())
+        .collect::<Result<Vec<_>, _>>()
+    {
+        Ok(ids) => Ids::Named(ids),
+        Err(_) => Ids::Refused(value),
+    }
+}
+
