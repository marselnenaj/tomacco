+/// Name the SIMD-group intrinsics a translated module calls, once per module.
+///
+/// AIR's simdgroup is 32 lanes and a Vulkan subgroup on this host may be wider;
+/// the translator emulates 32-lane partitions for these calls, so which shaders
+/// depend on that emulation is the question a wrong-but-not-refused frame asks.
+/// Observation only: the names come from the module's string table, the line
+/// carries the emitted SPIR-V word count that `linux_m2v_async done` joins on,
+/// and nothing here changes the translation.
+fn note_simd_intrinsics(air: &[u8], stage: Stage, spirv: &[u8]) {
+    const NEEDLE: &[u8] = b"air.simd";
+    let mut names: Vec<String> = Vec::new();
+    let mut at = 0;
+    while let Some(found) = air[at..].windows(NEEDLE.len()).position(|w| w == NEEDLE) {
+        let start = at + found;
+        let end = air[start..]
+            .iter()
+            .position(|&b| !(b.is_ascii_alphanumeric() || b == b'_' || b == b'.'))
+            .map_or(air.len(), |n| start + n);
+        let name = String::from_utf8_lossy(&air[start..end]).into_owned();
+        if !names.contains(&name) && names.len() < 16 {
+            names.push(name);
+        }
+        at = end.max(start + 1);
+    }
+    if names.is_empty() {
+        return;
+    }
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    air.hash(&mut hasher);
+    if crate::observe::first_sight("m2v_simd_intrinsics", hasher.finish()) {
+        crate::observe::off(format!(
+            "m2v_simd_intrinsics stage={} spv={} names=[{}]",
+            stage_name(stage),
+            spirv.len() / 4,
+            names.join(","),
+        ));
+    }
+}
