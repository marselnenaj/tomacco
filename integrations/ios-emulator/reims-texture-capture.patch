+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Unset, the capture names no task, so every hook's `wants` is a no-op and
+    /// a write leaves no file behind. The test binary never sets the switch.
+    #[test]
+    fn an_unset_switch_captures_nothing() {
+        assert!(std::env::var_os(crate::config::TEXTURE_CAPTURE).is_none());
+        assert!(!wants(0));
+        assert!(!wants(6));
+        write("sample", 6, 1, 1, 1, 1, "Bgra8", &[1, 2, 3, 4]);
+        assert!(rechecks().lock().unwrap().is_empty());
+    }
+}
