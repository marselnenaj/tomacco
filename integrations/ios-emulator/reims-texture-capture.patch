new file mode 100644
index 0000000..3044eef
--- /dev/null
+++ b/reims-vgpu/crates/reims-vgpu/src/runtime/texture_capture.rs
@@ -0,0 +1,394 @@
+//! Write the texels one task's draws sample and store, for offline inspection.
+//!
+//! A diagnostic capture in the sense of `AIR_CAPTURE`: it observes and never
+//! decides. Every draw, bind and Store runs exactly as it does with the switch
+//! unset; a write that fails costs its file and nothing else. It exists because
+//! a frame that renders wrong inside a guest process — an icon whose glyph never
+//! appears — names no failing record: every draw resolves, every Store lands,
+//! and the only evidence of which step lost the content is the content itself.
+//!
+//! [`crate::config::TEXTURE_CAPTURE`] names one guest task. Its sampled sources
+//! (as the bind uploads or reads them) and its render Stores (as the resident
+//! holds them) are written to `<log directory>/texture-capture/`, one raw file
+//! per distinct content, named by sequence, role, ref, pipeline, extent, texel
+//! layout and elapsed milliseconds. A source that binds the same bytes again
+//! under the same ref is written once. The total is bounded by file count and
+//! bytes; reaching either bound is reported once and ends the capture.
+
+use std::collections::HashMap;
+use std::hash::{Hash, Hasher};
+use std::path::PathBuf;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+/// Upper bound on files one process writes.
+const MAX_FILES: u64 = 20_000;
+/// Upper bound on bytes one process writes.
+const MAX_BYTES: u64 = 768 << 20;
+
+struct Capture {
+    directory: PathBuf,
+    task_id: u32,
+}
+
+fn capture() -> Option<&'static Capture> {
+    static CAPTURE: OnceLock<Option<Capture>> = OnceLock::new();
+    CAPTURE
+        .get_or_init(|| {
+            let task_id =
+                match crate::config::count(crate::config::TEXTURE_CAPTURE, u64::from(u32::MAX)) {
+                    crate::config::Count::Unset => return None,
+                    crate::config::Count::Narrowed(task) => task as u32,
+                    crate::config::Count::Refused(value) => {
+                        crate::observe::fail(format!(
+                            "texture_capture reason=task_unreadable value={value:?}"
+                        ));
+                        return None;
+                    }
+                };
+            let crate::config::LogDirectory::Directory(base) = crate::config::log_directory()
+            else {
+                crate::observe::fail(
+                    "texture_capture reason=no_log_directory (the capture writes beside the \
+                     renderer logs and has nowhere else it may write)",
+                );
+                return None;
+            };
+            let directory = base.join("texture-capture");
+            if let Err(e) = std::fs::create_dir_all(&directory) {
+                crate::observe::fail(format!(
+                    "texture_capture reason=mkdir_failed dir={} err={e}",
+                    directory.display()
+                ));
+                return None;
+            }
+            crate::observe::off(format!(
+                "texture_capture task={task_id} dir={}",
+                directory.display()
+            ));
+            Some(Capture { directory, task_id })
+        })
+        .as_ref()
+}
+
+/// Whether `task_id` is the task being captured. Callers ask before doing any
+/// readback a capture would need, so an unset switch costs one load.
+pub(crate) fn wants(task_id: u32) -> bool {
+    capture().is_some_and(|capture| capture.task_id == task_id)
+}
+
+/// Write one capture. `role` is `sample` or `store`; `layout` is the texel
+/// layout the bytes are in, as the engine names it.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn write(
+    role: &'static str,
+    task_id: u32,
+    texture_ref: u32,
+    pipeline_ref: u32,
+    width: u32,
+    height: u32,
+    layout: &str,
+    bytes: &[u8],
+) {
+    static FILES: AtomicU64 = AtomicU64::new(0);
+    static BYTES: AtomicU64 = AtomicU64::new(0);
+    static EXHAUSTED: AtomicBool = AtomicBool::new(false);
+    static LAST: OnceLock<Mutex<HashMap<(&'static str, u32), u64>>> = OnceLock::new();
+    let Some(capture) = capture().filter(|capture| capture.task_id == task_id) else {
+        return;
+    };
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    bytes.hash(&mut hasher);
+    (width, height, layout).hash(&mut hasher);
+    let digest = hasher.finish();
+    {
+        let mut last = LAST
+            .get_or_init(|| Mutex::new(HashMap::new()))
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        if last.insert((role, texture_ref), digest) == Some(digest) {
+            return;
+        }
+    }
+    let size = bytes.len() as u64;
+    let sequence = FILES.fetch_add(1, Ordering::Relaxed);
+    let total = BYTES.fetch_add(size, Ordering::Relaxed) + size;
+    if sequence >= MAX_FILES || total > MAX_BYTES {
+        if !EXHAUSTED.swap(true, Ordering::Relaxed) {
+            crate::observe::fail(format!(
+                "texture_capture reason=bound_reached files={sequence} bytes={total}"
+            ));
+        }
+        return;
+    }
+    let layout: String = layout
+        .chars()
+        .map(|c| if c.is_ascii_alphanumeric() { c } else { '_' })
+        .collect();
+    let name = format!(
+        "{sequence:05}-{role}-r{texture_ref}-p{pipeline_ref}-{width}x{height}-{layout}-t{}.raw",
+        crate::observe::elapsed_us() / 1000
+    );
+    if let Err(e) = std::fs::write(capture.directory.join(&name), bytes) {
+        if crate::observe::first_sight("texture_capture_write_failed", 0) {
+            crate::observe::fail(format!(
+                "texture_capture reason=write_failed file={name} err={e}"
+            ));
+        }
+    }
+}
+
+/// When after a blank read the same span is read again, in microseconds.
+const RECHECK_AFTER_US: [u64; 4] = [2_000, 20_000, 200_000, 2_000_000];
+/// Upper bound on spans watched at once.
+const MAX_RECHECKS: usize = 256;
+
+/// A buffer-backed texture that read all zero at its bind, to be read again.
+///
+/// The question it answers is whether a blank read was early or final: whether
+/// the guest's bytes appear in the same span a little later (the read raced the
+/// guest's write), or never do, and whether the span still translates to the
+/// page it did (the guest remapped the address under the read).
+struct Recheck {
+    task_id: u32,
+    texture_ref: u32,
+    buffer_ref: u32,
+    gva: u64,
+    row_pitch: u64,
+    row_bytes: usize,
+    width: u32,
+    height: u32,
+    format: u16,
+    armed_us: u64,
+    gpa_then: Option<u64>,
+    next: usize,
+}
+
+fn rechecks() -> &'static Mutex<Vec<Recheck>> {
+    static RECHECKS: OnceLock<Mutex<Vec<Recheck>>> = OnceLock::new();
+    RECHECKS.get_or_init(|| Mutex::new(Vec::new()))
+}
+
+/// Watch a buffer-backed texture span that read all zero at its bind.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn arm_blank_recheck<M: crate::runtime::host::HostMemory>(
+    state: &crate::model::DeviceState,
+    host: &M,
+    task_id: u32,
+    texture_ref: u32,
+    buffer_ref: u32,
+    gva: u64,
+    row_pitch: u64,
+    row_bytes: usize,
+    width: u32,
+    height: u32,
+    format: u16,
+) {
+    if !wants(task_id) {
+        return;
+    }
+    let gpa_then = state.tasks.get(task_id).and_then(|task| {
+        crate::runtime::gva_mem::translate_task_gva(host, task, gva, state.page_shift)
+    });
+    crate::observe::off(format!(
+        "texture_capture_blank task={task_id} ref={texture_ref} buf={buffer_ref} gva={gva:#x} \
+         gpa={gpa_then:?} {width}x{height} fmt={format:#x} pitch={row_pitch}"
+    ));
+    let mut watched = rechecks().lock().unwrap_or_else(|p| p.into_inner());
+    if watched.len() < MAX_RECHECKS {
+        watched.push(Recheck {
+            task_id,
+            texture_ref,
+            buffer_ref,
+            gva,
+            row_pitch,
+            row_bytes,
+            width,
+            height,
+            format,
+            armed_us: crate::observe::elapsed_us(),
+            gpa_then,
+            next: 0,
+        });
+    }
+}
+
+/// Read every watched span whose next delay has passed. Per drain tranche;
+/// returns at once when nothing is watched.
+pub fn sweep<M: crate::runtime::host::HostMemory>(state: &crate::model::DeviceState, host: &M) {
+    if capture().is_none() {
+        return;
+    }
+    let now = crate::observe::elapsed_us();
+    let mut watched = rechecks().lock().unwrap_or_else(|p| p.into_inner());
+    if watched.is_empty() {
+        return;
+    }
+    for recheck in watched.iter_mut() {
+        let Some(&after) = RECHECK_AFTER_US.get(recheck.next) else {
+            continue;
+        };
+        let age = now.saturating_sub(recheck.armed_us);
+        if age < after {
+            continue;
+        }
+        recheck.next += 1;
+        let mut bytes = vec![0u8; recheck.row_bytes * recheck.height as usize];
+        let mut readable = true;
+        for (row, destination) in bytes.chunks_mut(recheck.row_bytes).enumerate() {
+            let row_gva = recheck.gva + row as u64 * recheck.row_pitch;
+            if crate::runtime::gva_mem::read_task_gva_by_id(
+                host,
+                &state.tasks,
+                recheck.task_id,
+                row_gva,
+                destination,
+                state.page_shift,
+            )
+            .is_err()
+            {
+                readable = false;
+                break;
+            }
+        }
+        let gpa_now = state.tasks.get(recheck.task_id).and_then(|task| {
+            crate::runtime::gva_mem::translate_task_gva(host, task, recheck.gva, state.page_shift)
+        });
+        let nonzero = bytes.iter().filter(|&&b| b != 0).count();
+        crate::observe::off(format!(
+            "texture_capture_recheck task={} ref={} buf={} gva={:#x} after_us={age} \
+             readable={} nonzero={nonzero}/{} gpa_then={:?} gpa_now={:?}",
+            recheck.task_id,
+            recheck.texture_ref,
+            recheck.buffer_ref,
+            recheck.gva,
+            readable as u8,
+            bytes.len(),
+            recheck.gpa_then,
+            gpa_now,
+        ));
+        if readable && nonzero > 0 {
+            write(
+                "recheck",
+                recheck.task_id,
+                recheck.texture_ref,
+                0,
+                recheck.width,
+                recheck.height,
+                if recheck.format == 80 { "Bgra8" } else { "Raw" },
+                &bytes,
+            );
+        }
+    }
+    watched.retain(|recheck| recheck.next < RECHECK_AFTER_US.len());
+}
+
+/// Upper bound on draw records one process writes.
+const MAX_DRAW_LINES: u64 = 200_000;
+
+/// Append one line describing a captured task's draw to `draws.log` beside the
+/// texel files, so a frame that came out wrong can be joined to the draws that
+/// made it: target, pipeline, primitive shape, indices, viewport, scissor and
+/// the raster state that decides which triangles reach the target.
+pub(crate) fn note_draw(req: &crate::runtime::draw::DrawEncodeRequest) {
+    use std::io::Write as _;
+    static LINES: AtomicU64 = AtomicU64::new(0);
+    static FILE: OnceLock<Option<Mutex<std::fs::File>>> = OnceLock::new();
+    let Some(capture) = capture().filter(|capture| capture.task_id == req.task_id) else {
+        return;
+    };
+    if LINES.fetch_add(1, Ordering::Relaxed) >= MAX_DRAW_LINES {
+        return;
+    }
+    let Some(file) = FILE
+        .get_or_init(|| {
+            std::fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(capture.directory.join("draws.log"))
+                .ok()
+                .map(Mutex::new)
+        })
+        .as_ref()
+    else {
+        return;
+    };
+    let target = req
+        .colors
+        .first()
+        .map(|c| {
+            format!(
+                "ref={} {}x{} fmt={:#x} mid={}",
+                c.texture_ref, c.width, c.height, c.format, c.mapping_id
+            )
+        })
+        .unwrap_or_else(|| "none".to_owned());
+    let indexed = req
+        .indexed
+        .as_ref()
+        .map(|i| {
+            format!(
+                "idx(type={} count={} buf={} off={} base={})",
+                i.index_type,
+                i.index_count,
+                i.index_buffer_ref,
+                i.index_buffer_offset,
+                i.base_vertex
+            )
+        })
+        .unwrap_or_else(|| "idx(none)".to_owned());
+    let viewport = req
+        .viewports
+        .first()
+        .map(|v| format!("{:.1},{:.1},{:.1},{:.1}", v[0], v[1], v[2], v[3]))
+        .unwrap_or_default();
+    let scissor = req
+        .scissors
+        .first()
+        .map(|s| format!("{},{},{},{}", s.x, s.y, s.width, s.height))
+        .unwrap_or_default();
+    let line =
+        format!(
+        "t={} pipe={} target=[{target}] colors={} prim={} vtx={} first={} inst={} base_inst={} \
+         {indexed} vp=[{viewport}] sc=[{scissor}] cull={:?} front={:?} fill={:?} ds={} \
+         stencil_ref={:?} depth_attach={} stencil_attach={} continues={} pass_continues={} \
+         vtex={} ftex={}\n",
+        crate::observe::elapsed_us() / 1000,
+        req.pipeline_ref,
+        req.colors.len(),
+        req.primitive_type,
+        req.vertex_count,
+        req.first_vertex,
+        req.instance_count,
+        req.base_instance,
+        req.cull_mode,
+        req.front_facing,
+        req.fill_mode,
+        req.depth_stencil_ref,
+        req.stencil_ref,
+        req.depth_attach.is_some() as u8,
+        req.stencil_attach.is_some() as u8,
+        req.continues_render_pass as u8,
+        req.render_pass_continues as u8,
+        req.vertex_textures.iter().filter(|t| t.texture_ref != 0).count(),
+        req.fragment_textures.iter().filter(|t| t.texture_ref != 0).count(),
+    );
+    let mut file = file.lock().unwrap_or_else(|p| p.into_inner());
+    let _ = file.write_all(line.as_bytes());
+}
