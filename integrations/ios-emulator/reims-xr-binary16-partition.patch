+/// The guest's stored XR codes of one decoded resident texel: the colour
+/// channels through the format's transfer function, alpha through the family's
+/// own alpha interval (alpha8 natively, XR10 for BGRA10, none for BGR10).
+fn xr_stored_codes(format: reims_vgpu_vulkan::pixel::XrRenderFormat, texel: [f32; 4]) -> [i32; 4] {
+    use reims_vgpu_core::pixel_format::XrFormat;
+    use reims_vgpu_vulkan::pixel::XrRenderFormat;
+    let encode = |value: f32| -> f64 {
+        let value = f64::from(value);
+        if !format.is_srgb() {
+            return value;
+        }
+        let magnitude = value.abs();
+        let encoded = if magnitude <= 0.0031308 {
+            magnitude * 12.92
+        } else {
+            1.055 * magnitude.powf(1.0 / 2.4) - 0.055
+        };
+        encoded.copysign(value)
+    };
+    let colour = |value: f32| (encode(value) * 510.0 + 384.0).round() as i32;
+    let alpha = match format {
+        XrRenderFormat::NativeSurface(_) => (f64::from(texel[3]) * 255.0).round() as i32,
+        XrRenderFormat::Interleaved(XrFormat::Bgra10 | XrFormat::Bgra10Srgb) => {
+            (f64::from(texel[3]) * 510.0 + 384.0).round() as i32
+        }
+        XrRenderFormat::Interleaved(XrFormat::Bgr10 | XrFormat::Bgr10Srgb) => 1,
+    };
+    [colour(texel[0]), colour(texel[1]), colour(texel[2]), alpha]
+}
+
+/// Every XR pixel write is a half partition transfer: the encoder receives a
+/// binary16 value whether the draw blends, replaces or declares no blend.
+/// `0.51875` encodes as code 649 from Float32 and 648 from its binary16
+/// rounding `0.518555`; `0.75` and `-0.25` are exact ties (766.5 and 256.5)
+/// that round to even on both grids. On BGRA10 sRGB the alpha channel carries
+/// the partition-sensitive value.
+#[test]
+fn an_xr_fragment_output_reaches_its_encoder_as_binary16() {
+    use reims_vgpu_protocol::pixel_format::{
+        MTL_FORMAT_BGR10_XR, MTL_FORMAT_BGRA10_XR_SRGB, MTL_FORMAT_RGB10A8_2P_XR10,
+    };
+    use reims_vgpu_vulkan::pixel::{quantized_xr_render_values, XrRenderFormat};
+    let _g = engine_test_session();
+    let v = framebuffer_fetch_glsl("vertex", FETCH_VERTEX);
+    let f = framebuffer_fetch_glsl(
+        "fragment",
+        "#version 450
+layout(location=0) out vec4 primary;
+void main() { primary=vec4(0.51875,0.75,-0.25,0.51875); }
+",
+    );
+    let source = [0.51875f32, 0.75, -0.25, 0.51875];
+    let replacement = BlendStateResource {
+        src_rgb: MTL_BLEND_FACTOR_ONE,
+        dst_rgb: MTL_BLEND_FACTOR_ZERO,
+        op_rgb: MTL_BLEND_OPERATION_ADD,
+        src_alpha: MTL_BLEND_FACTOR_ONE,
+        dst_alpha: MTL_BLEND_FACTOR_ZERO,
+        op_alpha: MTL_BLEND_OPERATION_ADD,
+    };
+    let source_over = BlendStateResource {
+        src_rgb: MTL_BLEND_FACTOR_ONE,
+        dst_rgb: MTL_BLEND_FACTOR_ONE_MINUS_SOURCE_ALPHA,
+        op_rgb: MTL_BLEND_OPERATION_ADD,
+        src_alpha: MTL_BLEND_FACTOR_ONE,
+        dst_alpha: MTL_BLEND_FACTOR_ONE_MINUS_SOURCE_ALPHA,
+        op_alpha: MTL_BLEND_OPERATION_ADD,
+    };
+    let formats = [
+        MTL_FORMAT_BGR10_XR,
+        MTL_FORMAT_RGB10A8_2P_XR10,
+        MTL_FORMAT_BGRA10_XR_SRGB,
+    ];
+    for (n, mtl) in formats.into_iter().enumerate() {
+        let format = XrRenderFormat::from_mtl(mtl).unwrap();
+        // Over a black, transparent clear source-over stores the clamped and
+        // rounded source itself, so all three writes must agree.
+        let expected = xr_stored_codes(
+            format,
+            quantized_xr_render_values(format, source.map(binary16)),
+        );
+        if format.is_srgb() {
+            assert_eq!(expected[3], 648, "reference changed");
+        } else {
+            assert_eq!(expected[..3], [648, 766, 256], "reference changed");
+        }
+        for (m, blend) in [None, Some(replacement), Some(source_over)]
+            .into_iter()
+            .enumerate()
+        {
+            let identity = TargetIdentity::Gva {
+                gva: 0x2c9000 + n as u64 * 0x3000 + m as u64 * 0x1000,
+                width: 8,
+                height: 8,
+                generation: 1,
+                format: ash::vk::Format::R32G32B32A32_SFLOAT,
+            };
+            let mut req = engine_req(&v, &f, 8, 8);
+            req.target_identity = Some(identity.clone());
+            req.color_attachment = Some(color_attachment(mtl, [0.0; 4]));
+            req.blend = blend;
+            req.color_write_mask = engine::ColorWriteMask::ALL;
+            req.skip_readback = true;
+            engine::execute_draw_request(engine_device(), &req).expect("XR write");
+            let actual = engine::read_target_texels(&identity).unwrap().pixels;
+            assert_eq!(actual.len(), 64 * 16);
+            for texel in actual.as_chunks::<16>().0 {
+                let texel: [f32; 4] = std::array::from_fn(|c| {
+                    f32::from_le_bytes(texel[c * 4..c * 4 + 4].try_into().unwrap())
+                });
+                assert_eq!(
+                    xr_stored_codes(format, texel),
+                    expected,
+                    "{format:?} blend {blend:?}: {texel:?}"
+                );
+            }
+        }
+    }
+}
