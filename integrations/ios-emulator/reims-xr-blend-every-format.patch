+/// Blending on the four remaining XR spellings. The sRGB formats clamp the
+/// linear source to their published range `-0.5271..1.66894`, BGRA10 to
+/// BGR10's `-0.752941..1.25098` and every alpha to `0..1`; the blend then runs
+/// in binary16 steps and the RTNE encoder stores the result. A linear `1.5`
+/// on an sRGB target stores code 993 (the linear formats' clamp would store
+/// 947) and the `2.0` beside it stores 1022 (unclamped: 1023).
+#[test]
+fn framebuffer_fetch_blends_every_remaining_xr_format_with_its_published_clamp() {
+    use reims_vgpu_protocol::pixel_format::{
+        MTL_FORMAT_BGR10_XR_SRGB, MTL_FORMAT_BGRA10_XR, MTL_FORMAT_BGRA10_XR_SRGB,
+        MTL_FORMAT_RGB10A8_2P_XR10_SRGB,
+    };
+    use reims_vgpu_vulkan::pixel::{quantized_xr_render_values, XrRenderFormat};
+    let _g = engine_test_session();
+    let v = framebuffer_fetch_glsl("vertex", FETCH_VERTEX);
+    let clear = [0.5, 0.0, 1.0, 0.5];
+    let clamp = |format: XrRenderFormat, channel: usize, value: f32| -> f32 {
+        let (minimum, maximum) = if channel == 3 {
+            (0.0, 1.0)
+        } else if format.is_srgb() {
+            (-0.5271, 1.66894)
+        } else {
+            (f32::from_bits(0xbf40_c0be), f32::from_bits(0x3fa0_201d))
+        };
+        value.max(minimum).min(maximum)
+    };
+    // Two coincident triangles blend twice over the clear; one opaque
+    // triangle exposes the clamp. The reference colour codes guard the cases.
+    let srgb_cases = [
+        ([0.592f32, 0.634, 0.696, 0.6], 6, [873, 868, 923]),
+        ([2.0, 1.5, -0.9, 1.0], 3, [1022, 993, 0]),
+    ];
+    let linear_cases = [
+        ([0.592f32, 0.634, 0.696, 0.6], 6, [847, 836, 962]),
+        ([1.3, -0.9, 0.3, 1.0], 3, [1022, 0, 537]),
+    ];
+    let slots = [
+        (0u64, MTL_FORMAT_RGB10A8_2P_XR10_SRGB, 0),
+        (1, MTL_FORMAT_RGB10A8_2P_XR10_SRGB, 1),
+        (2, MTL_FORMAT_BGRA10_XR, 0),
+        (3, MTL_FORMAT_BGRA10_XR_SRGB, 0),
+        (4, MTL_FORMAT_BGR10_XR_SRGB, 0),
+        (5, MTL_FORMAT_BGR10_XR_SRGB, 1),
+    ];
+    for (n, mtl, slot) in slots {
+        let format = XrRenderFormat::from_mtl(mtl).unwrap();
+        let cases = if format.is_srgb() {
+            srgb_cases
+        } else {
+            linear_cases
+        };
+        for (m, (source, vertex_count, reference)) in cases.into_iter().enumerate() {
+            let f = framebuffer_fetch_glsl(
+                "fragment",
+                &format!(
+                    "#version 450
+layout(location=0) out vec4 primary;
+layout(location=1) out vec4 secondary;
+void main() {{ vec4 xr=vec4({:?},{:?},{:?},{:?}); primary={}; secondary=xr; }}
+",
+                    source[0],
+                    source[1],
+                    source[2],
+                    source[3],
+                    if slot == 0 { "xr" } else { "vec4(0,0,0,1)" }
+                ),
+            );
+            let identity = TargetIdentity::Gva {
+                gva: 0x2d9000 + n * 0x2000 + m as u64 * 0x1000,
+                width: 8,
+                height: 8,
+                generation: 1,
+                format: ash::vk::Format::R32G32B32A32_SFLOAT,
+            };
+            let source_over = BlendStateResource {
+                src_rgb: MTL_BLEND_FACTOR_ONE,
+                dst_rgb: MTL_BLEND_FACTOR_ONE_MINUS_SOURCE_ALPHA,
+                op_rgb: MTL_BLEND_OPERATION_ADD,
+                src_alpha: MTL_BLEND_FACTOR_ONE,
+                dst_alpha: MTL_BLEND_FACTOR_ONE_MINUS_SOURCE_ALPHA,
+                op_alpha: MTL_BLEND_OPERATION_ADD,
+            };
+            let mut req = engine_req(&v, &f, 8, 8);
+            req.vertex_count = vertex_count;
+            if slot == 0 {
+                req.target_identity = Some(identity.clone());
+                req.color_attachment = Some(color_attachment(mtl, clear));
+                req.blend = Some(source_over);
+                req.color_write_mask = engine::ColorWriteMask::ALL;
+                req.skip_readback = true;
+            } else {
+                req.secondary_targets.push(SecondaryColorTarget {
+                    identity: identity.clone(),
+                    width: 8,
+                    height: 8,
+                    attachment: color_attachment(mtl, clear),
+                    load: false,
+                    seed: None,
+                    blend: Some(source_over),
+                    color_write_mask: engine::ColorWriteMask::ALL,
+                });
+            }
+            engine::execute_draw_request(engine_device(), &req)
+                .unwrap_or_else(|e| panic!("{format:?} slot {slot} case {m}: {e:?}"));
+
+            // Clamp, round to binary16, blend in rounded steps, then quantize.
+            let s: [f32; 4] = std::array::from_fn(|c| binary16(clamp(format, c, source[c])));
+            let mut d = quantized_xr_render_values(format, clear.map(|v| v as f32));
+            for _ in 0..vertex_count / 3 {
+                let inverse = binary16(1.0 - s[3]);
+                let blended: [f32; 4] =
+                    std::array::from_fn(|c| binary16(s[c] + binary16(binary16(d[c]) * inverse)));
+                d = quantized_xr_render_values(format, blended);
+            }
+            let expected = xr_stored_codes(format, d);
+            assert_eq!(expected[..3], reference, "{format:?}: reference changed");
+            let actual = engine::read_target_texels(&identity).unwrap().pixels;
+            assert_eq!(actual.len(), 64 * 16);
+            for texel in actual.as_chunks::<16>().0 {
+                let texel: [f32; 4] = std::array::from_fn(|c| {
+                    f32::from_le_bytes(texel[c * 4..c * 4 + 4].try_into().unwrap())
+                });
+                assert_eq!(
+                    xr_stored_codes(format, texel),
+                    expected,
+                    "{format:?} slot {slot} case {m}: {texel:?}"
+                );
+            }
+        }
+    }
+}
