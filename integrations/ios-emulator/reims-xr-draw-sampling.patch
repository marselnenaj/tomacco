+/// XR is expanded before filtering, on callers that carry float32 uploads.
+/// The flag is the host's measured RGBA32Float filtering capability; Metal's
+/// byte loader requests NONE and continues through its existing path.
+pub(crate) fn linear_xr_upload_enabled(format: u16, native: NativeUploads) -> bool {
+    cfg!(feature = "backend-vulkan")
+        && native.float32
+        && pixel_format::XrFormat::from_mtl(format).is_some()
+}
+
+#[cfg(feature = "backend-vulkan")]
+pub(crate) fn decode_linear_xr_upload(
+    format: u16,
+    bytes: Vec<u8>,
+) -> Result<(Vec<u8>, SampledByteFormat), LinearLoadRefusal> {
+    let upload = reims_vgpu_vulkan::pixel::sampled_upload_bytes(format, bytes)
+        .map_err(|why| LinearLoadRefusal::XrUpload { reason: why.slug() })?;
+    let (_, bytes) = upload.into_parts();
+    Ok((
+        bytes,
+        SampledByteFormat::linearized_from_source(TexelLayout::Rgba32Float, format),
+    ))
+}
