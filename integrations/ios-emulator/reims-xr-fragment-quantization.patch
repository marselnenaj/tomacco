+//! Public XR fragment quantization, retained by the original shader lifetime.
+//! The native paired-plane renderer remains a separate admission contract.
+
+use std::collections::HashMap;
+use std::sync::{Arc, Weak};
+
+use metal2vulkan::fragment_color::{
+    AffineColorEncoding, ColorChannelEncoding, ColorTransfer, FragmentColorEncoding,
+};
+use reims_vgpu_core::pixel_format::XrFormat;
+
+use super::draw_validation::DrawValidationDecline;
+use super::types::{DrawError, DrawRequest};
+
+type Formats = [Option<XrFormat>; 8];
+type ShaderWords = Arc<Vec<u32>>;
+
+/// The attachment's semantic format survives lowering to the Float32 image.
+/// A renderer lacking quantization after blend must decline before GPU work.
+pub(super) fn formats(req: &DrawRequest) -> Result<Formats, DrawError> {
+    let mut formats = [None; 8];
+    let primary = req.color_attachment.and_then(|a| a.xr_format());
+    for (slot, (format, blend)) in std::iter::once((primary, req.blend.is_some()))
+        .chain(
+            req.secondary_targets
+                .iter()
+                .map(|s| (s.attachment.xr_format(), s.blend.is_some())),
+        )
+        .enumerate()
+    {
+        let Some(format) = format else {
+            continue;
+        };
+        if slot >= formats.len() {
+            return Err(DrawError::DrawValidation(
+                DrawValidationDecline::XrFragmentOutput {
+                    reason: "fragment_color_plan_shape".into(),
+                },
+            ));
+        }
+        if blend {
+            return Err(DrawError::DrawValidation(
+                DrawValidationDecline::XrBlendRequiresQuantization { slot: slot as u32 },
+            ));
+        }
+        let samples = req.raster_sample_count.max(1);
+        if samples > 1 {
+            return Err(DrawError::DrawValidation(
+                DrawValidationDecline::XrResolveRequiresQuantization {
+                    slot: slot as u32,
+                    samples,
+                },
+            ));
+        }
+        formats[slot] = Some(format);
+    }
+    Ok(formats)
+}
+
+struct Entry {
+    source: Weak<Vec<u32>>,
+    result: Result<ShaderWords, DrawError>,
+}
+
+#[derive(Default)]
+pub(super) struct ColorQuantizationCache {
+    entries: HashMap<(usize, Formats), Entry>,
+}
+
+impl ColorQuantizationCache {
+    pub(super) fn clear(&mut self) {
+        self.entries.clear();
+    }
+
+    pub(super) fn shader(
+        &mut self,
+        source: &ShaderWords,
+        formats: Formats,
+    ) -> Result<ShaderWords, DrawError> {
+        if formats.iter().all(Option::is_none) {
+            return Ok(source.clone());
+        }
+        let key = (Arc::as_ptr(source) as usize, formats);
+        if let Some(entry) = self.entries.get(&key) {
+            // A reused allocation address cannot revive an expired shader.
+            if entry
+                .source
+                .upgrade()
+                .is_some_and(|held| Arc::ptr_eq(&held, source))
+            {
+                crate::runtime::drain::note_store_route("xr_fragment_quantize_reused_n");
+                return entry.result.clone();
+            }
+        }
+        // Only expired input lifetimes may lose a retained transformation.
+        // No live guest shader is evicted to meet an arbitrary capacity bound.
+        self.entries
+            .retain(|_, entry| entry.source.strong_count() != 0);
+        let result = rewrite(source, formats);
+        self.entries.insert(
+            key,
+            Entry {
+                source: Arc::downgrade(source),
+                result: result.clone(),
+            },
+        );
+        crate::runtime::drain::note_store_route("xr_fragment_quantize_new_n");
+        result
+    }
+}
+
+fn rewrite(source: &[u32], formats: Formats) -> Result<ShaderWords, DrawError> {
+    let refused = |reason: String| {
+        DrawError::DrawValidation(DrawValidationDecline::XrFragmentOutput { reason })
+    };
+    let mut encodings = Vec::new();
+    for (location, format) in formats.into_iter().enumerate() {
+        let Some(format) = format else {
+            continue;
+        };
+        let transfer = if format.is_srgb() {
+            ColorTransfer::ExtendedSrgb
+        } else {
+            ColorTransfer::Linear
+        };
+        let colour = ColorChannelEncoding::Affine(
+            AffineColorEncoding::checked(510, 384, 0, 1023, transfer)
+                .map_err(|e| refused(e.to_string()))?,
+        );
+        let alpha = match format {
+            XrFormat::Bgr10 | XrFormat::Bgr10Srgb => ColorChannelEncoding::ConstantOne,
+            XrFormat::Bgra10 | XrFormat::Bgra10Srgb => ColorChannelEncoding::Affine(
+                AffineColorEncoding::checked(510, 384, 384, 894, ColorTransfer::Linear)
+                    .map_err(|e| refused(e.to_string()))?,
+            ),
+        };
+        encodings.push(FragmentColorEncoding {
+            location: location as u32,
+            channels: [colour, colour, colour, alpha],
+        });
+    }
+    let bytes: Vec<_> = source.iter().flat_map(|w| w.to_le_bytes()).collect();
+    let bytes = metal2vulkan::fragment_color::quantize_fragment_color_outputs(&bytes, &encodings)
+        .map_err(|e| refused(e.to_string()))?;
+    // Validation is part of shader construction, never a selection or repair
+    // loop. A rejected module cannot enter the positive cache or the driver.
+    let scratch =
+        std::env::temp_dir().join(format!("reims-vgpu-xr-fragment-{}", std::process::id()));
+    metal2vulkan::tools::spirv_val_bytes(&bytes, &scratch).map_err(refused)?;
+    Ok(Arc::new(
+        bytes
+            .chunks_exact(4)
+            .map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+            .collect(),
+    ))
+}
