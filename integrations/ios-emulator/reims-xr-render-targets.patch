 /// renderable format a single edit there rather than a pair of edits that a
 /// commit can half-land.
 pub fn color_attachment(mtl: u16) -> Result<(vk::Format, ColorNumericType), Refusal> {
-    let f = translate(mtl)?;
+    // XR10 has no bit-compatible Vulkan format. Keep its live resident in
+    // linear half-float so blending and sampling match Metal's linear shader
+    // values; the Store rail encodes the guest's XR10 bytes afterwards.
+    let format = if pixel_format::XrFormat::from_mtl(mtl).is_some() {
+        vk::Format::R16G16B16A16_SFLOAT
+    } else {
+        translate(mtl)?.vk
+    };
     let numeric = pixel_format::render_target_numeric_type(mtl)
         .ok_or(Refusal::NoColorAttachmentFormat(mtl))?;
-    Ok((f.vk, numeric))
+    Ok((format, numeric))
 }
 
