+/// Encode semantic, linear RGBA8 as one of Apple's XR10 guest texels.
+///
+/// A render target's Vulkan resident is linear RGBA16F. The CPU fallback
+/// narrows that resident to RGBA8 before reaching this exact-format encoder;
+/// sRGB XR encodes RGB but alpha stays linear in both XR variants.
+fn encode_xr_texel(format: u16, rgba: [u8; 4], dst: &mut [u8]) {
+    let xr = XrFormat::from_mtl(format).expect("caller matched an XR format");
+    let srgb = xr.is_srgb();
+    let code = |value| {
+        if srgb {
+            unorm8_to_extended_srgb_xr(value)
+        } else {
+            u16::from(value) * 2 + 384
+        }
+    };
+    let r = code(rgba[COMPONENT_R]);
+    let g = code(rgba[COMPONENT_G]);
+    let b = code(rgba[COMPONENT_B]);
+    let a = u16::from(rgba[COMPONENT_A]) * 2 + 384;
+    match xr {
+        XrFormat::Bgr10 | XrFormat::Bgr10Srgb => {
+            let word = u32::from(b) | (u32::from(g) << 10) | (u32::from(r) << 20);
+            dst[..4].copy_from_slice(&word.to_le_bytes());
+        }
+        XrFormat::Bgra10 | XrFormat::Bgra10Srgb => {
+            for (lane, value) in [(0, b), (2, g), (4, r), (6, a)] {
+                st16(&mut dst[lane..lane + 2], value << 6);
+            }
+        }
+    }
+}
