+    #[test]
+    fn xr_render_target_rows_encode_linear_rgba_and_the_srgb_variant() {
+        for format in FORMATS {
+            let xr = XrFormat::from_mtl(format).unwrap();
+            let rgba = [0, 64, 128, 255];
