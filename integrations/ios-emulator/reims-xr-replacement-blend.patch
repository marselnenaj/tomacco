+
+/// Replacement has no destination term. Drop this fixed-function state for XR
+/// before pipeline creation so the translator's quantization remains the last
+/// colour operation. No source-over, min/max or dual-source blend is admitted.
+fn replaces_source(blend: &BlendStateResource) -> bool {
+    use reims_vgpu_core::blend::{BlendFactor, BlendOperation};
+    blend.src_rgb == BlendFactor::One.ordinal()
+        && blend.dst_rgb == BlendFactor::Zero.ordinal()
+        && blend.op_rgb == BlendOperation::Add.ordinal()
+        && blend.src_alpha == BlendFactor::One.ordinal()
+        && blend.dst_alpha == BlendFactor::Zero.ordinal()
+        && blend.op_alpha == BlendOperation::Add.ordinal()
+}
+
+pub(super) fn pipeline_blend(
+    format: Option<XrRenderFormat>,
+    blend: Option<BlendStateResource>,
+) -> Option<BlendKey> {
+    blend
+        .filter(|b| format.is_none() || !replaces_source(b))
+        .map(|b| b.key())
+}
 
