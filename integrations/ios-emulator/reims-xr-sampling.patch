+/// Upload guest XR texels through the same converter used by dispatch, then
+/// fetch on the actual GPU. This checks that extended values survive image
+/// creation and binding, not just the CPU conversion function.
+#[test]
+fn compute_sampled_xr_upload_preserves_extended_range() {
+    use reims_vgpu_protocol::pixel_format as p;
+    let _g = engine_test_session();
+    let Some(words) = assemble_spvasm(SAMPLED_IMAGE_FETCH_KERNEL, "sampled_xr") else {
+        return;
+    };
+    for (mtl, bgra, srgb) in [
+        (p::MTL_FORMAT_BGR10_XR, false, false),
+        (p::MTL_FORMAT_BGR10_XR_SRGB, false, true),
+        (p::MTL_FORMAT_BGRA10_XR, true, false),
+        (p::MTL_FORMAT_BGRA10_XR_SRGB, true, true),
+    ] {
+        let packed = if bgra {
+            [1023u16, 639, 0, 500]
+                .into_iter()
+                .flat_map(|c| (c << 6).to_le_bytes())
+                .collect()
+        } else {
+            (1023u32 | (639 << 10)).to_le_bytes().to_vec()
+        };
+        let (format, bytes) = reims_vgpu_vulkan::pixel::sampled_upload_bytes(mtl, packed)
+            .expect("decode owned XR texels")
+            .into_parts();
+        let request = ComputeRequest {
+            spirv: words.clone(),
+            entry: "main".into(),
+            dispatch: engine::ComputeDispatch::Workgroups([1, 1, 1]),
+            storage_buffers: vec![ComputeBufferResource {
+                binding: 0,
+                bytes: vec![0; 16],
+                writable: true,
+            }],
+            sampled_images: vec![ComputeSampledImageResource {
+                mip_levels: 1,
+                binding: 32,
+                array_element: 0,
+                descriptor_count: 1,
+                format,
+                width: 1,
+                height: 1,
+                source: ComputeSampledSource::Bytes(bytes),
+            }],
+            samplers: vec![],
+            storage_images: vec![],
+        };
+        let Some(output) = engine_or_skip("compute XR sampling", &request) else {
+            return;
+        };
+        let expected = if srgb {
+            [-0.5271151, 0.21404114, 1.6749653]
+        } else {
+            [-0.7529412, 0.5, 1.2529412]
+        };
+        let expected = [
+            expected[0],
+            expected[1],
+            expected[2],
+            if bgra { 116.0 / 510.0 } else { 1.0 },
+        ];
+        assert_eq!(output.buffers[0].bytes.len(), 16);
+        for (channel, raw) in output.buffers[0]
+            .bytes
+            .as_chunks::<4>()
+            .0
+            .iter()
+            .enumerate()
+        {
+            let actual = f32::from_le_bytes(*raw);
+            assert!(
+                (actual - expected[channel]).abs() < 1e-5,
+                "XR format {mtl} channel {channel}: {actual} != {}",
+                expected[channel]
+            );
+        }
+    }
+}
