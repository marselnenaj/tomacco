+//! CPU-origin sampled images whose guest storage has no native Vulkan format.
+//! This does not admit XR render targets, storage writes or resident aliases.
+
+use std::sync::OnceLock;
+
+use reims_vgpu_core::pixel_format::XrFormat;
+
+use super::{sampled_image, Refusal, StorageImageFormat};
+
+/// The bytes and the format that interprets them travel together. XR bytes
+/// become linear RGBA32Float before the hardware filters them, preserving
+/// negative and above-white values. An sRGB transform after filtering would
+/// produce different colours, even for an ordinary black/white edge.
+pub struct SampledUpload {
+    format: StorageImageFormat,
+    bytes: Vec<u8>,
+}
+
+impl SampledUpload {
+    pub fn into_parts(self) -> (StorageImageFormat, Vec<u8>) {
+        (self.format, self.bytes)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SampledUploadRefusal {
+    Format(Refusal),
+    IncompleteXrTexel,
+    ExpandedSizeOverflow,
+    AllocationFailed,
+}
+
+impl SampledUploadRefusal {
+    pub const fn slug(self) -> &'static str {
+        match self {
+            Self::Format(why) => why.slug(),
+            Self::IncompleteXrTexel => "sampled_xr_incomplete_texel",
+            Self::ExpandedSizeOverflow => "sampled_xr_size_overflow",
+            Self::AllocationFailed => "sampled_xr_allocation_failed",
+        }
+    }
+}
+
+fn linear_values() -> &'static [f32; 1024] {
+    static VALUES: OnceLock<[f32; 1024]> = OnceLock::new();
+    VALUES.get_or_init(|| std::array::from_fn(|code| (code as f32 - 384.0) / 510.0))
+}
+
+fn srgb_values() -> &'static [f32; 1024] {
+    static VALUES: OnceLock<[f32; 1024]> = OnceLock::new();
+    VALUES.get_or_init(|| {
+        linear_values().map(|encoded| {
+            let magnitude = encoded.abs();
+            let linear = if magnitude <= 0.04045 {
+                magnitude / 12.92
+            } else {
+                ((magnitude + 0.055) / 1.055).powf(2.4)
+            };
+            linear.copysign(encoded)
+        })
+    })
+}
+
+/// Decode tightly packed guest levels, preserving their order and all colour
+/// codes. The engine still validates the mip geometry and host format support.
+/// Ordinary supported formats retain their original allocation and bytes.
+///
+/// XR's packing/linear encoding and clamped alpha are specified at
+/// https://developer.apple.com/documentation/metal/mtlpixelformat/bgra10_xr_srgb
+/// The signed sRGB extension is specified at
+/// https://developer.apple.com/documentation/coregraphics/cgcolorspace/extendedsrgb
+pub fn sampled_upload_bytes(
+    mtl: u16,
+    bytes: Vec<u8>,
+) -> Result<SampledUpload, SampledUploadRefusal> {
+    let Some(xr) = XrFormat::from_mtl(mtl) else {
+        return Ok(SampledUpload {
+            format: sampled_image(mtl).map_err(SampledUploadRefusal::Format)?,
+            bytes,
+        });
+    };
+    let stride = xr.bytes_per_texel();
+    if !bytes.len().is_multiple_of(stride) {
+        return Err(SampledUploadRefusal::IncompleteXrTexel);
+    }
+    let length = (bytes.len() / stride)
+        .checked_mul(16)
+        .ok_or(SampledUploadRefusal::ExpandedSizeOverflow)?;
+    let mut decoded = Vec::new();
+    decoded
+        .try_reserve_exact(length)
+        .map_err(|_| SampledUploadRefusal::AllocationFailed)?;
+    let linear = linear_values();
+    let colour = if xr.is_srgb() { srgb_values() } else { linear };
+    for texel in bytes.chunks_exact(stride) {
+        let codes = xr
+            .component_codes(texel)
+            .ok_or(SampledUploadRefusal::IncompleteXrTexel)?;
+        for &code in &codes[..3] {
+            decoded.extend_from_slice(&colour[usize::from(code)].to_le_bytes());
+        }
+        // Alpha is linear even in an sRGB texture, and Metal clamps it.
+        decoded.extend_from_slice(&linear[usize::from(codes[3])].clamp(0.0, 1.0).to_le_bytes());
+    }
+    Ok(SampledUpload {
+        format: StorageImageFormat::Rgba32Float,
+        bytes: decoded,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use reims_vgpu_core::pixel_format as p;
+
+    fn packed(format: XrFormat, rgba: [u16; 4], padding: bool) -> Vec<u8> {
+        match format {
+            XrFormat::Bgr10 | XrFormat::Bgr10Srgb => {
+                let [r, g, b, _] = rgba.map(u32::from);
+                (b | (g << 10) | (r << 20) | if padding { 3 << 30 } else { 0 })
+                    .to_le_bytes()
+                    .to_vec()
+            }
+            XrFormat::Bgra10 | XrFormat::Bgra10Srgb => [rgba[2], rgba[1], rgba[0], rgba[3]]
+                .into_iter()
+                .flat_map(|c| ((c << 6) | if padding { 63 } else { 0 }).to_le_bytes())
+                .collect(),
+        }
+    }
+
+    fn floats(bytes: &[u8]) -> Vec<f32> {
+        bytes
+            .as_chunks::<4>()
+            .0
+            .iter()
+            .map(|c| f32::from_le_bytes(*c))
+            .collect()
+    }
+
+    #[test]
+    fn xr_sampling_preserves_every_code_and_channel_and_ignores_padding() {
+        for mtl in [
+            p::MTL_FORMAT_BGR10_XR,
+            p::MTL_FORMAT_BGR10_XR_SRGB,
+            p::MTL_FORMAT_BGRA10_XR,
+            p::MTL_FORMAT_BGRA10_XR_SRGB,
+        ] {
+            let xr = XrFormat::from_mtl(mtl).unwrap();
+            let mut input = Vec::new();
+            for code in 0..1024 {
+                input.extend(packed(xr, [code, 1023 - code, 384, code], true));
+            }
+            let (format, bytes) = sampled_upload_bytes(mtl, input).unwrap().into_parts();
+            assert_eq!(format, StorageImageFormat::Rgba32Float);
+            assert_eq!(bytes.len(), 1024 * 16);
+            let output = floats(&bytes);
+            let mut previous = f32::NEG_INFINITY;
+            for (code, rgba) in output.as_chunks::<4>().0.iter().enumerate() {
+                assert!(rgba[0] > previous, "all 1024 codes stay distinct");
+                previous = rgba[0];
+                assert_eq!(rgba[1], output[(1023 - code) * 4]);
+                assert_eq!(rgba[2], 0.0);
+                // Round-trip through the independent inverse transfer, in f64.
+                let value = f64::from(rgba[0]);
+                let encoded = if xr.is_srgb() {
+                    value.signum()
+                        * if value.abs() <= 0.0031308 {
+                            value.abs() * 12.92
+                        } else {
+                            1.055 * value.abs().powf(1.0 / 2.4) - 0.055
+                        }
+                } else {
+                    value
+                };
+                assert!((encoded * 510.0 + 384.0 - code as f64).abs() < 0.001);
+                let alpha = if xr.bytes_per_texel() == 4 {
+                    1.0
+                } else {
+                    ((code as f32 - 384.0) / 510.0).clamp(0.0, 1.0)
+                };
+                assert_eq!(rgba[3], alpha);
+            }
+            assert!(output[0] < -0.5 && output[1023 * 4] > 1.25);
+        }
+    }
+
+    #[test]
+    fn srgb_is_expanded_before_filtering_and_alpha_stays_linear() {
+        let xr = XrFormat::Bgra10Srgb;
+        let input = [
+            packed(xr, [384, 639, 894, 639], false),
+            packed(xr, [894, 639, 384, 1023], false),
+        ]
+        .concat();
+        let (_, bytes) = sampled_upload_bytes(p::MTL_FORMAT_BGRA10_XR_SRGB, input)
+            .unwrap()
+            .into_parts();
+        let values = floats(&bytes);
+        assert!(((values[0] + values[4]) * 0.5 - 0.5).abs() < 1e-6);
+        assert!((values[1] - 0.21404114).abs() < 1e-6);
+        assert_eq!(values[3], 0.5);
+        assert_eq!(values[7], 1.0);
+        assert!((srgb_values()[0] + 0.5271151).abs() < 1e-6);
+        // Apple's prose upper bound 1.66894 describes code 1022. Its
+        // explicit (code - 384) / 510 formula also defines code 1023;
+        // do not rescale all 1024 codes to the prose endpoint. skcms fixed
+        // that same discrepancy in 12776964e26d33991ef8626d4fed226eefee7cdc.
+        assert!((srgb_values()[1022] - 1.6689452).abs() < 1e-6);
+        assert!((srgb_values()[1023] - 1.6749653).abs() < 1e-6);
+    }
+
+    #[test]
+    fn upload_rejects_partial_texels_and_never_changes_native_bytes() {
+        for (format, width) in [(p::MTL_FORMAT_BGR10_XR, 4), (p::MTL_FORMAT_BGRA10_XR, 8)] {
+            for length in 1..width {
+                assert!(matches!(
+                    sampled_upload_bytes(format, vec![0; length]),
+                    Err(SampledUploadRefusal::IncompleteXrTexel)
+                ));
+            }
+            assert!(
+                sampled_image(format).is_err(),
+                "XR bytes cannot bind natively"
+            );
+            assert!(
+                super::super::storage_image(format).is_err(),
+                "sampling does not admit writes"
+            );
+        }
+        let bytes = vec![1, 2, 3, 4];
+        let pointer = bytes.as_ptr();
+        let (format, bytes) = sampled_upload_bytes(p::MTL_FORMAT_BGRA8_UNORM, bytes)
+            .unwrap()
+            .into_parts();
+        assert_eq!(format, StorageImageFormat::Bgra8Unorm);
+        assert_eq!(bytes.as_ptr(), pointer);
+        assert_eq!(bytes, [1, 2, 3, 4]);
+        assert!(matches!(
+            sampled_upload_bytes(u16::MAX, vec![0; 4]),
+            Err(SampledUploadRefusal::Format(_))
+        ));
+    }
+}
