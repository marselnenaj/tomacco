+/// Extended-range texels have no bit-compatible Vulkan normalized format.
+/// Keep their packing and transfer function together until an upload decodes
+/// them. In particular, a BGR texel's two high bits are not an alpha channel.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum XrFormat {
+    Bgr10,
+    Bgr10Srgb,
+    Bgra10,
+    Bgra10Srgb,
+}
+
+impl XrFormat {
+    pub const fn from_mtl(format: u16) -> Option<Self> {
+        match format {
+            MTL_FORMAT_BGR10_XR => Some(Self::Bgr10),
+            MTL_FORMAT_BGR10_XR_SRGB => Some(Self::Bgr10Srgb),
+            MTL_FORMAT_BGRA10_XR => Some(Self::Bgra10),
+            MTL_FORMAT_BGRA10_XR_SRGB => Some(Self::Bgra10Srgb),
+            _ => None,
+        }
+    }
+
+    pub const fn bytes_per_texel(self) -> usize {
+        match self {
+            Self::Bgr10 | Self::Bgr10Srgb => 4,
+            Self::Bgra10 | Self::Bgra10Srgb => 8,
+        }
+    }
+
+    pub const fn is_srgb(self) -> bool {
+        matches!(self, Self::Bgr10Srgb | Self::Bgra10Srgb)
+    }
+
+    /// Raw RGBA codes, before the linear XR encoding and optional sRGB
+    /// expansion. 894 is exactly alpha 1 in this encoding. Padding is ignored.
+    pub fn component_codes(self, texel: &[u8]) -> Option<[u16; 4]> {
+        if texel.len() != self.bytes_per_texel() {
+            return None;
+        }
+        Some(match self {
+            Self::Bgr10 | Self::Bgr10Srgb => {
+                let word = u32::from_le_bytes([texel[0], texel[1], texel[2], texel[3]]);
+                [
+                    ((word >> 20) & 1023) as u16,
+                    ((word >> 10) & 1023) as u16,
+                    (word & 1023) as u16,
+                    894,
+                ]
+            }
+            Self::Bgra10 | Self::Bgra10Srgb => [
+                ld16(&texel[4..]) >> 6,
+                ld16(&texel[2..]) >> 6,
+                ld16(texel) >> 6,
+                ld16(&texel[6..]) >> 6,
+            ],
+        })
+    }
+}
