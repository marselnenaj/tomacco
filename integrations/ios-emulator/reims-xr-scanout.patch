+#[cfg(test)]
+mod xr_scanout_tests {
+    use super::*;
+
+    const FORMATS: [u16; 4] = [
+        MTL_FORMAT_BGR10_XR,
+        MTL_FORMAT_BGR10_XR_SRGB,
+        MTL_FORMAT_BGRA10_XR,
+        MTL_FORMAT_BGRA10_XR_SRGB,
+    ];
+
+    fn encode(format: u16, bgra: [u16; 4], padding: bool) -> Vec<u8> {
+        if matches!(format, MTL_FORMAT_BGR10_XR | MTL_FORMAT_BGR10_XR_SRGB) {
+            let word = bgra[0] as u32
+                | (bgra[1] as u32) << 10
+                | (bgra[2] as u32) << 20
+                | if padding { 3 << 30 } else { 0 };
+            word.to_le_bytes().to_vec()
+        } else {
+            bgra.iter()
+                .flat_map(|v| ((v << 6) | if padding { 63 } else { 0 }).to_le_bytes())
+                .collect()
+        }
+    }
+
+    #[test]
+    fn xr_capture_matches_reference_for_every_component_code() {
+        for format in FORMATS {
+            for code in 0..1024u16 {
+                // Each component exercises a different code, including alpha.
+                let bgra = [code, 1023 - code, (code + 341) % 1024, (code + 683) % 1024];
+                let reference =
+                    |c: u16| (((c as f64 - 384.0) / 510.0).clamp(0.0, 1.0) * 255.0).round() as u8;
+                let alpha = if bytes_per_pixel(format) == Some(4) {
+                    255
+                } else {
+                    reference(bgra[3])
+                };
+                let expected = [
+                    reference(bgra[2]),
+                    reference(bgra[1]),
+                    reference(bgra[0]),
+                    alpha,
+                ];
+                for padding in [false, true] {
+                    assert_eq!(
+                        texel_to_rgba8(format, &encode(format, bgra, padding)),
+                        Some(expected),
+                        "format={format} code={code}"
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn xr_opaque_white_black_and_midpoint_are_not_unorm10() {
+        for format in FORMATS {
+            assert_eq!(
+                texel_to_rgba8(format, &encode(format, [384, 639, 894, 894], false)),
+                Some([255, 128, 0, 255])
+            );
+            assert!(narrows_to_unorm8(format));
+            assert_eq!(
+                is_srgb(format),
+                matches!(format, MTL_FORMAT_BGR10_XR_SRGB | MTL_FORMAT_BGRA10_XR_SRGB)
+            );
+            // Capture support must not accidentally admit an unconverted GPU texture.
+            assert!(sampled_class(format).is_none());
+            assert!(storage_selector(format).is_none());
+            assert!(render_target_bpp(format).is_none());
+        }
+    }
+
+    #[test]
+    fn xr_rows_respect_source_padding_and_destination_bounds() {
+        for format in FORMATS {
+            let mut src = encode(format, [384, 384, 894, 894], true);
+            src.extend(encode(format, [894, 384, 384, 639], true));
+            let source_len = src.len();
+            src.extend([0xab; 17]); // Row stride padding is not another pixel.
+            let mut dst = [0xcc; 12];
+            assert!(convert_row_to_rgba8(format, &src, 2, &mut dst));
+            let alpha = if bytes_per_pixel(format) == Some(4) {
+                255
+            } else {
+                128
+            };
+            assert_eq!(&dst[..8], &[255, 0, 0, 255, 0, 0, 255, alpha]);
+            assert_eq!(&dst[8..], &[0xcc; 4]);
+            dst.fill(0xcc);
+            assert!(!convert_row_to_rgba8(
+                format,
+                &src[..source_len - 1],
+                2,
+                &mut dst
+            ));
+            assert_eq!(dst, [0xcc; 12]);
+            assert!(!convert_row_to_rgba8(format, &src, 2, &mut dst[..7]));
+            assert_eq!(dst, [0xcc; 12]);
+            assert_eq!(
+                texel_to_rgba8(
+                    format,
+                    &src[..bytes_per_pixel(format).unwrap() as usize - 1]
+                ),
+                None
+            );
+        }
+    }
