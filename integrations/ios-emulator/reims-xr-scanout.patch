+/// Preserve encoded values, like the RGBA8/sRGB byte paths. Clamp only at the
+/// SDR capture boundary; round half steps upwards. Shader sampling must not
+/// use this narrowing conversion to represent extended-range values.
+#[inline]
+fn xr10_to_unorm8(code: u16) -> u8 {
+    code.saturating_sub(384).min(510).div_ceil(2) as u8
+}
+
+#[inline]
+fn bgr10_xr_to_rgba8(src: &[u8]) -> [u8; 4] {
+    let word = u32::from_le_bytes([src[0], src[1], src[2], src[3]]);
+    [
+        xr10_to_unorm8(((word >> 20) & 1023) as u16),
+        xr10_to_unorm8(((word >> 10) & 1023) as u16),
+        xr10_to_unorm8((word & 1023) as u16),
+        UNORM8_MAX,
+    ]
+}
+
+#[inline]
+fn bgra10_xr_to_rgba8(src: &[u8]) -> [u8; 4] {
+    [
+        xr10_to_unorm8(ld16(&src[4..6]) >> 6),
+        xr10_to_unorm8(ld16(&src[2..4]) >> 6),
+        xr10_to_unorm8(ld16(&src[0..2]) >> 6),
+        xr10_to_unorm8(ld16(&src[6..8]) >> 6),
+    ]
+}
