+/// Every colour slot this draw reads as an input attachment: the shader's own
+/// framebuffer fetches and the destinations of its shader-evaluated blends.
+pub(super) fn color_inputs(req: &DrawRequest) -> ColorInputs {
+    req.color_inputs.union(blended_slots(req))
 }
 
