+/// Round to the nearest binary16 value, ties to even, for normal half
+/// magnitudes; the values below stay well inside that range.
+fn binary16(value: f32) -> f32 {
+    if value == 0.0 {
+        return value;
+    }
+    let bits = value.to_bits();
+    let exponent = ((bits >> 23) & 0xff) as i32 - 127;
+    assert!(
+        (-14..=15).contains(&exponent),
+        "{value} leaves the normal binary16 range"
+    );
+    let dropped = 13;
+    let lsb = (bits >> dropped) & 1;
+    let rounded = bits + ((1 << (dropped - 1)) - 1) + lsb;
+    f32::from_bits(rounded & !((1 << dropped) - 1))
+}
