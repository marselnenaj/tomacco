+/// Slots whose blend the shader evaluates; each reads its target as a
+/// framebuffer input. Infallible so the attachment set has one derivation;
+/// `plan` refuses a draw before any of it is used.
+fn blended_slots(req: &DrawRequest) -> ColorInputs {
+    let mut inputs = ColorInputs::NONE;
+    if req.frag_spirv.is_none() {
+        return inputs;
+    }
+    let primary = req.color_attachment.and_then(|a| a.xr_format());
+    for (slot, (format, blend)) in std::iter::once((primary, req.blend))
+        .chain(
+            req.secondary_targets
+                .iter()
+                .map(|s| (s.attachment.xr_format(), s.blend)),
+        )
+        .enumerate()
+    {
+        if format.is_some() && blend.is_some_and(|b| !replaces_source(&b)) {
+            inputs = inputs.with_slot(slot as u32).unwrap_or(inputs);
+        }
+    }
+    inputs
+}
