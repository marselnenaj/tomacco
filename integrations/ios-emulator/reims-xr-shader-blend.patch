+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::backend::vulkan::engine::types::{ColorAttachmentState, ColorClearValue};
+    use reims_vgpu_core::blend::{BlendFactor, BlendOperation};
+
+    fn blend(src: BlendFactor, dst: BlendFactor) -> BlendStateResource {
+        BlendStateResource {
+            src_rgb: src.ordinal(),
+            dst_rgb: dst.ordinal(),
+            op_rgb: BlendOperation::Add.ordinal(),
+            src_alpha: src.ordinal(),
+            dst_alpha: dst.ordinal(),
+            op_alpha: BlendOperation::Add.ordinal(),
+        }
+    }
+
+    fn xr_draw(format: XrRenderFormat, state: Option<BlendStateResource>) -> DrawRequest {
+        DrawRequest {
+            frag_spirv: Some(Arc::new(vec![0])),
+            color_attachment: Some(ColorAttachmentState::xr(format, ColorClearValue::default())),
+            blend: state,
+            ..Default::default()
+        }
+    }
+
+    fn decline(req: &DrawRequest) -> &'static str {
+        use crate::observe::Decline;
+        match plan(req) {
+            Err(DrawError::DrawValidation(decline)) => decline.slug(),
+            other => panic!("expected a typed XR decline, got {other:?}"),
+        }
+    }
+
+    const NATIVE: XrRenderFormat = XrRenderFormat::NativeSurface(PlanarXrFormat::Rgb10Alpha8);
+
+    #[test]
+    fn source_over_on_a_clamped_xr_format_moves_into_the_shader_and_reads_its_target() {
+        for format in [NATIVE, XrRenderFormat::Interleaved(XrFormat::Bgr10)] {
+            let req = xr_draw(
+                format,
+                Some(blend(BlendFactor::One, BlendFactor::OneMinusSourceAlpha)),
+            );
+            let plan = plan(&req).expect("admitted");
+            let admitted = plan.blends[0].expect("the shader evaluates the blend");
+            assert_eq!(admitted.arithmetic, BlendArithmetic::Binary16);
+            assert_eq!(admitted.destination.binding, COLOR_INPUT_BINDING);
+            assert_eq!(color_inputs(&req), ColorInputs::PRIMARY);
+            assert_eq!(pipeline_blend(Some(format), req.blend), None);
+        }
+    }
+
+    #[test]
+    fn replacement_and_unblended_xr_draws_read_nothing() {
+        for state in [None, Some(blend(BlendFactor::One, BlendFactor::Zero))] {
+            let req = xr_draw(NATIVE, state);
+            assert_eq!(plan(&req).unwrap().blends, [None; 8]);
+            assert!(color_inputs(&req).is_empty());
+        }
+        let mut vertex_only = xr_draw(
+            NATIVE,
+            Some(blend(BlendFactor::One, BlendFactor::OneMinusSourceAlpha)),
+        );
+        vertex_only.frag_spirv = None;
+        assert!(color_inputs(&vertex_only).is_empty());
+    }
+
+    #[test]
+    fn unqualified_formats_and_unrepresentable_factors_keep_typed_refusals() {
+        use reims_vgpu_core::pixel_format::XrFormat as F;
+        let source_over = Some(blend(BlendFactor::One, BlendFactor::OneMinusSourceAlpha));
+        for format in [
+            XrRenderFormat::Interleaved(F::Bgra10),
+            XrRenderFormat::Interleaved(F::Bgra10Srgb),
+            XrRenderFormat::Interleaved(F::Bgr10Srgb),
+            XrRenderFormat::NativeSurface(PlanarXrFormat::Rgb10Alpha8Srgb),
+        ] {
+            assert_eq!(
+                decline(&xr_draw(format, source_over)),
+                "vk_xr_blend_format_unqualified",
+                "{format:?}"
+            );
+        }
+        for factor in [
+            BlendFactor::BlendColor,
+            BlendFactor::OneMinusBlendAlpha,
+            BlendFactor::Source1Color,
+        ] {
+            assert_eq!(
+                decline(&xr_draw(NATIVE, Some(blend(BlendFactor::One, factor)))),
+                "vk_xr_blend_factor_unsupported"
+            );
+        }
+        let mut unknown = blend(BlendFactor::One, BlendFactor::OneMinusSourceAlpha);
+        unknown.op_alpha = 9;
+        assert_eq!(
+            decline(&xr_draw(NATIVE, Some(unknown))),
+            "vk_xr_blend_operation_unknown"
+        );
+    }
+
+    #[test]
+    fn the_original_pbe15_clamp_is_the_documented_decimal_xr_range() {
+        let [red, _, _, alpha] = source_clamp(NATIVE).unwrap();
+        // Apple's published range, not the exact code endpoints: -384/510 and
+        // 638/510 round to bits three ulps further out.
+        let documented = SourceClamp::checked(-0.752941, 1.25098).unwrap();
+        assert_eq!(red, documented);
+        assert_ne!(
+            red,
+            SourceClamp::checked(-384.0 / 510.0, 638.0 / 510.0).unwrap()
+        );
+        assert_eq!(alpha, SourceClamp::checked(0.0, 1.0).unwrap());
+    }
+}
