+/// The original PBE source clamp of an XR format, where one is established.
+///
+/// Formats 550 and 554 share PBE-source enum 15, whose clamp payload is
+/// `0xbf40c0be..0x3fa0201d` for colour and `0..1` for alpha (AGX compiler
+/// format table). Those bits
+/// are the documented decimal range `-0.752941..1.25098`, slightly inside the
+/// exact code-0 and code-1022 values. The other XR formats have no recovered
+/// clamp and keep their blend refusal.
+fn source_clamp(format: XrRenderFormat) -> Option<[SourceClamp; 4]> {
+    match format {
+        XrRenderFormat::NativeSurface(PlanarXrFormat::Rgb10Alpha8)
+        | XrRenderFormat::Interleaved(XrFormat::Bgr10) => {}
+        _ => return None,
+    }
+    let colour =
+        SourceClamp::checked(f32::from_bits(0xbf40_c0be), f32::from_bits(0x3fa0_201d)).ok()?;
+    let alpha = SourceClamp::checked(0.0, 1.0).ok()?;
+    Some([colour, colour, colour, alpha])
+}
+
+/// The first declared blend term the shader cannot evaluate.
+enum UnsupportedTerm {
+    Factor(u32),
+    Operation(u32),
+}
+
+fn equation(
+    source: u32,
+    destination: u32,
+    operation: u32,
+) -> Result<BlendEquation, UnsupportedTerm> {
+    use metal2vulkan::fragment_color::{BlendFactor as F, BlendOperation as O};
+    use reims_vgpu_core::blend::{BlendFactor, BlendOperation};
+    let factor = |ordinal: u32| {
+        let unsupported = UnsupportedTerm::Factor(ordinal);
+        Ok(
+            match BlendFactor::parse(ordinal).ok_or(UnsupportedTerm::Factor(ordinal))? {
+                BlendFactor::Zero => F::Zero,
+                BlendFactor::One => F::One,
+                BlendFactor::SourceColor => F::SourceColor,
+                BlendFactor::OneMinusSourceColor => F::OneMinusSourceColor,
+                BlendFactor::SourceAlpha => F::SourceAlpha,
+                BlendFactor::OneMinusSourceAlpha => F::OneMinusSourceAlpha,
+                BlendFactor::DestinationColor => F::DestinationColor,
+                BlendFactor::OneMinusDestinationColor => F::OneMinusDestinationColor,
+                BlendFactor::DestinationAlpha => F::DestinationAlpha,
+                BlendFactor::OneMinusDestinationAlpha => F::OneMinusDestinationAlpha,
+                BlendFactor::SourceAlphaSaturated => F::SourceAlphaSaturated,
+                // The encoder's blend colour and the second source output are not
+                // operands of the translated shader.
+                BlendFactor::BlendColor
+                | BlendFactor::OneMinusBlendColor
+                | BlendFactor::BlendAlpha
+                | BlendFactor::OneMinusBlendAlpha
+                | BlendFactor::Source1Color
+                | BlendFactor::OneMinusSource1Color
+                | BlendFactor::Source1Alpha
+                | BlendFactor::OneMinusSource1Alpha => return Err(unsupported),
+            },
+        )
+    };
+    Ok(BlendEquation {
+        source: factor(source)?,
+        destination: factor(destination)?,
+        operation: match BlendOperation::parse(operation)
+            .ok_or(UnsupportedTerm::Operation(operation))?
+        {
+            BlendOperation::Add => O::Add,
+            BlendOperation::Subtract => O::Subtract,
+            BlendOperation::ReverseSubtract => O::ReverseSubtract,
+            BlendOperation::Min => O::Min,
+            BlendOperation::Max => O::Max,
+        },
+    })
+}
+
+/// The shader blend of one XR slot, admitted from the format's original clamp
+/// and the declared factors.
+fn programmable_blend(
+    slot: u32,
+    format: XrRenderFormat,
+    blend: BlendKey,
+) -> Result<ProgrammableBlend, DrawValidationDecline> {
+    let source_clamp =
+        source_clamp(format).ok_or(DrawValidationDecline::XrBlendFormatUnqualified { slot })?;
+    let refused = |term| match term {
+        UnsupportedTerm::Factor(ordinal) => {
+            DrawValidationDecline::XrBlendFactorUnsupported { slot, ordinal }
+        }
+        UnsupportedTerm::Operation(ordinal) => {
+            DrawValidationDecline::XrBlendOperationUnknown { slot, ordinal }
+        }
+    };
+    Ok(ProgrammableBlend {
+        color: equation(blend.src_rgb, blend.dst_rgb, blend.op_rgb).map_err(refused)?,
+        alpha: equation(blend.src_alpha, blend.dst_alpha, blend.op_alpha).map_err(refused)?,
+        source_clamp,
+        // AGX evaluates the PBE15 software blend in a Half4 configuration.
+        arithmetic: BlendArithmetic::Binary16,
+        destination: DestinationInput {
+            set: 0,
+            binding: COLOR_INPUT_BINDING + slot,
+        },
+    })
+}
