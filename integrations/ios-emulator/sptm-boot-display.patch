+static void init_research_dart(DarwinState *s, struct dtree_node *node,
+                               uint64_t iobase, const char *name)
+{
+    struct adt_io_reg *reg;
+    uint32_t *irq;
+    DeviceState *device;
+
+    if (!node || !adt_get_prop_val(node, "reg") ||
+        !adt_get_prop_val(node, "interrupts") ||
+        !adt_get_prop_val(node, "compatible") ||
+        adt_get_prop_len(node, "reg") != sizeof(*reg) ||
+        adt_get_prop_len(node, "interrupts") != sizeof(*irq) ||
+        adt_get_prop_len(node, "compatible") != sizeof("dart,t8110") ||
+        memcmp(adt_get_prop_val(node, "compatible"), "dart,t8110",
+               sizeof("dart,t8110"))) {
+        error_setg(&error_fatal, "research-dart requires a T8110 %s node", name);
+        return;
+    }
+    reg = adt_get_prop_val(node, "reg");
+    irq = adt_get_prop_val(node, "interrupts");
+    if (reg->len != 0xc000 || reg->base > UINT64_MAX - iobase - 0xc000 ||
+        irq[0] >= 0x400) {
+        error_setg(&error_fatal, "Unsupported research-dart register/IRQ layout");
+        return;
+    }
+    device = qdev_new("tomacco-dart-t8110");
+    object_property_add_child(OBJECT(s), name, OBJECT(device));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(device), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(device), 0, iobase + reg->base);
+    sysbus_connect_irq(SYS_BUS_DEVICE(device), 0,
+                       qdev_get_gpio_in(s->aic, irq[0]));
+}
