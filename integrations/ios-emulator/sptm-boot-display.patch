+
+static void init_research_ptd(DarwinState *s, struct dtree_node *root, uint64_t iobase)
+{
+    if (!s->research_ptd) {
+        return;
+    }
+    struct dtree_node *node = adt_find_node(root, "arm-io/mcc");
+    struct dtree_node *nub = adt_find_node(root, "arm-io/pmp/iop-pmp-nub");
+    if (!s->research_mcc || !node || !nub ||
+        !mcc_tree_u32(nub, "ptd-driver-version", 1) ||
+        !mcc_tree_u32(node, "pmp_ptd_db_reg_idx", 6) ||
+        !mcc_tree_u32(node, "pmp_ptd_update_reg_idx", 7)) {
+        error_setg(&error_fatal, "research-ptd requires the validated T8140 MCC/PTD binding");
+        return;
+    }
+    struct adt_io_reg *reg = adt_get_prop_val(node, "reg");
+    if (reg[6].base != 0xf03c0000 || reg[6].len != 0x4000 ||
+        reg[7].base != 0xf03d0000 || reg[7].len != 0x4000) {
+        error_setg(&error_fatal, "Unsupported T8140 PTD register views");
+        return;
+    }
+    DeviceState *device = qdev_new("tomacco-ptd-t8140");
+    object_property_add_child(OBJECT(s), "ptd", OBJECT(device));
+    object_property_set_link(OBJECT(device), "cpu", OBJECT(s->cpu), &error_fatal);
+    /* Transport only: no PMP response or unqualified SoC interrupt wiring. */
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(device), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(device), 0, iobase + reg[6].base);
+}
