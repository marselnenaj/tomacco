+static void prepare_boot_ramfile(struct xnu_boot_info *info, hwaddr base)
+{
+    if (!info->boot_media) {
+        return;
+    }
+    struct dtree_node *chosen = adt_find_node(info->dtree_f.buf, "chosen");
+    uint64_t *size = adt_get_prop_val(chosen, "boot-ramdmg-size");
+    uint64_t *extent = adt_get_prop_val(chosen, "boot-ramdmg-extents");
+
+    if (!size || !extent ||
+        adt_get_prop_len(chosen, "boot-ramdmg-size") != 8 ||
+        adt_get_prop_len(chosen, "boot-ramdmg-extents") != 16) {
+        error_setg(&error_fatal, "boot RAM image requires 8-byte size and 16-byte extent");
+        return;
+    }
+    *size = info->ramdisk_f.len;
+    extent[0] = base;
+    extent[1] = info->ramdisk_f.len;
+    fprintf(stderr, "TOMACCO_BOOT_RAMFILE base=0x%" HWADDR_PRIx " size=%zu\n",
+            base, info->ramdisk_f.len);
+}
+
+static void prepare_boot_video(struct xnu_boot_info *info, boot_args *args)
+{
+    struct dtree_node *vram;
+    uint64_t *reg;
+    hwaddr end, size, base;
+
+    if (!info->video_width) {
+        return;
+    }
+    vram = adt_find_node((struct dtree_node *)info->dtree_f.buf, "vram");
+    if (!vram || adt_get_prop_len(vram, "reg") != 16) {
+        error_setg(&error_fatal, "boot-display requires a 16-byte vram/reg");
+        return;
+    }
+    size = ROUND_NEXT_PAGE((uint64_t)info->video_stride * info->video_height);
+    end = info->dram_base + args->memSize;
+    if (size > args->memSize || end < info->dram_base) {
+        error_setg(&error_fatal, "boot-display does not fit in guest RAM");
+        return;
+    }
+    base = ROUND_DOWN_POW2(end - size, DARWIN_PAGE_SIZE);
+    if (base < args->topOfKernelData) {
+        error_setg(&error_fatal, "boot-display overlaps kernel boot data");
+        return;
+    }
+    info->video_base = base;
+    info->video_size = size;
+    reg = adt_get_prop_val(vram, "reg");
+    reg[0] = base;
+    reg[1] = size;
+    /* Keep the framebuffer out of XNU's page allocator and SPTM's typed
+     * bootstrap region. Extending topOfKernelData leaves untyped pages and
+     * makes SPTM reject the boot before the serial console is available. */
+    args->memSize = base - info->dram_base;
+    args->Video.v_baseAddr = base;
+    args->Video.v_display = 0; /* Text boot console, not a graphics driver. */
+    args->Video.v_width = info->video_width;
+    args->Video.v_height = info->video_height;
+    args->Video.v_rowBytes = info->video_stride;
+    args->Video.v_depth = 32;
+    fprintf(stderr, "TOMACCO_BOOT_DISPLAY base=0x%" HWADDR_PRIx
+            " size=%" HWADDR_PRIu " width=%u height=%u stride=%u\n",
+            base, size, info->video_width, info->video_height,
+            info->video_stride);
+}
