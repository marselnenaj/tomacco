+/* Supply XNU's documented boot RAM-image descriptors without modifying the
+ * input device tree. The image bytes already reside in reserved guest RAM.
+ * DiskImages registers real IOMedia; this is not a NAND controller or a
+ * persistent disk. Default boots retain the original memory-device path. */
+static void prepare_boot_media_tree(struct xnu_boot_info *info)
+{
+    struct dtree_node *chosen;
+    uint8_t *copy, *cursor;
+    size_t offset, length;
+    const char *names[] = { "boot-ramdmg-size", "boot-ramdmg-extents" };
+    const uint32_t sizes[] = { 8, 16 };
+    const size_t extra = 2 * sizeof(struct dtree_prop) + 24;
+
+    if (!info->boot_media) {
+        return;
+    }
+    chosen = adt_find_node(info->dtree_f.buf, "chosen");
+    if (!chosen) {
+        error_setg(&error_fatal, "boot-media requires a chosen device-tree node");
+        return;
+    }
+    if (adt_get_prop_val(chosen, names[0]) ||
+        adt_get_prop_val(chosen, names[1])) {
+        /* The loader validates existing descriptors before updating them. */
+        return;
+    }
+    offset = (uint8_t *)(chosen + 1) - (uint8_t *)info->dtree_f.buf;
+    if (offset > info->dtree_f.len || info->dtree_f.len > SIZE_MAX - extra ||
+        chosen->nProperties > UINT32_MAX - 2) {
+        error_setg(&error_fatal, "Invalid boot-media device tree");
+        return;
+    }
+    length = info->dtree_f.len + extra;
+    copy = mmap(NULL, length, PROT_READ | PROT_WRITE,
+                MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (copy == MAP_FAILED) {
+        error_setg_errno(&error_fatal, errno, "Cannot allocate boot-media device tree");
+        return;
+    }
+    memcpy(copy, info->dtree_f.buf, offset);
+    cursor = copy + offset;
+    for (unsigned i = 0; i < G_N_ELEMENTS(names); i++) {
+        struct dtree_prop *prop = (struct dtree_prop *)cursor;
+        g_strlcpy(prop->name, names[i], sizeof(prop->name));
+        prop->length = sizes[i];
+        cursor += sizeof(*prop) + sizes[i];
+    }
+    memcpy(cursor, (uint8_t *)info->dtree_f.buf + offset,
+           info->dtree_f.len - offset);
+    chosen = (struct dtree_node *)(copy + offset - sizeof(*chosen));
+    chosen->nProperties += 2;
+    munmap(info->dtree_f.buf, info->dtree_f.len);
+    info->dtree_f.buf = copy;
+    info->dtree_f.len = length;
+}
+
+static bool boot_display_update(void *opaque)
+{
+    DarwinState *s = opaque;
+    qemu_console_update_full(s->boot_console);
+    return true;
+}
+
+static const GraphicHwOps boot_display_ops = {
+    .gfx_update = boot_display_update,
+};
+
+static void boot_display_unmap(pixman_image_t *image, void *unused)
+{
+    physical_memory_unmap(pixman_image_get_data(image),
+                         (hwaddr)pixman_image_get_stride(image) *
+                         pixman_image_get_height(image), false, 0);
+}
+
+static void init_boot_display(DarwinState *s)
+{
+    struct xnu_boot_info *info = &s->bootinfo;
+    hwaddr size = (hwaddr)info->video_stride * info->video_height;
+    hwaddr mapped = size;
+    DisplaySurface *surface;
+    void *pixels;
+
+    if (!size) {
+        return;
+    }
+    pixels = physical_memory_map(info->video_base, &mapped, false);
+    if (!pixels || mapped != size) {
+        if (pixels) {
+            physical_memory_unmap(pixels, mapped, false, 0);
+        }
+        error_setg(&error_fatal, "Cannot map boot-display guest RAM");
+        return;
+    }
+    surface = qemu_create_displaysurface_from(info->video_width,
+                  info->video_height, PIXMAN_x8r8g8b8, info->video_stride, pixels);
+    pixman_image_set_destroy_function(surface->image, boot_display_unmap, NULL);
+    s->boot_console = qemu_graphic_console_create(NULL, 0, &boot_display_ops, s);
+    qemu_console_set_surface(s->boot_console, surface);
+}
+
+static void parse_boot_display(struct xnu_boot_info *info)
+{
+    unsigned width, height;
+    char extra;
+
+    if (!info->boot_display) {
+        return;
+    }
+    if (sscanf(info->boot_display, "%ux%u%c", &width, &height, &extra) != 2 ||
+        width < 64 || width > 4096 || height < 64 || height > 4096) {
+        error_setg(&error_fatal, "boot-display must be WIDTHxHEIGHT (64..4096)");
+        return;
+    }
+    info->video_width = width;
+    info->video_height = height;
+    info->video_stride = ROUND_UP_POW2(width * 4, 64);
+}
 
