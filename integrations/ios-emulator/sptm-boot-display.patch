+typedef struct BootStorage {
+    MemoryRegion ram;
+    Notifier exit;
+    int fd;
+    size_t size;
+} BootStorage;
+
+static void flush_boot_storage(Notifier *notifier, void *unused)
+{
+    BootStorage *storage = container_of(notifier, BootStorage, exit);
+    int mapped, file;
+
+    do {
+        mapped = msync(memory_region_get_ram_ptr(&storage->ram),
+                       storage->size, MS_SYNC);
+    } while (mapped < 0 && errno == EINTR);
+    if (mapped < 0) {
+        error_report("boot-storage msync failed: %s", strerror(errno));
+    }
+    do {
+        file = fsync(storage->fd);
+    } while (file < 0 && errno == EINTR);
+    if (file < 0) {
+        error_report("boot-storage fsync failed: %s", strerror(errno));
+    }
+    fprintf(stderr, "TOMACCO_BOOT_STORAGE_FLUSH bytes=%zu msync=%d fsync=%d\n",
+            storage->size, mapped, file);
+    /* This flush cannot replace a clean guest filesystem unmount. */
+}
+
+static void load_boot_ramdisk(struct xnu_boot_info *info, MachineState *ms,
+                             hwaddr base)
+{
+    struct stat file;
+    BootStorage *storage;
+    int fd;
+
+    if (base < info->dram_base || base - info->dram_base > info->dram_size ||
+        info->ramdisk_f.len > info->dram_size - (base - info->dram_base)) {
+        error_setg(&error_fatal, "boot RAM image does not fit in guest memory");
+        return;
+    }
+    if (!info->boot_storage) {
+        if (address_space_write(&address_space_memory, base,
+                                MEMTXATTRS_UNSPECIFIED, info->ramdisk_f.buf,
+                                info->ramdisk_f.len) != MEMTX_OK) {
+            error_setg(&error_fatal, "Cannot load boot RAM image");
+        }
+        return;
+    }
+    if (!info->boot_media || info->boot_storage[0] != '/' ||
+        info->ramdisk_f.len % DARWIN_PAGE_SIZE) {
+        error_setg(&error_fatal, "boot-storage requires boot-media, an absolute "
+                   "working-copy path and a page-aligned image");
+        return;
+    }
+    /* No creation/truncation here. The caller owns preparation of an explicit
+     * working copy. Refuse devices, aliases of the source and shared inodes. */
+    fd = open(info->boot_storage, O_RDWR | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+    if (fd < 0) {
+        error_setg_errno(&error_fatal, errno, "Cannot open boot-storage copy");
+        return;
+    }
+    if (fstat(fd, &file) || !S_ISREG(file.st_mode) ||
+        file.st_uid != geteuid() || file.st_nlink != 1 ||
+        (file.st_mode & 0077) || file.st_size != info->ramdisk_f.len ||
+        (file.st_dev == info->ramdisk_f.device &&
+         file.st_ino == info->ramdisk_f.inode)) {
+        close(fd);
+        error_setg(&error_fatal, "boot-storage must be a separate owner-only "
+                   "regular image copy with exactly the source size");
+        return;
+    }
+    if (flock(fd, LOCK_EX | LOCK_NB)) {
+        close(fd);
+        error_setg(&error_fatal, "boot-storage copy is already in use");
+        return;
+    }
+    storage = g_new0(BootStorage, 1);
+    storage->fd = fd;
+    storage->size = file.st_size;
+    /* Overlay just the reserved RAM-image extent. mmap faults in the pages
+     * actually read by the guest, without an eager multi-GiB memory copy.
+     * The RAMBlock owns the descriptor (and lock) for the engine lifetime. */
+    memory_region_init_ram_from_fd(&storage->ram, OBJECT(ms), "boot-storage",
+                                   storage->size, RAM_SHARED | RAM_NAMED_FILE,
+                                   fd, 0, &error_fatal);
+    memory_region_add_subregion_overlap(get_system_memory(), base,
+                                        &storage->ram, 1);
+    storage->exit.notify = flush_boot_storage;
+    qemu_add_exit_notifier(&storage->exit);
+    fprintf(stderr, "TOMACCO_BOOT_STORAGE base=0x%" HWADDR_PRIx
+            " bytes=%zu shared=1 source_preserved=1\n", base, storage->size);
+}
