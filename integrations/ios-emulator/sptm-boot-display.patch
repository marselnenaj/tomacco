+static void init_dcp_dart(DarwinState *s, struct dtree_node *root,
+                          uint64_t iobase)
+{
+    struct dtree_node *aop;
+    if (!s->research_dart) {
+        return;
+    }
+    init_research_dart(s, adt_find_node(root, "arm-io/dart-dcp"), iobase, "dart-dcp");
+    aop = adt_find_node(root, "arm-io/dart-aop");
+    if (s->bootinfo.cl4 && aop && adt_get_prop_val(aop, "compatible")) {
+        init_research_dart(s, aop, iobase, "dart-aop");
+    }
+}
