+    mc->default_ram_size = 64 * 1024 * 1024;
+    mc->default_ram_id = "tomacco-apple-cpu-test.ram";
+    mc->no_serial = mc->no_parallel = mc->no_floppy = mc->no_cdrom = true;
+}
