+/* These are iBoot descriptors for an actual, separately supplied secure kernel.
+ * Enabling the property alone never substitutes for booting that kernel. */
+static void cl4_tree_property(struct xnu_boot_info *info, const char *path,
+                              const char *name, uint32_t bytes)
+{
+    struct dtree_node *node = adt_find_node(info->dtree_f.buf, path);
+    uint8_t *copy;
+    size_t offset, extra = sizeof(struct dtree_prop) + ROUND_UP(bytes, 4);
+    struct dtree_prop *prop;
+
+    if (!node) {
+        error_setg(&error_fatal, "CL4 requires device-tree node %s", path);
+        return;
+    }
+    if (adt_get_prop_val(node, name)) {
+        if (adt_get_prop_len(node, name) != bytes) {
+            error_setg(&error_fatal, "CL4 property %s/%s has wrong size", path, name);
+        }
+        return;
+    }
+    offset = (uint8_t *)(node + 1) - (uint8_t *)info->dtree_f.buf;
+    if (offset > info->dtree_f.len || info->dtree_f.len > SIZE_MAX - extra ||
+        node->nProperties == UINT32_MAX) {
+        error_setg(&error_fatal, "Invalid CL4 device tree");
+        return;
+    }
+    copy = mmap(NULL, info->dtree_f.len + extra, PROT_READ | PROT_WRITE,
+                MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (copy == MAP_FAILED) {
+        error_setg_errno(&error_fatal, errno, "Cannot allocate CL4 device tree");
+        return;
+    }
+    memcpy(copy, info->dtree_f.buf, offset);
+    prop = (struct dtree_prop *)(copy + offset);
+    g_strlcpy(prop->name, name, sizeof(prop->name));
+    prop->length = bytes;
+    memcpy(copy + offset + extra, (uint8_t *)info->dtree_f.buf + offset,
+           info->dtree_f.len - offset);
+    node = (struct dtree_node *)(copy + offset - sizeof(*node));
+    node->nProperties++;
+    munmap(info->dtree_f.buf, info->dtree_f.len);
+    info->dtree_f.buf = copy;
+    info->dtree_f.len += extra;
+}
+
+/* Insert a named child into the private boot-time tree. Firmware trees omit
+ * iBoot's dynamically allocated Exclave metadata descriptors. */
+static void cl4_tree_node(struct xnu_boot_info *info, const char *parent,
+                          const char *name)
+{
+    g_autofree char *path = g_strdup_printf("%s/%s", parent, name);
+    struct dtree_node *node;
+    struct dtree_prop *prop;
+    size_t parent_offset, offset, bytes = strlen(name) + 1;
+    size_t extra = sizeof(*node) + sizeof(*prop) + ROUND_UP(bytes, 4);
+    uint8_t *copy;
+
+    if (adt_find_node(info->dtree_f.buf, path)) {
+        return;
+    }
+    node = adt_find_node(info->dtree_f.buf, parent);
+    if (!node || node->nChildren == UINT32_MAX || bytes > 64 ||
+        info->dtree_f.len > SIZE_MAX - extra) {
+        error_setg(&error_fatal, "Invalid CL4 parent node %s", parent);
+        return;
+    }
+    parent_offset = (uint8_t *)node - (uint8_t *)info->dtree_f.buf;
+    offset = parent_offset + sizeof(*node);
+    for (unsigned i = 0; i < node->nProperties; i++) {
+        size_t length;
+        if (offset > info->dtree_f.len || info->dtree_f.len - offset < sizeof(*prop)) {
+            error_setg(&error_fatal, "Truncated CL4 parent node %s", parent);
+            return;
+        }
+        prop = (struct dtree_prop *)((uint8_t *)info->dtree_f.buf + offset);
+        length = ROUND_UP((size_t)(prop->length & 0x7fffffff), 4);
+        offset += sizeof(*prop);
+        if (length > info->dtree_f.len - offset) {
+            error_setg(&error_fatal, "Truncated CL4 property in %s", parent);
+            return;
+        }
+        offset += length;
+    }
+    copy = mmap(NULL, info->dtree_f.len + extra, PROT_READ | PROT_WRITE,
+                MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (copy == MAP_FAILED) {
+        error_setg_errno(&error_fatal, errno, "Cannot allocate CL4 child node");
+        return;
+    }
+    memcpy(copy, info->dtree_f.buf, offset);
+    ((struct dtree_node *)(copy + parent_offset))->nChildren++;
+    node = (struct dtree_node *)(copy + offset);
+    node->nProperties = 1;
+    prop = (struct dtree_prop *)(node + 1);
+    g_strlcpy(prop->name, "name", sizeof(prop->name));
+    prop->length = bytes;
+    memcpy(prop + 1, name, bytes);
+    memcpy(copy + offset + extra, (uint8_t *)info->dtree_f.buf + offset,
+           info->dtree_f.len - offset);
+    munmap(info->dtree_f.buf, info->dtree_f.len);
+    info->dtree_f.buf = copy;
+    info->dtree_f.len += extra;
+}
+
+static void prepare_cl4_tree(struct xnu_boot_info *info)
+{
+    struct dtree_node *chosen;
+    uint32_t *enabled;
+    const char *regions[] = { "CL4-rx", "CL4-ro", "CL4-rw", "CL4-le",
+        "CL4-entry", "CL4-virt", "CL4-dummypage",
+        "ExclaveOSIntegrityCatalog", "ExclaveOSTrustCache" };
+    if (!info->cl4) {
+        if (info->exclave_integrity || info->exclave_trustcache) {
+            error_setg(&error_fatal, "Exclave metadata requires research-cl4");
+        }
+        return;
+    }
+    if (!info->sptm || !info->exclave_integrity || !info->exclave_trustcache) {
+        error_setg(&error_fatal, "research-cl4 requires SPTM, exclave-integrity and exclave-trustcache");
+        return;
+    }
+    info->cl4_f = check_and_open(info->cl4, "error opening CL4 bundle");
+    info->exclave_integrity_f = check_and_open(info->exclave_integrity, "error opening Exclave integrity catalog");
+    info->exclave_trustcache_f = check_and_open(info->exclave_trustcache, "error opening Exclave trust cache");
+    if (!info->exclave_integrity_f.len || info->exclave_integrity_f.len > 16 * MiB ||
+        !info->exclave_trustcache_f.len || info->exclave_trustcache_f.len > 16 * MiB) {
+        error_setg(&error_fatal, "Exclave metadata must be nonempty and at most 16 MiB each");
+        return;
+    }
+    cl4_tree_property(info, "chosen", "exclaves-enabled", 4);
+    cl4_tree_property(info, "chosen", "cl4-entropy", 192);
+    for (unsigned i = 0; i < G_N_ELEMENTS(regions); i++) {
+        cl4_tree_property(info, "chosen/memory-map", regions[i], 16);
+    }
+    cl4_tree_node(info, "chosen", "exclave-memory-map");
+    for (unsigned i = 7; i < G_N_ELEMENTS(regions); i++) {
+        g_autofree char *path = g_strdup_printf("chosen/exclave-memory-map/%s", regions[i]);
+        cl4_tree_node(info, "chosen/exclave-memory-map", regions[i]);
+        cl4_tree_property(info, path, "range", 16);
+        cl4_tree_property(info, path, "flags", 4);
+        stl_le_p(adt_get_prop_val(adt_find_node(info->dtree_f.buf, path), "flags"), 0);
+    }
+    chosen = adt_find_node(info->dtree_f.buf, "chosen");
+    enabled = adt_get_prop_val(chosen, "exclaves-enabled");
+    stl_le_p(enabled, 1);
+    qemu_guest_getrandom_nofail(adt_get_prop_val(chosen, "cl4-entropy"), 192);
+}
