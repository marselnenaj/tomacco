+/* UPERM follows the current translation regime. HUPERM/VUPERM are explicit
+ * EL2 accessors, so switching between TXM and ExclaveCore cannot overwrite
+ * the other world's EL0 permissions. */
+static unsigned sprr_user_bank(CPUARMState *env, const ARMCPRegInfo *ri)
+{
+    if (ri->opc1 == 4) {
+        return ri->opc2 == 1 ? 2 : 1;
+    }
+    return el_is_in_host(env, arm_current_el(env)) ? 2 : 1;
+}
+
+static uint64_t sprr_user_read(CPUARMState *env, const ARMCPRegInfo *ri)
+{
+    return env->sprr_uperm_el[sprr_user_bank(env, ri)];
+}
+
+static void sprr_user_write(CPUARMState *env, const ARMCPRegInfo *ri, uint64_t value)
+{
+    unsigned bank = sprr_user_bank(env, ri);
+    if (env->sprr_uperm_el[bank] != value) {
+        env->sprr_uperm_el[bank] = value;
+        tlb_flush(env_cpu(env));
+    }
+}
+
+static const ARMCPRegInfo apple_user_permissions[] = {
+    { .name = "SPRR_UPERM_EL0", .state = ARM_CP_STATE_AA64, .access = PL0_RW,
+      .type = ARM_CP_ALIAS | ARM_CP_NO_RAW,
+      .opc0 = 3, .opc1 = 6, .crn = 15, .crm = 1, .opc2 = 5,
+      .readfn = sprr_user_read, .writefn = sprr_user_write },
+    { .name = "SPRR_HUPERM_EL0", .state = ARM_CP_STATE_AA64, .access = PL2_RW,
+      .opc0 = 3, .opc1 = 4, .crn = 15, .crm = 5, .opc2 = 1,
+      .fieldoffset = offsetof(CPUARMState, sprr_uperm_el[2]),
+      .writefn = sprr_user_write },
+    { .name = "SPRR_VUPERM_EL0", .state = ARM_CP_STATE_AA64, .access = PL2_RW,
+      .opc0 = 3, .opc1 = 4, .crn = 15, .crm = 5, .opc2 = 2,
+      .fieldoffset = offsetof(CPUARMState, sprr_uperm_el[1]),
+      .writefn = sprr_user_write },
+};
+
+/* The supplied T8140 tree exposes a read-only 64-bit Siri timebase counter.
+ * Use the same virtual clock and frequency as the emulated physical CPU
+ * counter. This keeps pause/resume and the synthetic boot timebase consistent;
+ * it is neither wall-clock time nor a success-returning service endpoint. */
+static MemTxResult exclave_timebase_read(void *opaque, hwaddr offset,
+                                         uint64_t *value, unsigned size,
+                                         MemTxAttrs attrs)
+{
+    ARMCPU *cpu = opaque;
+    if (offset != 0 || size != 8) {
+        return MEMTX_ACCESS_ERROR;
+    }
+    *value = gt_get_countervalue(&cpu->env);
+    return MEMTX_OK;
+}
+
+static MemTxResult exclave_timebase_write(void *opaque, hwaddr offset,
+                                          uint64_t value, unsigned size,
+                                          MemTxAttrs attrs)
+{
+    return MEMTX_ACCESS_ERROR;
+}
+
+static const MemoryRegionOps exclave_timebase_ops = {
+    .read_with_attrs = exclave_timebase_read,
+    .write_with_attrs = exclave_timebase_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 8, .max_access_size = 8 },
+    .impl = { .min_access_size = 8, .max_access_size = 8 },
+};
+
+void apple_exclave_timebase_init(ARMCPU *cpu, Object *owner,
+                                 MemoryRegion *region, hwaddr address)
+{
+    memory_region_init_io(region, owner, &exclave_timebase_ops, cpu,
+                          "exclave-timebase", 8);
+    memory_region_add_subregion(get_system_memory(), address, region);
+}
