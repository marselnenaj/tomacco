+/* Real CPU instructions and the production register bank, with plain RAM and
+ * no Apple firmware. Tests supply their own tiny ELF using the generic loader. */
+static void apple_cpu_test_init(MachineState *machine)
+{
+    ARMCPU *cpu = ARM_CPU(object_new(machine->cpu_type));
+    MemoryRegion *timebase = g_new0(MemoryRegion, 1);
+    cpu->has_el2 = true;
+    cpu->has_el3 = false;
+    cpu->gt_cntfrq_hz = 1000000;
+    unset_feature(&cpu->env, ARM_FEATURE_CBAR);
+    unset_feature(&cpu->env, ARM_FEATURE_CBAR_RO);
+    unset_feature(&cpu->env, ARM_FEATURE_EL3);
+    unset_feature(&cpu->env, ARM_FEATURE_PMU);
+    set_feature(&cpu->env, ARM_FEATURE_EL2);
+    cpu->env.apple_state = g_new0(apple_state_t, 1);
+    define_arm_cp_regs(cpu, apple_sysregs);
+    define_arm_cp_regs(cpu, apple_user_permissions);
+    qdev_realize(DEVICE(cpu), NULL, &error_fatal);
+    memory_region_add_subregion(get_system_memory(), 0, machine->ram);
+    apple_exclave_timebase_init(cpu, OBJECT(machine), timebase, 0x10000000);
+}
