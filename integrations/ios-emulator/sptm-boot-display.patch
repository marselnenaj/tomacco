+/* PMGR scratch word containing the consistent-debug registry PFN. With no
+ * debugger registry installed it is zero. This is one retained 32-bit word,
+ * not a permissive mapping of the PMGR block: all other PMGR registers remain
+ * unimplemented. CL4 checks this optional pointer before setting up services. */
+static uint64_t cl4_debug_read(void *opaque, hwaddr offset, unsigned size)
+{
+    return ((DarwinState *)opaque)->cl4_debug_root;
+}
+
+static void cl4_debug_write(void *opaque, hwaddr offset, uint64_t value,
+                            unsigned size)
+{
+    ((DarwinState *)opaque)->cl4_debug_root = value;
+}
+
+static const MemoryRegionOps cl4_debug_ops = {
+    .read = cl4_debug_read,
+    .write = cl4_debug_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void init_cl4_debug_root(DarwinState *s, struct dtree_node *root,
+                               uint64_t iobase)
+{
+    struct dtree_node *pmgr;
+    struct adt_io_reg *reg;
+    bool found = false;
+    if (!s->bootinfo.cl4) {
+        return;
+    }
+    pmgr = adt_find_node(root, "arm-io/pmgr");
+    if (!pmgr || iobase != 0x210000000 || !adt_get_prop_val(pmgr, "reg") ||
+        adt_get_prop_len(pmgr, "reg") % sizeof(*reg)) {
+        error_setg(&error_fatal, "CL4 debug scratch requires the T8140 PMGR layout");
+        return;
+    }
+    reg = adt_get_prop_val(pmgr, "reg");
+    for (unsigned i = 0; reg && i < adt_get_prop_len(pmgr, "reg") / sizeof(*reg); i++) {
+        found |= reg[i].base == 0xf82b8000 && reg[i].len == 0x10000;
+    }
+    if (!found) {
+        error_setg(&error_fatal, "CL4 debug scratch register is absent from PMGR");
+        return;
+    }
+    memory_region_init_io(&s->cl4_debug_root_mmio, OBJECT(s), &cl4_debug_ops, s,
+                          "cl4-debug-registry-pfn", 4);
+    memory_region_add_subregion(get_system_memory(), iobase + 0xf82b8004,
+                                &s->cl4_debug_root_mmio);
+}
+
+static void init_cl4_timebase(DarwinState *s, struct dtree_node *root)
+{
+    struct dtree_node *node;
+    struct adt_io_reg *reg;
+    if (!s->bootinfo.cl4) {
+        return;
+    }
+    node = adt_find_node(root, "arm-io/siri-exclave-timebase");
+    if (!node || !adt_get_prop_val(node, "reg") ||
+        adt_get_prop_len(node, "reg") != sizeof(*reg)) {
+        error_setg(&error_fatal, "CL4 requires the T8140 Siri timebase descriptor");
+        return;
+    }
+    reg = adt_get_prop_val(node, "reg");
+    /* This exclave-assigned descriptor is already an absolute PA, unlike
+     * the relative DART register tuples below. Keep all other offsets unmapped. */
+    if (reg->base != 0x3482a8000 || reg->len != 0x4000) {
+        error_setg(&error_fatal, "Unsupported CL4 timebase register layout");
+        return;
+    }
+    apple_exclave_timebase_init(s->cpu, OBJECT(s), &s->cl4_timebase_mmio,
+                                reg->base);
+}
+
+static bool mcc_tree_u32(struct dtree_node *node, const char *name, uint32_t expected)
+{
+    void *value = adt_get_prop_val(node, name);
+    return value && adt_get_prop_len(node, name) == 4 && ldl_le_p(value) == expected;
+}
+
+static void init_research_mcc(DarwinState *s, struct dtree_node *root, uint64_t iobase)
+{
+    struct dtree_node *node;
+    struct adt_io_reg *reg;
+    void *dram;
+    DeviceState *device;
+    if (!s->research_mcc) {
+        return;
+    }
+    node = adt_find_node(root, "arm-io/mcc");
+    if (!node || iobase != 0x210000000 ||
+        !adt_get_prop_val(node, "compatible") ||
+        adt_get_prop_len(node, "compatible") != sizeof("mcc,t8140") ||
+        memcmp(adt_get_prop_val(node, "compatible"), "mcc,t8140", sizeof("mcc,t8140")) ||
+        !mcc_tree_u32(node, "amcc-count", 1) ||
+        !mcc_tree_u32(node, "dcs-count-per-amcc", 4) ||
+        !mcc_tree_u32(node, "amcc-reg-idx", 2) ||
+        !mcc_tree_u32(node, "dcs-reg-idx", 8) ||
+        !adt_get_prop_val(node, "reg") ||
+        adt_get_prop_len(node, "reg") != 12 * sizeof(*reg) ||
+        !adt_get_prop_val(node, "dramcfg-data") ||
+        adt_get_prop_len(node, "dramcfg-data") != 8) {
+        error_setg(&error_fatal, "research-mcc requires the T8140 MCC tree layout and dramcfg-data");
+        return;
+    }
+    reg = adt_get_prop_val(node, "reg");
+    if (reg[2].base != 0x10000000 || reg[2].len != 0x140000) {
+        error_setg(&error_fatal, "Unsupported T8140 AMCC register range");
+        return;
+    }
+    for (unsigned i = 0; i < 4; ++i) {
+        if (reg[8 + i].base != 0x10400000 + i * 0x200000 ||
+            reg[8 + i].len != 0x8000) {
+            error_setg(&error_fatal, "Unsupported T8140 DCS register range");
+            return;
+        }
+    }
+    dram = adt_get_prop_val(node, "dramcfg-data");
+    device = qdev_new("tomacco-mcc-t8140");
+    object_property_add_child(OBJECT(s), "mcc", OBJECT(device));
+    /* Start the functional memory model in the tree's configured DRAM mode.
+     * The original driver writes this second word to DCS + 0x1d48. This is an
+     * explicit emulator boot policy, not an assertion of silicon POR state. */
+    qdev_prop_set_uint64(device, "dram-config", ldl_le_p((uint8_t *)dram + 4));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(device), &error_fatal);
+    /* Preserve CTRR ownership, including unexpected future tree layouts. */
+    if (s->amcc) {
+        for (unsigned i = 0; i < AMCC_NUM_BANKS; ++i) {
+            uint32_t lower = s->amcc->lwr_reg[i];
+            uint32_t upper = s->amcc->upr_reg[i];
+            if (((uint64_t)lower + 4 > PMCC_GATE_WINDOW &&
+                 lower < PMCC_GATE_WINDOW + PMCC_GATE_WINDOW_SIZE) ||
+                ((uint64_t)upper + 4 > PMCC_GATE_WINDOW &&
+                 upper < PMCC_GATE_WINDOW + PMCC_GATE_WINDOW_SIZE)) {
+                error_setg(&error_fatal, "MCC maintenance gate overlaps CTRR registers");
+                return;
+            }
+        }
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(device), 0, iobase + reg[2].base + 0x1000);
+    sysbus_mmio_map_overlap(SYS_BUS_DEVICE(device), 1 + PMCC_CHANNELS,
+                           iobase + reg[2].base + PMCC_GATE_WINDOW, 1);
+    for (unsigned i = 0; i < 4; ++i) {
+        sysbus_mmio_map(SYS_BUS_DEVICE(device), i + 1, iobase + reg[8 + i].base);
+    }
+}
