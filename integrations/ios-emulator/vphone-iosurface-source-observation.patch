diff --git a/target/arm/tcg/vphone-surface-source.h b/target/arm/tcg/vphone-surface-source.h
new file mode 100644
--- /dev/null
+++ b/target/arm/tcg/vphone-surface-source.h
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef TOMACCO_VPHONE_SURFACE_SOURCE_H
+#define TOMACCO_VPHONE_SURFACE_SOURCE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define TOMACCO_SURFACE_PRODUCER_PC UINT64_C(0xfffffe0007ed60a4)
+#define TOMACCO_SURFACE_PRODUCER_INSN UINT32_C(0xd503237f)
+#define TOMACCO_SURFACE_KERNEL_BASE UINT64_C(0xfffffe0007004000)
+#define TOMACCO_SURFACE_LAST_GUARD_END UINT64_C(0xfffffe00087d0334)
+#define TOMACCO_SURFACE_OBJECT_BYTES 0x9c
+#define TOMACCO_SURFACE_TARGET_FORMAT UINT32_C(0x5f524234)
+
+/* Original kernel -> client+0x38 -> response+0x18 -> user client+0x88
+ * -> IOSurfaceGetID. These are native IDs, not mapper/object-list references.
+ * This observes object fields at descriptor entry, before descriptor writes.
+ * It establishes no channel order, numeric encoding or generation binding. */
+typedef struct TomaccoSurfaceSource {
+    uint32_t native_id;
+    uint32_t pixel_format;
+    uint32_t planes;
+    uint64_t width;
+    uint64_t height;
+} TomaccoSurfaceSource;
+
+static inline uint32_t tomacco_surface_u32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+           (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline uint64_t tomacco_surface_u64(const uint8_t *p)
+{
+    return (uint64_t)tomacco_surface_u32(p) |
+           (uint64_t)tomacco_surface_u32(p + 4) << 32;
+}
+
+/* The loader supplies the actual placement; no masked-PC search or guessed
+ * address is accepted. Refuse unsupported bases and every guard-span overflow.
+ * Failure leaves the output unchanged. Runtime code guards still corroborate
+ * this placement before any object field is captured. */
+static inline bool tomacco_surface_kernel_entry(uint64_t original_base,
+                                               uint64_t loaded_base,
+                                               uint64_t *entry)
+{
+    if (!entry || original_base != TOMACCO_SURFACE_KERNEL_BASE ||
+        loaded_base < original_base || (loaded_base & 0x3fff)) {
+        return false;
+    }
+    uint64_t slide = loaded_base - original_base;
+    if (slide > UINT64_MAX - TOMACCO_SURFACE_LAST_GUARD_END) {
+        return false;
+    }
+    *entry = TOMACCO_SURFACE_PRODUCER_PC + slide;
+    return true;
+}
+
+static inline bool tomacco_surface_source_pc(uint64_t pc, unsigned el,
+                                             uint32_t instruction,
+                                             uint64_t expected_pc)
+{
+    return expected_pc && pc == expected_pc && el == 1 &&
+           instruction == TOMACCO_SURFACE_PRODUCER_INSN;
+}
+
+static inline bool tomacco_surface_source_decode(const uint8_t *bytes,
+                                                size_t length,
+                                                TomaccoSurfaceSource *out)
+{
+    if (!bytes || !out || length < TOMACCO_SURFACE_OBJECT_BYTES) {
+        return false;
+    }
+    TomaccoSurfaceSource value = {
+        .native_id = tomacco_surface_u32(bytes + 0x10),
+        .pixel_format = tomacco_surface_u32(bytes + 0x80),
+        .planes = tomacco_surface_u32(bytes + 0x98),
+        .width = tomacco_surface_u64(bytes + 0x58),
+        .height = tomacco_surface_u64(bytes + 0x60),
+    };
+    /* Preserve valid zero/nonplanar values and the full native ID bits. */
+    if (value.planes > 7 || value.width > 0xffffff ||
+        value.height > 0xffffff) {
+        return false;
+    }
+    *out = value;
+    return true;
+}
+
+/* Saturating process-wide capture slots. No overflow can reopen the budget. */
+static inline unsigned tomacco_surface_source_slot(unsigned *counter,
+                                                   unsigned limit)
+{
+    unsigned value = __atomic_load_n(counter, __ATOMIC_RELAXED);
+    while (value < limit) {
+        if (__atomic_compare_exchange_n(counter, &value, value + 1, false,
+                                         __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+            return value + 1;
+        }
+    }
+    return 0;
+}
+
+bool tomacco_surface_source_enabled(void);
+void tomacco_surface_source_bind_kernel(uint64_t original_base,
+                                      uint64_t loaded_base);
+/* Published once during loader initialization, before vCPU execution. Zero
+ * disables entry selection. Atomic reads preserve the startup binding. */
+extern uint64_t tomacco_surface_source_runtime_pc;
+
+#endif
