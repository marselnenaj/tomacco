+#include "vphone-surface-source.h"
+#ifndef CONFIG_USER_ONLY
+#include "qemu/rcu.h"
+#include "system/memory.h"
+#endif
+
+/* A process-start opt-in: changing tracing at runtime cannot silently change
+ * translated instruction paths. The flag enables evidence, not CPU features. */
+bool tomacco_surface_source_enabled(void)
+{
+    static gsize configured;
+    if (g_once_init_enter(&configured)) {
+        const char *value = getenv("TOMACCO_IOS_SURFACE_SOURCE_TRACE");
+        g_once_init_leave(&configured, value && strcmp(value, "1") == 0 ? 2 : 1);
+    }
+    return configured == 2;
+}
+
+uint64_t tomacco_surface_source_runtime_pc;
+
+void tomacco_surface_source_bind_kernel(uint64_t original_base,
+                                      uint64_t loaded_base)
+{
+    if (!tomacco_surface_source_enabled()) {
+        return;
+    }
+    uint64_t entry = 0;
+    bool valid = tomacco_surface_kernel_entry(original_base, loaded_base, &entry);
+    __atomic_store_n(&tomacco_surface_source_runtime_pc, valid ? entry : 0,
+                     __ATOMIC_RELEASE);
+    trace_tomacco_arm_iosurface_source_kernel(original_base, loaded_base,
+                                             valid ? entry : 0, valid);
+}
+
+#ifndef CONFIG_USER_ONLY
+/* Standard debug translation, followed by direct ordinary-RAM reads. No MMIO
+ * target load, guest page write, register write or architectural exception
+ * occurs here. Reject holes, device RAM and partial/unmapped target spans.
+ * Original page-table debug walking retains QEMU's existing behavior. */
+static bool tomacco_surface_read_ram(CPUState *cpu, uint64_t address,
+                                     uint8_t *bytes, size_t length)
+{
+    RCU_READ_LOCK_GUARD();
+    if (length == 0 || address > UINT64_MAX - length) {
+        return false;
+    }
+    while (length) {
+        TranslateForDebugResult result;
+        if (!cpu_translate_for_debug(cpu, address, &result)) {
+            return false;
+        }
+        unsigned bits = MIN(result.lg_page_size, TARGET_PAGE_BITS);
+        if (bits == 0 || bits >= 63) {
+            return false;
+        }
+        uint64_t page = UINT64_C(1) << bits;
+        size_t amount = MIN(length, page - (result.physaddr & (page - 1)));
+        AddressSpace *as = cpu_get_address_space(cpu,
+                                cpu_asidx_from_attrs(cpu, result.attrs));
+        MemoryRegionSection section = memory_region_find(as->root,
+                                                          result.physaddr, amount);
+        bool available = section.mr &&
+                         section.offset_within_address_space == result.physaddr &&
+                         int128_get64(section.size) == amount &&
+                         memory_region_is_ram(section.mr) &&
+                         !memory_region_is_ram_device(section.mr);
+        if (available) {
+            memcpy(bytes, (uint8_t *)memory_region_get_ram_ptr(section.mr) +
+                          section.offset_within_region, amount);
+        }
+        if (section.mr) {
+            memory_region_unref(section.mr);
+        }
+        if (!available) {
+            return false;
+        }
+        address += amount;
+        bytes += amount;
+        length -= amount;
+    }
+    return true;
+}
+
+static const char *tomacco_surface_code_contract(CPUState *cpu, uint64_t slide)
+{
+    static const struct {
+        uint64_t address;
+        unsigned length;
+        uint8_t bytes[48];
+    } guards[] = {
+        { UINT64_C(0xfffffe0007ed60a4), 48, { 0x7f, 0x23, 0x3, 0xd5, 0xff, 0x83, 0x1, 0xd1, 0xf8, 0x5f, 0x2, 0xa9, 0xf6, 0x57, 0x3, 0xa9, 0xf4, 0x4f, 0x4, 0xa9, 0xfd, 0x7b, 0x5, 0xa9, 0xfd, 0x43, 0x1, 0x91, 0xf3, 0x3, 0x2, 0xaa, 0xf4, 0x3, 0x1, 0xaa, 0xe0, 0x3, 0x2, 0xaa, 0x38, 0xc2, 0x23, 0x94, 0xf5, 0x3, 0x0, 0xaa } },
+        { UINT64_C(0xfffffe00087c694c), 12, { 0x5f, 0x24, 0x3, 0xd5, 0x0, 0x10, 0x40, 0xb9, 0xc0, 0x3, 0x5f, 0xd6 } },
+        { UINT64_C(0xfffffe00087c6940), 12, { 0x5f, 0x24, 0x3, 0xd5, 0x0, 0x80, 0x40, 0xb9, 0xc0, 0x3, 0x5f, 0xd6 } },
+        { UINT64_C(0xfffffe00087cfa14), 16, { 0x7f, 0x23, 0x3, 0xd5, 0xff, 0x83, 0x1, 0xd1, 0xfa, 0x67, 0x1, 0xa9, 0xf8, 0x5f, 0x2, 0xa9 } },
+        { UINT64_C(0xfffffe00087cfb20), 8, { 0x81, 0x12, 0x40, 0xb9, 0x61, 0x3a, 0x0, 0xb9 } },
+        { UINT64_C(0xfffffe00087d032c), 8, { 0xa8, 0x3a, 0x40, 0xb9, 0x68, 0x19, 0x0, 0xb9 } },
+    };
+    uint8_t bytes[48];
+    for (unsigned i = 0; i < G_N_ELEMENTS(guards); ++i) {
+        if (guards[i].address > UINT64_MAX - guards[i].length ||
+            slide > UINT64_MAX - guards[i].address - guards[i].length) {
+            return "contract-code-address-overflow";
+        }
+        if (!tomacco_surface_read_ram(cpu, guards[i].address + slide,
+                                    bytes, guards[i].length)) {
+            return "contract-code-ram-unavailable";
+        }
+        if (memcmp(bytes, guards[i].bytes, guards[i].length)) {
+            return "contract-code-mismatch";
+        }
+    }
+    return NULL;
+}
+#endif
+
+void HELPER(tomacco_surface_source)(CPUARMState *env)
+{
+#ifndef CONFIG_USER_ONLY
+    static unsigned attempts, targets, census, refusals;
+    if (!tomacco_surface_source_enabled() || !env->aarch64 ||
+        arm_current_el(env) != 1 ||
+        !trace_event_get_state_backends(TRACE_TOMACCO_ARM_IOSURFACE_SOURCE) ||
+        !trace_event_get_state_backends(TRACE_TOMACCO_ARM_IOSURFACE_SOURCE_SHAPE) ||
+        __atomic_load_n(&targets, __ATOMIC_RELAXED) >= 8) {
+        return;
+    }
+    unsigned attempt = tomacco_surface_source_slot(&attempts, 128);
+    if (!attempt) {
+        return;
+    }
+    CPUState *cpu = env_cpu(env);
+    uint64_t entry = __atomic_load_n(&tomacco_surface_source_runtime_pc,
+                                    __ATOMIC_ACQUIRE);
+    const char *reason = entry >= TOMACCO_SURFACE_PRODUCER_PC ?
+        tomacco_surface_code_contract(cpu, entry - TOMACCO_SURFACE_PRODUCER_PC) :
+        "kernel-placement-unavailable";
+    uint64_t object = env->xregs[2], descriptor = env->xregs[1];
+    uint8_t bytes[TOMACCO_SURFACE_OBJECT_BYTES];
+    TomaccoSurfaceSource source;
+    if (!reason && (!object || (object & 7) ||
+                   object > UINT64_MAX - TOMACCO_SURFACE_OBJECT_BYTES)) {
+        reason = "object-pointer-invalid";
+    }
+    if (!reason && !tomacco_surface_read_ram(cpu, object, bytes, sizeof(bytes))) {
+        reason = "object-ram-unavailable";
+    }
+    if (!reason && !tomacco_surface_source_decode(bytes, sizeof(bytes), &source)) {
+        reason = "object-shape-invalid";
+    }
+    if (reason) {
+        if (tomacco_surface_source_slot(&refusals, 4)) {
+            trace_tomacco_arm_iosurface_source_refused(cpu->cpu_index, attempt, reason);
+        }
+        return;
+    }
+    bool target = source.pixel_format == TOMACCO_SURFACE_TARGET_FORMAT;
+    unsigned event = tomacco_surface_source_slot(target ? &targets : &census,
+                                                target ? 8 : 4);
+    if (event) {
+        trace_tomacco_arm_iosurface_source(cpu->cpu_index, attempt, event, target,
+                                          object, descriptor, source.native_id,
+                                          source.pixel_format, source.planes);
+        trace_tomacco_arm_iosurface_source_shape(cpu->cpu_index, attempt,
+                                          source.width, source.height,
+                                          env->cp15.ttbr0_el[1]);
+    }
+#else
+    (void)env;
+#endif
+}
