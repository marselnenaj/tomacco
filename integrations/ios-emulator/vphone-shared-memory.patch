-static void alloc_ram(Object *cpuobj, hwaddr base, size_t len) {
+static void alloc_ram(MachineState *machine, hwaddr base, size_t len) {
     MemoryRegion *ram_main = get_system_memory();
+    /* Use an explicitly supplied QEMU memory backend for local vhost-user
+     * transports. MachineState owns it; retain private RAM by default. */
+    if (machine->ram) {
+        if (memory_region_size(machine->ram) != len) {
+            error_report("Darwin RAM backend size differs from the device tree");
+            exit(EXIT_FAILURE);
+        }
+        memory_region_add_subregion(ram_main, base, machine->ram);
+        return;
+    }
     MemoryRegion *ram_subreg = g_new(MemoryRegion, 1);
     memory_region_init_ram(ram_subreg, NULL, "dram", len, &error_fatal);
     memory_region_add_subregion(ram_main, base, ram_subreg);
