+/* Observe only original EL0 traps and alignment faults, never ordinary
+ * demand paging or system calls. Trace capture changes no exception semantics.
+ * A shared atomic bounds the entire process even with threaded AP execution. */
+static void tomacco_trace_user_exception(CPUARMState *env, uint32_t excp,
+                                         uint64_t syndrome, uint32_t target_el)
+{
+    static unsigned captured;
+    unsigned ec = syn_get_ec(syndrome);
+    if (!env->aarch64 || arm_current_el(env) != 0 ||
+        !(ec == EC_AA64_BKPT || ec == EC_PCALIGNMENT ||
+          ec == EC_SPALIGNMENT || ec == EC_PACFAIL ||
+          (ec == EC_DATAABORT && (syndrome & 0x3f) == 0x21)) ||
+        !trace_event_get_state_backends(TRACE_TOMACCO_ARM_USER_EXCEPTION)) {
+        return;
+    }
+    /* Stop incrementing after the budget; no wraparound can reopen it. */
+    unsigned sequence = qatomic_read(&captured);
+    while (sequence < 128) {
+        unsigned previous = qatomic_cmpxchg(&captured, sequence, sequence + 1);
+        if (previous == sequence) {
+            trace_tomacco_arm_user_exception(env_cpu(env)->cpu_index, env->pc,
+                                             syndrome, excp, target_el, sequence + 1);
+            tomacco_trace_fault_context(env, env->pc, "user-trap");
+            return;
+        }
+        sequence = previous;
+    }
+}
