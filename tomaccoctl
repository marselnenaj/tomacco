#!/bin/sh
# Source checkout convenience launcher. Installed distributions use the ELF binary.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for binary in "$root/build-product/tomaccoctl" "$root/build/tomaccoctl" "$root/target/release/tomaccoctl"; do
    if test -x "$binary"; then exec "$binary" "$@"; fi
done
printf '%s\n' 'Build Tomacco first: cargo build --release --locked (or cmake --build build).' >&2
exit 127
